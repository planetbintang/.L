<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>VendorDomain Enterprise — 150 Modul</title><meta name="description" content="150 fitur VendorDomain, 1800 submenu dan prompt implementasi"><style>
:root{--bg:#f3f6fb;--panel:#fff;--ink:#17243d;--muted:#71809a;--line:#e1e7f1;--blue:#5268ed;--soft:#edf1ff;--nav:#111b34}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.55 system-ui,sans-serif}button,input,select,textarea{font:inherit}button{cursor:pointer}.top{position:sticky;top:0;z-index:5;background:var(--panel);border-bottom:1px solid var(--line);padding:14px 22px;display:flex;justify-content:space-between;align-items:center}.brand{font-weight:850;font-size:16px}.brand small{display:block;color:var(--muted);font-size:10px;font-weight:500}.btn{background:var(--panel);border:1px solid var(--line);border-radius:9px;padding:8px 11px;font-size:11px;font-weight:750;color:var(--ink)}.primary{background:var(--blue);color:#fff;border-color:var(--blue)}.layout{display:grid;grid-template-columns:230px minmax(0,1fr);min-height:calc(100vh - 60px)}aside{background:var(--nav);padding:18px 12px;color:#eaf0ff}.label{font-size:10px;letter-spacing:1px;color:#91a1c2;padding:12px}.nav{width:100%;text-align:left;border:0;border-radius:8px;background:transparent;color:#cdd6e9;padding:10px;font-size:12px}.nav.active,.nav:hover{background:#28395d;color:#fff}.cats{display:grid;gap:2px}.cats button{background:none;border:0;color:#aebbd4;text-align:left;padding:7px 10px;font-size:11px;border-radius:7px}.cats button.active,.cats button:hover{background:#263554;color:white}main{padding:24px;max-width:1700px;width:100%;margin:auto;min-width:0}.hero{background:linear-gradient(115deg,#101a31,#263e80 75%,#5368d9);color:white;padding:28px;border-radius:16px}.eyebrow{color:#6b7bf3;letter-spacing:1.5px;font-size:10px;font-weight:850}.hero .eyebrow{color:#b3c0ff}.hero h1{margin:0;font-size:clamp(25px,3vw,36px)}.hero h1 span{color:#aab8ff}.hero p:last-child{color:#d4def9;margin-bottom:0}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:14px 0 26px}.stat,.card,.info{background:var(--panel);border:1px solid var(--line);border-radius:11px;padding:14px;min-width:0}.stat span,.stat small{display:block;color:var(--muted);font-size:10px}.stat strong{font-size:24px;display:block}.heading{display:flex;justify-content:space-between;align-items:end;gap:12px}.heading h2{margin:0;font-size:23px}.heading p{color:var(--muted);margin:5px 0 13px}.filters{display:grid;grid-template-columns:1fr 220px 130px;gap:8px;margin:12px 0}.filters input,.filters select{width:100%;padding:11px;border:1px solid var(--line);border-radius:9px;background:var(--panel);color:var(--ink)}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.card{display:flex;flex-direction:column;gap:8px}.cardtop,.cardfoot{display:flex;justify-content:space-between;align-items:center;gap:6px}.meta{font-size:10px;color:var(--muted)}.badge{font-size:9px;padding:3px 6px;border-radius:5px;background:var(--soft);color:#465acb;font-weight:850}.cat{font-size:10px;color:var(--blue);font-weight:750}.card h3{font-size:14px;margin:0}.card p{font-size:11px;color:var(--muted);margin:0;min-height:49px}.cardfoot{margin-top:auto}.view[hidden],.overlay[hidden]{display:none}.infogrid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.info h3{margin:8px 0 4px;font-size:14px}.info p{margin:0;color:var(--muted);font-size:12px}.warning{margin-top:12px;padding:16px;background:#fff7e6;border:1px solid #f0d9a2;border-radius:10px}.warning p{font-size:12px;color:#796c50}.phases{display:grid;gap:9px}.phase{background:var(--panel);border:1px solid var(--line);padding:14px;border-radius:10px}.phase b{color:var(--blue);margin-right:9px}.phase p{margin:5px 0 0 30px;color:var(--muted);font-size:12px}.master{margin-top:14px}.master textarea{width:100%;min-height:160px;background:var(--panel);border:1px solid var(--line);border-radius:9px;padding:12px;color:var(--ink)}.overlay{position:fixed;inset:0;z-index:20;background:#081329b3;display:flex;justify-content:flex-end}.panel{background:var(--bg);width:min(720px,100%);height:100%;overflow:auto;display:flex;flex-direction:column}.detailhead{background:var(--panel);padding:22px;display:flex;justify-content:space-between;gap:12px;border-bottom:1px solid var(--line)}.detailhead h2{margin:0;font-size:23px}.detailhead p{color:var(--muted);font-size:11px;margin:5px 0}.tabs{display:flex;gap:5px;padding:12px 20px;background:var(--panel)}.tabs button{border:0;background:transparent;border-radius:7px;padding:8px 12px;color:var(--muted);font-weight:750;font-size:12px}.tabs button.active{background:var(--soft);color:var(--blue)}.detailbody{padding:19px 22px;flex:1}.detailbox,.menurow{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:14px;margin-bottom:9px}.detailbox h3{font-size:13px;margin:0 0 7px}.detailbox p,.menurow p{color:var(--muted);font-size:12px;margin:0}.menurow{display:flex;gap:10px}.menurow b{color:var(--blue);font-size:10px}.menurow strong{font-size:12px}.code{white-space:pre-wrap;overflow-wrap:anywhere;font:12px/1.65 ui-monospace,monospace}.detailfoot{background:var(--panel);border-top:1px solid var(--line);padding:12px 20px;display:flex;gap:8px}.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#111b34;color:white;border-radius:8px;padding:10px 14px;opacity:0;transition:.2s;pointer-events:none}.toast.show{opacity:1}body.dark{color-scheme:dark;--bg:#0b1323;--panel:#131d31;--ink:#e8eefb;--muted:#9ba8c1;--line:#283651;--soft:#202e52}body.dark .warning{background:#282216;border-color:#594828}@media(max-width:1100px){.grid{grid-template-columns:repeat(2,1fr)}.layout{grid-template-columns:205px 1fr}.infogrid{grid-template-columns:repeat(2,1fr)}}@media(max-width:700px){.top{padding:11px}.layout{display:block}aside{padding:7px}.label{display:none}.nav{width:auto;display:inline-block}.cats{display:flex;overflow:auto}.cats button{white-space:nowrap}main{padding:11px}.stats{grid-template-columns:repeat(2,1fr)}.filters{grid-template-columns:1fr}.grid,.infogrid{grid-template-columns:1fr}.hero{padding:21px}.heading{align-items:start;flex-direction:column}.actions{display:flex;gap:3px}.btn{padding:7px;font-size:10px}}
</style></head><body><header class="top"><div class="brand">◈ VendorDomain<small>Enterprise Control Plane</small></div><div class="actions"><button id="json" class="btn">Ekspor JSON</button> <button id="csv" class="btn">Ekspor CSV</button> <button id="theme" class="btn">◐ Tema</button></div></header><div class="layout"><aside><div class="label">WORKSPACE</div><button class="nav active" data-view="catalog">▦ Katalog fitur · 150</button><button class="nav" data-view="architecture">◇ Arsitektur</button><button class="nav" data-view="plan">⌘ Implementasi</button><div class="label">KATEGORI</div><div id="cats" class="cats"></div></aside><main><section class="hero"><div class="eyebrow">PLATFORM BLUEPRINT / V1</div><h1>VendorDomain <span>Enterprise</span></h1><p>150 fitur utama, 1.800 submenu, detail tampilan, fungsi, persyaratan integrasi, dan prompt implementasi.</p></section><section class="stats"><div class="stat"><span>Fitur utama</span><strong>150</strong><small>10 kategori</small></div><div class="stat"><span>Submenu</span><strong>1.800</strong><small>12 per fitur</small></div><div class="stat"><span>Struktur</span><strong>6 + 6</strong><small>Umum dan spesifik</small></div><div class="stat"><span>Status</span><strong style="font-size:18px;color:#b7791f">Scaffold</strong><small>Backend belum otomatis aktif</small></div></section><section id="catalog" class="view"><div class="heading"><div><div class="eyebrow">MODULE DIRECTORY</div><h2>Katalog modul</h2><p>Telusuri fitur, lihat submenu dan salin prompt.</p></div><span id="count" class="badge">150 modul</span></div><div class="filters"><input id="q" type="search" placeholder="Cari fitur, fungsi, submenu…" autocomplete="off"><select id="cf"><option value="">Semua kategori</option></select><select id="pf"><option value="">Semua prioritas</option><option>P0</option><option>P1</option><option>P2</option><option>P3</option></select></div><div id="grid" class="grid"></div><div id="empty" hidden class="info">Tidak ada hasil. Ubah filter.</div></section><section id="architecture" class="view" hidden><div class="heading"><div><div class="eyebrow">SYSTEM DESIGN</div><h2>Arsitektur implementasi</h2><p>Fondasi untuk menjadikan modul operasional.</p></div></div><div class="infogrid"><article class="info"><b>01 / UI</b><h3>Frontend</h3><p>Routing unik, tabel, form, modal, status loading/kosong/error, tema dan aksesibilitas.</p></article><article class="info"><b>02 / API</b><h3>Service layer</h3><p>Kontrak API, adapter provider, validasi, timeout, idempotensi dan retry.</p></article><article class="info"><b>03 / DATA</b><h3>Database</h3><p>Skema, migrasi, indeks, isolasi tenant, backup dan audit.</p></article><article class="info"><b>04 / IAM</b><h3>Keamanan</h3><p>Autentikasi server-side, RBAC di setiap endpoint, rate limit dan secret vault.</p></article><article class="info"><b>05 / EXT</b><h3>Provider</h3><p>Registrar, DNS, cloud, email, sertifikat dan pembayaran perlu kredensial/provider yang sah.</p></article><article class="info"><b>06 / QA</b><h3>Quality gates</h3><p>Lint, type check, unit/integration/UI tests, build dan verifikasi deployment.</p></article></div><div class="warning"><strong>Batas deployment</strong><p>GitHub Pages hanya menyajikan frontend statis. Backend, database, cron, pembayaran, dan operasi domain harus berjalan pada layanan terpisah. Jangan menaruh token atau rahasia provider di JavaScript browser.</p></div></section><section id="plan" class="view" hidden><div class="heading"><div><div class="eyebrow">IMPLEMENTATION PLAN</div><h2>Urutan implementasi</h2></div></div><div class="phases"><article class="phase"><b>01</b><strong>Fondasi, routing, autentikasi, RBAC, audit</strong><p>Design system, registry, konfigurasi dan error handling.</p></article><article class="phase"><b>02</b><strong>Domain dan DNS</strong><p>Registrar adapter, DNS records, DNSSEC, nameserver, dry-run dan riwayat.</p></article><article class="phase"><b>03</b><strong>Hosting dan cloud</strong><p>File manager aman, deployment, backup, monitoring dan rollback.</p></article><article class="phase"><b>04</b><strong>Keamanan dan komunikasi</strong><p>Identity, secrets, sertifikat, email dan notifikasi.</p></article><article class="phase"><b>05</b><strong>Bisnis dan finansial</strong><p>Order, invoice, payment webhook, langganan dan rekonsiliasi.</p></article><article class="phase"><b>06</b><strong>Otomasi dan QA</strong><p>Workflow, dokumentasi, pengujian dan observabilitas.</p></article></div><article class="info master"><h3>Master prompt implementasi</h3><textarea id="master" readonly></textarea><button id="copyMaster" class="btn primary">Salin master prompt</button></article></section></main></div><div id="overlay" class="overlay" hidden><section class="panel" role="dialog" aria-modal="true"><div class="detailhead"><div><div class="eyebrow">MODULE DETAIL</div><h2 id="dt"></h2><p id="dm"></p></div><button id="close" class="btn">Tutup ✕</button></div><div class="tabs"><button class="active" data-tab="overview">Ikhtisar</button><button data-tab="menus">Submenu</button><button data-tab="prompt">Prompt</button></div><div id="db" class="detailbody"></div><div class="detailfoot"><button id="copyPrompt" class="btn primary">Salin prompt fitur</button><button id="download" class="btn">Unduh spesifikasi</button></div></section></div><div id="toast" class="toast" role="status"></div>
<script>
(()=>{const groups=[["Domain & Registration",["Domain Dashboard","Pencarian Domain","Registrasi Domain","Transfer Domain","Portofolio Domain","Perpanjangan Domain","Kepemilikan Domain","Nameserver","DNSSEC Domain","Domain Lock","Marketplace Domain","Penilaian Domain","Pemantauan Domain","Pengelolaan Domain Massal","Pemulihan Domain"]],["DNS Platform",["DNS Zone Editor","DNS Record Manager","DNS Propagation","DNS Lookup","MX Routing","TXT dan SPF","DKIM Manager","DMARC Manager","Reverse DNS","DNS Health Check","DNS Templates","DNS Failover","DNS Load Balancing","Anycast dan GeoDNS","DNS Change History"]],["Web Hosting",["Hosting Dashboard","Website Manager","Static Site Hosting","PHP Hosting","Node.js Hosting","Database Hosting","File Manager","FTP/SFTP","Cron Jobs","SSL Hosting","Website Redirects","Error Pages","Website Staging","Website Cloning","Website Migration"]],["Cloud Infrastructure",["Cloud Dashboard","Virtual Machines","Container Manager","Kubernetes","Server Monitoring","Server Provisioning","Load Balancer","Object Storage","CDN Manager","Deployment Pipeline","Git Integration","Release Manager","Infrastructure as Code","Backup dan Snapshot","Disaster Recovery"]],["Security & Identity",["Security Center","User Management","Role-Based Access Control","Multi-Factor Authentication","Single Sign-On","Session Manager","API Key Manager","Secrets Vault","Certificate Security","Vulnerability Scanner","Firewall Manager","DDoS Protection","Web Application Firewall","Audit Security","Compliance Center"]],["Communications",["Email Hosting","Mailbox Manager","Email Forwarding","Email Deliverability","SMTP Manager","Transactional Email","Email Templates","Notification Center","Notification Rules","SMS Gateway","Web Push","Certificate Authority Integration","Certificate Automation","Contact Directory","Communication Templates"]],["Analytics & Operations",["Analytics Dashboard","Traffic Analytics","Real-Time Monitoring","Uptime Monitoring","Synthetic Testing","Log Explorer","Error Tracking","Distributed Tracing","Performance Profiler","Synthetic DNS Tests","Incident Management","Alert Manager","Status Page","SLA Reporting","Capacity Planning"]],["Business Operations",["Billing Dashboard","Invoice Manager","Payment Gateway","Subscription Manager","Pricing Engine","Coupon Manager","Refund Manager","Customer Portal","CRM","Order Management","Affiliate Program","Reseller Portal","Revenue Analytics","Tax Management","Financial Reconciliation"]],["Platform Administration",["Admin Control Center","Menu Builder","Page Builder","Component Registry","Workflow Automation","Scheduled Tasks","API Management","Webhook Manager","Integration Hub","Import/Export Center","Localization Manager","Theme Manager","Feature Flags","Configuration Manager","System Diagnostics"]],["Collaboration & Developer Experience",["Support Center","Ticket Management","Knowledge Base","Live Chat","Team Collaboration","Task Manager","Project Management","Documentation Portal","Developer Console","SDK Manager","Sandbox Environment","Testing Center","Release Notes","Feedback Manager","VendorDomain System Orchestrator"]]];const common=[['Ikhtisar','Ringkasan status, statistik dan aktivitas terbaru.'],['Daftar data','Tabel dengan pencarian, filter, pengurutan, pagination dan aksi sesuai izin.'],['Detail objek','Metadata, relasi, status, konfigurasi dan riwayat.'],['Buat dan kelola','Form tambah/edit, validasi, konfirmasi dan penyimpanan persisten jika backend tersedia.'],['Pengaturan','Aturan, preferensi, integrasi dan konfigurasi modul.'],['Log dan laporan','Riwayat operasi, hasil, error, audit dan ekspor sesuai izin.']];const features=[];let n=1;groups.forEach(([category,items])=>items.forEach(name=>{const id=String(n).padStart(3,'0'),priority=n<=30?'P0':n<=75?'P1':n<=120?'P2':'P3',description='Modul '+name+' untuk '+category.toLowerCase()+'. Mengelola data, status, validasi, aktivitas, dan integrasi sesuai kapabilitas layanan yang dikonfigurasi.',appearance='Halaman '+name+' dengan judul, breadcrumb, kartu status, toolbar pencarian/filter, tabel atau panel detail, form tindakan, status loading/kosong/error/berhasil, dialog konfirmasi, dan panel riwayat. Responsif untuk desktop dan ponsel.',fn='Validasi input di klien dan server; jalankan operasi hanya jika diizinkan; tampilkan hasil API; tangani kegagalan jaringan; gunakan pagination; dan catat audit untuk perubahan sensitif.',integration='Gunakan service/API adapter dan penyimpanan persisten bila tersedia. Integrasi eksternal membutuhkan provider dan kredensial aman. Jika belum terhubung, tampilkan status Belum terhubung dan jangan menyimulasikan keberhasilan.',prompt='Implementasikan '+name+' ('+category+') di VendorDomain. Buat route unik. Tampilan: '+appearance+' Fungsi: '+description+' Operasional: '+fn+' Integrasi: '+integration+' Tambahkan RBAC backend, audit, penanganan error, test dan dokumentasi. Jangan klaim operasi eksternal berhasil tanpa konfirmasi provider.',specific=[name+' — ikhtisar',name+' — daftar dan pencarian',name+' — detail konfigurasi',name+' — buat atau ubah',name+' — kebijakan dan integrasi',name+' — riwayat dan laporan'];features.push({id,name,category,priority,description,appearance,fn,integration,prompt,menus:[...common.map((m,i)=>({id:id+'-S'+(i+1),name:m[0],purpose:m[1]})),...specific.map((m,i)=>({id:id+'-O'+(i+1),name:m,purpose:m+' untuk '+name+': tampilkan data relevan, validasi perubahan, status proses, izin akses dan jejak aktivitas.'}))]});n++}));const $=id=>document.getElementById(id),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));let cat='',chosen=null,tab='overview',timer;const master='Periksa stack dan repositori sebelum mengubah kode. Implementasikan 150 modul dan 1.800 submenu secara bertahap. Bangun design system, routing, autentikasi, RBAC server-side, API/service layer, database persisten, audit, integrasi provider, observabilitas, test dan dokumentasi. Setiap modul memiliki overview, daftar, detail, create/manage, settings, logs/reports serta enam submenu spesifik. Jangan menganggap scaffold sebagai produksi. GitHub Pages hanya frontend statis; deploy backend terpisah dengan secret manager. Jalankan lint, tests, build dan verifikasi hasil.';$('master').value=master;function toast(s){$('toast').textContent=s;$('toast').classList.add('show');clearTimeout(timer);timer=setTimeout(()=>$('toast').classList.remove('show'),2200)}function dl(name,text,type='application/json'){const a=document.createElement('a'),u=URL.createObjectURL(new Blob([text],{type}));a.href=u;a.download=name;a.click();URL.revokeObjectURL(u)}function exportJson(){dl('vendordomain-150-features.json',JSON.stringify({product:'VendorDomain Enterprise',featureCount:features.length,submenuCount:features.length*12,status:'scaffold',features},null,2))}function exportCsv(){const q=x=>'"'+String(x??'').replace(/"/g,'""')+'"',rows=[['ID','Nama','Kategori','Prioritas','Deskripsi','Tampilan','Fungsi','Integrasi','Prompt','Submenu']];features.forEach(f=>rows.push([f.id,f.name,f.category,f.priority,f.description,f.appearance,f.fn,f.integration,f.prompt,f.menus.map(m=>m.name).join('; ')]));dl('vendordomain-150-features.csv',rows.map(r=>r.map(q).join(',')).join('\r\n'),'text/csv;charset=utf-8')}function cats(){ $('cats').innerHTML=groups.map(g=>'<button data-cat="'+esc(g[0])+'" class="'+(cat===g[0]?'active':'')+'">'+esc(g[0])+'</button>').join('');$('cf').innerHTML='<option value="">Semua kategori</option>'+groups.map(g=>'<option>'+esc(g[0])+'</option>').join('')}function render(){const q=$('q').value.toLowerCase().trim(),c=$('cf').value,p=$('pf').value,list=features.filter(f=>(!q||(f.name+' '+f.category+' '+f.description+' '+f.menus.map(m=>m.name).join(' ')).toLowerCase().includes(q))&&(!c||f.category===c)&&(!cat||f.category===cat)&&(!p||f.priority===p));$('count').textContent=list.length+' modul';$('grid').innerHTML=list.map(f=>'<article class="card"><div class="cardtop"><span class="meta">VD-'+f.id+'</span><span class="badge">'+f.priority+'</span></div><div><span class="cat">'+esc(f.category)+'</span><h3>'+esc(f.name)+'</h3></div><p>'+esc(f.description)+'</p><div class="cardfoot"><span class="meta">12 submenu · scaffold</span><button class="btn" data-open="'+f.id+'">Detail ↗</button></div></article>').join('');$('empty').hidden=list.length>0;$('cats').querySelectorAll('[data-cat]').forEach(b=>b.classList.toggle('active',b.dataset.cat===cat))}function detail(){if(!chosen)return;$('dt').textContent=chosen.name;$('dm').textContent='VD-'+chosen.id+' · '+chosen.category+' · '+chosen.priority+' · '+chosen.menus.length+' submenu';document.querySelectorAll('[data-tab]').forEach(b=>b.classList.toggle('active',b.dataset.tab===tab));if(tab==='overview')$('db').innerHTML=[['Deskripsi dan fungsi',chosen.description],['Tampilan',chosen.appearance],['Perilaku operasional',chosen.fn],['Integrasi dan batasan',chosen.integration],['Kriteria minimum','Route unik, validasi server-side, status loading/kosong/error/sukses, RBAC, audit, pengujian dan dokumentasi.']].map(x=>'<article class="detailbox"><h3>'+esc(x[0])+'</h3><p>'+esc(x[1])+'</p></article>').join('');else if(tab==='menus')$('db').innerHTML=chosen.menus.map((m,i)=>'<article class="menurow"><b>'+String(i+1).padStart(2,'0')+'</b><div><strong>'+esc(m.name)+'</strong><p>'+esc(m.purpose)+'</p></div></article>').join('');else $('db').innerHTML='<article class="detailbox"><h3>Prompt implementasi spesifik</h3><p class="code">'+esc(chosen.prompt)+'</p><p style="margin-top:10px">Prompt adalah spesifikasi kerja, bukan bukti backend aktif.</p></article>'}function open(id){chosen=features.find(f=>f.id===id);if(!chosen)return;tab='overview';detail();$('overlay').hidden=false;document.body.style.overflow='hidden';history.replaceState(null,'','#feature-'+id)}function close(){ $('overlay').hidden=true;document.body.style.overflow='';chosen=null;if(location.hash.startsWith('#feature-'))history.replaceState(null,'',location.pathname+location.search)}async function copy(s){try{await navigator.clipboard.writeText(s);toast('Teks disalin.')}catch{const t=document.createElement('textarea');t.value=s;document.body.appendChild(t);t.select();const ok=document.execCommand('copy');t.remove();toast(ok?'Teks disalin.':'Gagal menyalin teks.')}}cats();render();$('q').addEventListener('input',render);$('cf').addEventListener('change',()=>{cat='';render()});$('pf').addEventListener('change',render);$('cats').addEventListener('click',e=>{const b=e.target.closest('[data-cat]');if(!b)return;cat=cat===b.dataset.cat?'':b.dataset.cat;$('cf').value=cat;render()});$('grid').addEventListener('click',e=>{const b=e.target.closest('[data-open]');if(b)open(b.dataset.open)});document.querySelectorAll('[data-view]').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('[data-view]').forEach(x=>x.classList.toggle('active',x===b));document.querySelectorAll('.view').forEach(x=>x.hidden=true);$(b.dataset.view).hidden=false}));document.querySelectorAll('[data-tab]').forEach(b=>b.addEventListener('click',()=>{tab=b.dataset.tab;detail()}));$('close').addEventListener('click',close);$('overlay').addEventListener('click',e=>{if(e.target===$('overlay'))close()});document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!$('overlay').hidden)close()});$('copyPrompt').addEventListener('click',()=>chosen&&copy(chosen.prompt));$('download').addEventListener('click',()=>chosen&&dl('vendordomain-'+chosen.id+'.json',JSON.stringify(chosen,null,2)));$('json').addEventListener('click',exportJson);$('csv').addEventListener('click',exportCsv);$('copyMaster').addEventListener('click',()=>copy(master));$('theme').addEventListener('click',()=>{document.body.classList.toggle('dark');try{localStorage.setItem('vd-theme',document.body.classList.contains('dark')?'dark':'light')}catch{}});try{if(localStorage.getItem('vd-theme')==='dark')document.body.classList.add('dark')}catch{}if(location.hash.startsWith('#feature-'))open(location.hash.slice(9,12));window.VendorDomainEnterprise={featureCount:features.length,submenuCount:features.length*12,getFeature:id=>features.find(f=>f.id===String(id).padStart(3,'0')),exportRegistry:exportJson}})();
</script></body></html>