
.vdCip{color:var(--text,#eaf4ff);display:grid;gap:14px}.vdCip *{box-sizing:border-box}.vdCip-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap}.vdCip-head h2{margin:0;font-size:23px}.vdCip-muted{color:var(--muted,#9cb2cc);font-size:12px}.vdCip-actions{display:flex;gap:7px;flex-wrap:wrap}.vdCip button,.vdCip input,.vdCip select{font:inherit;border-radius:0;min-height:40px}.vdCip button{border:1px solid #315474;background:#10243a;color:#dceeff;padding:8px 12px;cursor:pointer}.vdCip button:hover{border-color:#73cfff;background:#163452}.vdCip button:disabled{opacity:.45;cursor:not-allowed}.vdCip input,.vdCip select{background:#071321;color:#eaf4ff;border:1px solid #29415d;padding:9px;width:100%}.vdCip input:focus,.vdCip select:focus{outline:2px solid #73cfff;outline-offset:1px}.vdCip-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.vdCip-kpi,.vdCip-panel{border:1px solid rgba(119,174,225,.25);background:linear-gradient(145deg,#0d1e32,#071321);padding:15px;min-width:0}.vdCip-kpi small{display:block;color:#9cb2cc;font-size:10px;letter-spacing:.08em}.vdCip-kpi strong{display:block;font-size:25px;margin:5px 0}.vdCip-kpi em{font-style:normal;color:#9cb2cc;font-size:11px}.vdCip-layout{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(240px,.8fr);gap:12px}.vdCip-panel h3{margin:0 0 10px;font-size:14px}.vdCip-table-wrap{overflow:auto;border:1px solid #29415d}.vdCip table{width:100%;border-collapse:collapse;min-width:560px;font-size:12px}.vdCip th,.vdCip td{text-align:left;padding:10px;border-bottom:1px solid #203750}.vdCip th{color:#9fc9e8;font-size:10px;letter-spacing:.08em;background:#0c1c2e}.vdCip-empty{padding:18px;border:1px dashed #36516d;color:#9cb2cc;font-size:12px}.vdCip-status{display:inline-block;border:1px solid #36516d;padding:3px 7px;font-size:10px;color:#b9d8ef}.vdCip-status.ok{border-color:#34785e;color:#8ce0b5}.vdCip-status.warn{border-color:#80642f;color:#ffda91}.vdCip-error{border:1px solid #8a4b4b;padding:12px;color:#ffc1c1;background:#301a20;font-size:12px}.vdCip-nav{display:flex;gap:6px;flex-wrap:wrap}.vdCip-nav button[aria-current=page]{background:#17436a;border-color:#73cfff;color:#fff}.vdCip-toolbar{display:grid;grid-template-columns:minmax(160px,1fr) auto;gap:8px}.vdCip-flow{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:6px;align-items:center}.vdCip-node{padding:11px 7px;text-align:center;border:1px solid #315474;background:#0b1b2d;font-size:10px;color:#c9e7ff}.vdCip-arrow{text-align:center;color:#73cfff}.vdCip-note{border-left:3px solid #73cfff;padding:9px 12px;background:#0b1b2d;color:#9cb2cc;font-size:11px}.vdCip-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.vdCip-form label{display:grid;gap:5px;font-size:11px;color:#a9c0d8}.vdCip-form .wide{grid-column:1/-1}.vdCip-form button{justify-self:start}.vdCip-activity{display:grid;gap:8px}.vdCip-activity article{display:flex;justify-content:space-between;gap:10px;border-bottom:1px solid #203750;padding:8px 0;font-size:11px}.vdCip-small{font-size:10px;color:#9cb2cc}
@media(max-width:850px){.vdCip-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.vdCip-layout{grid-template-columns:1fr}.vdCip-flow{grid-template-columns:1fr}.vdCip-arrow{transform:rotate(90deg)}}
@media(max-width:480px){.vdCip-kpis{grid-template-columns:1fr 1fr}.vdCip-kpi{padding:11px}.vdCip-kpi strong{font-size:20px}.vdCip-form{grid-template-columns:1fr}.vdCip-form .wide{grid-column:auto}.vdCip-toolbar{grid-template-columns:1fr}}
