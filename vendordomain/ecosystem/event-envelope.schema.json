{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planetbintang.github.io/.L/vendordomain/ecosystem/event-envelope.schema.json",
  "title": "VendorDomain Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "occurredAt",
    "source",
    "version",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "tenantId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "actorId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 120
    },
    "data": {
      "type": "object"
    }
  }
}