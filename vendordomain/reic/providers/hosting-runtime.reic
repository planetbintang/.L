{
  "format": "PLANETBINTANG-REIC",
  "format_version": "1.1.0",
  "component_id": "PB-PROVIDERS-05",
  "slug": "hosting-runtime",
  "title": "Hosting dan Runtime",
  "owner": "OWNER",
  "platform": "PLANETBINTANG",
  "policy_authority": "SNAPS",
  "module": "providers",
  "status": "manual-contract-ready",
  "execution_mode": "server-adapter-required",
  "purpose": "Mendefinisikan deployment aplikasi, health check, rollback dan skala.",
  "extensions": [
    ".reic",
    ".json",
    ".js",
    ".html",
    ".css",
    ".sql",
    ".yaml",
    ".md"
  ],
  "contract": {
    "inputs": [
      "artifact_ref",
      "region",
      "plan"
    ],
    "outputs": [
      "result",
      "resource_id",
      "audit_event_id",
      "correlation_id"
    ],
    "operations": [
      {
        "name": "validate",
        "mode": "local",
        "mutates": false
      },
      {
        "name": "hosting.deploy",
        "mode": "server",
        "mutates": true,
        "requires_authorization": true,
        "requires_idempotency": true
      }
    ],
    "lifecycle": [
      "RECEIVED",
      "VALIDATED",
      "AUTHORIZED",
      "APPROVED",
      "EXECUTING",
      "COMMITTED",
      "AUDITED"
    ],
    "errors": [
      "INVALID_INPUT",
      "UNAUTHENTICATED",
      "FORBIDDEN",
      "TENANT_SCOPE_MISMATCH",
      "APPROVAL_REQUIRED",
      "PROVIDER_UNAVAILABLE",
      "CONFLICT",
      "TIMEOUT"
    ]
  },
  "access": {
    "authentication_required": true,
    "tenant_scope_required": true,
    "default_decision": "DENY",
    "roles": {
      "owner": [
        "*"
      ],
      "admin": [
        "read",
        "create",
        "update"
      ],
      "operator": [
        "read",
        "execute"
      ],
      "viewer": [
        "read"
      ]
    },
    "owner_override_requires_audit": true,
    "snaps_policy_required": true
  },
  "safety": {
    "secrets_in_browser": false,
    "provider_calls_server_side": true,
    "destructive_action_requires_owner_approval": true,
    "pii_redaction": true,
    "timeout_ms": 15000,
    "retries": "bounded-exponential-backoff",
    "idempotency_key_required": true
  },
  "persistence": {
    "engine": "PostgreSQL",
    "table": "hosting_instances",
    "transaction": "required-for-mutation",
    "sync": "transactional-outbox",
    "tenant_isolation": "row-level-policy-and-query-scope"
  },
  "events": {
    "published": [
      "providers.hosting-runtime.requested",
      "providers.hosting-runtime.completed",
      "providers.hosting-runtime.failed"
    ],
    "envelope": "vendordomain/ecosystem/event-envelope.schema.json"
  },
  "extensions_flow": [
    ".reic contract",
    ".json schema and manifest",
    ".js validator/controller",
    ".sql migration and transaction",
    ".yaml deployment policy",
    ".html/.css operator console",
    ".md runbook"
  ],
  "approval": {
    "required": true,
    "authority": [
      "OWNER",
      "SNAPS"
    ],
    "default": "DENY",
    "approval_token": "server-issued-single-use"
  },
  "observability": {
    "audit_required": true,
    "metrics": [
      "duration_ms",
      "success_count",
      "failure_count"
    ],
    "trace_fields": [
      "request_id",
      "correlation_id",
      "tenant_id",
      "actor_id"
    ]
  },
  "rollback": {
    "strategy": "compensating-action-or-database-rollback",
    "manual_confirmation": true
  },
  "execution_note": "Kontrak manual .reic. Operasi eksternal tidak dianggap aktif sebelum adapter provider, secret server-side, migrasi, test sandbox dan persetujuan Owner dikonfigurasi."
}
