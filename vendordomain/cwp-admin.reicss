
.vdcwp{color:var(--text,#eaf4ff);display:grid;gap:14px}.vdcwp *{box-sizing:border-box}.vdcwp-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap}.vdcwp-head h2{margin:0;font-size:23px}.vdcwp-muted{color:var(--muted,#9cb2cc);font-size:12px}.vdcwp-actions{display:flex;gap:7px;flex-wrap:wrap}.vdcwp button,.vdcwp input,.vdcwp select{font:inherit;border-radius:0;min-height:40px}.vdcwp button{border:1px solid #315474;background:#10243a;color:#dceeff;padding:8px 12px;cursor:pointer}.vdcwp button:hover{border-color:#73cfff;background:#163452}.vdcwp button:disabled{opacity:.45;cursor:not-allowed}.vdcwp input,.vdcwp select{background:#071321;color:#eaf4ff;border:1px solid #29415d;padding:9px;width:100%}.vdcwp input:focus,.vdcwp select:focus{outline:2px solid #73cfff;outline-offset:1px}.vdcwp-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.vdcwp-kpi,.vdcwp-panel{border:1px solid rgba(119,174,225,.25);background:linear-gradient(145deg,#0d1e32,#071321);padding:15px;min-width:0}.vdcwp-kpi small{display:block;color:#9cb2cc;font-size:10px;letter-spacing:.08em}.vdcwp-kpi strong{display:block;font-size:25px;margin:5px 0}.vdcwp-kpi em{font-style:normal;color:#9cb2cc;font-size:11px}.vdcwp-layout{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(240px,.8fr);gap:12px}.vdcwp-panel h3{margin:0 0 10px;font-size:14px}.vdcwp-table-wrap{overflow:auto;border:1px solid #29415d}.vdcwp table{width:100%;border-collapse:collapse;min-width:560px;font-size:12px}.vdcwp th,.vdcwp td{text-align:left;padding:10px;border-bottom:1px solid #203750}.vdcwp th{color:#9fc9e8;font-size:10px;letter-spacing:.08em;background:#0c1c2e}.vdcwp-empty{padding:18px;border:1px dashed #36516d;color:#9cb2cc;font-size:12px}.vdcwp-status{display:inline-block;border:1px solid #36516d;padding:3px 7px;font-size:10px;color:#b9d8ef}.vdcwp-status.ok{border-color:#34785e;color:#8ce0b5}.vdcwp-status.warn{border-color:#80642f;color:#ffda91}.vdcwp-error{border:1px solid #8a4b4b;padding:12px;color:#ffc1c1;background:#301a20;font-size:12px}.vdcwp-nav{display:flex;gap:6px;flex-wrap:wrap}.vdcwp-nav button[aria-current=page]{background:#17436a;border-color:#73cfff;color:#fff}.vdcwp-toolbar{display:grid;grid-template-columns:minmax(160px,1fr) auto;gap:8px}.vdcwp-flow{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:6px;align-items:center}.vdcwp-node{padding:11px 7px;text-align:center;border:1px solid #315474;background:#0b1b2d;font-size:10px;color:#c9e7ff}.vdcwp-arrow{text-align:center;color:#73cfff}.vdcwp-note{border-left:3px solid #73cfff;padding:9px 12px;background:#0b1b2d;color:#9cb2cc;font-size:11px}.vdcwp-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.vdcwp-form label{display:grid;gap:5px;font-size:11px;color:#a9c0d8}.vdcwp-form .wide{grid-column:1/-1}.vdcwp-form button{justify-self:start}.vdcwp-activity{display:grid;gap:8px}.vdcwp-activity article{display:flex;justify-content:space-between;gap:10px;border-bottom:1px solid #203750;padding:8px 0;font-size:11px}.vdcwp-small{font-size:10px;color:#9cb2cc}
@media(max-width:850px){.vdcwp-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.vdcwp-layout{grid-template-columns:1fr}.vdcwp-flow{grid-template-columns:1fr}.vdcwp-arrow{transform:rotate(90deg)}}
@media(max-width:480px){.vdcwp-kpis{grid-template-columns:1fr 1fr}.vdcwp-kpi{padding:11px}.vdcwp-kpi strong{font-size:20px}.vdcwp-form{grid-template-columns:1fr}.vdcwp-form .wide{grid-column:auto}.vdcwp-toolbar{grid-template-columns:1fr}}
