<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Detail Fitur — VendorDomain</title><style>body{font:16px/1.65 system-ui,sans-serif;max-width:850px;margin:0 auto;padding:24px;color:#eaf0fa;background:#101827}a{color:#a8c9ff}article{background:#19263a;border:1px solid #394b68;border-radius:14px;padding:22px}h1{line-height:1.2}.tag{display:inline-block;border:1px solid #526785;border-radius:20px;padding:3px 9px;margin:4px}dt{font-weight:700;margin-top:16px}dd{margin-left:0;color:#c5d2e5}.note{border-left:3px solid #d4a34d;padding:10px 14px;background:#252b33}</style></head><body><p><a href="./index.html">← Kembali ke indeks 500 fitur</a></p><main id="app">Memuat detail fitur…</main><script>
(async()=>{const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const id=Number(new URLSearchParams(location.search).get('id'));try{const r=await fetch('./index.json');if(!r.ok)throw Error('Tidak dapat membaca index.json');const d=await r.json(),f=d.features.find(x=>x.id===id);if(!f)throw Error('ID fitur tidak ditemukan. Gunakan ID 1–500.');document.title=f.name+' — VendorDomain';document.querySelector('#app').innerHTML='<article><div class="tag">FITUR '+esc(f.code)+'</div><div class="tag">'+esc(f.category)+'</div><h1>'+esc(f.name)+'</h1><p>'+esc(f.description)+'</p><dl><dt>Modul</dt><dd>'+esc(f.module)+' (modul '+esc(f.moduleNumber)+', posisi '+esc(f.position)+'/25)</dd><dt>Fungsi</dt><dd>'+esc(f.function)+'</dd><dt>Status</dt><dd>'+esc(f.mode)+' · siap produksi: '+(f.productionReady?'ya':'tidak')+'</dd><dt>Persyaratan produksi</dt><dd>'+esc(f.productionRequirements)+'</dd></dl><p class="note">Informasi dan alur demo tidak menjalankan operasi registrar, DNS, pembayaran, atau layanan eksternal. Integrasi produksi harus dilakukan melalui backend aman dan penyedia resmi.</p><p><a href="./index.html">Kembali ke katalog</a></p></article>'}catch(e){document.querySelector('#app').textContent='Gagal: '+e.message}})();
</script></body></html>
