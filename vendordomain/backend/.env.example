PORT=8787
HOST=0.0.0.0
DATA_DIR=./data
# Generate a long random secret; never commit the real value.
ADMIN_TOKEN=replace-with-a-long-random-secret
# Exact public site origin, e.g. https://planetbintang.github.io
ALLOWED_ORIGIN=https://planetbintang.github.io
# Optional: enables actual DNS record management in the selected Cloudflare zone.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
