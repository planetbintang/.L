<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Konfigurasi Penerbitan Teks Menjadi Situs</title><style>
:root{color-scheme:dark;--bg:#0a1120;--panel:#142139;--line:#2a4162;--text:#eef5ff;--muted:#9db2cf;--cyan:#70d9e7}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 15% 0%,#1c3454,transparent 48%),linear-gradient(145deg,#080e1a,#101d31);color:var(--text);font:14px/1.55 system-ui}header,main{padding:22px clamp(14px,4vw,40px)}header{border-bottom:1px solid var(--line);background:#101a2ddd}main{max-width:1300px;margin:auto}h1{font-size:clamp(24px,3vw,34px);margin:4px 0}.muted{color:var(--muted)}.shell{display:grid;grid-template-columns:260px 1fr;gap:16px}.panel{border:1px solid var(--line);border-radius:16px;padding:17px;background:linear-gradient(145deg,#192944,#101a2b);box-shadow:0 14px 35px #0004;margin-bottom:14px}.nav button,.tab,button,select,input{font:inherit;color:var(--text);background:#0c1729;border:1px solid var(--line);border-radius:9px;padding:10px;cursor:pointer}.nav button{display:block;width:100%;text-align:left;margin:5px 0}.active{border-color:var(--cyan)!important;background:#143347!important}.tabs{display:flex;gap:7px;flex-wrap:wrap;margin:12px 0}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:10px}.field{display:grid;gap:6px;margin:10px 0}.field input{width:100%;cursor:text}.path{font:12px ui-monospace,monospace;overflow-wrap:anywhere;color:#b2d6ee}.actions{display:flex;gap:8px;flex-wrap:wrap}.primary{border-color:#3d9daa;background:#123343}.status{color:var(--cyan);min-height:24px}.layer{border:1px solid var(--line);border-radius:12px;padding:14px;background:#0d192b}.preview{background:#0a1728;border-left:3px solid var(--cyan);padding:12px;margin-top:12px;border-radius:8px}@media(max-width:760px){.shell{grid-template-columns:1fr}}</style></head><body>
<header><div class="muted">VENDORDOMAIN / MODUL 06 / SISTEM KONFIGURASI BERLAPIS</div><h1>Penerbitan Teks Menjadi Situs</h1><p class="muted">Konfigurasi mandiri untuk 25 fitur dan 15 submenu. Setiap submenu memiliki enam lapisan pengaturan tersendiri.</p><a href="../../features/index.html">← Katalog fitur</a></header>
<main><div class="shell"><aside class="panel"><h2>Fitur</h2><select id="feature" style="width:100%"></select><h2>Submenu</h2><div class="nav" id="subs"></div></aside><div><section class="panel"><div class="muted" id="code"></div><h2 id="heading"></h2><p class="muted" id="desc"></p><div class="tabs" id="tabs"></div><div class="layer" id="editor"></div><p class="status" id="status">Memuat konfigurasi…</p></section><section class="panel"><h2>Penyimpanan Sistem Folder / File</h2><p class="path" id="path"></p><p class="muted">Struktur profil menggunakan berkas layout.json, choices.json, applied.json, storage.json, dan config.json untuk setiap submenu. Sumber sistem: .reic · keluaran situs: .html.</p><div class="actions"><button class="primary" id="save">Simpan pada perangkat</button><button id="export">Ekspor JSON</button><button id="restore">Pulihkan bawaan</button></div></section></div></div></main>
<script>
const list=[[126,"Editor Teks ke Situs"],[127,"Publikasi Teks Instan"],[128,"Generator HTML dari Teks"],[129,"Generator Halaman Markdown"],[130,"Konversi Dokumen Menjadi Halaman"],[131,"Konversi Teks Menjadi Artikel"],[132,"Generator Halaman Landing"],[133,"Generator Halaman Profil"],[134,"Generator Halaman Bisnis"],[135,"Generator Halaman Produk"],[136,"Generator Halaman Dokumentasi"],[137,"Generator Halaman Berita"],[138,"Generator Halaman Portofolio"],[139,"Pemilih Templat Situs"],[140,"Editor Blok Visual"],[141,"Editor HTML Langsung"],[142,"Editor CSS Langsung"],[143,"Editor JavaScript"],[144,"Pratinjau Desktop"],[145,"Pratinjau Tablet"],[146,"Pratinjau Seluler"],[147,"Penerbitan Satu Klik"],[148,"Simpan sebagai Draf"],[149,"Penjadwalan Publikasi"],[150,"Tarik Kembali Publikasi"]];
const subs=["Ringkasan","Konfigurasi","Data Masuk","Data Keluar","Validasi","Riwayat Aktivitas","Pencarian","Filter Data","Impor Berkas","Catatan Kerja","Pemantauan","Akses dan Izin","Bantuan","Pengaturan Lanjutan","Pemeriksaan Sistem"];
const layers=[["layout","LAYOUT"],["pilihan","PILIHAN"],["penerapan","PENERAPAN"],["penyimpanan","PENYIMPANAN"],["sistem","PENYIMPANAN SISTEM"],["konfigurasi","KONFIGURASI"]];
let id=new URLSearchParams(location.search).get("fitur")||"126",sub="Ringkasan",layer="layout",data={};const $=s=>document.querySelector(s);
function fresh(){return {layout:{mode:"berlapis",density:"rapi",navigation:"sidebar",columns:3},pilihan:{preset:"Profesional",format:"HTML",responsive:true},penerapan:{mode:"pratinjau",validasi:"aktif",persetujuan:"manual"},penyimpanan:{format:"JSON",versioning:true,retensi:"90 hari"},sistem:{folder:"vendordomain/config/penerbitan-teks-menjadi-situs/"+id+"/"+sub.toLowerCase().replace(/[^a-z0-9]+/g,"-")+"/",files:"layout.json, choices.json, applied.json, storage.json, config.json"},konfigurasi:{aktif:true,profil:id,submenu:sub,versi:"1.0.0",akses:"pemilik"}}}
function key(){return "pb-vendordomain-textsite-"+id+"-"+sub.toLowerCase().replace(/[^a-z0-9]+/g,"-")}
async function render(){const f=list.find(x=>String(x[0])===String(id))||list[0];id=String(f[0]);$("#feature").value=id;$("#code").textContent="FITUR "+id+" / MODUL 06";$("#heading").textContent=f[1]+" / "+sub;$("#desc").textContent="Pengaturan "+sub+" dibuat terpisah untuk fitur ini. Perubahan tidak memengaruhi profil fitur lain.";$("#subs").innerHTML=subs.map(s=>'<button class="'+(s===sub?"active":"")+'" data-sub="'+s+'">'+s+'</button>').join("");$("#subs").querySelectorAll("button").forEach(b=>b.onclick=()=>{sub=b.dataset.sub;layer="layout";render()});$("#tabs").innerHTML=layers.map(x=>'<button class="'+(x[0]===layer?"active":"")+'" data-layer="'+x[0]+'">'+x[1]+'</button>').join("");$("#tabs").querySelectorAll("button").forEach(b=>b.onclick=()=>{layer=b.dataset.layer;renderEditor()});$("#path").textContent="vendordomain/config/penerbitan-teks-menjadi-situs/"+id+"/"+sub.toLowerCase().replace(/[^a-z0-9]+/g,"-")+"/{layout,choices,applied,storage,config}.json";data=fresh();try{const response=await fetch("./"+id+"/profile.json");if(response.ok){const profile=await response.json();const stored=profile.submenus.find(x=>x.name===sub);if(stored)data=stored}}catch(e){}try{const v=JSON.parse(localStorage.getItem(key()));if(v)data=v}catch(e){}renderEditor()}
function renderEditor(){const names=Object.fromEntries(layers);const obj=data[layer]||{};$("#editor").innerHTML="<h3>"+names[layer]+"</h3><p class='muted'>Lapisan konfigurasi mandiri untuk "+sub+". Ubah nilai lalu terapkan atau simpan.</p><div class='grid'>"+Object.entries(obj).map(([k,v])=>'<label class="field">'+k.toUpperCase()+'<input data-k="'+k+'" value="'+String(v).replace(/"/g,"&quot;")+'"></label>').join("")+"</div><div class='actions'><button class='primary' id='apply'>Terapkan lapisan</button><button id='saveLayer'>Simpan lapisan</button></div><div class='preview' id='preview'>Pratinjau: "+JSON.stringify(obj)+"</div>";$("#editor").querySelectorAll("input").forEach(i=>i.onchange=()=>{const v=i.value;data[layer][i.dataset.k]=v==="true"?true:v==="false"?false:v});$("#apply").onclick=()=>{$("#preview").textContent="Pratinjau diterapkan: "+JSON.stringify(data[layer]);$("#status").textContent=names[layer]+" diterapkan pada pratinjau, belum dipublikasikan."};$("#saveLayer").onclick=save}
function save(){localStorage.setItem(key(),JSON.stringify(data));$("#status").textContent="Profil "+id+" / "+sub+" disimpan pada penyimpanan lokal perangkat."}
$("#feature").innerHTML=list.map(f=>'<option value="'+f[0]+'">'+f[0]+' · '+f[1]+'</option>').join("");$("#feature").onchange=()=>{id=$("#feature").value;sub="Ringkasan";layer="layout";history.replaceState(null,"","?fitur="+id);render()};$("#save").onclick=save;$("#export").onclick=()=>{const a=document.createElement("a"),u=URL.createObjectURL(new Blob([JSON.stringify({feature:list.find(f=>String(f[0])===id),submenu:sub,configuration:data},null,2)],{type:"application/json"}));a.href=u;a.download="vendordomain-"+id+"-"+sub.toLowerCase().replace(/[^a-z0-9]+/g,"-")+".json";a.click();URL.revokeObjectURL(u);$("#status").textContent="Berkas konfigurasi JSON diekspor."};$("#restore").onclick=()=>{localStorage.removeItem(key());render().then(()=>$("#status").textContent="Profil bawaan dari berkas sistem dipulihkan.")};render();
</script></body></html>