<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Kode Status HTTP · VendorDomain</title><style>
:root{color-scheme:dark;--bg:#090f1e;--panel:#121d31;--line:#2a3b58;--text:#eef4ff;--muted:#9bacc7;--accent:#83b3ff}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 12% 0%,#1b2b46 0,transparent 42%),var(--bg);color:var(--text);font:14px/1.55 system-ui,sans-serif}a{color:#b8d0ff}header{padding:20px clamp(16px,4vw,42px);border-bottom:1px solid var(--line);background:#0d1729dd}header .muted,small{color:var(--muted)}h1{font-size:clamp(24px,3vw,34px);margin:5px 0}main{max-width:1320px;margin:auto;padding:22px clamp(14px,3vw,34px)}.links{display:flex;gap:15px;flex-wrap:wrap;margin-top:12px}.workspace{display:grid;grid-template-columns:220px minmax(0,1fr);gap:16px}.rail,.panel,.metric,.field,.subnav{background:linear-gradient(145deg,#17243a,#101a2d);border:1px solid var(--line);border-radius:14px}.rail{padding:12px;height:max-content;position:sticky;top:12px}.rail button,.subnav{width:100%;text-align:left;padding:11px 12px;margin:3px 0;color:var(--text);cursor:pointer}.rail button{border:1px solid transparent;border-radius:9px;background:transparent}.rail button[aria-current=true],.rail button:hover{background:#20314c;border-color:#496486}.content{min-width:0}.panel{padding:18px;margin-bottom:14px}.panel h2{font-size:17px;margin:0 0 6px}.muted{margin:0 0 14px}.metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.metric{padding:15px;min-height:105px}.metric strong{display:block;font-size:24px;margin:8px 0 2px}.metric em{font-style:normal;color:var(--muted);font-size:11px}.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.field{padding:12px;display:grid;gap:8px}.field span{color:var(--muted)}select,textarea,button{font:inherit;color:var(--text)}select,textarea{width:100%;background:#091426;border:1px solid #344a6c;border-radius:9px;padding:10px}.actions{display:flex;gap:8px;flex-wrap:wrap}button.action{background:#203958;border:1px solid #45678f;border-radius:9px;padding:10px 14px;cursor:pointer}.primary{background:#315b88!important}.subgrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}.subnav{margin:0;min-height:74px}.subnav b{display:block}.view{display:none}.view.active{display:block}.status{padding:10px 12px;border-radius:9px;background:#0b1829;color:#b9d2f5;margin-top:12px}.layout-terminal .metrics{}.layout-terminal .panel.primary-panel{background:#07111c;font-family:ui-monospace,monospace}.layout-terminal .subgrid{}.mini-chart{height:105px;width:100%;background:linear-gradient(180deg,#83b3ff1a,transparent);border-bottom:1px solid #496486;margin-top:10px}.table{width:100%;border-collapse:collapse}.table td,.table th{padding:9px;border-bottom:1px solid var(--line);text-align:left}@media(max-width:760px){.workspace{grid-template-columns:1fr}.rail{position:static;display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.metrics,.subgrid{grid-template-columns:1fr 1fr}.fields{grid-template-columns:1fr}}@media(max-width:430px){.metrics,.subgrid,.rail{grid-template-columns:1fr}}
</style></head><body><header><span class="muted">VENDORDOMAIN · ANALITIK DAN PEMANTAUAN · MODUL 16 · HALAMAN 384/500</span><h1>Kode Status HTTP</h1><p class="muted">Konsol respons HTTP · Konfigurasi berlapis untuk fitur ini.</p><nav class="links"><a href="../features/index.html">Katalog fitur</a><a href="383-browser-pengunjung.html">← Sebelumnya</a><a href="385-pemantauan-uptime.html">Berikutnya →</a></nav></header><main class="layout-terminal"><div class="workspace"><aside class="rail"><button data-tab="overview" aria-current="true">01 · Ringkasan</button><button data-tab="layout">02 · Layout</button><button data-tab="choices">03 · Pilihan</button><button data-tab="apply">04 · Penerapan</button><button data-tab="storage">05 · Penyimpanan</button><button data-tab="files">06 · Folder & file</button><button data-tab="advanced">07 · Konfigurasi</button></aside><div class="content">
<section class="view active" id="overview"><div class="panel primary-panel"><h2>Ringkasan data</h2><p class="muted">Konsol respons HTTP. Nilai metrik muncul setelah sumber data dihubungkan.</p><div class="metrics"><article class="metric"><small>Respons 2xx</small><strong>—</strong><em>Menunggu konektor data</em></article><article class="metric"><small>Respons 4xx</small><strong>—</strong><em>Menunggu konektor data</em></article><article class="metric"><small>Respons 5xx</small><strong>—</strong><em>Menunggu konektor data</em></article></div></div><div class="panel"><h2>Submenu konfigurasi</h2><div class="subgrid"><button class="subnav" data-tab="layout"><b>Layout</b><small>Komposisi panel</small></button><button class="subnav" data-tab="choices"><b>Pilihan</b><small>Parameter pengukuran</small></button><button class="subnav" data-tab="apply"><b>Penerapan</b><small>Validasi konfigurasi</small></button><button class="subnav" data-tab="storage"><b>Penyimpanan</b><small>Impor dan ekspor</small></button><button class="subnav" data-tab="files"><b>Folder & file</b><small>Indeks data</small></button><button class="subnav" data-tab="advanced"><b>Konfigurasi lanjutan</b><small>Akses dan retensi</small></button></div></div></section>
<section class="view" id="layout"><div class="panel"><h2>LAYOUT · Kode Status HTTP</h2><p class="muted">Konsol respons HTTP. Pilih variasi tampilan.</p><div class="fields"><label class="field"><span>Komposisi</span><select id="layoutMode"><option>Konsol respons HTTP</option><option>Dashboard kartu</option><option>Tabel operasional</option><option>Panel dua kolom</option><option>Linimasa</option></select></label><label class="field"><span>Kepadatan</span><select id="density"><option>Seimbang</option><option>Ringkas</option><option>Detail</option></select></label></div><button class="action primary" data-save>Terapan layout</button></div></section>
<section class="view" id="choices"><div class="panel"><h2>PILIHAN · Parameter</h2><p class="muted">Pengaturan khusus untuk Kode Status HTTP.</p><div class="fields"><label class="field"><span>Koleksi status HTTP</span><select data-setting="0"><option selected>Kelompok status</option><option >Nonaktif</option><option >Otomatis</option><option >Kustom</option></select></label><label class="field"><span>2xx / 3xx / 4xx / 5xx</span><select data-setting="1"><option selected>Ambang error</option><option >Nonaktif</option><option >Otomatis</option><option >Kustom</option></select></label><label class="field"><span>5%</span><select data-setting="2"><option selected>Sumber data</option><option >Nonaktif</option><option >Otomatis</option><option >Kustom</option></select></label><label class="field"><span>Access log / API</span><select data-setting="3"><option selected>Retensi</option><option >Nonaktif</option><option >Otomatis</option><option >Kustom</option></select></label><label class="field"><span>30 hari</span><select data-setting="4"><option selected>undefined</option><option >Nonaktif</option><option >Otomatis</option><option >Kustom</option></select></label></div><button class="action primary" data-save>Simpan pilihan</button></div></section>
<section class="view" id="apply"><div class="panel"><h2>PENERAPAN · Validasi</h2><p class="muted">Periksa parameter sebelum menandai konfigurasi aktif.</p><div class="metrics"><article class="metric"><small>Status konfigurasi</small><strong id="applyState">Draft</strong></article><article class="metric"><small>Parameter</small><strong>5</strong></article><article class="metric"><small>Konektor</small><strong>—</strong></article></div><div class="actions"><button class="action" id="validate">Validasi</button><button class="action primary" id="apply">Terapkan</button></div></div></section>
<section class="view" id="storage"><div class="panel"><h2>PENYIMPANAN · Konfigurasi</h2><p class="muted">Disimpan lokal di browser. Ekspor JSON untuk pencadangan.</p><div class="actions"><button class="action primary" id="saveConfig">Simpan</button><button class="action" id="export">Ekspor JSON</button><label class="action" for="importFile">Impor JSON</label><input id="importFile" type="file" accept="application/json" hidden></div><textarea id="jsonPreview" rows="7" placeholder="Pratinjau JSON"></textarea></div></section>
<section class="view" id="files"><div class="panel"><h2>SISTEM FOLDER FILE · Indeks</h2><p class="muted">Lokasi logis rancangan; belum membuat folder server.</p><table class="table"><tr><th>Lokasi</th><th>Fungsi</th><th>Status</th></tr><tr><td>vendordomain/analytics/384-kode-status-http/config/</td><td>Preferensi</td><td>Lokal</td></tr><tr><td>vendordomain/analytics/384-kode-status-http/data/</td><td>Snapshot</td><td>Belum terhubung</td></tr><tr><td>vendordomain/analytics/384-kode-status-http/logs/</td><td>Audit</td><td>Lokal</td></tr><tr><td>vendordomain/analytics/384-kode-status-http/index.json</td><td>Manifest</td><td>Skema</td></tr></table></div></section>
<section class="view" id="advanced"><div class="panel"><h2>KONFIGURASI · Lapisan lanjutan</h2><div class="fields"><label class="field"><span>Retensi</span><select id="retention"><option>30 hari</option><option>7 hari</option><option>90 hari</option><option>365 hari</option></select></label><label class="field"><span>Hak akses</span><select id="access"><option>Administrator</option><option>Editor</option><option>Pembaca</option></select></label><label class="field"><span>Audit</span><select id="audit"><option>Aktif</option><option>Nonaktif</option></select></label><label class="field"><span>Sumber data</span><select id="dataMode"><option>Menunggu konektor</option><option>Impor manual</option><option>API eksternal</option></select></label></div><button class="action primary" data-save>Simpan konfigurasi</button></div></section><p class="status" id="status" role="status">Siap · data menunggu konektor.</p>
</div></div></main><script>
(()=>{const key="pb-vendordomain-analytics-384",status=document.getElementById("status"),tabs=[...document.querySelectorAll("[data-tab]")],views=[...document.querySelectorAll(".view")];let cfg={page:"Kode Status HTTP",layout:"terminal",settings:{}};try{cfg={...cfg,...JSON.parse(localStorage.getItem(key)||"{}")}}catch(e){}function read(){document.querySelectorAll("[data-setting]").forEach(el=>cfg.settings[el.dataset.setting]=el.value);["layoutMode","density","retention","access","audit","dataMode"].forEach(id=>{const el=document.getElementById(id);if(el)cfg[id]=el.value});cfg.updatedAt=new Date().toISOString();return cfg}function save(){read();localStorage.setItem(key,JSON.stringify(cfg));document.getElementById("jsonPreview").value=JSON.stringify(cfg,null,2);status.textContent="Konfigurasi "+cfg.page+" disimpan lokal."}function show(n){views.forEach(v=>v.classList.toggle("active",v.id===n));tabs.forEach(t=>{if(t.dataset.tab)t.setAttribute("aria-current",String(t.dataset.tab===n))})}tabs.forEach(t=>t.addEventListener("click",()=>show(t.dataset.tab)));document.querySelectorAll("[data-save]").forEach(b=>b.addEventListener("click",save));document.getElementById("saveConfig").addEventListener("click",save);document.getElementById("validate").addEventListener("click",()=>{read();status.textContent="Validasi lokal selesai · "+Object.keys(cfg.settings).length+" parameter terbaca · konektor belum diperiksa."});document.getElementById("apply").addEventListener("click",()=>{read();cfg.applied=true;save();document.getElementById("applyState").textContent="Draft lokal aktif";status.textContent="Ditandai diterapkan secara lokal; integrasi produksi membutuhkan API/server."});document.getElementById("export").addEventListener("click",()=>{save();const b=new Blob([JSON.stringify(cfg,null,2)],{type:"application/json"}),u=URL.createObjectURL(b),a=document.createElement("a");a.href=u;a.download="vendordomain-384-kode-status-http-config.json";a.click();URL.revokeObjectURL(u)});document.getElementById("importFile").addEventListener("change",async e=>{const f=e.target.files[0];if(!f)return;try{cfg=JSON.parse(await f.text());document.getElementById("jsonPreview").value=JSON.stringify(cfg,null,2);status.textContent="JSON terbaca; tekan Simpan untuk menyimpan."}catch(err){status.textContent="JSON tidak valid: "+err.message}});document.getElementById("jsonPreview").value=JSON.stringify(cfg,null,2)})();
</script></body></html>