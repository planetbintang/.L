<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Aktifkan Plugin · VendorDomain</title><style>:root{color-scheme:dark;--a:#e89ab4;--p:#142139;--bg:#0b1220;--line:#2a3c59;--txt:#eef4ff;--muted:#9eafc9}*{box-sizing:border-box}body{margin:0;background:radial-gradient(at top left,#1b2d48,#0b1220 60%);color:var(--txt);font:14px/1.55 system-ui}header{padding:20px clamp(16px,4vw,40px);background:#0d1728;border-bottom:1px solid var(--line)}h1{margin:6px 0;font-size:clamp(24px,3vw,36px)}h2{font-size:18px}p,small{color:var(--muted)}a{color:var(--a);text-decoration:none}.links,.actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:12px}main{max-width:1300px;margin:auto;padding:22px clamp(14px,3vw,34px)}.hero,.work{display:grid;grid-template-columns:1fr 220px;gap:12px;margin-bottom:14px}.work{grid-template-columns:220px 1fr}.card{background:linear-gradient(145deg,var(--p),#101a2d);border:1px solid var(--line);border-radius:16px;padding:18px}.metric{font-size:26px;color:var(--a);font-weight:bold}.tabs{display:grid;gap:8px;align-content:start}.tab,button,input,select,textarea{font:inherit;color:var(--txt);background:#0d192b;border:1px solid var(--line);border-radius:10px;padding:10px}.tab{text-align:left;cursor:pointer}.tab[aria-selected=true],.primary{border-color:var(--a);background:#20324b}.view{display:none}.view.active{display:block}.fields{display:grid;grid-template-columns:1fr 1fr;gap:12px}.field{display:grid;gap:6px;margin:10px 0}.field label{font-size:11px;color:var(--muted)}.field input,.field select{width:100%}.tree,.preview,.status{border:1px dashed var(--a);border-radius:12px;padding:14px;background:#0b1729;margin-top:12px}.tree{font:12px/1.8 monospace;white-space:pre-wrap}.json{width:100%;min-height:180px;font:12px monospace}.status{border-style:solid;color:var(--a)}button{cursor:pointer}@media(max-width:700px){.hero,.work{grid-template-columns:1fr}.tabs{display:flex;overflow:auto}.tab{white-space:nowrap}.fields{grid-template-columns:1fr}}</style></head><body><header><small>VENDORDOMAIN / MODUL 08 / HALAMAN 179</small><h1>Aktifkan Plugin</h1><p>Ruang konfigurasi enam lapisan untuk aktifkan plugin.</p><nav class="links"><a href="../features/index.html">Katalog fitur</a><a href="178-penghapusan-plugin.html">← Sebelumnya</a><a href="180-nonaktifkan-plugin.html">Berikutnya →</a></nav></header><main><section class="hero"><div class="card"><small>PUSAT KENDALI MODUL</small><h2>Aktifkan Plugin / Workspace</h2><p>Atur layout, pilihan, penerapan, penyimpanan, folder dan konfigurasi teknis.</p><b style="color:var(--a)">6 LAPISAN KONFIGURASI</b></div><div class="card"><small>IDENTITAS MODUL</small><div class="metric">179</div>AKTIFKAN-PLUGIN</div></section><section class="work"><aside class="tabs"><button class="tab" data-tab="v1" aria-selected="true">01 · LAYOUT</button><button class="tab" data-tab="v2">02 · PILIHAN</button><button class="tab" data-tab="v3">03 · PENERAPAN</button><button class="tab" data-tab="v4">04 · PENYIMPANAN</button><button class="tab" data-tab="v5">05 · SISTEM FOLDER & FILE</button><button class="tab" data-tab="v6">06 · KONFIGURASI</button></aside><div>
<div class="view active" id="v1"><div class="card"><h2>01 / Layout</h2><div class="fields"><label class="field">JENIS LAYOUT<select id="layout"><option>Panel bertingkat</option><option>Sidebar kerja</option><option>Grid adaptif</option><option>Konsol teknis</option><option>Split pratinjau</option></select></label><label class="field">KEPADATAN<select id="density"><option>Normal</option><option>Ringkas</option><option>Lapang</option></select></label></div><div class="preview" id="preview">Pratinjau Aktifkan Plugin · panel · navigasi · konten</div></div></div>
<div class="view" id="v2"><div class="card"><h2>02 / Pilihan</h2><div class="fields"><label class="field">AKSEN<select id="accent"><option value="#e89ab4">Warna modul</option><option value="#8bb8ff">Biru</option><option value="#83d6c5">Mint</option><option value="#c4a4ff">Ungu</option><option value="#f0b477">Amber</option></select></label><label class="field">BENTUK<select id="shape"><option>16</option><option>8</option><option>24</option></select></label></div><label><input type="checkbox" id="hints" checked> Tampilkan petunjuk</label><label><input type="checkbox" id="motion"> Transisi ringan</label></div></div>
<div class="view" id="v3"><div class="card"><h2>03 / Penerapan</h2><p>Tinjau perubahan sebelum menerapkannya ke halaman.</p><div class="preview" id="review">Belum ada pratinjau.</div><div class="actions"><button class="primary" id="apply">Terapkan konfigurasi</button><button id="reset">Pulihkan bawaan</button></div></div></div>
<div class="view" id="v4"><div class="card"><h2>04 / Penyimpanan</h2><p>Disimpan di browser perangkat ini, bukan backend GitHub.</p><label class="field">NAMA PROFIL<input id="profile" value="aktifkan-plugin"></label><div class="actions"><button class="primary" id="save">Simpan</button><button id="export">Ekspor JSON</button><button id="import">Impor JSON</button><input id="file" type="file" accept="application/json" hidden></div><div class="status" id="storageStatus">Belum disimpan.</div></div></div>
<div class="view" id="v5"><div class="card"><h2>05 / Sistem Folder & File</h2><div class="tree">vendordomain/<br>└── extensions/aktifkan-plugin/<br>    ├── layout/view.config.json<br>    ├── choices/options.config.json<br>    ├── apply/deployment.plan.json<br>    ├── storage/profile.json<br>    └── config/module.config.json</div><label class="field">LOKASI FOLDER<input id="folder" value="vendordomain/extensions/aktifkan-plugin/config/"></label><label class="field">NAMA FILE<input id="filename" value="module.config.json"></label><small>Struktur ini adalah rancangan lokasi. Ekspor JSON untuk dipindahkan ke repositori.</small></div></div>
<div class="view" id="v6"><div class="card"><h2>06 / Konfigurasi</h2><textarea class="json" id="json" spellcheck="false"></textarea><div class="actions"><button id="validate">Validasi JSON</button><button id="format">Rapikan JSON</button></div><div class="status" id="configStatus">Siap.</div></div></div><div class="status" id="global">Perubahan belum diterapkan.</div></div></section></main><script>(()=>{const $=id=>document.getElementById(id),key="pb-ext-179-config",def={layout:"Panel bertingkat",density:"Normal",accent:"#e89ab4",shape:"16",hints:true,motion:false,profile:"aktifkan-plugin",folder:"vendordomain/extensions/aktifkan-plugin/config/",filename:"module.config.json"};let s={...def};function get(){return {module:"aktifkan-plugin",page:179,layout:$("layout").value,density:$("density").value,accent:$("accent").value,shape:$("shape").value,hints:$("hints").checked,motion:$("motion").checked,profile:$("profile").value,folder:$("folder").value,filename:$("filename").value}}function sync(){ $("json").value=JSON.stringify(s,null,2);$("preview").textContent="Layout: "+s.layout+" · Kepadatan: "+s.density;$("review").textContent=JSON.stringify(s,null,2)}function load(){try{s={...def,...JSON.parse(localStorage.getItem(key)||"{}")}}catch(e){}Object.keys({layout:1,density:1,accent:1,shape:1,profile:1,folder:1,filename:1}).forEach(k=>$(k).value=s[k]);$("hints").checked=s.hints;$("motion").checked=s.motion;sync()}document.querySelectorAll(".tab").forEach(b=>b.onclick=()=>{document.querySelectorAll(".tab").forEach(x=>x.setAttribute("aria-selected",String(x===b)));document.querySelectorAll(".view").forEach(v=>v.classList.toggle("active",v.id===b.dataset.tab))});["layout","density","accent","shape","hints","motion","profile","folder","filename"].forEach(k=>$(k).onchange=()=>{s=get();sync()});$("apply").onclick=()=>{s=get();document.documentElement.style.setProperty("--a",s.accent);document.documentElement.style.setProperty("--radius",s.shape+"px");$("global").textContent="Konfigurasi diterapkan pada halaman ini."};$("reset").onclick=()=>{localStorage.removeItem(key);s={...def};load();$("global").textContent="Bawaan dipulihkan."};$("save").onclick=()=>{s=get();localStorage.setItem(key,JSON.stringify(s));$("storageStatus").textContent="Tersimpan di perangkat · "+new Date().toLocaleString("id-ID")};$("export").onclick=()=>{s=get();const a=document.createElement("a"),u=URL.createObjectURL(new Blob([JSON.stringify(s,null,2)],{type:"application/json"}));a.href=u;a.download="aktifkan-plugin-config.json";a.click();URL.revokeObjectURL(u)};$("import").onclick=()=>$("file").click();$("file").onchange=async e=>{try{s={...def,...JSON.parse(await e.target.files[0].text())};localStorage.setItem(key,JSON.stringify(s));load();$("storageStatus").textContent="Impor berhasil."}catch(e){$("storageStatus").textContent="JSON tidak valid."}};$("validate").onclick=()=>{try{JSON.parse($("json").value);$("configStatus").textContent="JSON valid."}catch(e){$("configStatus").textContent="JSON tidak valid."}};$("format").onclick=()=>{try{$("json").value=JSON.stringify(JSON.parse($("json").value),null,2);$("configStatus").textContent="JSON dirapikan."}catch(e){$("configStatus").textContent="JSON tidak valid."}};load()})();</script></body></html>