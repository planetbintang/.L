<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Pembuatan Arsip ZIP · PlanetBintang .L</title><style>
:root{color-scheme:dark;--bg:#0b1020;--panel:#131b2f;--line:#263451;--text:#eef4ff;--muted:#9fb0ca;--accent:#73a7ff}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:15px/1.55 system-ui,sans-serif}header{padding:22px clamp(16px,4vw,44px);background:#10182b;border-bottom:1px solid var(--line)}h1{font-size:clamp(23px,3vw,34px);margin:6px 0}p,.muted{color:var(--muted)}main{max-width:1240px;margin:auto;padding:clamp(16px,3vw,36px)}.card{border:1px solid var(--line);background:var(--panel);border-radius:16px;padding:20px;margin-bottom:18px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px}.sub{border:1px solid var(--line);border-radius:12px;background:#0d1527;color:var(--text);padding:14px;text-align:left;min-height:95px;cursor:pointer}.sub:hover,button:hover{border-color:var(--accent)}.sub strong{display:block;margin-bottom:5px}.sub small{color:var(--muted)}button,textarea{font:inherit;border:1px solid var(--line);border-radius:10px;background:#0d1527;color:var(--text);padding:10px 12px}textarea{width:100%;min-height:110px}.row{display:flex;gap:12px;flex-wrap:wrap}a{color:#b8d0ff}.status{color:#a8c8ff}@media(max-width:600px){.row>*{flex:1 1 100%}}
</style></head><body><header><div class="muted">VENDORDOMAIN · MODUL 13 · HALAMAN 322 DARI 500</div><h1>Pembuatan Arsip ZIP</h1><p>File, dokumen, dan media · Halaman fitur mandiri dengan 15 submenu.</p><div class="row"><a href="../features/index.html">Katalog fitur</a><a href="321-pemulihan-file.html">← Sebelumnya</a><a href="323-ekstraksi-arsip.html">Berikutnya →</a></div></header><main><section class="card"><h2>Submenu fitur</h2><p>Submenu berjalan langsung di halaman tanpa modal pop-up.</p><div class="grid"><button class="sub" data-sub="Ringkasan"><strong>01 · Ringkasan</strong><small>Ringkasan status fitur dan data.</small></button><button class="sub" data-sub="Konfigurasi"><strong>02 · Konfigurasi</strong><small>Ubah preferensi kerja lokal.</small></button><button class="sub" data-sub="Data Masuk"><strong>03 · Data Masuk</strong><small>Catat sumber data yang digunakan.</small></button><button class="sub" data-sub="Data Keluar"><strong>04 · Data Keluar</strong><small>Tinjau hasil dan keluaran fitur.</small></button><button class="sub" data-sub="Validasi"><strong>05 · Validasi</strong><small>Periksa format dan kelengkapan data.</small></button><button class="sub" data-sub="Riwayat Aktivitas"><strong>06 · Riwayat Aktivitas</strong><small>Tampilkan riwayat lokal fitur.</small></button><button class="sub" data-sub="Pencarian"><strong>07 · Pencarian</strong><small>Cari informasi dalam ruang kerja.</small></button><button class="sub" data-sub="Filter Data"><strong>08 · Filter Data</strong><small>Saring informasi berdasarkan kata kunci.</small></button><button class="sub" data-sub="Impor Berkas"><strong>09 · Impor Berkas</strong><small>Pilih berkas JSON untuk diproses.</small></button><button class="sub" data-sub="Catatan Kerja"><strong>10 · Catatan Kerja</strong><small>Simpan catatan pada perangkat.</small></button><button class="sub" data-sub="Pemantauan"><strong>11 · Pemantauan</strong><small>Periksa status kesiapan fitur.</small></button><button class="sub" data-sub="Akses dan Izin"><strong>12 · Akses dan Izin</strong><small>Tampilkan keterangan akses.</small></button><button class="sub" data-sub="Bantuan"><strong>13 · Bantuan</strong><small>Baca petunjuk penggunaan.</small></button><button class="sub" data-sub="Pengaturan Lanjutan"><strong>14 · Pengaturan Lanjutan</strong><small>Tampilkan opsi tambahan.</small></button><button class="sub" data-sub="Pemeriksaan Sistem"><strong>15 · Pemeriksaan Sistem</strong><small>Jalankan pemeriksaan lokal.</small></button></div><p id="status" class="status" role="status">Pilih submenu untuk menjalankan aksi lokal.</p></section><section class="card"><h2>Catatan kerja lokal</h2><p>Catatan tersimpan pada browser/perangkat ini, bukan backend produksi.</p><textarea id="notes" placeholder="Catatan untuk Pembuatan Arsip ZIP…"></textarea><div class="row" style="margin-top:10px"><button id="save">Simpan catatan</button><button id="clear">Hapus catatan</button><button id="check">Periksa status halaman</button></div></section><section class="card vd-config" id="vd-config-workspace" data-layout="2"><style>.vd-config{background:linear-gradient(145deg,#17243c,#101827 65%,#151d31);border:1px solid #344867}.vd-config .cfg-tabs,.vd-config .cfg-actions{display:flex;gap:8px;flex-wrap:wrap;margin:14px 0}.vd-config button,.vd-config input,.vd-config select{font:inherit;color:var(--text);background:#0b1425;border:1px solid #354765;border-radius:10px;padding:10px}.vd-config .cfg-tabs button[aria-selected=true]{background:#29436b}.vd-config .cfg-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.vd-config .cfg-field{display:grid;gap:6px}.vd-config small{color:var(--muted)}.vd-config .cfg-panel{border:1px solid #30415e;border-radius:14px;padding:16px;background:#0b142599}.vd-config[data-layout="1"] .cfg-grid{grid-template-columns:1fr 2fr}.vd-config[data-layout="2"] .cfg-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.vd-config[data-layout="3"] .cfg-grid{grid-template-columns:repeat(4,minmax(0,1fr))}@media(max-width:760px){.vd-config .cfg-grid,.vd-config[data-layout] .cfg-grid{grid-template-columns:1fr}}</style><div><small>VENDORDOMAIN · KONFIGURASI BERLAPIS · MODUL 322</small><h2>Konfigurasi Pembuatan Arsip ZIP</h2><p>Layout, pilihan, penerapan, penyimpanan, folder/file, dan konfigurasi khusus fitur.</p></div><nav class="cfg-tabs"><button data-cfg-tab="layout" aria-selected="true">LAYOUT</button><button data-cfg-tab="pilihan" aria-selected="false">PILIHAN</button><button data-cfg-tab="penerapan" aria-selected="false">PENERAPAN</button><button data-cfg-tab="penyimpanan" aria-selected="false">PENYIMPANAN</button><button data-cfg-tab="folder" aria-selected="false">SISTEM FOLDER &amp; FILE</button><button data-cfg-tab="konfigurasi" aria-selected="false">KONFIGURASI</button></nav><div class="cfg-panel"><div class="cfg-grid"><label class="cfg-field" data-cfg-field="layout">Jenis layout<select id="vd-layout"><option>Dasbor berlapis</option><option>Ruang kerja dua kolom</option><option>Panel ringkas</option><option>Direktori</option></select></label><label class="cfg-field" data-cfg-field="pilihan">Tema<select id="vd-theme"><option>Gelap abstrak</option><option>Midnight</option><option>Slate</option></select></label><label class="cfg-field" data-cfg-field="pilihan">Kepadatan<select id="vd-density"><option>Normal</option><option>Ringkas</option><option>Lapang</option></select></label><label class="cfg-field" data-cfg-field="penerapan">Cakupan<select id="vd-scope"><option>Halaman ini</option><option>Seluruh modul</option><option>Pratinjau saja</option></select></label><label class="cfg-field" data-cfg-field="penyimpanan">Penyimpanan<select id="vd-storage"><option>Browser lokal</option><option>Manifest / indeks</option><option>GitHub (perlu integrasi)</option></select></label><label class="cfg-field" data-cfg-field="folder">Folder kerja<input id="vd-folder" value="vendordomain/data/file-media/"/></label><label class="cfg-field" data-cfg-field="folder">Berkas konfigurasi<input id="vd-file" value="file-media-322.json"/></label><label class="cfg-field" data-cfg-field="konfigurasi">Versi<input id="vd-version" value="1.0.0"/></label><label class="cfg-field" data-cfg-field="konfigurasi">Catatan teknis<input id="vd-note" placeholder="Catatan fitur"/></label></div><div class="cfg-actions"><button id="vd-save">Simpan konfigurasi</button><button id="vd-apply">Terapkan layout</button><button id="vd-export">Ekspor JSON</button><button id="vd-reset">Pulihkan awal</button></div><p id="vd-config-status" role="status">Konfigurasi siap. Data disimpan pada browser perangkat ini.</p></div></section></main><script>
const id=322, key="pb-vendor-page-"+id, status=document.querySelector("#status"), notes=document.querySelector("#notes");
notes.value=localStorage.getItem(key)||"";
document.querySelectorAll("[data-sub]").forEach(button=>button.addEventListener("click",()=>{const name=button.dataset.sub;status.textContent="Submenu “"+name+"” dijalankan untuk Pembuatan Arsip ZIP. Aksi dicatat lokal.";const history=JSON.parse(localStorage.getItem("pb-vendor-history")||"[]");history.unshift({id,name:"Pembuatan Arsip ZIP",submenu:name,at:new Date().toISOString()});localStorage.setItem("pb-vendor-history",JSON.stringify(history.slice(0,200)));if(name==="Catatan Kerja")notes.focus();if(name==="Riwayat Aktivitas")status.textContent="Riwayat aktivitas tersimpan: "+history.length+" catatan.";}));
document.querySelector("#save").onclick=()=>{localStorage.setItem(key,notes.value);status.textContent="Catatan halaman 322 disimpan lokal."};
document.querySelector("#clear").onclick=()=>{localStorage.removeItem(key);notes.value="";status.textContent="Catatan halaman dihapus."};
document.querySelector("#check").onclick=()=>status.textContent="Halaman 322 siap · 15 submenu terpasang · penyimpanan lokal tersedia.";
const vk="pb-vendordomain-config-322",vi=["layout","theme","density","scope","storage","folder","file","version","note"],vs=document.querySelector("#vd-config-status");function vr(){const o={};vi.forEach(k=>o[k]=document.querySelector("#vd-"+k).value);return o}function vl(){let s={};try{s=JSON.parse(localStorage.getItem(vk)||"{}")}catch(e){}vi.forEach(k=>{if(s[k])document.querySelector("#vd-"+k).value=s[k]})}function vsave(){localStorage.setItem(vk,JSON.stringify(vr()));vs.textContent="Konfigurasi 322 disimpan lokal."}vl();document.querySelectorAll("[data-cfg-tab]").forEach(t=>t.onclick=()=>{document.querySelectorAll("[data-cfg-tab]").forEach(x=>x.setAttribute("aria-selected",String(x===t)));document.querySelectorAll("[data-cfg-field]").forEach(x=>x.hidden=x.dataset.cfgField!==t.dataset.cfgTab);vs.textContent="Lapisan "+t.textContent+" dipilih."});document.querySelector("#vd-save").onclick=vsave;document.querySelector("#vd-apply").onclick=()=>{document.querySelector("#vd-config-workspace").dataset.layout=String(document.querySelector("#vd-layout").selectedIndex);vs.textContent="Layout diterapkan pada panel konfigurasi."};document.querySelector("#vd-export").onclick=()=>{const u=URL.createObjectURL(new Blob([JSON.stringify(vr(),null,2)],{type:"application/json"}));const a=document.createElement("a");a.href=u;a.download="file-media-322.json";a.click();URL.revokeObjectURL(u)};document.querySelector("#vd-reset").onclick=()=>{localStorage.removeItem(vk);location.reload()};</script></body></html>
