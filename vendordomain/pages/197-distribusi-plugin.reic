<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Distribusi Plugin · VendorDomain</title><style>:root{color-scheme:dark;--a:#c4a4ff;--p:#142139;--line:#2a3c59;--txt:#eef4ff}*{box-sizing:border-box}body{margin:0;background:radial-gradient(at top left,#1b2d48,#0b1220 60%);color:var(--txt);font:14px/1.55 system-ui}header,main{padding:20px clamp(16px,4vw,40px)}header{background:#0d1728;border-bottom:1px solid var(--line)}h1{margin:6px 0}p,small{color:#9eafc9}a{color:var(--a)}main{max-width:1200px;margin:auto}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}.card{background:linear-gradient(145deg,#142139,#101a2d);border:1px solid var(--line);border-radius:16px;padding:18px}.field{display:grid;gap:6px;margin:12px 0}label{color:#9eafc9;font-size:12px}input,select,textarea,button{font:inherit;color:var(--txt);background:#0d192b;border:1px solid var(--line);border-radius:10px;padding:10px}input,select,textarea{width:100%}textarea{min-height:180px;font:12px monospace}.tabs,.actions{display:flex;gap:8px;flex-wrap:wrap;margin:14px 0}.tabs button[aria-selected=true],.primary{border-color:var(--a);background:#25334b}.panel{display:none}.panel.active{display:block}.tree{font:12px/1.8 monospace;white-space:pre-wrap;background:#0b1729;border:1px dashed var(--a);padding:14px;border-radius:12px}.status{padding:12px;border:1px solid var(--line);border-radius:10px;color:var(--a)}@media(max-width:600px){.grid{grid-template-columns:1fr}}</style></head><body><header><small>VENDORDOMAIN / MODUL 08 / HALAMAN 197</small><h1>Distribusi Plugin</h1><p>Pusat konfigurasi berlapis untuk sistem ekstensi dan plugin.</p><a href="176-katalog-plugin.reic">Katalog Plugin</a></header><main><div class="grid"><section class="card"><small>MODUL AKTIF</small><h2>Distribusi Plugin</h2><p>Enam lapisan pengelolaan konfigurasi mandiri.</p></section><section class="card"><small>LOKASI SISTEM</small><h2>vendordomain/extensions</h2><p>Konfigurasi lokal dapat diekspor sebagai JSON untuk penyimpanan repositori.</p></section></div><nav class="tabs"><button data-id="layout" aria-selected="true">01 · LAYOUT</button><button data-id="pilihan">02 · PILIHAN</button><button data-id="apply">03 · PENERAPAN</button><button data-id="storage">04 · PENYIMPANAN</button><button data-id="files">05 · FOLDER & FILE</button><button data-id="config">06 · KONFIGURASI</button></nav><section id="layout" class="panel active card"><h2>Layout</h2><div class="grid"><label class="field">Tata letak<select id="lay"><option>Panel bertingkat</option><option>Sidebar kerja</option><option>Grid adaptif</option><option>Konsol teknis</option><option>Split pratinjau</option></select></label><label class="field">Kepadatan<select id="density"><option>Normal</option><option>Ringkas</option><option>Lapang</option></select></label></div></section><section id="pilihan" class="panel card"><h2>Pilihan</h2><div class="grid"><label class="field">Aksen<select id="accent"><option>#c4a4ff</option><option>#8bb8ff</option><option>#83d6c5</option><option>#f0b477</option></select></label><label class="field">Bentuk<input id="radius" type="number" min="4" max="32" value="16"></label></div><label><input type="checkbox" id="hints" checked> Petunjuk konfigurasi</label></section><section id="apply" class="panel card"><h2>Penerapan</h2><p id="preview">Pratinjau akan muncul di sini.</p><button class="primary" id="applyBtn">Terapkan konfigurasi</button></section><section id="storage" class="panel card"><h2>Penyimpanan</h2><p>Profil disimpan di browser perangkat ini; bukan backend produksi.</p><label class="field">Nama profil<input id="profile" value="distribusi-plugin"></label><div class="actions"><button class="primary" id="save">Simpan lokal</button><button id="export">Ekspor JSON</button><button id="import">Impor JSON</button><input hidden type="file" id="file" accept="application/json"></div><div class="status" id="status">Belum disimpan.</div></section><section id="files" class="panel card"><h2>Sistem Folder & File</h2><div class="tree">vendordomain/<br>└── extensions/<br>    └── plugin/<br>        ├── layout/view.config.json<br>        ├── choices/options.config.json<br>        ├── apply/deployment.plan.json<br>        ├── storage/profile.json<br>        └── config/module.config.json</div></section><section id="config" class="panel card"><h2>Konfigurasi Teknis</h2><textarea id="json" spellcheck="false"></textarea><div class="actions"><button id="validate">Validasi JSON</button><button id="format">Rapikan JSON</button></div><div class="status" id="valid">Siap.</div></section></main><script>(()=>{const $=id=>document.getElementById(id),key="pb-ext-197-config";let data={};function collect(){return {module:"distribusi-plugin",layout:$("lay").value,density:$("density").value,accent:$("accent").value,radius:$("radius").value,hints:$("hints").checked,profile:$("profile").value}}function sync(){data=collect();$("json").value=JSON.stringify(data,null,2);$("preview").textContent=JSON.stringify(data,null,2)}document.querySelectorAll("[data-id]").forEach(b=>b.onclick=()=>{document.querySelectorAll("[data-id]").forEach(x=>x.setAttribute("aria-selected",String(x===b)));document.querySelectorAll(".panel").forEach(p=>p.classList.toggle("active",p.id===b.dataset.id))});["lay","density","accent","radius","hints","profile"].forEach(k=>$(k).onchange=sync);$("applyBtn").onclick=()=>{sync();document.documentElement.style.setProperty("--a",data.accent);$("status").textContent="Konfigurasi diterapkan ke tampilan halaman."};$("save").onclick=()=>{sync();localStorage.setItem(key,JSON.stringify(data));$("status").textContent="Tersimpan di perangkat ini."};$("export").onclick=()=>{sync();let a=document.createElement("a"),u=URL.createObjectURL(new Blob([JSON.stringify(data,null,2)],{type:"application/json"}));a.href=u;a.download="distribusi-plugin.json";a.click();URL.revokeObjectURL(u)};$("import").onclick=()=>$("file").click();$("file").onchange=async e=>{try{data=JSON.parse(await e.target.files[0].text());$("lay").value=data.layout;$("density").value=data.density;$("accent").value=data.accent;$("radius").value=data.radius;$("hints").checked=data.hints;$("profile").value=data.profile;sync()}catch(e){$("status").textContent="JSON tidak valid."}};$("validate").onclick=()=>{try{JSON.parse($("json").value);$("valid").textContent="JSON valid."}catch(e){$("valid").textContent="JSON tidak valid."}};$("format").onclick=()=>{try{$("json").value=JSON.stringify(JSON.parse($("json").value),null,2)}catch(e){$("valid").textContent="JSON tidak valid."}};try{data=JSON.parse(localStorage.getItem(key)||"{}");if(data.layout){$("lay").value=data.layout;$("density").value=data.density;$("accent").value=data.accent;$("radius").value=data.radius;$("hints").checked=data.hints;$("profile").value=data.profile}}catch(e){}sync()})();</script></body></html>