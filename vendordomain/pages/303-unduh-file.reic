<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Unduh File · PlanetBintang .L</title><style>
:root{color-scheme:dark;--bg:#0b1020;--panel:#131b2f;--line:#263451;--text:#eef4ff;--muted:#9fb0ca;--accent:#73a7ff}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:15px/1.55 system-ui,sans-serif}header{padding:22px clamp(16px,4vw,44px);background:#10182b;border-bottom:1px solid var(--line)}h1{font-size:clamp(23px,3vw,34px);margin:6px 0}p,.muted{color:var(--muted)}main{max-width:1240px;margin:auto;padding:clamp(16px,3vw,36px)}.card{border:1px solid var(--line);background:var(--panel);border-radius:16px;padding:20px;margin-bottom:18px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px}.sub{border:1px solid var(--line);border-radius:12px;background:#0d1527;color:var(--text);padding:14px;text-align:left;min-height:95px;cursor:pointer}.sub:hover,button:hover{border-color:var(--accent)}.sub strong{display:block;margin-bottom:5px}.sub small{color:var(--muted)}button,textarea{font:inherit;border:1px solid var(--line);border-radius:10px;background:#0d1527;color:var(--text);padding:10px 12px}textarea{width:100%;min-height:110px}.row{display:flex;gap:12px;flex-wrap:wrap}a{color:#b8d0ff}.status{color:#a8c8ff}@media(max-width:600px){.row>*{flex:1 1 100%}}
</style></head><body><header><div class="muted">VENDORDOMAIN · MODUL 13 · HALAMAN 303 DARI 500</div><h1>Unduh File</h1><p>File, dokumen, dan media · Halaman fitur mandiri dengan 15 submenu.</p><div class="row"><a href="../features/index.html">Katalog fitur</a><a href="302-unggah-file.html">← Sebelumnya</a><a href="304-unggah-banyak-file.html">Berikutnya →</a></div></header><main><section class="card"><h2>Submenu fitur</h2><p>Submenu berjalan langsung di halaman tanpa modal pop-up.</p><div class="grid"><button class="sub" data-sub="Ringkasan"><strong>01 · Ringkasan</strong><small>Ringkasan status fitur dan data.</small></button><button class="sub" data-sub="Konfigurasi"><strong>02 · Konfigurasi</strong><small>Ubah preferensi kerja lokal.</small></button><button class="sub" data-sub="Data Masuk"><strong>03 · Data Masuk</strong><small>Catat sumber data yang digunakan.</small></button><button class="sub" data-sub="Data Keluar"><strong>04 · Data Keluar</strong><small>Tinjau hasil dan keluaran fitur.</small></button><button class="sub" data-sub="Validasi"><strong>05 · Validasi</strong><small>Periksa format dan kelengkapan data.</small></button><button class="sub" data-sub="Riwayat Aktivitas"><strong>06 · Riwayat Aktivitas</strong><small>Tampilkan riwayat lokal fitur.</small></button><button class="sub" data-sub="Pencarian"><strong>07 · Pencarian</strong><small>Cari informasi dalam ruang kerja.</small></button><button class="sub" data-sub="Filter Data"><strong>08 · Filter Data</strong><small>Saring informasi berdasarkan kata kunci.</small></button><button class="sub" data-sub="Impor Berkas"><strong>09 · Impor Berkas</strong><small>Pilih berkas JSON untuk diproses.</small></button><button class="sub" data-sub="Catatan Kerja"><strong>10 · Catatan Kerja</strong><small>Simpan catatan pada perangkat.</small></button><button class="sub" data-sub="Pemantauan"><strong>11 · Pemantauan</strong><small>Periksa status kesiapan fitur.</small></button><button class="sub" data-sub="Akses dan Izin"><strong>12 · Akses dan Izin</strong><small>Tampilkan keterangan akses.</small></button><button class="sub" data-sub="Bantuan"><strong>13 · Bantuan</strong><small>Baca petunjuk penggunaan.</small></button><button class="sub" data-sub="Pengaturan Lanjutan"><strong>14 · Pengaturan Lanjutan</strong><small>Tampilkan opsi tambahan.</small></button><button class="sub" data-sub="Pemeriksaan Sistem"><strong>15 · Pemeriksaan Sistem</strong><small>Jalankan pemeriksaan lokal.</small></button></div><p id="status" class="status" role="status">Pilih submenu untuk menjalankan aksi lokal.</p></section><section class="card"><h2>Catatan kerja lokal</h2><p>Catatan tersimpan pada browser/perangkat ini, bukan backend produksi.</p><textarea id="notes" placeholder="Catatan untuk Unduh File…"></textarea><div class="row" style="margin-top:10px"><button id="save">Simpan catatan</button><button id="clear">Hapus catatan</button><button id="check">Periksa status halaman</button></div></section>
<section class="card vd-config" id="vd-config-workspace" data-layout="3">
<style>
.vd-config{background:linear-gradient(145deg,#17243c,#101827 65%,#151d31);border-color:#344867}.vd-config .cfg-head{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}.vd-config .cfg-kicker{font-size:11px;letter-spacing:.16em;color:#9fbce9}.vd-config .cfg-tabs{display:flex;gap:8px;flex-wrap:wrap;margin:16px 0}.vd-config button,.vd-config input,.vd-config select{font:inherit;color:var(--text);background:#0b1425;border:1px solid #354765;border-radius:10px;padding:10px}.vd-config .cfg-tabs button[aria-selected=true]{background:#29436b;border-color:#91baff}.vd-config .cfg-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.vd-config .cfg-field{display:grid;gap:6px}.vd-config .cfg-field small,.vd-config .cfg-help{color:var(--muted)}.vd-config .cfg-panel{border:1px solid #30415e;border-radius:14px;padding:16px;background:rgba(8,15,28,.55)}.vd-config .cfg-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}.vd-config .cfg-status{color:#b9d5ff;min-height:24px}.vd-config[data-layout="1"] .cfg-grid{grid-template-columns:1fr 2fr}.vd-config[data-layout="1"] .cfg-panel{border-radius:5px}.vd-config[data-layout="2"] .cfg-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.vd-config[data-layout="2"] .cfg-panel{border-radius:22px}.vd-config[data-layout="3"] .cfg-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.vd-config[data-layout="3"] .cfg-panel{border-radius:4px;border-left:3px solid #739bd5}@media(max-width:760px){.vd-config .cfg-grid,.vd-config[data-layout] .cfg-grid{grid-template-columns:1fr}}
</style>
<div class="cfg-head"><div><div class="cfg-kicker">VENDORDOMAIN · KONFIGURASI BERLAPIS</div><h2>Konfigurasi Unduh File</h2><p class="cfg-help">Pengaturan mandiri untuk tampilan, pilihan, penerapan, penyimpanan, folder, file, dan parameter fitur.</p></div><span class="muted">ID MODUL 303</span></div>
<nav class="cfg-tabs" aria-label="Lapisan konfigurasi"><button type="button" data-cfg-tab="layout" aria-selected="true">LAYOUT</button><button type="button" data-cfg-tab="pilihan" aria-selected="false">PILIHAN</button><button type="button" data-cfg-tab="penerapan" aria-selected="false">PENERAPAN</button><button type="button" data-cfg-tab="penyimpanan" aria-selected="false">PENYIMPANAN</button><button type="button" data-cfg-tab="folder" aria-selected="false">SISTEM FOLDER &amp; FILE</button><button type="button" data-cfg-tab="konfigurasi" aria-selected="false">KONFIGURASI</button></nav>
<div class="cfg-panel"><div class="cfg-grid">
<label class="cfg-field" data-cfg-field="layout"><strong>Jenis layout</strong><select id="vd-layout"><option value="dashboard">Dasbor berlapis</option><option value="workspace">Ruang kerja dua kolom</option><option value="compact">Panel ringkas</option><option value="directory">Tampilan direktori</option></select><small>Susunan panel halaman ini.</small></label>
<label class="cfg-field" data-cfg-field="pilihan"><strong>Skema tampilan</strong><select id="vd-theme"><option value="dark">Gelap abstrak</option><option value="midnight">Midnight</option><option value="slate">Slate</option></select><small>Warna dan kontras komponen.</small></label>
<label class="cfg-field" data-cfg-field="pilihan"><strong>Kepadatan komponen</strong><select id="vd-density"><option value="normal">Normal</option><option value="compact">Ringkas</option><option value="spacious">Lapang</option></select><small>Jarak antarbagian.</small></label>
<label class="cfg-field" data-cfg-field="penerapan"><strong>Mode penerapan</strong><select id="vd-apply"><option value="current">Halaman ini</option><option value="module">Seluruh modul File, Dokumen dan Media</option><option value="preview">Pratinjau saja</option></select><small>Cakupan penerapan pilihan.</small></label>
<label class="cfg-field" data-cfg-field="penyimpanan"><strong>Strategi penyimpanan</strong><select id="vd-storage"><option value="browser">Penyimpanan browser lokal</option><option value="manifest">Manifest / indeks berkas</option><option value="repository">Repositori GitHub (perlu integrasi)</option></select><small>GitHub belum terhubung otomatis.</small></label>
<label class="cfg-field" data-cfg-field="folder"><strong>Folder kerja</strong><input id="vd-folder" value="vendordomain/data/file-media/"/><small>Lokasi logis yang dicatat.</small></label>
<label class="cfg-field" data-cfg-field="folder"><strong>Nama berkas konfigurasi</strong><input id="vd-file" value="file-media-303.json"/><small>Nama berkas ekspor.</small></label>
<label class="cfg-field" data-cfg-field="konfigurasi"><strong>Versi konfigurasi</strong><input id="vd-version" value="1.0.0"/><small>Versi pengaturan halaman.</small></label>
<label class="cfg-field" data-cfg-field="konfigurasi"><strong>Catatan teknis</strong><input id="vd-note" placeholder="Catatan konfigurasi fitur…"/><small>Disimpan bersama preferensi.</small></label>
</div><div class="cfg-actions"><button type="button" id="vd-save">Simpan konfigurasi</button><button type="button" id="vd-apply">Terapkan pilihan</button><button type="button" id="vd-export">Ekspor JSON</button><button type="button" id="vd-reset">Pulihkan nilai awal</button></div><p class="cfg-status" id="vd-config-status" role="status">Konfigurasi siap diatur. Penyimpanan aktif pada browser perangkat ini.</p></div></section>
</main><script>
const id=303, key="pb-vendor-page-"+id, status=document.querySelector("#status"), notes=document.querySelector("#notes");
notes.value=localStorage.getItem(key)||"";
document.querySelectorAll("[data-sub]").forEach(button=>button.addEventListener("click",()=>{const name=button.dataset.sub;status.textContent="Submenu “"+name+"” dijalankan untuk Unduh File. Aksi dicatat lokal.";const history=JSON.parse(localStorage.getItem("pb-vendor-history")||"[]");history.unshift({id,name:"Unduh File",submenu:name,at:new Date().toISOString()});localStorage.setItem("pb-vendor-history",JSON.stringify(history.slice(0,200)));if(name==="Catatan Kerja")notes.focus();if(name==="Riwayat Aktivitas")status.textContent="Riwayat aktivitas tersimpan: "+history.length+" catatan.";}));
document.querySelector("#save").onclick=()=>{localStorage.setItem(key,notes.value);status.textContent="Catatan halaman 303 disimpan lokal."};
document.querySelector("#clear").onclick=()=>{localStorage.removeItem(key);notes.value="";status.textContent="Catatan halaman dihapus."};
document.querySelector("#check").onclick=()=>status.textContent="Halaman 303 siap · 15 submenu terpasang · penyimpanan lokal tersedia.";

const vdKey="pb-vendordomain-config-303",vdIds=["layout","theme","density","apply","storage","folder","file","version","note"],vdDefaults={layout:"dashboard",theme:"dark",density:"normal",apply:"current",storage:"browser",folder:"vendordomain/data/file-media/",file:"file-media-303.json",version:"1.0.0",note:""},vdStatus=document.querySelector("#vd-config-status");
function vdRead(){const o={};vdIds.forEach(k=>o[k]=document.querySelector("#vd-"+k).value);return o}
function vdLoad(){let s={};try{s=JSON.parse(localStorage.getItem(vdKey)||"{}")}catch(e){}vdIds.forEach(k=>document.querySelector("#vd-"+k).value=s[k]??vdDefaults[k])}
function vdSave(){localStorage.setItem(vdKey,JSON.stringify(vdRead()));vdStatus.textContent="Konfigurasi halaman 303 disimpan pada browser lokal."}
vdLoad();
document.querySelectorAll("[data-cfg-tab]").forEach(t=>t.addEventListener("click",()=>{document.querySelectorAll("[data-cfg-tab]").forEach(x=>x.setAttribute("aria-selected",String(x===t)));document.querySelectorAll("[data-cfg-field]").forEach(x=>x.hidden=x.dataset.cfgField!==t.dataset.cfgTab);vdStatus.textContent="Lapisan "+t.textContent+" dipilih."}));
document.querySelector("#vd-save").addEventListener("click",vdSave);
document.querySelector("#vd-apply").addEventListener("click",()=>{const v=vdRead();document.querySelector("#vd-config-workspace").dataset.layout=String(({dashboard:0,workspace:1,compact:2,directory:3})[v.layout]??0);vdStatus.textContent="Layout diterapkan pada panel konfigurasi. Cakupan: "+v.apply+"."});
document.querySelector("#vd-export").addEventListener("click",()=>{const u=URL.createObjectURL(new Blob([JSON.stringify(vdRead(),null,2)],{type:"application/json"}));const a=document.createElement("a");a.href=u;a.download="file-media-303-config.json";a.click();URL.revokeObjectURL(u);vdStatus.textContent="JSON konfigurasi diekspor."});
document.querySelector("#vd-reset").addEventListener("click",()=>{localStorage.removeItem(vdKey);vdLoad();vdStatus.textContent="Nilai awal dipulihkan."});

</script></body></html>
