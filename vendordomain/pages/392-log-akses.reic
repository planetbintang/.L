<!doctype html>
<html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Log Akses · VendorDomain</title>
<style>
:root{color-scheme:dark;--bg:#090f1e;--panel:#121d31;--panel2:#0d1729;--line:#2a3b58;--text:#eef4ff;--muted:#9bacc7;--accent:#83b3ff;--glow:#83b3ff22}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 12% 0%,#1b2b46 0,transparent 42%),var(--bg);color:var(--text);font:14px/1.55 system-ui,sans-serif}a{color:#b8d0ff}header{padding:20px clamp(16px,4vw,42px);border-bottom:1px solid var(--line);background:#0d1729dd;position:relative}header .eyebrow,.muted,small{color:var(--muted)}h1{font-size:clamp(24px,3vw,34px);margin:5px 0}main{max-width:1320px;margin:auto;padding:22px clamp(14px,3vw,34px)}.topline{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}.links{display:flex;gap:15px;flex-wrap:wrap;margin-top:12px}.workspace{display:grid;grid-template-columns:220px minmax(0,1fr);gap:16px}.rail,.panel,.metric,.field,.subnav{background:linear-gradient(145deg,#17243a,#101a2d);border:1px solid var(--line);border-radius:14px}.rail{padding:12px;height:max-content;position:sticky;top:12px}.rail button,.subnav{width:100%;text-align:left;padding:11px 12px;margin:3px 0;color:var(--text);cursor:pointer}.rail button{border:1px solid transparent;border-radius:9px;background:transparent}.rail button[aria-current=true],.rail button:hover{background:#20314c;border-color:#496486}.content{min-width:0}.panel{padding:18px;margin-bottom:14px;box-shadow:0 12px 40px #0002}.panel h2{font-size:17px;margin:0 0 6px}.muted{margin:0 0 14px}.metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.metric{padding:15px;min-height:105px}.metric strong{display:block;font-size:24px;margin:8px 0 2px}.metric em{font-style:normal;color:var(--muted);font-size:11px}.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.field{padding:12px;display:grid;gap:8px}.field span{color:var(--muted)}select,input,textarea,button{font:inherit;color:var(--text)}select,input,textarea{width:100%;background:#091426;border:1px solid #344a6c;border-radius:9px;padding:10px}.actions{display:flex;gap:8px;flex-wrap:wrap}button.action{background:#203958;border:1px solid #45678f;border-radius:9px;padding:10px 14px;cursor:pointer}button.action.primary{background:#315b88}.subgrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}.subnav{margin:0;min-height:74px}.subnav b{display:block}.view{display:none}.view.active{display:block}.status{padding:10px 12px;border-radius:9px;background:#0b1829;color:#b9d2f5;margin-top:12px}.layout-table .metrics{}.layout-table .metric:nth-child(2){}.layout-table .panel.primary-panel{}.layout-table .subgrid{}.mini-chart{height:105px;width:100%;border-radius:9px;background:linear-gradient(180deg,#83b3ff1a,transparent);border-bottom:1px solid #496486;margin-top:10px}.table{width:100%;border-collapse:collapse}.table td,.table th{padding:9px;border-bottom:1px solid var(--line);text-align:left}.table th{color:var(--muted)}@media(max-width:760px){.workspace{grid-template-columns:1fr}.rail{position:static;display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.metrics,.subgrid{grid-template-columns:1fr 1fr}.fields{grid-template-columns:1fr}}@media(max-width:430px){.metrics,.subgrid{grid-template-columns:1fr}.rail{grid-template-columns:1fr}}
</style></head><body><header><div class="topline"><span class="eyebrow">VENDORDOMAIN · ANALITIK DAN PEMANTAUAN · MODUL 16</span><span class="muted">HALAMAN 392 / 500 · LAPISAN KONFIGURASI</span></div><h1>Log Akses</h1><p class="muted">Tabel log dengan filter kolom · Konfigurasi, penerapan, dan penyimpanan khusus fitur.</p><nav class="links"><a href="../features/index.html">Katalog fitur</a><a href="391-pemantauan-memori.html">← Sebelumnya</a><a href="393-log-kesalahan.html">Berikutnya →</a></nav></header>
<main class="layout-table"><div class="workspace"><aside class="rail" aria-label="Lapisan konfigurasi"><button data-tab="overview" aria-current="true">01 · Ringkasan</button><button data-tab="layout">02 · Layout</button><button data-tab="choices">03 · Pilihan</button><button data-tab="apply">04 · Penerapan</button><button data-tab="storage">05 · Penyimpanan</button><button data-tab="files">06 · Folder & file</button><button data-tab="advanced">07 · Konfigurasi</button></aside><div class="content">
<section class="view active" id="overview"><div class="panel primary-panel"><h2>Ringkasan pemantauan</h2><p class="muted">Tabel log dengan filter kolom. Angka metrik akan terisi setelah sumber data atau API dikoneksikan.</p><div class="metrics"><article class="metric"><small>Permintaan tercatat</small><strong>—</strong><em>Belum ada konektor data</em></article><article class="metric"><small>Sesi aktif</small><strong>—</strong><em>Belum ada konektor data</em></article><article class="metric"><small>Alamat terfilter</small><strong>—</strong><em>Belum ada konektor data</em></article></div></div><div class="panel"><h2>Submenu operasional</h2><p class="muted">Pilih lapisan untuk membuka konfigurasi terpisah tanpa dialog pop-up.</p><div class="subgrid"><button class="subnav" data-tab="layout"><b>Layout & visualisasi</b><small>Atur struktur panel dan tampilan</small></button><button class="subnav" data-tab="choices"><b>Pilihan parameter</b><small>Nilai dan ambang fitur</small></button><button class="subnav" data-tab="apply"><b>Penerapan</b><small>Validasi sebelum diterapkan</small></button><button class="subnav" data-tab="storage"><b>Penyimpanan</b><small>Ekspor dan impor konfigurasi</small></button><button class="subnav" data-tab="files"><b>Sistem folder file</b><small>Indeks penyimpanan fitur</small></button><button class="subnav" data-tab="advanced"><b>Konfigurasi lanjutan</b><small>Retensi, akses, dan audit</small></button></div></div></section>
<section class="view" id="layout"><div class="panel"><h2>LAYOUT · Log Akses</h2><p class="muted">Jenis layout khusus: Tabel log dengan filter kolom. Pilih komposisi tampilan untuk halaman ini.</p><div class="fields"><label class="field"><span>Komposisi panel</span><select id="layoutMode"><option>Tabel log dengan filter kolom</option><option>Dashboard kartu</option><option>Tabel operasional</option><option>Panel dua kolom</option><option>Linimasa bertingkat</option></select></label><label class="field"><span>Kepadatan informasi</span><select id="density"><option>Seimbang</option><option>Ringkas</option><option>Detail</option></select></label></div><div class="actions" style="margin-top:12px"><button class="action primary" data-save>Terapan layout</button></div></div></section>
<section class="view" id="choices"><div class="panel"><h2>PILIHAN · Parameter fitur</h2><p class="muted">Parameter ini tersimpan per halaman dan dapat diubah sebelum penerapan.</p><div class="fields"><label class="field"><span>Sumber log</span><select data-setting="0"><option selected>Format log</option><option >Nonaktif</option><option >Otomatis</option><option >Kustom</option></select></label><label class="field"><span>JSON Lines</span><select data-setting="1"><option selected>Level detail</option><option >Nonaktif</option><option >Otomatis</option><option >Kustom</option></select></label><label class="field"><span>Terstruktur</span><select data-setting="2"><option selected>Retensi log</option><option >Nonaktif</option><option >Otomatis</option><option >Kustom</option></select></label><label class="field"><span>30 hari</span><select data-setting="3"><option selected>Penyamaran IP</option><option >Nonaktif</option><option >Otomatis</option><option >Kustom</option></select></label><label class="field"><span>Aktif</span><select data-setting="4"><option selected>undefined</option><option >Nonaktif</option><option >Otomatis</option><option >Kustom</option></select></label></div><div class="actions" style="margin-top:12px"><button class="action primary" data-save>Simpan pilihan</button></div></div></section>
<section class="view" id="apply"><div class="panel"><h2>PENERAPAN · Validasi konfigurasi</h2><p class="muted">Periksa kelengkapan parameter dan tinjau perubahan sebelum menandai konfigurasi aktif.</p><div class="metrics"><article class="metric"><small>Konfigurasi</small><strong id="applyState">Draft</strong><em>Status lokal</em></article><article class="metric"><small>Parameter</small><strong>5</strong><em>Opsi tersedia</em></article><article class="metric"><small>Sumber data</small><strong>—</strong><em>Belum terhubung</em></article></div><div class="actions" style="margin-top:12px"><button class="action" id="validate">Validasi</button><button class="action primary" id="apply">Terapkan konfigurasi</button></div></div></section>
<section class="view" id="storage"><div class="panel"><h2>PENYIMPANAN · Data konfigurasi</h2><p class="muted">Konfigurasi disimpan pada browser ini. Ekspor JSON dapat dipindahkan ke perangkat lain.</p><div class="actions"><button class="action primary" id="saveConfig">Simpan ke perangkat</button><button class="action" id="export">Ekspor JSON</button><label class="action" for="importFile">Impor JSON</label><input id="importFile" type="file" accept="application/json" hidden></div><textarea id="jsonPreview" rows="7" placeholder="Pratinjau konfigurasi JSON…"></textarea></div></section>
<section class="view" id="files"><div class="panel"><h2>SISTEM FOLDER FILE · Indeks fitur</h2><p class="muted">Rancangan lokasi logis. Penyimpanan ini belum membuat folder di server.</p><table class="table"><tr><th>Lokasi logis</th><th>Fungsi</th><th>Status</th></tr><tr><td>vendordomain/analytics/392-log-akses/config/</td><td>Pengaturan fitur</td><td>Browser lokal</td></tr><tr><td>vendordomain/analytics/392-log-akses/data/</td><td>Snapshot dan hasil</td><td>Belum terhubung</td></tr><tr><td>vendordomain/analytics/392-log-akses/logs/</td><td>Riwayat penerapan</td><td>Browser lokal</td></tr><tr><td>vendordomain/analytics/392-log-akses/index.json</td><td>Manifest file</td><td>Skema rancangan</td></tr></table></div></section>
<section class="view" id="advanced"><div class="panel"><h2>KONFIGURASI · Lapisan lanjutan</h2><p class="muted">Kontrol akses, retensi, dan audit untuk Log Akses.</p><div class="fields"><label class="field"><span>Retensi riwayat</span><select id="retention"><option>30 hari</option><option>7 hari</option><option>90 hari</option><option>365 hari</option></select></label><label class="field"><span>Hak akses</span><select id="access"><option>Administrator</option><option>Editor</option><option>Pembaca</option></select></label><label class="field"><span>Audit perubahan</span><select id="audit"><option>Aktif</option><option>Nonaktif</option></select></label><label class="field"><span>Mode data</span><select id="dataMode"><option>Menunggu konektor</option><option>Impor manual</option><option>API eksternal</option></select></label></div><div class="actions" style="margin-top:12px"><button class="action primary" data-save>Simpan konfigurasi</button></div></div></section>
<p class="status" id="status" role="status">Siap · konfigurasi Log Akses belum diterapkan.</p>
</div></div></main><script>
(()=>{const id=392,key="pb-vendordomain-analytics-392",status=document.getElementById("status"),tabs=[...document.querySelectorAll("[data-tab]")],views=[...document.querySelectorAll(".view")];let cfg={page:"Log Akses",layout:"table",settings:{},applied:false};try{cfg={...cfg,...JSON.parse(localStorage.getItem(key)||"{}")}}catch(e){}
function read(){document.querySelectorAll("[data-setting]").forEach(el=>cfg.settings[el.dataset.setting]=el.value);cfg.layoutMode=document.getElementById("layoutMode")?.value||"";cfg.density=document.getElementById("density")?.value||"";cfg.retention=document.getElementById("retention")?.value||"";cfg.access=document.getElementById("access")?.value||"";cfg.audit=document.getElementById("audit")?.value||"";cfg.dataMode=document.getElementById("dataMode")?.value||"";cfg.updatedAt=new Date().toISOString();return cfg}
function save(){read();localStorage.setItem(key,JSON.stringify(cfg));document.getElementById("jsonPreview").value=JSON.stringify(cfg,null,2);status.textContent="Konfigurasi "+cfg.page+" tersimpan pada browser/perangkat ini."}
function show(name){views.forEach(v=>v.classList.toggle("active",v.id===name));tabs.forEach(t=>{if(t.dataset.tab)t.setAttribute("aria-current",String(t.dataset.tab===name))});}
tabs.forEach(t=>t.addEventListener("click",()=>show(t.dataset.tab)));
document.querySelectorAll("[data-save]").forEach(b=>b.addEventListener("click",save));
document.getElementById("saveConfig").addEventListener("click",save);
document.getElementById("validate").addEventListener("click",()=>{read();status.textContent="Validasi lokal selesai · "+Object.keys(cfg.settings).length+" parameter terbaca · konektor server belum diperiksa.";});
document.getElementById("apply").addEventListener("click",()=>{read();cfg.applied=true;save();document.getElementById("applyState").textContent="Draft lokal aktif";status.textContent="Konfigurasi ditandai diterapkan secara lokal. Integrasi produksi memerlukan API/server.";});
document.getElementById("export").addEventListener("click",()=>{save();const blob=new Blob([JSON.stringify(cfg,null,2)],{type:"application/json"}),url=URL.createObjectURL(blob),a=document.createElement("a");a.href=url;a.download="vendordomain-392-log-akses-config.json";a.click();URL.revokeObjectURL(url);});
document.getElementById("importFile").addEventListener("change",async e=>{const f=e.target.files[0];if(!f)return;try{cfg=JSON.parse(await f.text());document.getElementById("jsonPreview").value=JSON.stringify(cfg,null,2);status.textContent="Berkas konfigurasi berhasil dibaca. Tekan Simpan ke perangkat untuk menyimpan."; }catch(err){status.textContent="JSON tidak valid: "+err.message;}});
document.getElementById("jsonPreview").value=JSON.stringify(cfg,null,2);
})();
</script></body></html>