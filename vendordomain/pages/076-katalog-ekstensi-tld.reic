<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#050a14">
<title>Katalog Ekstensi TLD · VendorDomain</title>
<style>
:root{color-scheme:dark;--bg:#050a14;--surface:#0b1728;--surface2:#10243a;--line:#29415d;--text:#eaf4ff;--muted:#9cb2cc;--cyan:#63e4d1;--blue:#73cfff;--green:#68dfa2;--amber:#ffcf76}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 85% -10%,#14375a 0,transparent 42%),linear-gradient(180deg,#050a14,#071321 60%,#050a14);color:var(--text);font:14px/1.55 Inter,system-ui,sans-serif}
a{color:#83dfff;text-decoration:none}button,input,select,textarea{font:inherit;color:inherit}button{cursor:pointer;border:1px solid var(--line);background:#10243a;padding:10px 13px}button:hover,a:hover{border-color:var(--blue);filter:brightness(1.12)}input,select,textarea{width:100%;background:#071321;border:1px solid var(--line);padding:11px;outline:none}input:focus,select:focus,textarea:focus{border-color:var(--cyan)}header{padding:22px clamp(14px,3vw,38px);border-bottom:1px solid var(--line);background:#071222eF;position:sticky;top:0;z-index:5;backdrop-filter:blur(15px)}.eyebrow{font-size:10px;letter-spacing:1.6px;color:var(--cyan);font-weight:800}h1{font-size:clamp(25px,4vw,42px);margin:7px 0;letter-spacing:-1px}header p,.muted{color:var(--muted)}.headlinks{display:flex;gap:16px;flex-wrap:wrap;font-size:12px}main{max-width:1500px;margin:auto;padding:22px clamp(12px,2.5vw,36px) 60px}.intro{padding:22px;border:1px solid var(--line);background:radial-gradient(circle at 90% 0,#16436355,transparent 40%),linear-gradient(145deg,#0d1e33,#081321);margin-bottom:16px}.intro h2{margin:0 0 7px}.intro p{max-width:900px;color:var(--muted)}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:16px 0}.stat,.layer,.subcard{border:1px solid var(--line);background:linear-gradient(145deg,#0d1c30,#081423);padding:15px}.stat strong{display:block;font-size:22px}.stat span,.hint{font-size:11px;color:var(--muted)}.layout{display:grid;grid-template-columns:230px minmax(0,1fr);gap:14px}.rail{border:1px solid var(--line);background:#091525;padding:10px;align-self:start;position:sticky;top:150px}.rail button{display:block;width:100%;text-align:left;margin:4px 0;background:transparent;border-color:transparent}.rail button.active{background:#17304c;border-color:#3d7899}.workspace{min-width:0}.layer{margin-bottom:13px;position:relative;overflow:hidden}.layer:before{content:"";position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(135deg,#83cfff08 0,#83cfff08 1px,transparent 1px,transparent 13px)}.layer>*{position:relative}.layerhead{display:flex;align-items:start;justify-content:space-between;gap:12px;margin-bottom:12px}.layerhead h2{font-size:17px;margin:0}.layerhead p{font-size:11px;color:var(--muted);margin:4px 0}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}.subcard{display:block;min-height:112px}.subcard strong{display:block;margin-bottom:5px}.subcard small{color:var(--muted)}.fieldgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.field{display:grid;gap:5px}.field label{font-size:11px;color:#b8cbe0}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.primary{background:linear-gradient(120deg,#237ca8,#36b6b5);color:#03111e;border:1px solid #4ccbd7;font-weight:800}.status{padding:10px 12px;border-left:3px solid var(--cyan);background:#0b2030;color:#bde9f5;margin-top:12px;font-size:12px;overflow-wrap:anywhere}.filetree{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.filetree div{padding:12px;background:#071321;border:1px solid #29415d}.filetree code{display:block;color:var(--cyan);font-size:12px}.filetree span{font-size:10px;color:var(--muted)}.subnav{display:flex;gap:7px;flex-wrap:wrap}.subnav a{border:1px solid var(--line);padding:8px 10px;font-size:11px;background:#0a1728}.danger{color:#ffb3a9}.tag{font-size:10px;border:1px solid #3b617f;padding:3px 7px;color:#b9d8f5}
@media(max-width:900px){.layout{grid-template-columns:1fr}.rail{position:static;display:grid;grid-template-columns:repeat(3,1fr)}.rail button{font-size:11px}.grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.stats{grid-template-columns:repeat(2,1fr)}.grid,.fieldgrid,.filetree{grid-template-columns:1fr}.rail{grid-template-columns:repeat(2,1fr)}.layerhead{display:block}}
</style>
</head>
<body>
<header><div class="eyebrow">VENDORDOMAIN / MODUL 04 / HALAMAN 076</div><h1>Katalog Ekstensi TLD</h1><p>Ruang konfigurasi berlapis untuk katalog ekstensi, kebijakan TLD, penerapan, penyimpanan, dan struktur berkas sistem.</p><nav class="headlinks"><a href="../features/index.html">Direktori fitur</a><a href="../index.reic">VendorDomain</a><a href="075-penilaian-vendor.reic">← Sebelumnya</a></nav></header>
<main>
<section class="intro"><span class="tag">WORKSPACE KONFIGURASI</span><h2>Kelola ekstensi sebagai sistem, bukan sekadar daftar.</h2><p>Setiap lapisan memiliki tata letak, pilihan, dan ruang penerapan tersendiri. Konfigurasi di bawah ini disimpan di browser perangkat ini dan dapat diekspor sebagai JSON untuk dipindahkan ke folder sistem. Penyimpanan ini belum menulis langsung ke server GitHub atau registrar.</p>
<div class="stats"><div class="stat"><strong id="extensionCount">12</strong><span>Ekstensi contoh</span></div><div class="stat"><strong>05</strong><span>Lapisan konfigurasi</span></div><div class="stat"><strong id="savedState">0</strong><span>Konfigurasi tersimpan</span></div><div class="stat"><strong>JSON</strong><span>Format ekspor / impor</span></div></div>
<div class="subnav"><a href="077-ekstensi-com.reic">.com</a><a href="078-ekstensi-id.reic">.id</a><a href="079-ekstensi-co-id.reic">.co.id</a><a href="080-ekstensi-web-id.reic">.web.id</a><a href="081-ekstensi-org.reic">.org</a><a href="082-ekstensi-net.reic">.net</a><a href="083-ekstensi-app.reic">.app</a><a href="084-ekstensi-dev.reic">.dev</a><a href="085-ekstensi-ai.reic">.ai</a><a href="086-ekstensi-cloud.reic">.cloud</a><a href="087-ekstensi-store.reic">.store</a><a href="088-ekstensi-online.reic">.online</a><a href="089-ekstensi-site.reic">.site</a><a href="090-ekstensi-tech.reic">.tech</a><a href="091-ekstensi-geografis.reic">Geografis</a><a href="092-ekstensi-industri.reic">Industri</a><a href="093-ekstensi-premium.reic">Premium</a><a href="094-persyaratan-registrasi-tld.reic">Persyaratan</a><a href="095-harga-per-ekstensi.reic">Harga</a><a href="096-biaya-perpanjangan-tld.reic">Perpanjangan</a><a href="097-status-dukungan-vendor.reic">Dukungan vendor</a><a href="098-perbandingan-ekstensi.reic">Perbandingan</a><a href="099-rekomendasi-ekstensi.reic">Rekomendasi</a><a href="100-peringatan-aturan-ekstensi.reic">Peringatan aturan</a></div></section>
<div class="layout">
<aside class="rail" aria-label="Navigasi lapisan"><button class="active" data-jump="catalog">01 · Katalog</button><button data-jump="layout">02 · Layout</button><button data-jump="choices">03 · Pilihan</button><button data-jump="apply">04 · Penerapan</button><button data-jump="storage">05 · Penyimpanan</button><button data-jump="files">06 · Folder & file</button><button data-jump="config">07 · Konfigurasi</button></aside>
<div class="workspace">
<section class="layer" id="catalog"><div class="layerhead"><div><h2>01 / Katalog ekstensi dan TLD</h2><p>Daftar contoh yang dapat dicari, difilter, dan dipilih untuk konfigurasi.</p></div><span class="tag">DATA LAYER</span></div><div class="fieldgrid"><div class="field"><label for="searchExt">Cari ekstensi</label><input id="searchExt" placeholder="Cari .com, .id, kategori…"></div><div class="field"><label for="filterKind">Jenis TLD</label><select id="filterKind"><option value="">Semua jenis</option><option>gTLD</option><option>ccTLD</option><option>sTLD</option><option>New gTLD</option></select></div></div><div class="grid" id="extensionGrid" style="margin-top:12px"></div><p class="hint">Data adalah katalog kerja awal, bukan daftar lengkap registri atau pemeriksaan ketersediaan.</p></section>
<section class="layer" id="layout"><div class="layerhead"><div><h2>02 / Layout</h2><p>Pilih cara halaman ekstensi ditampilkan. Setiap pilihan mengubah komposisi area kerja.</p></div><span class="tag">PRESENTATION LAYER</span></div><div class="fieldgrid"><div class="field"><label for="layoutMode">Model tampilan</label><select id="layoutMode"><option value="cards">Kartu bertingkat</option><option value="table">Tabel administrasi</option><option value="compact">Daftar ringkas</option><option value="split">Panel terpisah</option></select></div><div class="field"><label for="density">Kepadatan</label><select id="density"><option value="comfortable">Lapang</option><option value="balanced">Seimbang</option><option value="dense">Padat</option></select></div></div><div class="status" id="layoutPreview">Pratinjau layout: kartu bertingkat · lapang.</div></section>
<section class="layer" id="choices"><div class="layerhead"><div><h2>03 / Pilihan dan kebijakan</h2><p>Atur aturan bawaan untuk ekstensi yang dipilih.</p></div><span class="tag">POLICY LAYER</span></div><div class="fieldgrid"><div class="field"><label for="selectedExt">Ekstensi aktif</label><select id="selectedExt"><option>.com</option><option>.id</option><option>.co.id</option><option>.net</option><option>.org</option><option>.info</option><option>.biz</option><option>.dev</option><option>.ai</option><option>.cloud</option><option>.online</option><option>.site</option></select></div><div class="field"><label for="policy">Kebijakan penggunaan</label><select id="policy"><option value="open">Umum / terbuka</option><option value="verified">Perlu verifikasi identitas</option><option value="business">Khusus badan usaha</option><option value="technical">Khusus teknis / developer</option><option value="restricted">Terbatas / tinjau manual</option></select></div><div class="field"><label for="renewal">Pengingat perpanjangan</label><select id="renewal"><option value="30">30 hari sebelum kedaluwarsa</option><option value="60">60 hari sebelum kedaluwarsa</option><option value="90">90 hari sebelum kedaluwarsa</option><option value="off">Nonaktif</option></select></div><div class="field"><label for="visibility">Visibilitas katalog</label><select id="visibility"><option value="public">Tampilkan</option><option value="internal">Internal saja</option><option value="hidden">Sembunyikan</option></select></div></div></section>
<section class="layer" id="apply"><div class="layerhead"><div><h2>04 / Penerapan</h2><p>Siapkan perubahan dan validasi sebelum konfigurasi diterapkan.</p></div><span class="tag">DEPLOYMENT LAYER</span></div><div class="fieldgrid"><div class="field"><label for="targetScope">Target penerapan</label><select id="targetScope"><option value="workspace">Workspace VendorDomain</option><option value="catalog">Katalog ekstensi</option><option value="staging">Lingkungan staging</option><option value="production">Produksi (perlu backend)</option></select></div><div class="field"><label for="applyMode">Mode penerapan</label><select id="applyMode"><option value="manual">Manual / tinjau dahulu</option><option value="staged">Bertahap</option><option value="scheduled">Terjadwal (rencana)</option></select></div></div><div class="actions"><button class="primary" id="validateBtn">Validasi konfigurasi</button><button id="applyBtn">Terapkan ke workspace lokal</button></div><div class="status" id="applyStatus" role="status">Belum ada penerapan. Produksi memerlukan integrasi backend dan persetujuan provider.</div></section>
<section class="layer" id="storage"><div class="layerhead"><div><h2>05 / Penyimpanan</h2><p>Kelola konfigurasi browser, ekspor berkas, atau pulihkan data JSON.</p></div><span class="tag">PERSISTENCE LAYER</span></div><div class="fieldgrid"><div class="field"><label for="storageName">Nama profil</label><input id="storageName" value="ekstensi-tld-default"></div><div class="field"><label for="storageScope">Ruang penyimpanan</label><select id="storageScope"><option value="local">Browser perangkat ini</option><option value="session">Sesi browser</option><option value="export">Ekspor berkas saja</option></select></div></div><div class="actions"><button class="primary" id="saveBtn">Simpan konfigurasi</button><button id="exportBtn">Ekspor JSON</button><button id="importBtn">Impor JSON</button><input id="importFile" type="file" accept="application/json,.json" hidden></div><div class="status" id="storageStatus" role="status">Belum ada konfigurasi yang disimpan.</div></section>
<section class="layer" id="files"><div class="layerhead"><div><h2>06 / Penyimpanan sistem: folder dan file</h2><p>Struktur tujuan yang disarankan untuk integrasi dengan File Manager PlanetBintang.</p></div><span class="tag">FILE SYSTEM LAYER</span></div><div class="filetree"><div><code>vendordomain/</code><span>Modul utama</span></div><div><code>vendordomain/config/</code><span>Profil dan kebijakan TLD</span></div><div><code>vendordomain/data/extensions/</code><span>Metadata ekstensi</span></div><div><code>vendordomain/pages/</code><span>Halaman detail ekstensi</span></div><div><code>vendordomain/schemas/</code><span>Skema validasi JSON</span></div><div><code>vendordomain/logs/</code><span>Riwayat penerapan dan audit</span></div></div><div class="field" style="margin-top:12px"><label for="fileTarget">Lokasi file konfigurasi yang dituju</label><input id="fileTarget" value="vendordomain/config/extensions-tld.json"></div><p class="hint">Lokasi di atas adalah target/manifest. Browser tidak dapat menulis langsung ke repositori atau folder server; gunakan Ekspor JSON lalu commit melalui File Manager/GitHub.</p></section>
<section class="layer" id="config"><div class="layerhead"><div><h2>07 / Konfigurasi dan audit</h2><p>Pratinjau objek konfigurasi aktif, catatan perubahan, dan reset profil.</p></div><span class="tag">CONTROL LAYER</span></div><div class="field"><label for="configNotes">Catatan konfigurasi</label><textarea id="configNotes" rows="3" placeholder="Catatan perubahan, alasan kebijakan, atau instruksi penerapan…"></textarea></div><pre id="configPreview" style="white-space:pre-wrap;overflow-wrap:anywhere;background:#06101d;border:1px solid var(--line);padding:13px;font-size:11px;color:#b9d8f5"></pre><div class="actions"><button id="refreshPreview">Perbarui pratinjau</button><button class="danger" id="resetBtn">Reset profil lokal</button><a href="077-ekstensi-com.reic" style="padding:10px">Buka halaman .com →</a></div><div class="status" id="configStatus" role="status">Konfigurasi belum disimpan.</div></section>
</div></div>
</main>
<script>
(()=>{'use strict';
const $=s=>document.querySelector(s),key='vd-extensions-tld-config-v1';
const catalog=[
{ext:'.com',kind:'gTLD',label:'Komersial umum',policy:'open',desc:'Penggunaan umum untuk bisnis dan situs global.'},
{ext:'.id',kind:'ccTLD',label:'Indonesia',policy:'verified',desc:'Kode negara Indonesia; ketentuan mengikuti registri.'},
{ext:'.co.id',kind:'ccTLD',label:'Bisnis Indonesia',policy:'business',desc:'Kategori untuk kebutuhan badan usaha di Indonesia.'},
{ext:'.net',kind:'gTLD',label:'Jaringan',policy:'open',desc:'Awalnya berorientasi jaringan dan infrastruktur.'},
{ext:'.org',kind:'gTLD',label:'Organisasi',policy:'open',desc:'Sering digunakan organisasi dan komunitas.'},
{ext:'.info',kind:'gTLD',label:'Informasi',policy:'open',desc:'Situs informasi dan publikasi.'},
{ext:'.biz',kind:'gTLD',label:'Bisnis',policy:'business',desc:'Pilihan nama domain untuk usaha.'},
{ext:'.dev',kind:'New gTLD',label:'Developer',policy:'technical',desc:'Ekosistem pengembang; HTTPS wajib di browser modern.'},
{ext:'.ai',kind:'ccTLD',label:'AI / teknologi',policy:'open',desc:'Kode negara Anguilla yang populer di industri AI.'},
{ext:'.cloud',kind:'New gTLD',label:'Cloud',policy:'technical',desc:'Layanan cloud, infrastruktur, dan SaaS.'},
{ext:'.online',kind:'New gTLD',label:'Online',policy:'open',desc:'Penggunaan web umum.'},
{ext:'.site',kind:'New gTLD',label:'Website',policy:'open',desc:'Identitas situs dan proyek digital.'}
];
let applied=false;
function read(){const data={profile:$('#storageName').value.trim()||'ekstensi-tld-default',layout:$('#layoutMode').value,density:$('#density').value,extension:$('#selectedExt').value,policy:$('#policy').value,renewal:$('#renewal').value,visibility:$('#visibility').value,targetScope:$('#targetScope').value,applyMode:$('#applyMode').value,storageScope:$('#storageScope').value,fileTarget:$('#fileTarget').value.trim(),notes:$('#configNotes').value,updatedAt:new Date().toISOString()};return {schemaVersion:1,module:'vendordomain.extensions-tld',...data}}
function renderCatalog(){const q=$('#searchExt').value.toLowerCase(),kind=$('#filterKind').value;const list=catalog.filter(x=>(!q||(x.ext+' '+x.label+' '+x.desc).toLowerCase().includes(q))&&(!kind||x.kind===kind));$('#extensionGrid').innerHTML=list.map(x=>'<button class="subcard" data-ext="'+x.ext+'"><strong>'+x.ext+' <span class="tag">'+x.kind+'</span></strong><small>'+x.label+'<br>'+x.desc+'</small></button>').join('')||'<p class="muted">Tidak ada ekstensi yang cocok.</p>';$('#extensionCount').textContent=catalog.length;document.querySelectorAll('[data-ext]').forEach(b=>b.onclick=()=>{$('#selectedExt').value=b.dataset.ext;$('#policy').value=catalog.find(x=>x.ext===b.dataset.ext).policy;preview();$('#choices').scrollIntoView({behavior:'smooth'})})}
function preview(){const d=read();$('#configPreview').textContent=JSON.stringify(d,null,2);$('#layoutPreview').textContent='Pratinjau layout: '+$('#layoutMode').selectedOptions[0].text+' · '+$('#density').selectedOptions[0].text+'.';}
function persist(){const d=read();const target=d.storageScope==='session'?sessionStorage:localStorage;if(d.storageScope!=='export')target.setItem(key,JSON.stringify(d));$('#savedState').textContent=d.storageScope==='export'?'Ekspor': '1';$('#storageStatus').textContent='Profil “'+d.profile+'” disimpan pada '+(d.storageScope==='session'?'sesi browser':'browser perangkat ini')+'. '+d.updatedAt;preview()}
function download(){const blob=new Blob([JSON.stringify(read(),null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='extensions-tld-config.json';a.click();URL.revokeObjectURL(url);$('#storageStatus').textContent='Berkas JSON berhasil disiapkan untuk diunduh.'}
function validate(){const d=read(),issues=[];if(!d.profile)issues.push('Nama profil wajib diisi.');if(!d.fileTarget.startsWith('vendordomain/'))issues.push('Lokasi file harus berada di folder vendordomain/.');if(!catalog.some(x=>x.ext===d.extension))issues.push('Ekstensi belum ada di katalog lokal.');$('#applyStatus').textContent=issues.length?'Validasi menemukan: '+issues.join(' '):'Validasi lokal berhasil. Struktur dan pilihan konfigurasi lengkap; belum ada perubahan registrar atau server.';return !issues.length}
$('#searchExt').oninput=renderCatalog;$('#filterKind').onchange=renderCatalog;
['layoutMode','density','selectedExt','policy','renewal','visibility','targetScope','applyMode','storageScope','storageName','fileTarget','configNotes'].forEach(id=>$('#'+id).addEventListener('input',preview));
$('#validateBtn').onclick=validate;$('#applyBtn').onclick=()=>{if(!validate())return;applied=true;persist();$('#applyStatus').textContent='Konfigurasi diterapkan ke workspace lokal. Penerapan produksi belum dijalankan.';$('#configStatus').textContent='Status: diterapkan secara lokal · '+new Date().toLocaleString('id-ID')};
$('#saveBtn').onclick=persist;$('#exportBtn').onclick=download;$('#importBtn').onclick=()=>$('#importFile').click();
$('#importFile').onchange=async e=>{const f=e.target.files[0];if(!f)return;try{const d=JSON.parse(await f.text());if(d.module!=='vendordomain.extensions-tld'||d.schemaVersion!==1)throw Error('Skema file tidak cocok.');for(const [id,v] of Object.entries({storageName:d.profile,layoutMode:d.layout,density:d.density,selectedExt:d.extension,policy:d.policy,renewal:d.renewal,visibility:d.visibility,targetScope:d.targetScope,applyMode:d.applyMode,storageScope:d.storageScope,fileTarget:d.fileTarget,configNotes:d.notes}))if(v!==undefined&&$('#'+id))$('#'+id).value=v;preview();$('#storageStatus').textContent='Konfigurasi berhasil dimuat. Tekan Simpan untuk menyimpan profil.'}catch(err){$('#storageStatus').textContent='Impor gagal: '+err.message}e.target.value=''};
$('#refreshPreview').onclick=preview;$('#resetBtn').onclick=()=>{if(!confirm('Reset konfigurasi lokal untuk modul Ekstensi dan TLD?'))return;localStorage.removeItem(key);sessionStorage.removeItem(key);location.reload()};
document.querySelectorAll('[data-jump]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-jump]').forEach(x=>x.classList.toggle('active',x===b));$('#'+b.dataset.jump).scrollIntoView({behavior:'smooth',block:'start'})});
try{const saved=JSON.parse(localStorage.getItem(key)||sessionStorage.getItem(key)||'null');if(saved){for(const [id,v] of Object.entries({storageName:saved.profile,layoutMode:saved.layout,density:saved.density,selectedExt:saved.extension,policy:saved.policy,renewal:saved.renewal,visibility:saved.visibility,targetScope:saved.targetScope,applyMode:saved.applyMode,storageScope:saved.storageScope,fileTarget:saved.fileTarget,configNotes:saved.notes}))if(v!==undefined&&$('#'+id))$('#'+id).value=v;$('#savedState').textContent='1';$('#storageStatus').textContent='Profil tersimpan dimuat: '+saved.profile}}catch{}
renderCatalog();preview();
})();
</script>
</body></html>