<!doctype html>
<html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="Konfigurasi berlapis Slug SEO pada VendorDomain."><title>Slug SEO · VendorDomain</title>
<style>
:root{color-scheme:dark;--bg:#050a14;--panel:#0b1728;--panel2:#10243a;--line:#29415d;--text:#eaf4ff;--muted:#9cb2cc;--accent:#73cfff;--cyan:#63e4d1}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 80% -10%,#14375a 0,transparent 42%),linear-gradient(180deg,#050a14,#071321 55%,#050a14);color:var(--text);font:14px/1.6 Inter,system-ui,sans-serif}a{color:#83dfff;text-decoration:none}button,select,input{font:inherit;color:inherit;background:#071321;border:1px solid var(--line);border-radius:0;padding:10px}button{cursor:pointer}button:hover,.nav button.active{border-color:var(--accent);background:#12304a}header{padding:18px clamp(14px,3vw,38px);border-bottom:1px solid var(--line);background:#071222eF}header small,.eyebrow{color:var(--cyan);letter-spacing:1.5px;font-weight:800}h1{font-size:clamp(23px,3vw,34px);margin:5px 0}header p{margin:4px 0;color:var(--muted)}.crumb{display:flex;gap:12px;flex-wrap:wrap;font-size:12px;margin-bottom:10px}main{max-width:1440px;margin:auto;padding:22px clamp(12px,2.5vw,36px) 50px}.intro{border:1px solid var(--line);background:linear-gradient(145deg,#0d1e32,#081321);padding:20px;margin-bottom:15px}.intro p{color:var(--muted);margin:6px 0}.workspace{display:grid;grid-template-columns:230px minmax(0,1fr);gap:14px}.nav,.stage{border:1px solid var(--line);background:linear-gradient(145deg,#0b1a2d,#071321)}.nav{padding:10px;display:flex;flex-direction:column;gap:6px;align-self:start;position:sticky;top:10px}.nav button{text-align:left;background:transparent;padding:12px}.nav button span{display:block;color:var(--muted);font-size:10px}.stage{min-width:0;padding:clamp(14px,2vw,24px)}.layer{display:none}.layer.active{display:block}.layer-head{display:flex;justify-content:space-between;gap:15px;border-bottom:1px solid var(--line);padding-bottom:14px;margin-bottom:18px}.layer-head small{color:var(--cyan);letter-spacing:1.5px}.layer-head h2{margin:3px 0;font-size:22px}.layer-head p{margin:0;color:var(--muted)}.layer-mark{font-size:32px;color:#315c7c}.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.field{display:grid;gap:6px;color:#bfd0e5}.field select{width:100%;min-height:42px}.pathbox{margin-top:18px;padding:15px;border:1px solid var(--line);background:#06101d;display:grid;gap:7px}.pathbox b{color:var(--cyan);font-size:11px;letter-spacing:1px}.pathbox code{color:#b9d9ff}.pathbox p{color:var(--muted);font-size:12px}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}.import{border:1px solid var(--line);padding:9px 12px;cursor:pointer}.import input{max-width:180px}.footer-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:20px;padding-top:16px;border-top:1px solid var(--line)}.status{margin-top:14px;padding:12px;border-left:3px solid var(--cyan);background:#0c2032;color:#c9e8ff}.muted{color:var(--muted)}@media(max-width:700px){.workspace{grid-template-columns:1fr}.nav{position:static;display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.nav button{font-size:11px;padding:9px}.fields{grid-template-columns:1fr}.layer-mark{font-size:24px}}
</style></head><body><header><div class="crumb"><a href="../index.html">VENDORDOMAIN</a><span>›</span><a href="../features/index.html">FITUR</a><span>›</span><span>SEO DAN PENEMUAN SITUS</span></div><small>MODUL 15 · FITUR 353 DARI 500</small><h1>Slug SEO</h1><p>Workspace konfigurasi khusus · enam lapisan pengaturan dan penyimpanan</p></header><main><section class="intro"><div class="eyebrow">SEO & SITE DISCOVERY / CONFIGURATION WORKSPACE</div><p>Atur layout, pilihan, penerapan, penyimpanan, folder-file, dan parameter Slug SEO secara terpisah. Setiap lapisan memiliki pengaturan mandiri.</p></section><div class="workspace"><nav class="nav" aria-label="Lapisan konfigurasi"><button type="button" class="active" data-tab="layout"><span>LAPISAN 01</span>LAYOUT</button><button type="button" class="" data-tab="pilihan"><span>LAPISAN 02</span>PILIHAN</button><button type="button" class="" data-tab="penerapan"><span>LAPISAN 03</span>PENERAPAN</button><button type="button" class="" data-tab="penyimpanan"><span>LAPISAN 04</span>PENYIMPANAN</button><button type="button" class="" data-tab="folder"><span>LAPISAN 05</span>FOLDER & FILE</button><button type="button" class="" data-tab="konfigurasi"><span>LAPISAN 06</span>KONFIGURASI</button></nav><div class="stage"><section class="layer active" id="panel-layout" data-panel="layout"><div class="layer-head"><div><small>LAPISAN 01</small><h2>LAYOUT</h2><p>Atur komposisi dan lapisan antarmuka.</p></div><span class="layer-mark">01</span></div><div class="fields"><label class="field"><span>Tata letak</span><select data-setting="layout.0"><option value="Panel bertingkat">Panel bertingkat</option><option value="Kanvas kerja">Kanvas kerja</option><option value="Tabel dan detail">Tabel dan detail</option><option value="Pratinjau terpisah">Pratinjau terpisah</option></select></label><label class="field"><span>Kepadatan</span><select data-setting="layout.1"><option value="Ringkas">Ringkas</option><option value="Standar">Standar</option><option value="Lapang">Lapang</option></select></label><label class="field"><span>Navigasi</span><select data-setting="layout.2"><option value="Tab horizontal">Tab horizontal</option><option value="Sidebar">Sidebar</option><option value="Panel bertumpuk">Panel bertumpuk</option></select></label></div></section><section class="layer " id="panel-pilihan" data-panel="pilihan"><div class="layer-head"><div><small>LAPISAN 02</small><h2>PILIHAN</h2><p>Pilihan yang khusus untuk fitur ini.</p></div><span class="layer-mark">02</span></div><div class="fields"><label class="field"><span>Struktur URL</span><select data-setting="pilihan.0"><option value="Otomatis">Otomatis</option><option value="Manual">Manual</option><option value="Gunakan templat">Gunakan templat</option></select></label><label class="field"><span>Pemisah kata</span><select data-setting="pilihan.1"><option value="Standar">Standar</option><option value="Disesuaikan">Disesuaikan</option><option value="Lanjutan">Lanjutan</option></select></label><label class="field"><span>Normalisasi karakter</span><select data-setting="pilihan.2"><option value="Aktif">Aktif</option><option value="Nonaktif">Nonaktif</option><option value="Ikuti sistem">Ikuti sistem</option></select></label><label class="field"><span>Aturan trailing slash</span><select data-setting="pilihan.3"><option value="Default">Default</option><option value="Ketat">Ketat</option><option value="Fleksibel">Fleksibel</option></select></label></div></section><section class="layer " id="panel-penerapan" data-panel="penerapan"><div class="layer-head"><div><small>LAPISAN 03</small><h2>PENERAPAN</h2><p>Tentukan cara konfigurasi diterapkan.</p></div><span class="layer-mark">03</span></div><div class="fields"><label class="field"><span>Mode penerapan</span><select data-setting="penerapan.0"><option value="Pratinjau">Pratinjau</option><option value="Terapkan ke proyek">Terapkan ke proyek</option><option value="Jadwalkan">Jadwalkan</option></select></label><label class="field"><span>Cakupan</span><select data-setting="penerapan.1"><option value="Halaman aktif">Halaman aktif</option><option value="Seluruh situs">Seluruh situs</option><option value="Pilihan URL">Pilihan URL</option></select></label><label class="field"><span>Validasi sebelum penerapan</span><select data-setting="penerapan.2"><option value="Wajib">Wajib</option><option value="Peringatan saja">Peringatan saja</option><option value="Lewati">Lewati</option></select></label><label class="field"><span>Status fitur</span><select data-setting="penerapan.3"><option value="Aktif">Aktif</option><option value="Jeda">Jeda</option><option value="Nonaktif">Nonaktif</option></select></label></div></section><section class="layer " id="panel-penyimpanan" data-panel="penyimpanan"><div class="layer-head"><div><small>LAPISAN 04</small><h2>PENYIMPANAN</h2><p>Kelola data konfigurasi, versi, dan ekspor.</p></div><span class="layer-mark">04</span></div><div class="fields"><label class="field"><span>Lokasi penyimpanan</span><select data-setting="penyimpanan.0"><option value="Penyimpanan browser">Penyimpanan browser</option><option value="Ekspor JSON">Ekspor JSON</option><option value="Backend terhubung">Backend terhubung</option></select></label><label class="field"><span>Kebijakan versi</span><select data-setting="penyimpanan.1"><option value="Simpan setiap perubahan">Simpan setiap perubahan</option><option value="Simpan manual">Simpan manual</option><option value="Satu versi terakhir">Satu versi terakhir</option></select></label><label class="field"><span>Retensi</span><select data-setting="penyimpanan.2"><option value="30 hari">30 hari</option><option value="90 hari">90 hari</option><option value="Tanpa batas">Tanpa batas</option></select></label><label class="field"><span>Format ekspor</span><select data-setting="penyimpanan.3"><option value="JSON">JSON</option><option value="TXT">TXT</option><option value="CSV">CSV</option></select></label></div><div class="actions"><button type="button" data-export>Ekspor konfigurasi JSON</button><label class="import">Impor konfigurasi<input type="file" accept="application/json" data-import></label></div></section><section class="layer " id="panel-folder" data-panel="folder"><div class="layer-head"><div><small>LAPISAN 05</small><h2>FOLDER & FILE</h2><p>Peta penyimpanan sistem dan berkas fitur.</p></div><span class="layer-mark">05</span></div><div class="fields"><label class="field"><span>Folder fitur</span><select data-setting="folder.0"><option value="vendordomain/storage/seo/slug-seo/">vendordomain/storage/seo/slug-seo/</option></select></label><label class="field"><span>File konfigurasi</span><select data-setting="folder.1"><option value="config.json">config.json</option><option value="settings.json">settings.json</option><option value="manifest.reic">manifest.reic</option></select></label><label class="field"><span>File data</span><select data-setting="folder.2"><option value="data.json">data.json</option><option value="records.json">records.json</option><option value="report.json">report.json</option></select></label><label class="field"><span>Akses file</span><select data-setting="folder.3"><option value="Baca dan tulis lokal">Baca dan tulis lokal</option><option value="Baca saja">Baca saja</option><option value="Ekspor saja">Ekspor saja</option></select></label></div><div class="pathbox"><b>STRUKTUR FOLDER SISTEM</b><code>vendordomain/</code><code>└── storage/seo/slug-seo/</code><code>    ├── config.json</code><code>    ├── manifest.reic</code><code>    ├── data/</code><code>    └── reports/</code><p>Jalur ini merupakan rancangan lokasi penyimpanan. Penyimpanan persisten server memerlukan backend.</p></div></section><section class="layer " id="panel-konfigurasi" data-panel="konfigurasi"><div class="layer-head"><div><small>LAPISAN 06</small><h2>KONFIGURASI</h2><p>Parameter teknis, aturan, dan pemeriksaan.</p></div><span class="layer-mark">06</span></div><div class="fields"><label class="field"><span>Struktur URL</span><select data-setting="konfigurasi.0"><option value="Nilai otomatis">Nilai otomatis</option><option value="Nilai khusus">Nilai khusus</option></select></label><label class="field"><span>Pemisah kata</span><select data-setting="konfigurasi.1"><option value="Validasi standar">Validasi standar</option><option value="Validasi ketat">Validasi ketat</option></select></label><label class="field"><span>Bahasa antarmuka</span><select data-setting="konfigurasi.2"><option value="Indonesia">Indonesia</option><option value="English">English</option></select></label><label class="field"><span>Pencatatan aktivitas</span><select data-setting="konfigurasi.3"><option value="Aktif">Aktif</option><option value="Nonaktif">Nonaktif</option></select></label></div></section><div class="footer-actions"><button type="button" id="save">Simpan konfigurasi</button><button type="button" id="apply">Validasi & terapkan</button><button type="button" id="reset">Pulihkan default</button><button type="button" id="exportAll">Unduh konfigurasi</button></div><div class="status" id="status" role="status">Konfigurasi Slug SEO siap disunting. Perubahan belum diterapkan.</div></div></div></main>
<script>
(()=>{const id=353,name="Slug SEO",key="pb-vendordomain-seo-"+id,root=document,nav=[...root.querySelectorAll("[data-tab]")],panels=[...root.querySelectorAll("[data-panel]")],status=root.querySelector("#status");let state={};const controls=[...root.querySelectorAll("[data-setting]")];function read(){return Object.fromEntries(controls.map(x=>[x.dataset.setting,x.value]))}function load(v){controls.forEach(x=>{if(v&&Object.prototype.hasOwnProperty.call(v,x.dataset.setting))x.value=v[x.dataset.setting]})}function save(){state=read();localStorage.setItem(key,JSON.stringify({id,name,updatedAt:new Date().toISOString(),settings:state}));status.textContent="Konfigurasi "+name+" tersimpan pada penyimpanan browser perangkat ini."}function download(){const data={schema:"PlanetBintang.VendorDomain.SEO/1",id,name,settings:read(),exportedAt:new Date().toISOString()};const a=document.createElement("a"),url=URL.createObjectURL(new Blob([JSON.stringify(data,null,2)],{type:"application/json"}));a.href=url;a.download="seo-"+id+"-"+name.toLowerCase().replace(/[^a-z0-9]+/g,"-")+".json";a.click();URL.revokeObjectURL(url)}nav.forEach(b=>b.addEventListener("click",()=>{nav.forEach(n=>n.classList.toggle("active",n===b));panels.forEach(p=>p.classList.toggle("active",p.dataset.panel===b.dataset.tab))}));root.querySelector("#save").onclick=save;root.querySelector("#apply").onclick=()=>{const v=read();if(Object.values(v).some(x=>!x)){status.textContent="Validasi gagal: lengkapi seluruh pilihan.";return}save();status.textContent="Validasi berhasil. Konfigurasi diterapkan pada workspace lokal; sinkronisasi server memerlukan backend.";};root.querySelector("#reset").onclick=()=>{controls.forEach(x=>x.selectedIndex=0);localStorage.removeItem(key);status.textContent="Pengaturan dikembalikan ke nilai awal.";};root.querySelector("#exportAll").onclick=download;root.querySelector("[data-export]").onclick=download;root.querySelector("[data-import]").onchange=async e=>{try{const d=JSON.parse(await e.target.files[0].text());if(!d.settings)throw Error("Format konfigurasi tidak sesuai");load(d.settings);status.textContent="Konfigurasi berhasil dimuat. Simpan untuk menyimpan perubahan."}catch(err){status.textContent="Impor gagal: "+err.message}};try{const d=JSON.parse(localStorage.getItem(key)||"null");if(d&&d.settings)load(d.settings)}catch{};})();
</script></body></html>