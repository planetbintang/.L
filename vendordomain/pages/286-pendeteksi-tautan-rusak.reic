<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Pendeteksi Tautan Rusak · PlanetBintang .L</title><style>
:root{color-scheme:dark;--bg:#0b1020;--panel:#131b2f;--line:#263451;--text:#eef4ff;--muted:#9fb0ca;--accent:#73a7ff}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:15px/1.55 system-ui,sans-serif}header{padding:22px clamp(16px,4vw,44px);background:#10182b;border-bottom:1px solid var(--line)}h1{font-size:clamp(23px,3vw,34px);margin:6px 0}p,.muted{color:var(--muted)}main{max-width:1240px;margin:auto;padding:clamp(16px,3vw,36px)}.card{border:1px solid var(--line);background:var(--panel);border-radius:16px;padding:20px;margin-bottom:18px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px}.sub{border:1px solid var(--line);border-radius:12px;background:#0d1527;color:var(--text);padding:14px;text-align:left;min-height:95px;cursor:pointer}.sub:hover,button:hover{border-color:var(--accent)}.sub strong{display:block;margin-bottom:5px}.sub small{color:var(--muted)}button,textarea{font:inherit;border:1px solid var(--line);border-radius:10px;background:#0d1527;color:var(--text);padding:10px 12px}textarea{width:100%;min-height:110px}.row{display:flex;gap:12px;flex-wrap:wrap}a{color:#b8d0ff}.status{color:#a8c8ff}@media(max-width:600px){.row>*{flex:1 1 100%}}
</style><style id="pb-layered-config-style">.pb-config{--pc:#66d5e8;border:1px solid #29415d;background:radial-gradient(circle at 95% 0,#16365366,transparent 38%),linear-gradient(145deg,#0d1c30,#071321);padding:20px;margin:20px 0;color:#eaf4ff}.pb-config[data-layout="1"]{border-radius:3px;border-left:5px solid var(--pc)}.pb-config[data-layout="2"]{border-radius:24px;background:linear-gradient(120deg,#10253b,#091525)}.pb-config[data-layout="3"]{border-radius:3px;border-top:3px solid var(--pc);background:repeating-linear-gradient(135deg,#0b192a 0,#0b192a 9px,#0d1d30 9px,#0d1d30 10px)}.pb-config p,.pb-config small{color:#a9bdd3}.pb-config-head{display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap}.pb-config-tabs,.pb-config .pb-actions{display:flex;gap:6px;flex-wrap:wrap;margin:14px 0}.pb-config button,.pb-config input,.pb-config select,.pb-config textarea{font:inherit;color:inherit;background:#071321;border:1px solid #29415d;padding:10px;border-radius:3px}.pb-config button{cursor:pointer}.pb-config button.active,.pb-config button:hover{border-color:var(--pc);background:#14314a}.pb-config-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.pb-config label{display:grid;gap:6px;font-size:12px;color:#b8cbe0}.pb-config textarea{min-height:90px;width:100%}.pb-config .pb-wide{grid-column:1/-1}.pb-config .pb-panel{padding:14px;border:1px solid #29415d;background:#081625;margin-top:10px}.pb-config .pb-status{color:#8de3c0;min-height:22px}@media(max-width:620px){.pb-config-grid{grid-template-columns:1fr}.pb-config .pb-wide{grid-column:auto}}</style></head><body><header><div class="muted">VENDORDOMAIN · MODUL 12 · HALAMAN 286 DARI 500</div><h1>Pendeteksi Tautan Rusak</h1><p>AI dan otomatisasi · Halaman fitur mandiri dengan 15 submenu.</p><div class="row"><a href="../features/index.html">Katalog fitur</a><a href="285-penerjemah-konten.html">← Sebelumnya</a><a href="287-saran-perbaikan-dns.html">Berikutnya →</a></div></header><main><section class="card"><h2>Submenu fitur</h2><p>Submenu berjalan langsung di halaman tanpa modal pop-up.</p><div class="grid"><button class="sub" data-sub="Ringkasan"><strong>01 · Ringkasan</strong><small>Ringkasan status fitur dan data.</small></button><button class="sub" data-sub="Konfigurasi"><strong>02 · Konfigurasi</strong><small>Ubah preferensi kerja lokal.</small></button><button class="sub" data-sub="Data Masuk"><strong>03 · Data Masuk</strong><small>Catat sumber data yang digunakan.</small></button><button class="sub" data-sub="Data Keluar"><strong>04 · Data Keluar</strong><small>Tinjau hasil dan keluaran fitur.</small></button><button class="sub" data-sub="Validasi"><strong>05 · Validasi</strong><small>Periksa format dan kelengkapan data.</small></button><button class="sub" data-sub="Riwayat Aktivitas"><strong>06 · Riwayat Aktivitas</strong><small>Tampilkan riwayat lokal fitur.</small></button><button class="sub" data-sub="Pencarian"><strong>07 · Pencarian</strong><small>Cari informasi dalam ruang kerja.</small></button><button class="sub" data-sub="Filter Data"><strong>08 · Filter Data</strong><small>Saring informasi berdasarkan kata kunci.</small></button><button class="sub" data-sub="Impor Berkas"><strong>09 · Impor Berkas</strong><small>Pilih berkas JSON untuk diproses.</small></button><button class="sub" data-sub="Catatan Kerja"><strong>10 · Catatan Kerja</strong><small>Simpan catatan pada perangkat.</small></button><button class="sub" data-sub="Pemantauan"><strong>11 · Pemantauan</strong><small>Periksa status kesiapan fitur.</small></button><button class="sub" data-sub="Akses dan Izin"><strong>12 · Akses dan Izin</strong><small>Tampilkan keterangan akses.</small></button><button class="sub" data-sub="Bantuan"><strong>13 · Bantuan</strong><small>Baca petunjuk penggunaan.</small></button><button class="sub" data-sub="Pengaturan Lanjutan"><strong>14 · Pengaturan Lanjutan</strong><small>Tampilkan opsi tambahan.</small></button><button class="sub" data-sub="Pemeriksaan Sistem"><strong>15 · Pemeriksaan Sistem</strong><small>Jalankan pemeriksaan lokal.</small></button></div><p id="status" class="status" role="status">Pilih submenu untuk menjalankan aksi lokal.</p></section><section class="card"><h2>Catatan kerja lokal</h2><p>Catatan tersimpan pada browser/perangkat ini, bukan backend produksi.</p><textarea id="notes" placeholder="Catatan untuk Pendeteksi Tautan Rusak…"></textarea><div class="row" style="margin-top:10px"><button id="save">Simpan catatan</button><button id="clear">Hapus catatan</button><button id="check">Periksa status halaman</button></div></section><section class="pb-config" id="pbLayeredConfig"><div class="pb-config-head"><div><small>VENDORDOMAIN / AI & OTOMATISASI / CONFIGURATION STACK</small><h2>Konfigurasi Berlapis</h2><p>Pengaturan mandiri untuk setiap submenu fitur.</p></div><span class="pill">5 LAPISAN · 15 SUBMENU</span></div><div class="pb-config-grid"><label class="pb-wide">SUBMENU<select id="pbTarget"></select></label></div><nav class="pb-config-tabs"><button type="button" data-tab="layout" class="active">01 · Layout</button><button type="button" data-tab="pilihan">02 · Pilihan</button><button type="button" data-tab="penerapan">03 · Penerapan</button><button type="button" data-tab="penyimpanan">04 · Penyimpanan</button><button type="button" data-tab="sistem">05 · Konfigurasi Sistem</button></nav><div class="pb-panel" data-panel="layout"><div class="pb-config-grid"><label>Jenis layout<select id="pbLayout"><option>Panel bertingkat</option><option>Kartu modular</option><option>Ruang kerja dua kolom</option><option>Alur vertikal</option><option>Dasbor ringkas</option></select></label><label>Kepadatan<select id="pbDensity"><option>Seimbang</option><option>Ringkas</option><option>Luas</option></select></label><label>Navigasi<select id="pbNav"><option>Atas</option><option>Samping kiri</option><option>Tab horizontal</option></select></label><label>Tema<select id="pbTheme"><option>Gelap abstrak</option><option>Gelap kontras</option><option>Biru teknis</option><option>Transparan berlapis</option></select></label></div></div><div class="pb-panel" data-panel="pilihan" hidden><div class="pb-config-grid"><label>Model AI<select id="pbModel"><option>Model otomatis</option><option>Model ringan</option><option>Model kualitas tinggi</option><option>Model lokal / simulasi</option></select></label><label>Metode<select id="pbMethod"><option>Terbantu AI</option><option>Otomatis berbasis aturan</option><option>Manual dengan rekomendasi</option><option>Hibrida</option></select></label><label>Bahasa<select id="pbLanguage"><option>Indonesia</option><option>Inggris</option><option>Multi bahasa</option></select></label><label>Prioritas<select id="pbPriority"><option>Keseimbangan</option><option>Kecepatan</option><option>Ketepatan</option><option>Efisiensi sumber daya</option></select></label></div></div><div class="pb-panel" data-panel="penerapan" hidden><div class="pb-config-grid"><label>Pemicu<select id="pbTrigger"><option>Jalankan manual</option><option>Saat data berubah</option><option>Terjadwal</option><option>Saat publikasi</option><option>Setelah validasi</option></select></label><label>Mode penerapan<select id="pbDeploy"><option>Pratinjau dahulu</option><option>Persetujuan sebelum terbit</option><option>Otomatis setelah validasi</option><option>Nonaktif</option></select></label><label>Lingkup<select id="pbScope"><option>Halaman ini</option><option>Domain terpilih</option><option>Workspace VendorDomain</option></select></label><label>Persetujuan<select id="pbApproval"><option>Wajib</option><option>Tidak wajib untuk tugas aman</option><option>Selalu manual</option></select></label></div></div><div class="pb-panel" data-panel="penyimpanan" hidden><div class="pb-config-grid"><label>Folder tujuan<input id="pbPath" value="vendordomain/config/ai-automation/"></label><label>Retensi<select id="pbRetention"><option>30 hari</option><option>90 hari</option><option>180 hari</option><option>1 tahun</option><option>Simpan sampai dihapus</option></select></label><label>Jenis data<select id="pbData"><option>Konfigurasi dan log</option><option>Konfigurasi saja</option><option>Konfigurasi, hasil, dan log</option></select></label><label>Format<select id="pbFormat"><option>JSON</option><option>REIC metadata</option><option>JSON + log teks</option></select></label></div><p>Disimpan di browser; ekspor menghasilkan file yang dapat ditempatkan ke folder sistem.</p></div><div class="pb-panel" data-panel="sistem" hidden><div class="pb-config-grid"><label>Nama file<input id="pbFilename" value="submenu-config.json"></label><label>Versi skema<input id="pbSchema" value="1.0.0" readonly></label><label class="pb-wide">Aturan khusus<textarea id="pbRules" placeholder="Aturan dan parameter submenu…"></textarea></label></div><p><small>Sinkronisasi langsung ke GitHub memerlukan backend berizin. Halaman statis tidak menyimpan token GitHub.</small></p></div><div class="pb-actions"><button type="button" id="pbApply">Terapkan</button><button type="button" id="pbSave">Simpan</button><button type="button" id="pbExport">Ekspor JSON</button><button type="button" id="pbImport">Impor file</button><input id="pbImportFile" type="file" accept=".json,application/json" hidden></div><div class="pb-status" id="pbConfigStatus" role="status">Pilih submenu untuk memulai.</div></section></main><script>
const id=286, key="pb-vendor-page-"+id, status=document.querySelector("#status"), notes=document.querySelector("#notes");
notes.value=localStorage.getItem(key)||"";
document.querySelectorAll("[data-sub]").forEach(button=>button.addEventListener("click",()=>{const name=button.dataset.sub;status.textContent="Submenu “"+name+"” dijalankan untuk Pendeteksi Tautan Rusak. Aksi dicatat lokal.";const history=JSON.parse(localStorage.getItem("pb-vendor-history")||"[]");history.unshift({id,name:"Pendeteksi Tautan Rusak",submenu:name,at:new Date().toISOString()});localStorage.setItem("pb-vendor-history",JSON.stringify(history.slice(0,200)));if(name==="Catatan Kerja")notes.focus();if(name==="Riwayat Aktivitas")status.textContent="Riwayat aktivitas tersimpan: "+history.length+" catatan.";}));
document.querySelector("#save").onclick=()=>{localStorage.setItem(key,notes.value);status.textContent="Catatan halaman 286 disimpan lokal."};
document.querySelector("#clear").onclick=()=>{localStorage.removeItem(key);notes.value="";status.textContent="Catatan halaman dihapus."};
document.querySelector("#check").onclick=()=>status.textContent="Halaman 286 siap · 15 submenu terpasang · penyimpanan lokal tersedia.";
</script><script id="pb-layered-config-script">(()=>{const r=document.getElementById('pbLayeredConfig');if(!r||r.dataset.ready)return;r.dataset.ready='1';const id=Number((document.querySelector('header .muted')?.textContent.match(/HALAMAN\s+(\d+)/i)||[])[1]||0),name=document.querySelector('h1')?.textContent||'Fitur AI';r.dataset.layout=String(id%4);r.style.setProperty('--pc',['#66d5e8','#8bb6ff','#9bd6a5','#c5a6ff'][id%4]);const t=r.querySelector('#pbTarget'),subs=[...document.querySelectorAll('[data-sub]')];subs.forEach((b,i)=>{const o=document.createElement('option');o.value=b.dataset.sub;o.textContent=String(i+1).padStart(2,'0')+' · '+b.dataset.sub;t.append(o)});const ids=['pbLayout','pbDensity','pbNav','pbTheme','pbModel','pbMethod','pbLanguage','pbPriority','pbTrigger','pbDeploy','pbScope','pbApproval','pbPath','pbRetention','pbData','pbFormat','pbFilename','pbSchema','pbRules'],s=r.querySelector('#pbConfigStatus'),key=()=> 'pb-vendordomain-ai-config-'+id+'-'+t.value,read=()=>Object.fromEntries(ids.map(x=>[x,r.querySelector('#'+x).value])),fill=d=>ids.forEach(x=>{if(d&&d[x]!==undefined)r.querySelector('#'+x).value=d[x]}),load=()=>{try{fill(JSON.parse(localStorage.getItem(key())||'{}'))}catch(e){s.textContent='Konfigurasi tersimpan tidak terbaca.'}};t.addEventListener('change',load);subs.forEach(b=>b.addEventListener('click',()=>{t.value=b.dataset.sub;load()}));r.querySelectorAll('[data-tab]').forEach(b=>b.addEventListener('click',()=>{r.querySelectorAll('[data-tab]').forEach(x=>x.classList.toggle('active',x===b));r.querySelectorAll('[data-panel]').forEach(p=>p.hidden=p.dataset.panel!==b.dataset.tab)}));const pack=()=>({schema:'planetbintang.vendordomain.ai-automation',version:'1.0.0',page_id:id,feature:name,submenu:t.value,updated_at:new Date().toISOString(),settings:read()});r.querySelector('#pbApply').onclick=()=>s.textContent='Pratinjau diterapkan: '+t.value+' · '+read().pbLayout+' · '+read().pbDeploy;r.querySelector('#pbSave').onclick=()=>{localStorage.setItem(key(),JSON.stringify(read()));s.textContent='Tersimpan lokal untuk '+t.value+' · '+r.querySelector('#pbPath').value};r.querySelector('#pbExport').onclick=()=>{const b=new Blob([JSON.stringify(pack(),null,2)],{type:'application/json'}),u=URL.createObjectURL(b),a=document.createElement('a');a.href=u;a.download='vd-'+id+'-'+t.value.toLowerCase().replace(/[^a-z0-9]+/g,'-')+'.json';a.click();URL.revokeObjectURL(u);s.textContent='File JSON konfigurasi dibuat.'};r.querySelector('#pbImport').onclick=()=>r.querySelector('#pbImportFile').click();r.querySelector('#pbImportFile').onchange=async e=>{const f=e.target.files[0];if(!f)return;try{const p=JSON.parse(await f.text());fill(p.settings||p);localStorage.setItem(key(),JSON.stringify(read()));s.textContent='Konfigurasi diimpor untuk '+t.value}catch(e){s.textContent='File JSON tidak valid'}e.target.value=''};load()})();</script></body></html>
