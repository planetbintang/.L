/* Shared stylesheet for exported OS MEDIA VM REIC layout components */
.reic-layout{display:flex;flex-direction:column;min-width:0;min-height:100%;color:var(--reic-text,#eaf4ff);background:var(--reic-surface,#0b1828);border:1px solid var(--reic-line,#29425d);font:inherit}
.reic-layout__header{padding:12px 16px;border-bottom:1px solid var(--reic-line,#29425d);font-weight:700}
.reic-layout__body{display:grid;grid-template-columns:220px minmax(0,1fr);flex:1;min-height:0}
.reic-layout__sidebar{padding:14px;border-right:1px solid var(--reic-line,#29425d);color:var(--reic-muted,#91a8c3)}
.reic-layout__content{min-width:0;padding:16px}
.reic-layout--dashboard .reic-layout__content{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;align-content:start}
.reic-layout--workbench .reic-layout__body{grid-template-columns:minmax(180px,26%) minmax(0,1fr)}
.reic-layout--canvas .reic-layout__body{grid-template-columns:minmax(0,1fr)}
.reic-layout--console{font-family:ui-monospace,SFMono-Regular,monospace}
.reic-layout--console .reic-layout__content{background:#06111e}
.reic-layout--library .reic-layout__content{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:10px;align-content:start}
.reic-layout--compact .reic-layout__header{padding:7px 10px}
.reic-layout--compact .reic-layout__body{grid-template-columns:110px minmax(0,1fr)}
.reic-layout--compact .reic-layout__content{padding:9px}
.reic-layout[data-width="wide"]{max-width:1200px;margin-inline:auto}
.reic-layout[data-width="contained"]{max-width:860px;margin-inline:auto}
.reic-layout[data-density="compact"] .reic-layout__content{gap:6px;padding:8px}
.reic-layout[data-density="spacious"] .reic-layout__content{gap:18px;padding:24px}
.reic-layout[data-theme="contrast"]{--reic-text:#fff;--reic-surface:#000;--reic-line:#fff;--reic-muted:#ddd}
.reic-layout[data-theme="neutral"]{--reic-text:#202b38;--reic-surface:#f3f6f9;--reic-line:#c5d0dc;--reic-muted:#536273}
@media(max-width:700px){.reic-layout__body,.reic-layout--workbench .reic-layout__body{grid-template-columns:minmax(0,1fr)}.reic-layout__sidebar{border-right:0;border-bottom:1px solid var(--reic-line,#29425d)}.reic-layout--compact .reic-layout__body{grid-template-columns:80px minmax(0,1fr)}}
