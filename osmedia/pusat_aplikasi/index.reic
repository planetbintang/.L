<!doctype html>
<html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#08162f"><title>Pusat Aplikasi — OS MEDIA VM</title>
<style>
:root{color-scheme:dark;font-family:system-ui,-apple-system,"Segoe UI",sans-serif;background:#07152f;color:#edf6ff}*{box-sizing:border-box}body{margin:0;min-height:100vh;background:radial-gradient(ellipse at 50% 0,#244f91,transparent 55%),#07152f}.wadah{max-width:1400px;margin:auto;padding:24px}.atas{display:flex;justify-content:space-between;align-items:center;gap:15px;flex-wrap:wrap}.atas a,.tombol{color:#dff5ff;border:1px solid #8dcaff55;border-radius:12px;padding:10px 14px;background:#ffffff0b;text-decoration:none;cursor:pointer}.label{color:#63e7f4;font-size:11px;letter-spacing:.18em;font-weight:800;margin-top:30px}h1{font-size:clamp(30px,5vw,52px);margin:8px 0;letter-spacing:-.04em}.penjelasan{color:#a9c0df;line-height:1.7;font-size:13px;max-width:850px}.alat{display:grid;grid-template-columns:minmax(0,1fr) 220px;gap:12px;margin:24px 0}.alat input,.alat select{width:100%;padding:14px;border-radius:13px;border:1px solid #8dcaff44;background:#091a37;color:white;outline-color:#51dff5}.kategori{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}.kategori button{border:1px solid #7eb7e944;background:#ffffff08;color:#d6eaff;padding:8px 12px;border-radius:999px;cursor:pointer;font-size:11px}.kategori button.aktif{background:#45d7ed;color:#06162d;border-color:#45d7ed}.ringkasan{display:flex;justify-content:space-between;gap:12px;align-items:center;color:#a7c4e8;font-size:12px;margin:15px 0}.kartu{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.aplikasi{min-width:0;border:1px solid #85bfff30;border-radius:16px;background:linear-gradient(145deg,#10264b,#09152e);padding:15px;cursor:pointer;text-align:left;color:#edf6ff;min-height:145px;transition:.15s}.aplikasi:hover,.aplikasi:focus{border-color:#4fe3f3;transform:translateY(-2px)}.ikon{font-size:22px;color:#69e8f5}.aplikasi strong{display:block;font-size:12px;margin:9px 0 6px}.aplikasi small{display:block;color:#9bb6d8;font-size:10px;line-height:1.5}.halaman{display:flex;justify-content:center;align-items:center;gap:12px;margin:24px}.halaman button{background:#142c52;color:white;border:1px solid #8dcaff44;border-radius:10px;padding:10px 14px}.kosong{display:none;border:1px dashed #8dcaff44;padding:30px;border-radius:15px;text-align:center;color:#9bb6d8}.catatan{margin-top:28px;border-top:1px solid #8dcaff22;padding-top:15px;color:#809fc8;font-size:10px;line-height:1.7}.lapisan{position:fixed;inset:0;background:#020817c9;display:none;place-items:center;padding:20px}.lapisan.buka{display:grid}.dialog{width:min(650px,100%);max-height:85vh;overflow:auto;border:1px solid #80c9ff66;border-radius:20px;background:#0a1a36;padding:22px;box-shadow:0 20px 60px #0008}.dialog h2{margin:6px 0 12px}.dialog p{font-size:13px;line-height:1.7;color:#b1c8e6}.dialog pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#061126;border-radius:12px;padding:13px;color:#a8f2ed;font-size:11px}.kanan{float:right}@media(max-width:900px){.kartu{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:600px){.wadah{padding:15px}.alat{grid-template-columns:1fr}.kartu{grid-template-columns:repeat(2,minmax(0,1fr))}.aplikasi{padding:11px;min-height:140px}.ringkasan{align-items:flex-start;flex-direction:column}}@media(max-width:350px){.kartu{grid-template-columns:1fr}}
</style></head><body><main class="wadah">
<header class="atas"><a href="../">← Kembali ke desktop</a><span id="status">● Runtime web siap</span></header>
<div class="label">KATALOG MODULAR · BERBAHASA INDONESIA</div><h1>Pusat Aplikasi<span style="color:#52e3f1">.</span></h1>
<p class="penjelasan">Jelajahi 1.000 manifes aplikasi sistem yang disusun per kategori. Cari berdasarkan nama atau alias, buka rincian, dan periksa berkas konfigurasi setiap modul. Katalog ini merupakan dasar pengembangan; manifes bukan berarti semua aplikasi sudah memiliki layanan mandiri penuh.</p>
<div class="alat"><input id="cari" type="search" placeholder="Cari aplikasi, kata, alias, atau deskripsi…" aria-label="Cari aplikasi"><select id="pilihKategori" aria-label="Saring kategori"><option value="">Semua kategori</option></select></div>
<nav class="kategori" id="tombolKategori" aria-label="Kategori aplikasi"></nav>
<div class="ringkasan"><strong id="jumlah">Memuat katalog…</strong><span id="rentang"></span></div><section class="kartu" id="daftar" aria-live="polite"></section><div class="kosong" id="kosong">Tidak ada aplikasi yang sesuai dengan pencarian ini.</div>
<nav class="halaman"><button id="sebelumnya">← Sebelumnya</button><span id="nomorHalaman">Halaman 1</span><button id="berikutnya">Berikutnya →</button></nav>
<footer class="catatan">OS MEDIA VM · Inti Runtime v0.3.0 · Antarmuka situs statis. Pembacaan manifes berjalan di peramban; layanan peladen, proses latar, dan eksekusi kode aplikasi belum diaktifkan. Format katalog menggunakan JSON dengan dukungan ekstensi inti HTML, JavaScript, CSS, Markdown, TypeScript, SQL, SVG, dan TXT.</footer>
</main>
<div class="lapisan" id="lapisan" role="dialog" aria-modal="true" aria-labelledby="judulDialog"><section class="dialog"><button class="tombol kanan" id="tutup">Tutup ✕</button><div class="label" id="kelompokDialog">APLIKASI SISTEM</div><h2 id="judulDialog">Rincian aplikasi</h2><p id="uraianDialog"></p><p id="alamatDialog"></p><pre id="isiDialog"></pre><p id="statusDialog"></p></section></div>
<script src="../mesin_runtime/inti-runtime.js"></script><script src="../mesin_runtime/daftar_aplikasi.js"></script>
<script>
(function(){"use strict";
const daftar=window.DAFTAR_APLIKASI_VM||[],ukuranHalaman=60;let halaman=0,kategoriAktif="";
const el=id=>document.getElementById(id),masukan=el("cari"),pilih=el("pilihKategori"),wadah=el("daftar"),kosong=el("kosong");
const kategori=[...new Map(daftar.map(a=>[a.kategori,{id:a.kategori,nama:a.kelompok}])).values()];
function aman(teks){return window.IntiRuntimeVM.bersihkan(teks)}
function cocok(a,q){return (!kategoriAktif||a.kategori===kategoriAktif)&&(!q||(a.nama+" "+a.deskripsi+" "+a.alias.join(" ")+" "+a.kelompok).toLocaleLowerCase("id-ID").includes(q))}
function hasil(){const q=masukan.value.trim().toLocaleLowerCase("id-ID"),hasil=daftar.filter(a=>cocok(a,q)),maks=Math.max(0,Math.ceil(hasil.length/ukuranHalaman)-1);halaman=Math.min(halaman,maks);const awal=halaman*ukuranHalaman,bagian=hasil.slice(awal,awal+ukuranHalaman);wadah.innerHTML=bagian.map(a=>'<button class="aplikasi" data-id="'+aman(a.id)+'"><span class="ikon">▦</span><strong>'+aman(a.nama)+'</strong><small>'+aman(a.kelompok)+'<br>'+aman(a.alias.slice(0,3).join(" · "))+'</small></button>').join("");wadah.querySelectorAll("[data-id]").forEach(b=>b.addEventListener("click",()=>buka(daftar.find(a=>a.id===b.dataset.id))));kosong.style.display=hasil.length?"none":"block";el("jumlah").textContent=hasil.length.toLocaleString("id-ID")+" aplikasi ditemukan";el("rentang").textContent=hasil.length?("Menampilkan "+(awal+1).toLocaleString("id-ID")+"–"+Math.min(awal+ukuranHalaman,hasil.length).toLocaleString("id-ID")):"";el("nomorHalaman").textContent="Halaman "+(halaman+1)+" dari "+Math.max(1,Math.ceil(hasil.length/ukuranHalaman));el("sebelumnya").disabled=halaman===0;el("berikutnya").disabled=halaman>=maks}
function setKategori(id){kategoriAktif=id;halaman=0;pilih.value=id;el("tombolKategori").querySelectorAll("button").forEach(b=>b.classList.toggle("aktif",b.dataset.kategori===id));hasil()}
async function buka(a){if(!a)return;el("judulDialog").textContent=a.nama;el("kelompokDialog").textContent=a.kelompok;el("uraianDialog").textContent=a.deskripsi;el("alamatDialog").textContent="Berkas: berkas_sistem/"+a.kategori+"/"+a.berkas;el("isiDialog").textContent="Membaca manifes…";el("statusDialog").textContent="Status: konfigurasi katalog";el("lapisan").classList.add("buka");try{const data=await window.IntiRuntimeVM.bacaManifes(a);el("isiDialog").textContent=JSON.stringify(data,null,2);el("statusDialog").textContent="Manifes berhasil dibaca. Modul tercatat di katalog; eksekusi fitur khusus memerlukan pengembangan lanjutan."}catch(e){el("isiDialog").textContent="Manifes belum dapat dibaca.";el("statusDialog").textContent=e.message}}
kategori.forEach(k=>{const o=document.createElement("option");o.value=k.id;o.textContent=k.nama;pilih.appendChild(o);const b=document.createElement("button");b.textContent=k.nama;b.dataset.kategori=k.id;b.addEventListener("click",()=>setKategori(k.id));el("tombolKategori").appendChild(b)});const semua=document.createElement("button");semua.textContent="Semua";semua.dataset.kategori="";semua.className="aktif";semua.addEventListener("click",()=>setKategori(""));el("tombolKategori").prepend(semua);masukan.addEventListener("input",()=>{halaman=0;hasil()});pilih.addEventListener("change",()=>setKategori(pilih.value));el("sebelumnya").addEventListener("click",()=>{halaman=Math.max(0,halaman-1);hasil()});el("berikutnya").addEventListener("click",()=>{halaman++;hasil()});el("tutup").addEventListener("click",()=>el("lapisan").classList.remove("buka"));el("lapisan").addEventListener("click",e=>{if(e.target===el("lapisan"))el("lapisan").classList.remove("buka")});document.addEventListener("keydown",e=>{if(e.key==="Escape")el("lapisan").classList.remove("buka")});el("status").textContent="● "+daftar.length.toLocaleString("id-ID")+" manifes terdaftar";hasil();
})();
</script></body></html>
