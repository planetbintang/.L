const grid=document.getElementById('feature-grid'), search=document.getElementById('feature-search'), filters=document.getElementById('category-filters'), count=document.getElementById('result-count');
let active='SEMUA';
const categories=['SEMUA',...new Set(FEATURES.map(f=>f.category))];
categories.forEach(c=>{const b=document.createElement('button');b.type='button';b.textContent=c;b.className='filter'+(c===active?' active':'');b.addEventListener('click',()=>{active=c;renderFilters();render();});filters.append(b);});
function renderFilters(){[...filters.children].forEach(b=>{b.classList.toggle('active',b.textContent===active);b.setAttribute('aria-pressed',String(b.textContent===active));});}
function render(){
 const q=search.value.trim().toLowerCase();
 const rows=FEATURES.filter(f=>(active==='SEMUA'||f.category===active)&&[f.name,f.category,...f.subfeatures].join(' ').toLowerCase().includes(q));
 grid.replaceChildren();count.textContent=rows.length+' dari 150 fitur';
 rows.forEach(f=>{
  const article=document.createElement('article');article.className='feature-card';
  const top=document.createElement('div');top.className='card-top';
  const id=document.createElement('span');id.className='feature-id';id.textContent='PB-'+f.id;
  const cat=document.createElement('span');cat.className='category';cat.textContent=f.category;
  top.append(id,cat);
  const h=document.createElement('h3');h.textContent=f.name;
  const ol=document.createElement('ol');
  f.subfeatures.forEach(s=>{const li=document.createElement('li');li.textContent=s;ol.append(li);});
  const details=document.createElement('details');const summary=document.createElement('summary');summary.textContent='Lihat 6 subfitur';details.append(summary,ol);
  article.append(top,h,details);grid.append(article);
 });
 if(!rows.length){const p=document.createElement('p');p.className='empty';p.textContent='Tidak ada fitur yang cocok.';grid.append(p);}
}
search.addEventListener('input',render);renderFilters();render();
</script>