/* REICG — visual system untuk pustaka desain PlanetBintang */
:root{color-scheme:dark;--bg:#101216;--panel:#191d23;--panel2:#202630;--line:#3a424d;--text:#f3f5f7;--muted:#aab3bf;--accent:#d6e4f5;--radius:3px}
*{box-sizing:border-box}
.media-design{min-height:100vh;padding:clamp(18px,4vw,56px);background:radial-gradient(ellipse at 80% 0%,#263342 0,transparent 42%),var(--bg);color:var(--text);font:14px/1.55 Inter,ui-sans-serif,system-ui,sans-serif}
.hero{max-width:1200px;margin:0 auto 34px;padding:clamp(22px,4vw,48px);border:1px solid var(--line);background:linear-gradient(135deg,#1d242d,#15191f);box-shadow:0 18px 55px #0005}
.eyebrow,.category,.feature-id,.stats span,.catalog-head,footer{letter-spacing:.12em;text-transform:uppercase}
.eyebrow{color:var(--accent);font-size:11px;font-weight:800}
h1{font-size:clamp(28px,5vw,54px);line-height:1.04;letter-spacing:-.045em;margin:14px 0}
.lead{color:var(--muted);max-width:650px}
.stats{display:flex;align-items:baseline;gap:10px 14px;flex-wrap:wrap;margin:28px 0}
.stats strong{font-size:25px}.stats span{font-size:10px;color:var(--muted);margin-right:12px}
.search{display:flex;gap:12px;align-items:center;max-width:620px;padding:12px 15px;border:1px solid var(--line);background:#0e1116}
.search input{width:100%;border:0;outline:0;background:transparent;color:var(--text);font:inherit}
.filters{display:flex;gap:8px;overflow:auto;padding:18px 0 2px}
.filter{flex:0 0 auto;border:1px solid var(--line);border-radius:var(--radius);padding:8px 11px;background:transparent;color:var(--muted);font:700 10px/1.3 inherit;cursor:pointer}
.filter:hover,.filter.active{background:var(--accent);border-color:var(--accent);color:#121820}
.catalog-head{max-width:1200px;margin:0 auto 14px;display:flex;justify-content:space-between;align-items:center;font-size:11px}
.catalog-head h2{font-size:12px}.catalog-head output{color:var(--muted)}
.feature-grid{max-width:1200px;margin:auto;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.feature-card{min-width:0;padding:18px;border:1px solid var(--line);background:linear-gradient(145deg,var(--panel2),var(--panel));transition:transform .18s,border-color .18s}
.feature-card:hover{transform:translateY(-2px);border-color:#8999aa}
.card-top{display:flex;justify-content:space-between;gap:10px;align-items:center}
.feature-id{font-size:10px;color:var(--accent);font-weight:800}.category{font-size:9px;color:var(--muted);text-align:right}
.feature-card h3{font-size:17px;margin:16px 0 12px}
details{border-top:1px solid var(--line);padding-top:10px}summary{cursor:pointer;color:var(--accent);font-size:12px;font-weight:700}
ol{padding-left:20px;color:var(--muted);font-size:12px}li{padding:4px 0 4px 3px}
.empty{grid-column:1/-1;padding:30px;border:1px solid var(--line);color:var(--muted)}
footer{max-width:1200px;margin:36px auto 0;padding-top:16px;border-top:1px solid var(--line);font-size:10px;color:var(--muted)}
@media(max-width:900px){.feature-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:580px){.media-design{padding:12px}.hero{padding:20px 15px}.feature-grid{grid-template-columns:1fr}.category{max-width:55%;}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition:none!important}}
