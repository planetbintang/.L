<!doctype html>
<reic-app id="planetbintang-reic-core" lang="id" data-reic-version="2.0.0">
  <reic-config theme="ocean-elite" runtime="./reic-core.reicjs"></reic-config>
  <reic-layer name="foundation" order="01"></reic-layer>
  <reic-layer name="design-system" order="02"></reic-layer>
  <reic-layer name="components" order="03"></reic-layer>
  <reic-layer name="application" order="04"></reic-layer>
  <reic-layer name="integration" order="05"></reic-layer>
  <reic-layer name="observability" order="06"></reic-layer>
</reic-app>
