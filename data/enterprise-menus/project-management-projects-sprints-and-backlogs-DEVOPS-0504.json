  "sql": [
   "CREATE TABLE IF NOT EXISTS feat_project_management_projects_sprints_and_backlogs (id BIGINT PRIMARY KEY, payload JSONB, updated_at TIMESTAMPTZ DEFAULT now());",
   "CREATE INDEX IF NOT EXISTS idx_project_management_projects_sprints_and_backlogs_ts ON feat_project_management_projects_sprints_and_backlogs (updated_at DESC);",
   "INSERT INTO feat_project_management_projects_sprints_and_backlogs (id, payload) VALUES (505, '{\"menu_code\":\"DEVOPS-0504\"}') ON CONFLICT DO NOTHING;",
   "BEGIN; UPDATE system_menus SET is_active = TRUE WHERE id = 505; COMMIT;",
   "SELECT count(*) FROM feat_project_management_projects_sprints_and_backlogs WHERE updated_at > now() - interval '1 hour';",
   "DELETE FROM feat_project_management_projects_sprints_and_backlogs_staging WHERE created_at < now() - interval '55 days';",
   "GRANT SELECT ON feat_project_management_projects_sprints_and_backlogs TO role_viewer;",
   "GRANT USAGE, SELECT ON SEQUENCE seq_project_management_projects_sprints_and_backlogs TO role_worker;",
   "COPY feat_project_management_projects_sprints_and_backlogs TO STDOUT WITH (FORMAT csv, HEADER true);",
   "EXPLAIN ANALYZE SELECT * FROM feat_project_management_projects_sprints_and_backlogs ORDER BY updated_at DESC LIMIT 100;",
   "ALTER TABLE feat_project_management_projects_sprints_and_backlogs ADD COLUMN IF NOT EXISTS drift_flag BOOLEAN DEFAULT FALSE;",
   "VACUUM ANALYZE feat_project_management_projects_sprints_and_backlogs;"
  ],
