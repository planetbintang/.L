  "sql": [
   "CREATE TABLE IF NOT EXISTS feat_artifacts_packages_container_registry (id BIGINT PRIMARY KEY, payload JSONB, updated_at TIMESTAMPTZ DEFAULT now());",
   "CREATE INDEX IF NOT EXISTS idx_artifacts_packages_container_registry_ts ON feat_artifacts_packages_container_registry (updated_at DESC);",
   "INSERT INTO feat_artifacts_packages_container_registry (id, payload) VALUES (2001, '{\"menu_code\":\"DEVOPS-2000\"}') ON CONFLICT DO NOTHING;",
   "BEGIN; UPDATE system_menus SET is_active = TRUE WHERE id = 2001; COMMIT;",
   "SELECT count(*) FROM feat_artifacts_packages_container_registry WHERE updated_at > now() - interval '1 hour';",
   "DELETE FROM feat_artifacts_packages_container_registry_staging WHERE created_at < now() - interval '51 days';",
   "GRANT SELECT ON feat_artifacts_packages_container_registry TO role_viewer;",
   "GRANT USAGE, SELECT ON SEQUENCE seq_artifacts_packages_container_registry TO role_worker;",
   "COPY feat_artifacts_packages_container_registry TO STDOUT WITH (FORMAT csv, HEADER true);",
   "EXPLAIN ANALYZE SELECT * FROM feat_artifacts_packages_container_registry ORDER BY updated_at DESC LIMIT 100;",
   "ALTER TABLE feat_artifacts_packages_container_registry ADD COLUMN IF NOT EXISTS drift_flag BOOLEAN DEFAULT FALSE;",
   "VACUUM ANALYZE feat_artifacts_packages_container_registry;"
