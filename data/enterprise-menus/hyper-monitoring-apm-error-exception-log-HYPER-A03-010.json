   "GRANT USAGE, SELECT ON SEQUENCE seq_hyper_monitoring_apm_error_exception_log TO role_worker;",
   "COPY feat_hyper_monitoring_apm_error_exception_log TO STDOUT WITH (FORMAT csv, HEADER true);",
   "EXPLAIN ANALYZE SELECT * FROM feat_hyper_monitoring_apm_error_exception_log ORDER BY updated_at DESC LIMIT 100;",
