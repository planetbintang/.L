   "SELECT count(*) FROM feat_hyper_monitoring_apm_error_exception_log WHERE updated_at > now() - interval '1 hour';",
   "DELETE FROM feat_hyper_monitoring_apm_error_exception_log_staging WHERE created_at < now() - interval '40 days';",
