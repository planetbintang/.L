   "INSERT INTO feat_data_storage_storage_s3_compatible_buckets (id, payload) VALUES (8501, '{\"menu_code\":\"HYPER-A08-001\"}') ON CONFLICT DO NOTHING;",
   "BEGIN; UPDATE system_menus SET is_active = TRUE WHERE id = 8501; COMMIT;",
   "SELECT count(*) FROM feat_data_storage_storage_s3_compatible_buckets WHERE updated_at > now() - interval '1 hour';",
   "DELETE FROM feat_data_storage_storage_s3_compatible_buckets_staging WHERE created_at < now() - interval '71 days';",
   "GRANT SELECT ON feat_data_storage_storage_s3_compatible_buckets TO role_viewer;",
   "GRANT USAGE, SELECT ON SEQUENCE seq_data_storage_storage_s3_compatible_buckets TO role_worker;",
   "COPY feat_data_storage_storage_s3_compatible_buckets TO STDOUT WITH (FORMAT csv, HEADER true);",
   "EXPLAIN ANALYZE SELECT * FROM feat_data_storage_storage_s3_compatible_buckets ORDER BY updated_at DESC LIMIT 100;",
   "ALTER TABLE feat_data_storage_storage_s3_compatible_buckets ADD COLUMN IF NOT EXISTS drift_flag BOOLEAN DEFAULT FALSE;",
   "VACUUM ANALYZE feat_data_storage_storage_s3_compatible_buckets;"
