  "sql": [
   "CREATE TABLE IF NOT EXISTS feat_data_storage_storage_lifecycle_policies (id BIGINT PRIMARY KEY, payload JSONB, updated_at TIMESTAMPTZ DEFAULT now());",
   "CREATE INDEX IF NOT EXISTS idx_data_storage_storage_lifecycle_policies_ts ON feat_data_storage_storage_lifecycle_policies (updated_at DESC);",
   "INSERT INTO feat_data_storage_storage_lifecycle_policies (id, payload) VALUES (8502, '{\"menu_code\":\"HYPER-A08-002\"}') ON CONFLICT DO NOTHING;",
   "BEGIN; UPDATE system_menus SET is_active = TRUE WHERE id = 8502; COMMIT;",
   "SELECT count(*) FROM feat_data_storage_storage_lifecycle_policies WHERE updated_at > now() - interval '1 hour';",
   "DELETE FROM feat_data_storage_storage_lifecycle_policies_staging WHERE created_at < now() - interval '72 days';",
   "GRANT SELECT ON feat_data_storage_storage_lifecycle_policies TO role_viewer;",
   "GRANT USAGE, SELECT ON SEQUENCE seq_data_storage_storage_lifecycle_policies TO role_worker;",
   "COPY feat_data_storage_storage_lifecycle_policies TO STDOUT WITH (FORMAT csv, HEADER true);",
   "EXPLAIN ANALYZE SELECT * FROM feat_data_storage_storage_lifecycle_policies ORDER BY updated_at DESC LIMIT 100;",
   "ALTER TABLE feat_data_storage_storage_lifecycle_policies ADD COLUMN IF NOT EXISTS drift_flag BOOLEAN DEFAULT FALSE;",
   "VACUUM ANALYZE feat_data_storage_storage_lifecycle_policies;"
