  "sql": [
   "CREATE TABLE IF NOT EXISTS feat_billing_quotas_compute_minutes (id BIGINT PRIMARY KEY, payload JSONB, updated_at TIMESTAMPTZ DEFAULT now());",
   "CREATE INDEX IF NOT EXISTS idx_billing_quotas_compute_minutes_ts ON feat_billing_quotas_compute_minutes (updated_at DESC);",
   "INSERT INTO feat_billing_quotas_compute_minutes (id, payload) VALUES (4504, '{\"menu_code\":\"DEVOPS-4503\"}') ON CONFLICT DO NOTHING;",
   "BEGIN; UPDATE system_menus SET is_active = TRUE WHERE id = 4504; COMMIT;",
   "SELECT count(*) FROM feat_billing_quotas_compute_minutes WHERE updated_at > now() - interval '1 hour';",
   "DELETE FROM feat_billing_quotas_compute_minutes_staging WHERE created_at < now() - interval '34 days';",
   "GRANT SELECT ON feat_billing_quotas_compute_minutes TO role_viewer;",
   "GRANT USAGE, SELECT ON SEQUENCE seq_billing_quotas_compute_minutes TO role_worker;",
   "COPY feat_billing_quotas_compute_minutes TO STDOUT WITH (FORMAT csv, HEADER true);",
   "EXPLAIN ANALYZE SELECT * FROM feat_billing_quotas_compute_minutes ORDER BY updated_at DESC LIMIT 100;",
   "ALTER TABLE feat_billing_quotas_compute_minutes ADD COLUMN IF NOT EXISTS drift_flag BOOLEAN DEFAULT FALSE;",
   "VACUUM ANALYZE feat_billing_quotas_compute_minutes;"
  ],
