  "sql": [
   "CREATE TABLE IF NOT EXISTS feat_data_storage_audit_log_streaming (id BIGINT PRIMARY KEY, payload JSONB, updated_at TIMESTAMPTZ DEFAULT now());",
   "CREATE INDEX IF NOT EXISTS idx_data_storage_audit_log_streaming_ts ON feat_data_storage_audit_log_streaming (updated_at DESC);",
   "INSERT INTO feat_data_storage_audit_log_streaming (id, payload) VALUES (8504, '{\"menu_code\":\"HYPER-A08-004\"}') ON CONFLICT DO NOTHING;",
   "BEGIN; UPDATE system_menus SET is_active = TRUE WHERE id = 8504; COMMIT;",
   "SELECT count(*) FROM feat_data_storage_audit_log_streaming WHERE updated_at > now() - interval '1 hour';",
   "DELETE FROM feat_data_storage_audit_log_streaming_staging WHERE created_at < now() - interval '74 days';",
   "GRANT SELECT ON feat_data_storage_audit_log_streaming TO role_viewer;",
   "GRANT USAGE, SELECT ON SEQUENCE seq_data_storage_audit_log_streaming TO role_worker;",
   "COPY feat_data_storage_audit_log_streaming TO STDOUT WITH (FORMAT csv, HEADER true);",
   "EXPLAIN ANALYZE SELECT * FROM feat_data_storage_audit_log_streaming ORDER BY updated_at DESC LIMIT 100;",
   "ALTER TABLE feat_data_storage_audit_log_streaming ADD COLUMN IF NOT EXISTS drift_flag BOOLEAN DEFAULT FALSE;",
   "VACUUM ANALYZE feat_data_storage_audit_log_streaming;"
  ],
