# Copy to .env on the PlanetBintang server. Never commit real secrets.
PORT=8787
HOST=127.0.0.1
DATABASE_URL=postgresql://galeri_app:CHANGE_ME@127.0.0.1:5432/planetbintang
SESSION_TTL_HOURS=168
COOKIE_SECURE=true
GALERI_STORAGE_DIR=/srv/planetbintang/galeri-data
MAX_UPLOAD_BYTES=52428800
ALLOWED_ORIGINS=https://planetbintang.github.io
