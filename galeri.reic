<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#0d5cf2">
<title>Galeri · Planetbintang .L</title>
<style>
:root{color-scheme:dark;--bg:#07152f;--panel:#10264b;--line:#294b7a;--text:#f2f7ff;--muted:#a9c1e4;--accent:#1da9ff;--header-bg:linear-gradient(110deg,#07152f 0%,#102d5c 48%,#10264b 100%)}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at top,#123c80,var(--bg) 65%);color:var(--text);font:15px/1.55 system-ui,sans-serif;min-height:100vh}
header{padding:16px clamp(16px,4vw,44px);border-bottom:1px solid #3985c866;background:var(--header-bg);background-color:#081b39;box-shadow:0 12px 32px #02081766;position:sticky;top:0;backdrop-filter:blur(18px) saturate(145%);-webkit-backdrop-filter:blur(18px) saturate(145%);z-index:1000;isolation:isolate}header:after{content:"";position:absolute;left:clamp(16px,4vw,44px);right:clamp(16px,4vw,44px);bottom:0;height:1px;background:linear-gradient(90deg,transparent,#45b8ffb3,transparent);pointer-events:none}.top{position:relative;z-index:1}.top strong{letter-spacing:.1em;font-size:clamp(11px,1.2vw,14px);color:#f4f9ff}.top a.back{display:inline-flex;align-items:center;gap:8px;padding:9px 12px;border:1px solid #6ba8ef55;border-radius:10px;background:#0d2850a8;color:#d8edff;transition:background .18s ease,border-color .18s ease}.top a.back:hover{background:#174077;border-color:#54b5ff}
.top{max-width:1400px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}a,button{color:inherit}a.back{color:#b7dfff;text-decoration:none}
main{position:relative;z-index:0;max-width:1400px;margin:0 auto;padding:clamp(20px,3vw,40px)}main>*{scroll-margin-top:100px}h1{font-size:clamp(28px,4vw,46px);margin:5px 0}.muted{color:var(--muted)}.toolbar{display:flex;gap:10px;flex-wrap:wrap;margin:22px 0}
button,.file-label,input[type=search]{font:inherit;border:1px solid var(--line);border-radius:12px;padding:11px 15px;background:#10264b;color:var(--text)}button,.file-label{cursor:pointer}.primary{background:#0968ed;border-color:#4da2ff}.file-label input{display:none}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:16px}.card{overflow:hidden;border:1px solid var(--line);border-radius:18px;background:linear-gradient(160deg,#132f5b,#091a36);box-shadow:0 14px 38px #0003}.card img{width:100%;height:250px;object-fit:contain;background:#f8faff;display:block}.card .info{padding:13px 15px}.card h2{font-size:16px;margin:0 0 4px}.card p{margin:0;color:var(--muted);font-size:13px;overflow-wrap:anywhere}
.empty{padding:28px;border:1px dashed #5278ac;border-radius:16px;background:#0c2142;margin-top:16px}.status{min-height:1.5em;color:#b8e5ff}.hint{font-size:13px;color:var(--muted);margin-top:14px}
</style></head>
<body>
<header><div class="top"><a class="back" href="./">← Kembali ke Planetbintang .L</a><strong>PLANETBINTANG · GALERI</strong></div></header>
<main>
<p class="muted">GALERI MEDIA · LOGO · IDENTITAS · DESAIN SISTEM</p><h1>Galeri Gambar</h1>
<p class="muted">Ruang visual untuk logo, konsep identitas, papan alfabet, dan referensi antarmuka Planetbintang. Gambar dari folder galeri/ repositori GitHub tampil otomatis, serta Anda dapat menambahkan gambar lokal pada browser ini.</p>
<div class="toolbar"><label class="file-label primary">＋ Tambahkan gambar<input id="fileInput" type="file" accept="image/*" multiple></label><input id="search" type="search" placeholder="Cari gambar…" aria-label="Cari gambar"><button id="clearLocal" type="button">Hapus gambar lokal</button></div>
<p class="status" id="status" role="status" aria-live="polite"></p><section id="grid" class="grid" aria-label="Koleksi gambar"></section>
<section class="empty" id="empty"><strong>Tidak ada gambar yang cocok</strong><p class="muted">Coba kata kunci lain atau tambahkan gambar dari perangkat.</p></section>
<p class="hint">Gambar repositori dimuat dari GitHub dan tersedia bagi pengunjung situs. Gambar yang diimpor dari perangkat tetap tersimpan secara lokal pada browser.</p>
</main>
<script>
const KEY='pb-dotl-gallery-v1';const grid=document.querySelector('#grid'),empty=document.querySelector('#empty'),status=document.querySelector('#status'),search=document.querySelector('#search');
let items=[];try{items=JSON.parse(localStorage.getItem(KEY)||'[]')}catch{}
let repoItems=[{name:"1782911782.png",src:"https://raw.githubusercontent.com/planetbintang/.L/io/galeri/1782911782.png",size:"Berkas repositori GitHub"},{name:"1782912612.png",src:"https://raw.githubusercontent.com/planetbintang/.L/io/galeri/1782912612.png",size:"Berkas repositori GitHub"},{name:"1783464948.png",src:"https://raw.githubusercontent.com/planetbintang/.L/io/galeri/1783464948.png",size:"Berkas repositori GitHub"},{name:"1783464953.png",src:"https://raw.githubusercontent.com/planetbintang/.L/io/galeri/1783464953.png",size:"Berkas repositori GitHub"},{name:"1792841119.png",src:"https://raw.githubusercontent.com/planetbintang/.L/io/galeri/1792841119.png",size:"Berkas repositori GitHub"},{name:"2608260135124.jpg",src:"https://raw.githubusercontent.com/planetbintang/.L/io/galeri/2608260135124.jpg",size:"Berkas repositori GitHub"},{name:"2610142012197.jpg",src:"https://raw.githubusercontent.com/planetbintang/.L/io/galeri/2610142012197.jpg",size:"Berkas repositori GitHub"},{name:"2610161533016.jpg",src:"https://raw.githubusercontent.com/planetbintang/.L/io/galeri/2610161533016.jpg",size:"Berkas repositori GitHub"},{name:"2610161643214.jpg",src:"https://raw.githubusercontent.com/planetbintang/.L/io/galeri/2610161643214.jpg",size:"Berkas repositori GitHub"},{name:"2610221551221.jpg",src:"https://raw.githubusercontent.com/planetbintang/.L/io/galeri/2610221551221.jpg",size:"Berkas repositori GitHub"},{name:"2610231227446.jpg",src:"https://raw.githubusercontent.com/planetbintang/.L/io/galeri/2610231227446.jpg",size:"Berkas repositori GitHub"},{name:"2610271451244.jpg",src:"https://raw.githubusercontent.com/planetbintang/.L/io/galeri/2610271451244.jpg",size:"Berkas repositori GitHub"},{name:"2610271456346.jpg",src:"https://raw.githubusercontent.com/planetbintang/.L/io/galeri/2610271456346.jpg",size:"Berkas repositori GitHub"}];
async function syncRepoGallery(){try{const response=await fetch('https://api.github.com/repos/planetbintang/.L/contents/galeri?ref=io',{headers:{Accept:'application/vnd.github+json'}});if(!response.ok)throw new Error('GitHub API '+response.status);const files=await response.json();if(!Array.isArray(files))throw new Error('Daftar berkas tidak valid');const images=files.filter(f=>f.type==='file'&&/\\.(png|jpe?g|gif|webp|avif|svg)$/i.test(f.name)).sort((a,b)=>a.name.localeCompare(b.name,undefined,{numeric:true}));if(images.length){repoItems=images.map(f=>({name:f.name,src:f.download_url||'https://raw.githubusercontent.com/planetbintang/.L/io/galeri/'+encodeURIComponent(f.name),size:'Berkas repositori GitHub'}));status.textContent='Daftar galeri berhasil disinkronkan dari GitHub.'}else{status.textContent='Folder galeri GitHub tidak memiliki gambar yang didukung; memakai daftar cadangan.'}}catch(error){status.textContent='Tidak dapat menyegarkan daftar GitHub saat ini; memakai daftar gambar cadangan.'}render()}
function render(){grid.replaceChildren();const q=search.value.trim().toLowerCase();const all=[...repoItems,...items.map(x=>({...x,src:x.data,local:true}))];const shown=all.filter(x=>x.name.toLowerCase().includes(q));shown.forEach(item=>{const card=document.createElement('article');card.className='card';const img=document.createElement('img');img.src=item.src;img.alt=item.name;img.loading='lazy';img.onerror=()=>{img.alt='Gambar tidak dapat dimuat: '+item.name;img.style.objectFit='contain';};const info=document.createElement('div');info.className='info';const title=document.createElement('h2');title.textContent=item.name;const desc=document.createElement('p');desc.textContent=item.size||(item.local?'Gambar lokal':'Gambar repositori GitHub');const link=document.createElement('a');link.href=item.local?item.src:'https://github.com/planetbintang/.L/blob/io/galeri/'+encodeURIComponent(item.name);link.target='_blank';link.rel='noopener noreferrer';link.textContent='Lihat berkas ↗';link.style.cssText='display:inline-block;margin-top:8px;color:#8fd4ff;font-size:13px';info.append(title,desc,link);card.append(img,info);grid.append(card)});empty.hidden=shown.length>0;status.textContent=shown.length+' gambar ditampilkan ('+repoItems.length+' dari repositori, '+items.length+' lokal).';}
document.querySelector('#fileInput').addEventListener('change',async e=>{const files=[...e.target.files].filter(f=>f.type.startsWith('image/'));if(!files.length)return;let added=0;for(const file of files){if(file.size>2*1024*1024){status.textContent=file.name+' melebihi 2 MB; lewati file ini.';continue}const data=await new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>resolve(r.result);r.onerror=reject;r.readAsDataURL(file)});items.unshift({name:file.name,data,size:Math.round(file.size/1024)+' KB'});added++}try{localStorage.setItem(KEY,JSON.stringify(items));status.textContent=added+' gambar ditambahkan.'}catch{status.textContent='Penyimpanan browser penuh. Hapus sebagian gambar lalu coba lagi.'}render();e.target.value=''});
search.addEventListener('input',render);document.querySelector('#clearLocal').addEventListener('click',()=>{if(!confirm('Hapus semua gambar yang disimpan lokal pada browser ini?'))return;items=[];localStorage.removeItem(KEY);render()});render();syncRepoGallery();
</script></body></html>