
/* Runtime windows: every app and modal is clipped to the desktop-stage boundary. */
.desktop-stage{position:relative;isolation:isolate;min-width:0;min-height:0}
#apps{position:absolute!important;inset:0!important;z-index:8!important;overflow:hidden!important;pointer-events:none!important;contain:layout paint}
.reic-app-window{position:absolute;display:flex;flex-direction:column;min-width:260px;max-width:calc(100% - 16px);min-height:180px;max-height:calc(100% - 16px);overflow:hidden;pointer-events:auto;background:linear-gradient(145deg,rgba(5,24,66,.99),rgba(2,11,37,.99));border:1px solid #22aaff;box-shadow:0 12px 36px #000b,0 0 22px #078cff66;color:#f4f9ff}
.reic-app-title{height:40px;flex:0 0 40px;display:flex;align-items:center;justify-content:space-between;padding:0 10px 0 14px;background:linear-gradient(90deg,#07132e,#0b3c84);border-bottom:1px solid #168fff;cursor:move;touch-action:none}
.reic-app-title strong{font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.reic-app-title strong span{margin-right:7px}
.reic-app-title button{width:27px;height:25px;margin-left:4px;background:#0b4b9a;border:1px solid #4aaeff;color:#fff;cursor:pointer}
.reic-app-content{padding:clamp(12px,2vw,22px);overflow:auto;min-height:0;flex:1;overscroll-behavior:contain}
.reic-app-window.is-maximized{min-width:0;min-height:0}
.reic-restore-chip{position:absolute;left:8px;bottom:8px;max-width:45%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;pointer-events:auto;background:#052b65;border:1px solid #35baff;color:white;padding:6px 10px}
.reic-eyebrow{font-size:10px;letter-spacing:.18em;color:#7fdcff;font-weight:800}
.reic-dashboard h2,.reic-github h2,.reic-settings h2,.reic-monitor h2,.reic-library h2{font-size:clamp(18px,2.3vw,27px);margin:10px 0;color:#fff}
.reic-dashboard p,.reic-github p,.reic-library p,.reic-note{color:#a8c9ed;font-size:12px;line-height:1.6}
.reic-stat-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin:18px 0}
.reic-stat-grid article{padding:13px;border:1px solid #235a91;background:#09264e;min-width:0}
.reic-stat-grid b{display:block;font-size:clamp(15px,2vw,22px);color:#83dcff;overflow-wrap:anywhere}
.reic-stat-grid span{display:block;margin-top:5px;font-size:10px;color:#c2d9f4}
.reic-action-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(125px,1fr));gap:8px;margin-top:16px}
.reic-action-grid button,.reic-toolbar button{min-height:42px;padding:9px 12px;text-align:left;background:#0c3670;border:1px solid #287bc0;color:#f2f9ff;cursor:pointer}
.reic-action-grid button:hover,.reic-toolbar button:hover{background:#1054a1;border-color:#74d9ff}
.reic-toolbar{display:flex;flex-wrap:wrap;gap:7px;margin:14px 0}
.reic-toolbar input{flex:1;min-width:130px;padding:10px;background:#041630;border:1px solid #32618b;color:#fff}
.reic-toolbar a,.reic-browser a{display:inline-flex;align-items:center;padding:10px;background:#082b5a;border:1px solid #286ca8;color:#bfeeff;text-decoration:none;font-size:11px}
[data-repo-status]{padding:9px 0;color:#86dfff;font-size:11px}
.reic-repo-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:8px;overflow:auto}
.reic-repo-card{min-width:0;padding:12px;background:#071d3d;border:1px solid #1c548a}
.reic-repo-card>a{color:#8cdeff;font-weight:800;text-decoration:none;overflow-wrap:anywhere}
.reic-repo-card small{display:block;color:#8ba9c8;margin-top:5px}
.reic-repo-card p{min-height:30px;margin:8px 0;color:#c4d6ec}
.reic-repo-actions{display:flex;flex-wrap:wrap;gap:6px}
.reic-repo-actions button,.reic-repo-actions a,.reic-tree-head button{padding:7px 9px;background:#0b3976;border:1px solid #347bb8;color:white;text-decoration:none;font-size:10px;cursor:pointer}
.reic-tree-head{grid-column:1/-1;display:flex;flex-wrap:wrap;align-items:center;gap:10px;padding:8px;background:#092b5a}
.reic-tree-head strong{font-size:11px;overflow-wrap:anywhere}
.reic-tree-row{padding:7px 10px;background:#071e42;border-bottom:1px solid #173c65}
.reic-tree-row button{width:100%;text-align:left;background:transparent;border:0;color:#d9f0ff;cursor:pointer}
.reic-error{padding:12px;background:#4c1727;color:#ffdce4;border:1px solid #b64a65}
.reic-setting{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:13px 0;border-bottom:1px solid #25496c;color:#dceeff;font-size:12px}
.reic-setting select{background:#071b39;border:1px solid #3b77a5;color:#fff;padding:8px}
.reic-terminal{font:12px/1.7 ui-monospace,monospace}
.terminal-output{min-height:150px;margin:12px 0;padding:12px;background:#010b1d;border:1px solid #1c548a;color:#8fe5b5;white-space:pre-wrap;overflow-wrap:anywhere}
[data-terminal-form]{display:flex;flex-wrap:wrap;gap:7px;align-items:center;color:#79dfff}
[data-terminal-input]{flex:1;min-width:110px;padding:9px;background:#010b1d;border:1px solid #287bc0;color:#fff}
[data-terminal-form] button{padding:9px 13px;background:#0b4d93;border:1px solid #46baff;color:#fff}
.reic-browser{display:grid;gap:10px}
.reic-no-motion *{animation:none!important;transition:none!important}
.reic-no-glow .reic-app-window{box-shadow:0 8px 24px #0009}
#items.list-mode{display:flex;flex-direction:column;gap:2px}
#items.list-mode button{min-height:36px;flex-direction:row;justify-content:flex-start;padding:5px 12px}
.file-window-max{position:absolute!important;inset:4px!important;width:auto!important;height:auto!important;z-index:6}
@media(max-width:600px){.reic-app-window{min-width:0}.reic-stat-grid{grid-template-columns:1fr 1fr}.reic-stat-grid article:last-child{grid-column:1/-1}.reic-app-content{padding:11px}.reic-repo-list{grid-template-columns:1fr}.reic-app-title{height:36px;flex-basis:36px}.reic-app-title button{width:25px;height:24px}}


/* Interaction and responsive layout refinement */
.system-bar{min-width:0;overflow:hidden}
.system-links{display:flex;align-items:center;justify-content:center;gap:clamp(2px,.45vw,7px);flex:1;min-width:0;overflow:hidden}
.system-links button{flex:0 1 auto;min-width:0;min-height:30px;padding:3px clamp(3px,.55vw,8px);border:0;border-right:1px solid rgba(137,205,255,.5);background:transparent;color:#f1f7ff;font-size:clamp(7px,.85vw,11px);font-weight:800;white-space:nowrap;cursor:pointer}
.system-links button:hover,.system-links button:focus-visible{background:#0758a8;color:#fff;outline:1px solid #61caff}
.launcher button{min-height:48px;max-width:100%;border:1px solid rgba(70,174,255,.55);border-radius:7px;background:linear-gradient(145deg,rgba(16,105,206,.92),rgba(2,24,71,.96));box-shadow:inset 0 1px 0 #b5eaff55,0 3px 12px #001a4d;color:#fff;transition:transform .15s ease,filter .15s ease}
.launcher button:hover,.launcher button:focus-visible{transform:translateY(-2px);filter:brightness(1.2);outline:2px solid #83dcff;outline-offset:1px}
.launcher small{padding:1px 2px}
.window{min-width:0;min-height:0;height:min(86%,560px);max-height:100%;display:flex;flex-direction:column}
.file-layout{min-height:0;flex:1}
.file-nav button,.file-toolbar button,#items button,.window-title button{min-height:36px}
.file-nav button:focus-visible,.file-toolbar button:focus-visible,#items button:focus-visible,.window-title button:focus-visible{outline:2px solid #078cff;outline-offset:1px}
#items button{padding:6px 3px}
#apps{position:absolute!important;inset:0!important;z-index:8!important;overflow:hidden!important;pointer-events:none!important;contain:layout paint}
.reic-app-window{width:min(760px,calc(100% - 20px));min-width:0;min-height:0;max-height:calc(100% - 16px);border-radius:9px}
.reic-app-title button{min-width:32px;min-height:30px;border-radius:4px;font-size:16px}
.reic-app-content{min-width:0;max-width:100%;overflow:auto;scrollbar-gutter:stable}
.reic-app-content button,.reic-app-content a,.reic-app-content input,.reic-app-content select{max-width:100%}
.reic-action-grid button,.reic-toolbar button,.reic-repo-actions button,.reic-tree-head button{min-height:44px;border-radius:5px}
.reic-repo-list{min-width:0;max-height:calc(100% - 110px);overflow:auto;overscroll-behavior:contain}
.reic-repo-card{overflow-wrap:anywhere}
.reic-module-detail h2{font-size:clamp(18px,3vw,26px);margin:10px 0;color:#fff}
.reic-module-detail p{color:#c3dafa;font-size:13px;line-height:1.65}
.reic-setting input[type=checkbox]{width:22px;height:22px;accent-color:#159bff}
.reic-setting select{min-height:40px}
.reic-app-window a:focus-visible,.reic-app-window button:focus-visible,.reic-app-window input:focus-visible,.reic-app-window select:focus-visible{outline:2px solid #8de6ff;outline-offset:2px}
@media(max-width:700px){
 .system-links{justify-content:flex-start;overflow-x:auto;scrollbar-width:none}
 .system-links::-webkit-scrollbar{display:none}
 .system-links button{font-size:7px;min-height:34px;padding:3px 5px}
 .reic-stat-grid{grid-template-columns:1fr 1fr}
 .reic-stat-grid article:last-child{grid-column:1/-1}
 .reic-action-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
 .reic-app-window{max-width:calc(100% - 12px)}
 .reic-app-title{padding:0 6px}
 .reic-app-content{padding:10px}
 .reic-repo-list{grid-template-columns:1fr;max-height:none}
}
@media(max-width:650px) and (orientation:portrait){
 .system-bar{gap:4px}
 .system-links button{font-size:6.5px;padding:2px 4px}
 .launcher button{min-height:43px;padding:3px 0}
 .window{height:86%;width:100%}
 .file-nav button{min-height:34px}
}
@media(max-height:600px) and (orientation:landscape){
 .reic-app-window{max-height:calc(100% - 8px)}
 .reic-app-content{padding:8px}
 .reic-stat-grid{margin:8px 0}
}


/* Final interaction pass: touch targets, keyboard focus, draggable modal chrome. */
.system-links{overflow-x:auto;overflow-y:hidden;scrollbar-width:thin;scrollbar-color:#168dff #031638}
.system-links button{min-height:38px;flex:0 0 auto;border-radius:3px;transition:background .16s ease,color .16s ease,box-shadow .16s ease}
.system-links button:active{background:#0878d8;box-shadow:inset 0 0 0 1px #9ceaff}
.launcher button{min-width:44px;min-height:56px;padding:5px 3px;touch-action:manipulation}
.launcher button:active{transform:scale(.96);background:linear-gradient(145deg,#168eff,#05265f)}
.launcher button:focus-visible,.system-links button:focus-visible{outline:2px solid #a6edff;outline-offset:2px;box-shadow:0 0 0 4px #087dff55}
.reic-app-window{min-width:0;min-height:160px;max-width:calc(100% - 16px);max-height:calc(100% - 16px);overscroll-behavior:contain}
.reic-app-title{user-select:none;-webkit-user-select:none;touch-action:none;cursor:grab}
.reic-app-title:active{cursor:grabbing}
.reic-app-title button{min-width:36px;min-height:34px;touch-action:manipulation}
.reic-app-title button:hover,.reic-app-title button:focus-visible{background:#1475d2;outline:2px solid #8fe4ff;outline-offset:1px}
.reic-app-content{overscroll-behavior:contain;overflow-x:hidden;overflow-y:auto}
.reic-app-content button,.reic-app-content a{touch-action:manipulation}
.reic-restore-chip{position:relative;left:auto;bottom:auto;display:inline-flex;align-items:center;min-height:40px;max-width:48%;margin:6px 0 0 6px;padding:7px 10px;border-radius:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#apps:has(.reic-restore-chip){display:flex;flex-direction:column;align-items:flex-start;justify-content:flex-end;pointer-events:none}
#apps .reic-restore-chip{pointer-events:auto;flex:0 0 auto}
.file-nav button,.file-toolbar button,#items button,.window-title button{touch-action:manipulation}
.file-nav button{min-height:40px}
.file-toolbar button{min-width:36px;min-height:36px}
#items button{min-height:76px}
.reic-action-grid button,.reic-toolbar button,.reic-repo-actions button,.reic-tree-head button{min-height:44px;cursor:pointer;touch-action:manipulation}
.reic-app-window button:focus-visible,.reic-app-window a:focus-visible,.reic-app-window input:focus-visible,.reic-app-window select:focus-visible{outline:2px solid #9ceaff;outline-offset:2px}
@media(max-width:700px){
 .system-links{justify-content:flex-start;gap:2px;padding:0 2px}
 .system-links button{min-height:40px;padding:4px 7px;font-size:8px}
 .launcher button{min-height:48px;font-size:clamp(20px,5vw,28px)}
 .launcher small{font-size:clamp(7px,2vw,9px)}
 .reic-app-window{max-width:calc(100% - 12px);max-height:calc(100% - 12px)}
 .reic-app-title button{min-width:36px;min-height:34px}
 .reic-app-content{padding:10px}
}
@media(prefers-reduced-motion:reduce){
 .launcher button,.system-links button{transition:none}
}


/* Language catalog and library input */
.reic-language-input{display:grid;gap:8px;margin:14px 0 22px;padding:14px;background:linear-gradient(145deg,#08294d,#04152f);border:1px solid #278bc2}
.reic-language-input label,.reic-language-selected>strong{font-size:10px;letter-spacing:.12em;color:#8cddff;font-weight:800}
.reic-language-input input,.reic-language-input select{width:100%;min-width:0;min-height:42px;padding:9px 11px;background:#03162e;border:1px solid #2877a8;color:#f4fbff;border-radius:3px}
.reic-language-detail{padding:10px;background:#0b3761;border-left:3px solid #54caff;color:#d4edff;font-size:12px;line-height:1.6;overflow-wrap:anywhere}
.reic-language-input>[data-language-add],.reic-language-input>[data-language-export]{min-height:42px;padding:9px 12px;background:linear-gradient(100deg,#087bc1,#07508c);border:1px solid #65caff;color:#fff;text-align:left;cursor:pointer}
.reic-language-selected{display:grid;gap:8px;padding:10px 0;border-top:1px solid #24547a}
.reic-language-chip{display:inline-flex;align-items:center;gap:8px;margin:3px;padding:6px 8px;background:#0d4774;border:1px solid #3a9bc9;color:#effaff;font-size:11px}
.reic-language-chip button{border:0;background:transparent;color:#fff;font-size:16px;cursor:pointer}
.reic-language-config{max-height:220px;overflow:auto;padding:10px;background:#010d20;border:1px solid #23618d;color:#a9e6ff;white-space:pre-wrap;overflow-wrap:anywhere;font-size:10px}
@media(max-width:600px){.reic-language-input{padding:10px}.reic-language-chip{max-width:100%;overflow-wrap:anywhere}}

/* REIC local host, authenticated repository explorer, and safe source preview */
.reic-host{display:grid;gap:12px}
.reic-host>label{display:grid;gap:6px;color:#a9ddff;font-size:11px}
.reic-host input{width:100%;min-height:40px;padding:9px 11px;background:#03162e;border:1px solid #2877a8;color:#f4fbff}
.reic-host-actions{display:flex;flex-wrap:wrap;gap:8px}
.reic-host-actions button{min-height:38px;padding:8px 11px;background:linear-gradient(100deg,#087bc1,#07508c);border:1px solid #65caff;color:#fff;cursor:pointer}
.reic-host [data-host-status]{padding:10px;background:#03162e;border-left:3px solid #35baff;color:#ccecff;font-size:12px;overflow-wrap:anywhere}
.reic-host h3{margin:10px 0 0;color:#8cddff;font-size:13px}
.reic-host ul{margin:0;padding-left:20px;color:#c9e4fa;font-size:12px;line-height:1.8}
.reic-file-preview{display:grid;gap:10px;min-width:0}
.reic-file-preview pre{max-height:65vh;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;padding:12px;background:#010b1a;border:1px solid #23618d;color:#d6efff;font:11px/1.6 ui-monospace,monospace}
.reic-host .reic-stat-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
.reic-repo-card small{display:inline-block;margin:6px 0;padding:4px 7px;background:#0b4772;border:1px solid #287bb0;color:#c6eaff;letter-spacing:.04em}
.reic-repo-card:has(small:first-of-type){min-width:0}
@media(max-width:600px){.reic-host-actions{display:grid}.reic-host-actions button{width:100%}.reic-host .reic-stat-grid{grid-template-columns:1fr}}


/* REIC Search application and desktop dock removal */
.app-dock{display:none!important}
.reic-search-app{display:grid;gap:12px;min-width:0}
.reic-search-app h2{margin:0;color:#f4fbff;font-size:clamp(20px,3vw,28px)}
.reic-search-app>p{margin:0;color:#c3def4;font-size:12px;line-height:1.6}
.reic-search-form{display:flex;align-items:center;gap:8px;min-width:0;padding:6px 8px;background:#03162e;border:1px solid #399bd0;box-shadow:0 0 0 2px #0a4d7a55}
.reic-search-form>span{color:#8ce2ff;font-size:24px;line-height:1}
.reic-search-form input{flex:1;min-width:0;height:42px;border:0;outline:0;background:transparent;color:#fff;font-size:14px}
.reic-search-form button{min-width:68px;min-height:40px;background:linear-gradient(100deg,#0789d4,#07518d);border:1px solid #7bdcff;color:#fff;font-weight:800;cursor:pointer}
.reic-search-providers{display:flex;flex-wrap:wrap;align-items:center;gap:7px;color:#9acbe9;font-size:9px}
.reic-search-providers b,.reic-search-providers a{padding:5px 7px;background:#082d50;border:1px solid #23628b;color:#d8f2ff;text-decoration:none}
.reic-search-app [data-reic-search-status]{padding:9px 11px;background:#03162e;border-left:3px solid #37baff;color:#bfeaff;font-size:11px;overflow-wrap:anywhere}
.reic-search-results{display:grid;gap:8px;max-height:48vh;overflow:auto}
.reic-search-result{display:grid;gap:5px;padding:11px;background:linear-gradient(135deg,#08294a,#04152d);border:1px solid #1e5b86;overflow-wrap:anywhere}
.reic-search-result small{color:#80d9ff;font-size:9px;font-weight:800;letter-spacing:.1em}
.reic-search-result a{color:#d8f4ff;font-size:14px;font-weight:700;text-decoration:none}
.reic-search-result a:hover{text-decoration:underline}
.reic-search-result p{margin:0;color:#b9d4e9;font-size:11px;line-height:1.55}
@media(max-width:600px){.reic-search-form{gap:5px;padding:4px}.reic-search-form button{min-width:58px}.reic-search-results{max-height:42vh}}

.reic-local-result-button{padding:0;border:0;background:transparent;color:#d8f4ff;text-align:left;font:inherit;font-size:14px;font-weight:700;cursor:pointer;text-decoration:underline;text-decoration-color:#4ba9d2;text-underline-offset:3px}
.reic-local-result-button:hover{color:#8fe5ff}

/* INTERNAL WEB VIEW: links open inside a movable REIC application window. */
.reic-browser-window{width:min(1100px,calc(100% - 16px))!important;height:calc(100% - 24px)!important;min-height:220px!important}
.reic-browser-window .reic-app-content{display:flex;flex-direction:column;gap:7px;padding:8px;overflow:hidden}
.reic-inapp-browser{display:flex;flex-direction:column;gap:7px;flex:1;min-height:0;height:100%}
.reic-inapp-browser form{display:flex;gap:5px;flex:0 0 auto;min-width:0}
.reic-inapp-browser form button{min-width:38px;min-height:36px;padding:5px 8px;border:1px solid #329eff;background:linear-gradient(#1269c7,#063c87);color:#fff;cursor:pointer}
.reic-inapp-browser form input{flex:1;min-width:0;height:36px;padding:6px 9px;border:1px solid #4b8bc9;background:#eaf4ff;color:#102b50}
.reic-inapp-status{flex:0 0 auto;min-height:18px;color:#9fdcff;font-size:11px}
.reic-inapp-browser iframe{display:block;flex:1 1 auto;width:100%;height:100%;min-height:120px;border:1px solid #2868a5;background:#fff}
.reic-inapp-note{flex:0 0 auto;color:#9bb9d8;font-size:10px;line-height:1.4}
@media(max-width:650px){
 .reic-browser-window{left:4px!important;top:4px!important;width:calc(100% - 8px)!important;height:calc(100% - 8px)!important;max-width:none!important;max-height:none!important}
 .reic-inapp-browser form{gap:3px}
 .reic-inapp-browser form button{min-width:30px;padding:4px;font-size:11px}
 .reic-inapp-browser form input{font-size:11px}
}

/* REIC Application Center: 150 named modules and per-app modal workspaces */
.reic-app-catalog{display:flex;flex-direction:column;gap:10px;min-height:0;height:100%;color:#08234c}
.reic-app-catalog h2{margin:0;color:#092b5b;font-size:clamp(19px,2.1vw,28px)}
.reic-app-catalog-toolbar{display:flex;flex-direction:column;gap:8px}
.reic-app-category-tabs{display:flex;gap:6px;overflow-x:auto;padding:3px 0}
.reic-app-category-tabs button{flex:0 0 auto;border:1px solid #b8d9f5;background:linear-gradient(#f7fbff,#d9eaff);color:#092b5b;padding:8px 12px;font-weight:800;cursor:pointer}
.reic-app-category-tabs button.is-active{background:linear-gradient(#168cff,#0561ca);color:#fff;border-color:#3cb9ff}
.reic-app-catalog-toolbar input,.reic-app-work-toolbar input{min-width:120px;flex:1;padding:10px 12px;border:1px solid #9dc9ee;background:#f7fbff;color:#102f59}
.reic-app-catalog-grid{display:grid;grid-template-columns:repeat(10,minmax(0,1fr));gap:5px;overflow:auto;min-height:0;padding:5px;background:linear-gradient(145deg,#f7fbffed,#d9ebf9e8);border:1px solid #acd2f2}
.reic-app-tile{display:flex;min-width:0;min-height:76px;flex-direction:column;align-items:center;justify-content:center;gap:4px;padding:6px 3px;border:1px solid #d3e8fa;background:linear-gradient(145deg,#fff,#e5f3ff);color:#092b58;cursor:pointer;box-shadow:0 2px 7px #0a5ca51a}
.reic-app-tile:hover{border-color:#168dff;box-shadow:0 0 0 2px #168dff38}
.reic-app-tile-icon{display:grid;place-items:center;width:39px;height:39px;font-size:25px;color:#0877df}
.reic-app-tile strong{font-size:clamp(9px,.8vw,12px);line-height:1.2;text-align:center;overflow-wrap:anywhere}
.reic-app-tile small{font-size:8px;color:#52769b;text-align:center}
.reic-app-catalog [data-app-catalog-status]{font-size:11px;color:#365d83}
.reic-product-app{display:flex;flex-direction:column;gap:12px;color:#102b4c}
.reic-product-app-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}
.reic-product-app-head h2{margin:5px 0;color:#0759ad;font-size:clamp(21px,2.4vw,30px)}
.reic-product-app-head p{margin:0;color:#426383;font-size:13px;line-height:1.5}
.reic-app-ready{padding:6px 9px;background:#e0f8ed;color:#087648;border:1px solid #9bdfbd;font-size:10px;font-weight:900}
.reic-app-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}
.reic-app-stats article{padding:10px;background:linear-gradient(145deg,#f3faff,#dceeff);border:1px solid #b7d8f4;min-width:0}
.reic-app-stats b,.reic-app-stats span{display:block;overflow-wrap:anywhere}.reic-app-stats b{font-size:11px;color:#0759ad}.reic-app-stats span{font-size:10px;color:#567796;margin-top:4px}
.reic-app-work-toolbar{display:flex;gap:7px;flex-wrap:wrap}
.reic-app-work-toolbar button,.reic-app-record-form button,.reic-app-url-form button,.reic-app-tool button{padding:9px 12px;border:1px solid #168dff;background:linear-gradient(#168dff,#0564c8);color:#fff;font-weight:800;cursor:pointer}
.reic-app-record-form{display:grid;grid-template-columns:1fr 1.4fr auto;gap:8px;align-items:end;padding:10px;background:#edf6ff;border:1px solid #c3def5}
.reic-app-record-form label,.reic-app-tool label{display:flex;flex-direction:column;gap:5px;font-size:11px;font-weight:800;color:#244f78;min-width:0}
.reic-app-record-form input,.reic-app-record-form textarea,.reic-app-tool textarea,.reic-app-url-form input{width:100%;min-width:0;padding:9px;border:1px solid #a9cce9;background:#fff;color:#153452;resize:vertical}
.reic-app-record-heading{display:flex;justify-content:space-between;gap:8px;color:#0a3c70;font-size:13px}.reic-app-record-heading span{font-size:11px;color:#53799e}
.reic-app-record-list{display:grid;gap:6px;max-height:280px;overflow:auto}
.reic-app-record{display:flex;justify-content:space-between;gap:10px;padding:10px;background:#f8fcff;border:1px solid #c7dff3}
.reic-app-record strong{color:#0c4d8d}.reic-app-record p{margin:4px 0;color:#365a7c;font-size:12px;white-space:pre-wrap;overflow-wrap:anywhere}.reic-app-record small{color:#7892ab;font-size:10px}
.reic-app-record button{align-self:center;border:1px solid #d28d9a;background:#fff0f2;color:#a22b40;padding:6px 9px;cursor:pointer}
.reic-app-empty{padding:18px;text-align:center;color:#6484a3;background:#f4f9ff;border:1px dashed #aacbe8;font-size:12px}
.reic-app-runtime-status{padding:8px 10px;background:#e7f5ff;border-left:3px solid #168dff;color:#315b80;font-size:11px}
.reic-app-package-details{padding:9px;background:#f4f8fc;border:1px solid #d3e3f0;color:#3b5d7d;font-size:11px}
.reic-app-url-form{display:flex;gap:7px}.reic-app-color-row{display:flex;align-items:center;gap:10px;color:#335a80;font-size:12px}
.reic-app-tool{display:grid;gap:7px;padding:10px;background:#eef6ff;border:1px solid #c0dcf5}.reic-app-tool pre{white-space:pre-wrap;background:#09264a;color:#c5e5ff;padding:9px;max-height:120px;overflow:auto;font-size:11px}
@media(max-width:900px){.reic-app-catalog-grid{grid-template-columns:repeat(6,minmax(0,1fr))}}
@media(max-width:560px){.reic-app-catalog-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.reic-app-record-form{grid-template-columns:1fr}.reic-app-stats{grid-template-columns:1fr}.reic-app-work-toolbar{flex-direction:column}.reic-app-work-toolbar>*{width:100%}.reic-product-app-head{flex-direction:column}.reic-app-url-form{flex-direction:column}}
