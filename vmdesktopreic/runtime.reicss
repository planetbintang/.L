
/* Runtime windows: every app and modal is clipped to the desktop-stage boundary. */
.desktop-stage{position:relative;isolation:isolate;min-width:0;min-height:0}
#apps{position:absolute!important;inset:0!important;z-index:8!important;overflow:hidden!important;pointer-events:none!important;contain:layout paint}
.reic-app-window{position:absolute;display:flex;flex-direction:column;min-width:260px;max-width:calc(100% - 16px);min-height:180px;max-height:calc(100% - 16px);overflow:hidden;pointer-events:auto;background:linear-gradient(145deg,rgba(5,24,66,.99),rgba(2,11,37,.99));border:1px solid #22aaff;box-shadow:0 12px 36px #000b,0 0 22px #078cff66;color:#f4f9ff}
.reic-app-title{height:40px;flex:0 0 40px;display:flex;align-items:center;justify-content:space-between;padding:0 10px 0 14px;background:linear-gradient(90deg,#07132e,#0b3c84);border-bottom:1px solid #168fff;cursor:move;touch-action:none}
.reic-app-title strong{font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.reic-app-title strong span{margin-right:7px}
.reic-app-title button{width:27px;height:25px;margin-left:4px;background:#0b4b9a;border:1px solid #4aaeff;color:#fff;cursor:pointer}
.reic-app-content{padding:clamp(12px,2vw,22px);overflow:auto;min-height:0;flex:1;overscroll-behavior:contain}
.reic-app-window.is-maximized{min-width:0;min-height:0}
.reic-restore-chip{position:absolute;left:8px;bottom:8px;max-width:45%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;pointer-events:auto;background:#052b65;border:1px solid #35baff;color:white;padding:6px 10px}
.reic-eyebrow{font-size:10px;letter-spacing:.18em;color:#7fdcff;font-weight:800}
.reic-dashboard h2,.reic-github h2,.reic-settings h2,.reic-monitor h2,.reic-library h2{font-size:clamp(18px,2.3vw,27px);margin:10px 0;color:#fff}
.reic-dashboard p,.reic-github p,.reic-library p,.reic-note{color:#a8c9ed;font-size:12px;line-height:1.6}
.reic-stat-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin:18px 0}
.reic-stat-grid article{padding:13px;border:1px solid #235a91;background:#09264e;min-width:0}
.reic-stat-grid b{display:block;font-size:clamp(15px,2vw,22px);color:#83dcff;overflow-wrap:anywhere}
.reic-stat-grid span{display:block;margin-top:5px;font-size:10px;color:#c2d9f4}
.reic-action-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(125px,1fr));gap:8px;margin-top:16px}
.reic-action-grid button,.reic-toolbar button{min-height:42px;padding:9px 12px;text-align:left;background:#0c3670;border:1px solid #287bc0;color:#f2f9ff;cursor:pointer}
.reic-action-grid button:hover,.reic-toolbar button:hover{background:#1054a1;border-color:#74d9ff}
.reic-toolbar{display:flex;flex-wrap:wrap;gap:7px;margin:14px 0}
.reic-toolbar input{flex:1;min-width:130px;padding:10px;background:#041630;border:1px solid #32618b;color:#fff}
.reic-toolbar a,.reic-browser a{display:inline-flex;align-items:center;padding:10px;background:#082b5a;border:1px solid #286ca8;color:#bfeeff;text-decoration:none;font-size:11px}
[data-repo-status]{padding:9px 0;color:#86dfff;font-size:11px}
.reic-repo-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:8px;overflow:auto}
.reic-repo-card{min-width:0;padding:12px;background:#071d3d;border:1px solid #1c548a}
.reic-repo-card>a{color:#8cdeff;font-weight:800;text-decoration:none;overflow-wrap:anywhere}
.reic-repo-card small{display:block;color:#8ba9c8;margin-top:5px}
.reic-repo-card p{min-height:30px;margin:8px 0;color:#c4d6ec}
.reic-repo-actions{display:flex;flex-wrap:wrap;gap:6px}
.reic-repo-actions button,.reic-repo-actions a,.reic-tree-head button{padding:7px 9px;background:#0b3976;border:1px solid #347bb8;color:white;text-decoration:none;font-size:10px;cursor:pointer}
.reic-tree-head{grid-column:1/-1;display:flex;flex-wrap:wrap;align-items:center;gap:10px;padding:8px;background:#092b5a}
.reic-tree-head strong{font-size:11px;overflow-wrap:anywhere}
.reic-tree-row{padding:7px 10px;background:#071e42;border-bottom:1px solid #173c65}
.reic-tree-row button{width:100%;text-align:left;background:transparent;border:0;color:#d9f0ff;cursor:pointer}
.reic-error{padding:12px;background:#4c1727;color:#ffdce4;border:1px solid #b64a65}
.reic-setting{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:13px 0;border-bottom:1px solid #25496c;color:#dceeff;font-size:12px}
.reic-setting select{background:#071b39;border:1px solid #3b77a5;color:#fff;padding:8px}
.reic-terminal{font:12px/1.7 ui-monospace,monospace}
.terminal-output{min-height:150px;margin:12px 0;padding:12px;background:#010b1d;border:1px solid #1c548a;color:#8fe5b5;white-space:pre-wrap;overflow-wrap:anywhere}
[data-terminal-form]{display:flex;flex-wrap:wrap;gap:7px;align-items:center;color:#79dfff}
[data-terminal-input]{flex:1;min-width:110px;padding:9px;background:#010b1d;border:1px solid #287bc0;color:#fff}
[data-terminal-form] button{padding:9px 13px;background:#0b4d93;border:1px solid #46baff;color:#fff}
.reic-browser{display:grid;gap:10px}
.reic-no-motion *{animation:none!important;transition:none!important}
.reic-no-glow .reic-app-window{box-shadow:0 8px 24px #0009}
#items.list-mode{display:flex;flex-direction:column;gap:2px}
#items.list-mode button{min-height:36px;flex-direction:row;justify-content:flex-start;padding:5px 12px}
.file-window-max{position:absolute!important;inset:4px!important;width:auto!important;height:auto!important;z-index:6}
@media(max-width:600px){.reic-app-window{min-width:0}.reic-stat-grid{grid-template-columns:1fr 1fr}.reic-stat-grid article:last-child{grid-column:1/-1}.reic-app-content{padding:11px}.reic-repo-list{grid-template-columns:1fr}.reic-app-title{height:36px;flex-basis:36px}.reic-app-title button{width:25px;height:24px}}
