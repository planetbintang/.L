(()=>{'use strict';const host=document.querySelector('#reic-filemanager-app');if(!host||host.dataset.ready)return;host.dataset.ready='1';const $=s=>host.querySelector(s),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));let data,active=0,query='',components=[],page=0,selected=null;const size=60,nav=$('#reic-fm-nav'),tabs=$('#reic-fm-tabs'),content=$('#reic-fm-content'),pages='https://planetbintang.github.io/.L/osmedia/components/',domain='https://planetbintang.com/osmedia/components/',gh='https://github.com/planetbintang/.L/tree/io/osmedia/recordin/components/';async function loadComponents(){const m=await fetch('./osmedia/recordin/components/manifest.json',{cache:'no-cache'}).then(r=>{if(!r.ok)throw Error('Manifest '+r.status);return r.json()});const parts=await Promise.all(m.shards.map(p=>fetch('./osmedia/recordin/components/manifest-parts/'+p.split('/').pop(),{cache:'no-cache'}).then(r=>{if(!r.ok)throw Error(p+' '+r.status);return r.json()})));components=parts.flatMap(x=>x.components||[]);if(components.length!==15000)throw Error('Komponen ditemukan '+components.length+', target 15000');const v=data.views.find(x=>x.id==='osmedia-15000-folders');if(v)v.files=components.map(c=>({path:'osmedia/recordin/components/'+c.id+'/',kind:'folder',title:c.title,id:c.id,group:c.group,component:c}))}async function load(){const r=await fetch('./vmdesktopreic/reic-library/index.reicg',{cache:'no-cache'});if(!r.ok)throw Error('REICG HTTP '+r.status);data=await r.json();await loadComponents();drawNav();drawTabs();draw()}function drawNav(){nav.innerHTML=data.views.map((v,i)=>'<button data-view="'+i+'" class="'+(i===active?'active':'')+'">▸ '+esc(v.title)+'</button>').join('');nav.querySelectorAll('[data-view]').forEach(b=>b.onclick=()=>select(+b.dataset.view))}function drawTabs(){tabs.innerHTML=data.views.map((v,i)=>'<button data-tab="'+i+'" class="'+(i===active?'active':'')+'">'+esc(v.title)+'</button>').join('');tabs.querySelectorAll('[data-tab]').forEach(b=>b.onclick=()=>select(+b.dataset.tab))}function select(i){active=i;page=0;selected=null;drawNav();drawTabs();draw()}function drawComponents(){const term=query.toLocaleLowerCase('id'),filtered=components.filter(c=>!term||(c.id+' '+c.title+' '+c.group).toLocaleLowerCase('id').includes(term)),max=Math.max(1,Math.ceil(filtered.length/size));page=Math.min(page,max-1);const rows=filtered.slice(page*size,(page+1)*size),chosen=selected&&components.find(c=>c.id===selected);content.innerHTML='<div class="reic-fm-section"><div><h3>OSMEDIA · 15.000 FOLDER KOMPONEN</h3><p>Setiap folder berisi tiga file sumber asli: REIC, CSS, dan JS.</p></div><b>'+filtered.length.toLocaleString('id-ID')+' HASIL</b></div><div class="reic-fm-grid">'+rows.map(c=>'<button class="reic-fm-card" data-component="'+esc(c.id)+'"><small>'+esc(c.group.toUpperCase())+'</small><b>'+esc(c.title)+'</b><span>'+esc(c.id)+'</span></button>').join('')+'</div><div class="reic-fm-pager"><button data-page="prev" '+(page===0?'disabled':'')+'>← SEBELUMNYA</button><span>HALAMAN '+(page+1)+' / '+max+'</span><button data-page="next" '+(page>=max-1?'disabled':'')+'>BERIKUTNYA →</button></div>'+(chosen?'<section class="reic-fm-files"><h3>'+esc(chosen.title)+'</h3>'+['reic','css','js'].map(k=>'<div class="reic-fm-file"><code>'+esc(chosen[k])+'</code><a target="_blank" rel="noopener" href="https://github.com/planetbintang/.L/blob/io/osmedia/recordin/components/'+esc(chosen[k])+'">GITHUB ↗</a></div>').join('')+'<div class="reic-fm-links"><a target="_blank" rel="noopener" href="'+pages+'?component='+encodeURIComponent(chosen.id)+'">GITHUB PAGES ↗</a><a target="_blank" rel="noopener" href="'+domain+'?component='+encodeURIComponent(chosen.id)+'">.PLANETBINTANG.COM ↗</a><a target="_blank" rel="noopener" href="'+gh+encodeURIComponent(chosen.id)+'">FOLDER GITHUB ↗</a></div><small class="reic-fm-domain-note">Domain kustom perlu DNS dan sertifikat aktif; tautan ini bukan bukti aktivasi DNS.</small></section>':'');content.querySelectorAll('[data-component]').forEach(b=>b.onclick=()=>{selected=b.dataset.component;drawComponents()});content.querySelector('[data-page="prev"]')?.addEventListener('click',()=>{page--;drawComponents()});content.querySelector('[data-page="next"]')?.addEventListener('click',()=>{page++;drawComponents()});$('#reic-fm-count').textContent='15.000 FOLDER · 45.000 FILE · '+new Set(components.map(c=>c.group)).size+' KELOMPOK'}function draw(){const v=data.views[active];if(v.id==='aireber-million-folders'){content.innerHTML='<section style="height:min(78vh,920px);min-height:540px;background:#071522"><iframe title="Aireber one million virtual folders" src="./aireber/filesystem/" style="display:block;width:100%;height:100%;border:0;background:#071522"></iframe></section>';$('#reic-fm-count').textContent='AIREBER · 1.000.000 FOLDER VIRTUAL · 5.000.000 FILE VIRTUAL';return}if(v.id==='osmedia-15000-folders'){drawComponents();return}const term=query.toLowerCase(),files=(v.files||[]).filter(f=>!term||(f.path+' '+v.title).toLowerCase().includes(term));content.innerHTML='<div class="reic-fm-section"><div><h3>'+esc(v.title)+'</h3><p>'+esc(v.description)+'</p></div><b>'+files.length+' ITEM</b></div><div class="reic-fm-grid">'+data.views.map((x,i)=>'<button class="reic-fm-card" data-card="'+i+'"><small>FOLDER REIC</small><b>'+esc(x.title)+'</b><span>'+esc(x.description)+'</span></button>').join('')+'</div><div class="reic-fm-files">'+files.map(f=>'<div class="reic-fm-file"><code>'+esc(f.path)+'</code><span>'+(f.kind==='folder'?'FOLDER':'FILE')+'</span></div>').join('')+'</div>';content.querySelectorAll('[data-card]').forEach(b=>b.onclick=()=>select(+b.dataset.card));$('#reic-fm-count').textContent='15.000 FOLDER OSMEDIA TERINDEKS · '+data.views.length+' AREA SISTEM'}$('#reic-fm-search').addEventListener('input',e=>{query=e.target.value;page=0;draw()});host.querySelector('[data-fm-refresh]').onclick=()=>load().catch(e=>content.textContent='Gagal memuat: '+e.message);load().catch(e=>content.textContent='Gagal memuat indeks OSMEDIA: '+e.message);window.REICFileManager={reload:load,open:select,get components(){return components}}})();