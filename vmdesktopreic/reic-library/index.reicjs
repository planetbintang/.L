(()=>{'use strict';const host=document.querySelector('#reic-filemanager-app');if(!host||host.dataset.ready)return;host.dataset.ready='1';const $=s=>host.querySelector(s),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));let data,active=0,query='';const nav=$('#reic-fm-nav'),tabs=$('#reic-fm-tabs'),content=$('#reic-fm-content');async function load(){const r=await fetch('./vmdesktopreic/reic-library/index.reicg',{cache:'no-cache'});if(!r.ok)throw Error('REICG HTTP '+r.status);data=await r.json();drawNav();drawTabs();draw()}function drawNav(){nav.innerHTML=data.views.map((v,i)=>'<button data-view="'+i+'" class="'+(i===active?'active':'')+'">▸ '+esc(v.title)+'</button>').join('');nav.querySelectorAll('[data-view]').forEach(b=>b.onclick=()=>select(+b.dataset.view))}function drawTabs(){tabs.innerHTML=data.views.map((v,i)=>'<button data-tab="'+i+'" class="'+(i===active?'active':'')+'">'+esc(v.title)+'</button>').join('');tabs.querySelectorAll('[data-tab]').forEach(b=>b.onclick=()=>select(+b.dataset.tab))}function select(i){active=i;drawNav();drawTabs();draw()}function draw(){const v=data.views[active],term=query.toLowerCase(),files=v.files.filter(f=>!term||(f.path+' '+v.title).toLowerCase().includes(term));const matches=data.views.map((x,i)=>({x,i})).filter(({x})=>!term||(x.title+' '+x.description+' '+x.files.map(f=>f.path).join(' ')).toLowerCase().includes(term));content.innerHTML='<div class="reic-fm-section"><div><h3>'+esc(v.title)+'</h3><p>'+esc(v.description)+'</p></div><b>'+files.length+' ITEM</b></div><div class="reic-fm-grid">'+matches.map(({x,i})=>'<button class="reic-fm-card" data-card="'+i+'"><small>FOLDER REIC</small><b>'+esc(x.title)+'</b><span>'+esc(x.description)+'</span></button>').join('')+'</div><div class="reic-fm-files">'+files.map(f=>'<div class="reic-fm-file"><code>'+esc(f.path)+'</code><span>'+(f.kind==='folder'?'FOLDER':'FILE')+'</span></div>').join('')+'</div><p style="margin-top:12px">'+esc(data.note)+'</p>';content.querySelectorAll('[data-card]').forEach(b=>b.onclick=()=>select(+b.dataset.card));$('#reic-fm-count').textContent=data.views.length+' FOLDER SISTEM · '+data.views.reduce((n,x)=>n+x.files.length,0)+' SUMBER TERINDEKS'}function fail(e){content.textContent='Gagal memuat indeks REIC: '+e.message}$('#reic-fm-search').addEventListener('input',e=>{query=e.target.value;draw()});host.querySelector('[data-fm-refresh]').onclick=()=>load().catch(fail);load().catch(fail);window.REICFileManager={reload:load,open:select,get manifest(){return data}}})();