.reic-library-module[data-reic-module="list-blok"]{padding:16px;background:#0b1728;color:#e8f2ff;border:1px solid #29445f}.reic-library-module header{border-bottom:1px solid #29445f;padding-bottom:12px}.reic-library-module h2{letter-spacing:.08em}.reic-library-module p{color:#a9bdd1;line-height:1.6}.reic-library-module .reic-module-body{padding-top:12px}