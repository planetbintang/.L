{
  "schemaVersion": 1,
  "id": "REIC-REGISTRY-ROOT",
  "system": "REIC",
  "name": "REIC System Registry",
  "logicalCodeUnits": 1000000,
  "physicalFiles": 0,
  "materialization": "lazy-on-preview-or-export",
