(()=>{const $=s=>document.querySelector(s);const win=$('#vmWindow'),title=$('#windowTitle'),content=$('#windowContent');const apps={home:['Beranda','<h2>Selamat datang di VMDESKTOPREIC</h2><p>Desktop ini memakai OS MEDIA VM sebagai lapisan runtime, navigasi aplikasi, dan fondasi modul.</p>'],files:['File Manager','<h2>File Manager</h2><p>Ruang penjelajahan folder sistem OS MEDIA VM.</p><p><code>/osmediavm/</code> · <code>/vmdesktopreic/</code> · <code>/media/</code></p>'],registry:['Registri Sistem','<h2>Registri OS MEDIA VM</h2><p>Lapisan registri desktop menghubungkan modul, konfigurasi, dan identitas komponen REIC.</p><p>Runtime: <code>OS MEDIA VM / REIC</code></p>'],terminal:['Terminal REIC','<h2>Terminal REIC</h2><p><code>VMDESKTOPREIC &gt; status</code></p><p>Frontend statis aktif. Operasi sistem jarak jauh memerlukan adapter backend yang terhubung.</p>'],settings:['Pengaturan Desktop','<h2>Pengaturan</h2><p>Resolusi logis: <code>1920 × 1080</code></p><p>Mode tampilan: adaptif · Skala: otomatis · Runtime: OS MEDIA VM</p>'],monitor:['Pemantauan Sistem','<h2>Pemantauan Runtime</h2><p>Status UI: <code>ONLINE</code></p><p>Komponen: REIC · REICCSS · REICJS</p><p>Hosting: GitHub Pages (frontend statis)</p>']};function openApp(id){const app=apps[id]||apps.home;title.textContent=app[0];content.innerHTML=app[1];win.hidden=false;document.querySelectorAll('[data-app]').forEach(b=>b.classList.toggle('active',b.dataset.app===id));}document.querySelectorAll('[data-app]').forEach(b=>b.addEventListener('click',()=>openApp(b.dataset.app)));$('#windowClose').addEventListener('click',()=>win.hidden=true);$('#windowMin').addEventListener('click',()=>win.hidden=true);function tick(){const d=new Date();$('#vmClock').textContent=d.toLocaleTimeString('id-ID',{hour:'2-digit',minute:'2-digit'});$('#vmDate').textContent=d.toLocaleDateString('id-ID',{day:'2-digit',month:'short',year:'numeric'});const cal=$('#calendarDate');if(cal)cal.textContent=d.toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'});}tick();setInterval(tick,30000);})();