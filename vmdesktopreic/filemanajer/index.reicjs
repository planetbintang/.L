(()=>{'use strict';
const host=document.querySelector('#reic-filemanager-app');if(!host||host.dataset.ready)return;host.dataset.ready='1';
const $=s=>host.querySelector(s),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let data,active=0,query='',theme='all',kataPage=0,selectedKata=null,selectedCategory='numeric',engine=null;
const nav=$('#reic-fm-nav'),themes=$('#reic-fm-themes'),tabs=$('#reic-fm-tabs'),content=$('#reic-fm-content');
const type=p=>(String(p).match(/\.[a-z0-9]+$/i)||['FOLDER'])[0].toUpperCase();
const href=p=>'../'+String(p).replace(/^\/+/, '');
async function loadEngine(){if(window.REICKataEngine){engine=window.REICKataEngine;return engine;}const r=await fetch('./filemanajer/allunivers_os/kata/kata-engine.reicjs',{cache:'no-cache'});if(!r.ok)throw Error('Kata engine HTTP '+r.status);const s=document.createElement('script');s.textContent=await r.text();document.body.append(s);engine=window.REICKataEngine;if(!engine)throw Error('Kata engine tidak terinisialisasi');return engine;}
async function load(){const r=await fetch('./filemanajer/index.reicg',{cache:'no-cache'});if(!r.ok)throw Error('Manifest File Manager HTTP '+r.status);data=await r.json();if(data.schema!=='planetbintang.vmdesktopreic.filemanager.v2')throw Error('Versi manifest File Manager tidak cocok');drawNav();drawThemes();drawTabs();draw();const files=data.categories.flatMap(c=>c.files||[]);const ext=data.extensions.map(x=>'<span>'+esc(x.toUpperCase())+'</span>').join('');$('#reic-fm-summary').innerHTML='<span>'+data.categories.length+' KATEGORI</span><span>'+files.length+' SUMBER FILE</span><span>'+data.componentThemes.length+' TEMA KOMPONEN</span>'+ext;}
function drawNav(){nav.innerHTML=data.categories.map((v,i)=>'<button data-view="'+i+'" class="'+(i===active?'active':'')+'">▸ '+esc(v.title)+'</button>').join('');nav.querySelectorAll('[data-view]').forEach(b=>b.onclick=()=>select(+b.dataset.view));}
function drawThemes(){themes.innerHTML=data.componentThemes.map(v=>'<button data-theme="'+esc(v.id)+'">◈ '+esc(v.title)+'</button>').join('');themes.querySelectorAll('[data-theme]').forEach(b=>b.onclick=()=>{theme=b.dataset.theme;drawThemes();drawTheme();});}
function drawTabs(){tabs.innerHTML=data.categories.map((v,i)=>'<button data-tab="'+i+'" class="'+(i===active?'active':'')+'">'+esc(v.title)+'</button>').join('');tabs.querySelectorAll('[data-tab]').forEach(b=>b.onclick=()=>select(+b.dataset.tab));}
function select(i){active=i;theme='all';kataPage=0;selectedKata=null;drawNav();drawThemes();drawTabs();draw();}
function draw(){const v=data.categories[active];if(!v)return;if(v.id==='allunivers-kata'){drawKata().catch(fail);return;}const term=query.toLocaleLowerCase('id');const files=(v.files||[]).filter(f=>(f.path+' '+(f.label||'')+' '+type(f.path)).toLocaleLowerCase('id').includes(term));const folders=(v.folders||[]).filter(f=>(f.name+' '+f.path+' '+f.description).toLocaleLowerCase('id').includes(term));content.dataset.reicCategory=v.id;content.innerHTML='<div class="reic-fm-section"><div><small>'+esc(v.theme)+'</small><h3>'+esc(v.title)+'</h3><p>'+esc(v.description)+'</p></div><b>'+files.length+' FILE · '+folders.length+' FOLDER</b></div><div class="reic-fm-grid">'+folders.map(f=>'<article class="reic-fm-folder"><b>▰ '+esc(f.name)+'</b><code>'+esc(f.path)+'</code><p>'+esc(f.description)+'</p></article>').join('')+'</div><div class="reic-fm-files">'+files.map(f=>'<div class="reic-fm-file"><div><b>'+esc(f.label||f.path.split('/').pop())+'</b><br><code>'+esc(f.path)+'</code></div><a href="'+esc(href(f.path))+'" target="_blank" rel="noopener">BUKA '+esc(type(f.path))+' ↗</a></div>').join('')+'</div>' +(files.length||folders.length?'':'<p class="reic-fm-empty">Tidak ada sumber yang cocok dengan pencarian.</p>');$('#reic-fm-count').textContent=data.categories.length+' KATEGORI · '+data.categories.reduce((n,x)=>n+(x.files||[]).length,0)+' SUMBER FILE · INDEKS TERPUSAT';}
async function drawKata(){engine=await loadEngine();const v=data.categories[active],term=query.trim().toLocaleLowerCase('id');if(!selectedKata){const cats=engine.categories;const cat=cats.find(x=>x.id===selectedCategory)||cats[0];const result=engine.browse(cat.id,kataPage,50);const items=result.items.filter(x=>!term||x.name.toLocaleLowerCase('id').includes(term));content.dataset.reicCategory=v.id;content.innerHTML='<div class="reic-fm-section"><div><small>ALLUNIVERS OS / KATA / VIRTUAL FILESYSTEM</small><h3>ALLUNIVERS OS · KATA</h3><p>Direktori kata dibangkitkan sesuai halaman. Setiap folder menyediakan enam berkas REBER: .ieje, .aeea, .nz, .ck, .regs, .log.</p></div><b>'+result.total.toLocaleString('id-ID')+' NODE</b></div><div class="reic-kata-toolbar"><label>KATEGORI <select id="reic-kata-category">'+cats.map(c=>'<option value="'+c.id+'" '+(c.id===cat.id?'selected':'')+'>'+esc(c.label)+' · '+c.count.toLocaleString('id-ID')+'</option>').join('')+'</select></label><span>HALAMAN '+(kataPage+1)+' / '+result.pages.toLocaleString('id-ID')+'</span></div><div class="reic-kata-grid">'+items.map(x=>'<button class="reic-kata-node" data-kata="'+esc(x.name)+'" data-index="'+x.index+'"><b>▰ '+esc(x.name)+'</b><small>'+esc(x.path)+'</small><span>6 BERKAS REBER ↗</span></button>').join('')+'</div><div class="reic-kata-pager"><button data-page="prev" '+(kataPage===0?'disabled':'')+'>← SEBELUMNYA</button><span>'+result.items.length+' / '+result.total.toLocaleString('id-ID')+' FOLDER PADA KATEGORI</span><button data-page="next" '+(kataPage+1>=result.pages?'disabled':'')+'>BERIKUTNYA →</button></div><p class="reic-fm-empty">Mode virtual on-demand: folder dan isi file dibentuk saat dibuka atau diunduh, tanpa menambahkan jutaan direktori fisik ke repositori GitHub.</p>';
$('#reic-kata-category').onchange=e=>{selectedCategory=e.target.value;kataPage=0;drawKata();};content.querySelectorAll('[data-kata]').forEach(b=>b.onclick=()=>{selectedKata={name:b.dataset.kata,index:+b.dataset.index,category:selectedCategory};drawKata();});content.querySelector('[data-page="prev"]').onclick=()=>{kataPage=Math.max(0,kataPage-1);drawKata();};content.querySelector('[data-page="next"]').onclick=()=>{kataPage++;drawKata();};$('#reic-fm-count').textContent=engine.total.toLocaleString('id-ID')+' NODE KATA · 6 FILE / NODE · VIRTUAL ON-DEMAND';return;}
const k=selectedKata,cat=engine.categories.find(x=>x.id===k.category);content.innerHTML='<div class="reic-fm-section"><div><small>ALLUNIVERS OS / KATA / '+esc(cat.label)+'</small><h3>▰ '+esc(k.name)+'</h3><p>Folder virtual dengan enam file REBER yang mengikuti struktur sumber Aireber.</p></div><button id="reic-kata-back">← KEMBALI KE FOLDER</button></div><div class="reic-fm-files">'+engine.files.map(f=>'<div class="reic-fm-file"><div><b>'+esc(f)+'</b><br><code>'+esc('/allunivers_os/kata/'+encodeURIComponent(k.name)+'/'+f)+'</code></div><button data-download="'+f+'">UNDUH '+esc(type(f))+' ↓</button></div>').join('')+'</div><pre class="reic-kata-preview" id="reic-kata-preview">Pilih salah satu file untuk melihat isi REBER.</pre>';
$('#reic-kata-back').onclick=()=>{selectedKata=null;drawKata();};content.querySelectorAll('[data-download]').forEach(b=>b.onclick=()=>{const f=b.dataset.download,body=engine.getFile(k.name,k.category,f,k.index);$('#reic-kata-preview').textContent=body;engine.download(f,body);});$('#reic-fm-count').textContent='FOLDER '+k.name+' · 6 FILE REBER TERSEDIA';}
function drawTheme(){const v=data.componentThemes.find(x=>x.id===theme);if(!v)return;content.dataset.reicCategory='system-themes';content.innerHTML='<div class="reic-fm-section"><div><small>THEME SYSTEM / COMPONENT GROUP</small><h3>'+esc(v.title)+'</h3><p>'+esc(v.description)+'</p></div></div><p class="reic-fm-empty">Kategori tema ini mengelompokkan komponen desktop berdasarkan fungsi. Buka kategori utama untuk menelusuri sumber file dan folder.</p>';$('#reic-fm-count').textContent='TEMA SISTEM · '+v.title;}
function fail(e){content.textContent='Gagal memuat File Manager: '+e.message;$('#reic-fm-count').textContent='INDEX ERROR';}
$('#reic-fm-search').addEventListener('input',e=>{query=e.target.value;theme='all';selectedKata=null;kataPage=0;draw();});host.querySelector('[data-fm-refresh]').onclick=()=>load().catch(fail);load().catch(fail);
window.REICFileManager={reload:load,open:select,get manifest(){return data;},get status(){return data?'ready':'loading';},get kataEngine(){return engine;}};
})();