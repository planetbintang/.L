(()=>{'use strict';const host=document.querySelector('#reic-filemanager-app');if(!host||host.dataset.ready)return;host.dataset.ready='1';const $=s=>host.querySelector(s),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));let data,active=0,query='',theme='all';const nav=$('#reic-fm-nav'),themes=$('#reic-fm-themes'),tabs=$('#reic-fm-tabs'),content=$('#reic-fm-content');const type=p=>(String(p).match(/\.[a-z0-9]+$/i)||['FOLDER'])[0].toUpperCase();const href=p=>'../'+String(p).replace(/^\/+/, '');async function load(){const r=await fetch('./filemanajer/index.reicg',{cache:'no-cache'});if(!r.ok)throw Error('Manifest File Manager HTTP '+r.status);data=await r.json();if(data.schema!=='planetbintang.vmdesktopreic.filemanager.v2')throw Error('Versi manifest File Manager tidak cocok');drawNav();drawThemes();drawTabs();draw();const files=data.categories.flatMap(c=>c.files||[]);const ext=data.extensions.map(x=>'<span>'+esc(x.toUpperCase())+'</span>').join('');$('#reic-fm-summary').innerHTML='<span>'+data.categories.length+' KATEGORI</span><span>'+files.length+' SUMBER FILE</span><span>'+data.componentThemes.length+' TEMA KOMPONEN</span>'+ext;}function drawNav(){nav.innerHTML=data.categories.map((v,i)=>'<button data-view="'+i+'" class="'+(i===active?'active':'')+'">▸ '+esc(v.title)+'</button>').join('');nav.querySelectorAll('[data-view]').forEach(b=>b.onclick=()=>select(+b.dataset.view));}function drawThemes(){themes.innerHTML=data.componentThemes.map(v=>'<button data-theme="'+esc(v.id)+'">◈ '+esc(v.title)+'</button>').join('');themes.querySelectorAll('[data-theme]').forEach(b=>b.onclick=()=>{theme=b.dataset.theme;drawThemes();drawTheme();});}function drawTabs(){tabs.innerHTML=data.categories.map((v,i)=>'<button data-tab="'+i+'" class="'+(i===active?'active':'')+'">'+esc(v.title)+'</button>').join('');tabs.querySelectorAll('[data-tab]').forEach(b=>b.onclick=()=>select(+b.dataset.tab));}function select(i){active=i;theme='all';drawNav();drawThemes();drawTabs();draw();}function draw(){const v=data.categories[active];if(!v)return;const term=query.toLocaleLowerCase('id');const files=(v.files||[]).filter(f=>(f.path+' '+(f.label||'')+' '+type(f.path)).toLocaleLowerCase('id').includes(term));const folders=(v.folders||[]).filter(f=>(f.name+' '+f.path+' '+f.description).toLocaleLowerCase('id').includes(term));content.innerHTML='<div class="reic-fm-section"><div><small>'+esc(v.theme)+'</small><h3>'+esc(v.title)+'</h3><p>'+esc(v.description)+'</p></div><b>'+files.length+' FILE · '+folders.length+' FOLDER</b></div><div class="reic-fm-grid">'+folders.map(f=>'<article class="reic-fm-folder"><b>▰ '+esc(f.name)+'</b><code>'+esc(f.path)+'</code><p>'+esc(f.description)+'</p></article>').join('')+'</div><div class="reic-fm-files">'+files.map(f=>'<div class="reic-fm-file"><div><b>'+esc(f.label||f.path.split('/').pop())+'</b><br><code>'+esc(f.path)+'</code></div><a href="'+esc(href(f.path))+'" target="_blank" rel="noopener">BUKA '+esc(type(f.path))+' ↗</a></div>').join('')+'</div>'+(files.length||folders.length?'':'<p class="reic-fm-empty">Tidak ada sumber yang cocok dengan pencarian.</p>');$('#reic-fm-count').textContent=data.categories.length+' KATEGORI · '+data.categories.reduce((n,x)=>n+(x.files||[]).length,0)+' SUMBER FILE · INDEKS TERPUSAT';}function drawTheme(){const v=data.componentThemes.find(x=>x.id===theme);if(!v)return;content.innerHTML='<div class="reic-fm-section"><div><small>THEME SYSTEM / COMPONENT GROUP</small><h3>'+esc(v.title)+'</h3><p>'+esc(v.description)+'</p></div></div><p class="reic-fm-empty">Kategori tema ini mengelompokkan komponen desktop berdasarkan fungsi. Buka kategori utama untuk menelusuri sumber file dan folder.</p>';$('#reic-fm-count').textContent='TEMA SISTEM · '+v.title;}function fail(e){content.textContent='Gagal memuat indeks File Manager: '+e.message;$('#reic-fm-count').textContent='INDEX ERROR';}$('#reic-fm-search').addEventListener('input',e=>{query=e.target.value;theme='all';draw();});host.querySelector('[data-fm-refresh]').onclick=()=>load().catch(fail);load().catch(fail);window.REICFileManager={reload:load,open:select,get manifest(){return data;},get status(){return data?'ready':'loading';}}})();