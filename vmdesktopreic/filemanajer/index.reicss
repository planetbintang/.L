.reic-fm{min-height:560px;height:100%;padding:14px;background:linear-gradient(145deg,#0b1728,#07101d 68%,#101e31);color:#e8f2ff;border:1px solid #29445f;font:13px/1.5 system-ui,sans-serif;display:flex;flex-direction:column}.reic-fm *{box-sizing:border-box}.reic-fm-head,.reic-fm-tools,.reic-fm footer{display:flex;justify-content:space-between;align-items:center;gap:12px}.reic-fm small,.reic-fm nav>b,.reic-fm footer{color:#83c8f2;letter-spacing:.1em;font-size:10px}.reic-fm h2{margin:4px 0;font-size:22px;letter-spacing:.06em}.reic-fm p{color:#a9bdd1;margin:0}.reic-fm-runtime{font-size:10px;color:#9be7c0;letter-spacing:.12em;white-space:nowrap}.reic-fm-tools{margin:12px 0;flex:0 0 auto}.reic-fm input{flex:1;min-width:0;padding:10px;background:#101f32;border:1px solid #29445f;color:#fff}.reic-fm button{cursor:pointer;background:#12263b;border:1px solid #29445f;color:#dcecff;padding:9px}.reic-fm button.active,.reic-fm button:hover{background:#174366;border-color:#62bce9}.reic-fm-summary{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 10px}.reic-fm-summary span{padding:5px 9px;background:#10253a;border:1px solid #29445f;color:#a9d9f8;font-size:10px;letter-spacing:.06em}.reic-fm-layout{display:grid;grid-template-columns:220px minmax(0,1fr);border:1px solid #243c54;min-height:0;flex:1}.reic-fm nav{padding:10px;background:#0a1727;border-right:1px solid #243c54;overflow:auto}.reic-fm nav>b{display:block;margin:2px 0 8px}.reic-fm nav .reic-fm-theme-label{margin-top:18px}.reic-fm nav button{display:block;width:100%;text-align:left;margin:3px 0;background:transparent;border-color:transparent;font-size:10px}.reic-fm main{min-width:0;min-height:0;padding:12px;overflow:auto}.reic-fm-tabs{display:flex;gap:5px;flex-wrap:wrap;margin-bottom:12px}.reic-fm-section{display:flex;justify-content:space-between;gap:10px;border-bottom:1px solid #29445f;padding-bottom:12px;margin-bottom:12px}.reic-fm-section h3{margin:2px 0 5px;font-size:17px}.reic-fm-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:8px}.reic-fm-card{text-align:left;display:flex;flex-direction:column;align-items:flex-start;min-height:88px}.reic-fm-card small{color:#7ed8ee}.reic-fm-card b{margin:5px 0}.reic-fm-card span{color:#a9bdd1;font-size:11px}.reic-fm-files{margin-top:14px;border-top:1px solid #29445f}.reic-fm-file{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:8px 2px;border-bottom:1px solid #1c3046;overflow-wrap:anywhere}.reic-fm-file code{color:#a9d9f8;overflow-wrap:anywhere}.reic-fm-file a{color:#83c8f2;text-decoration:none;font-size:10px;white-space:nowrap}.reic-fm-file a:hover{text-decoration:underline}.reic-fm-folder{padding:9px;margin:6px 0;background:#10253a;border:1px solid #29445f}.reic-fm-folder b{display:block;color:#eaf4ff}.reic-fm-folder code{font-size:10px;color:#83c8f2}.reic-fm-empty{padding:18px;color:#a9bdd1}.reic-fm footer{margin-top:10px;padding-top:9px;border-top:1px solid #29445f;flex:0 0 auto}@media(max-width:700px){.reic-fm{padding:9px}.reic-fm-layout{grid-template-columns:1fr}.reic-fm nav{border-right:0;border-bottom:1px solid #243c54;max-height:180px}.reic-fm nav #reic-fm-nav,.reic-fm nav #reic-fm-themes{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.reic-fm-head{align-items:flex-start;flex-direction:column}.reic-fm-tools{align-items:stretch}.reic-fm footer{flex-wrap:wrap}}
.reic-kata-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin:10px 0;padding:10px;background:#0d2033;border:1px solid #29445f}.reic-kata-toolbar label{display:flex;align-items:center;gap:8px;color:#9ed8f5;font-size:10px;letter-spacing:.08em}.reic-kata-toolbar select{min-width:220px;padding:8px;background:#101f32;border:1px solid #29445f;color:#e8f2ff}.reic-kata-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:7px}.reic-kata-node{display:flex;flex-direction:column;align-items:flex-start;gap:5px;min-width:0;text-align:left;background:#10253a;border:1px solid #29445f;padding:10px;color:#e8f2ff}.reic-kata-node small{max-width:100%;overflow-wrap:anywhere;color:#83c8f2;font-size:9px}.reic-kata-node span{color:#9be7c0;font-size:9px}.reic-kata-pager{display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;margin-top:12px;padding:10px 0;border-top:1px solid #29445f}.reic-kata-pager span{color:#a9bdd1;font-size:10px}.reic-kata-preview{white-space:pre-wrap;overflow-wrap:anywhere;max-height:300px;overflow:auto;padding:12px;background:#07101d;border:1px solid #29445f;color:#cce5ff;font:11px/1.5 ui-monospace,monospace}.reic-fm-file button{flex:0 0 auto}@media(max-width:700px){.reic-kata-toolbar{align-items:stretch}.reic-kata-toolbar label{align-items:flex-start;flex-direction:column}.reic-kata-toolbar select{width:100%;min-width:0}.reic-kata-pager{align-items:stretch}.reic-kata-pager button{flex:1}}
