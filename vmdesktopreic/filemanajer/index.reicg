{
  "schema": "planetbintang.vmdesktopreic.filemanager.v2",
  "title": "VMDESKTOPREIC · FILE MANAGER REIC SYSTEM",
  "root": "vmdesktopreic/filemanajer/",
  "extensions": [
    ".reic",
    ".reicss",
    ".reicjs",
    ".reicg"
  ],
  "policy": "single-index-preserve-source-paths",
  "description": "Pusat kategori untuk seluruh sistem desktop. Berkas sumber tetap pada lokasi aslinya agar impor dan runtime yang sudah aktif tidak rusak.",
  "categories": [
    {
      "id": "system-folders",
      "title": "FOLDER SISTEM",
      "theme": "CORE / STORAGE",
      "description": "Akar sistem dan penyimpanan terkelola.",
      "folders": [
        {
          "name": "acct",
          "path": "acct/",
          "description": "Aktivitas, akun, dan aktivasi."
        },
        {
          "name": "sys",
          "path": "sys/",
          "description": "Inti sistem dan layanan."
        },
        {
          "name": "system_ext",
          "path": "system_ext/",
          "description": "Penyimpanan sistem eksternal."
        },
        {
          "name": "cache",
          "path": "cache/",
          "description": "Cache dan rekonstruksi sementara."
        },
        {
          "name": "config",
          "path": "config/",
          "description": "Konfigurasi sistem."
        },
        {
          "name": "media",
          "path": "media/",
          "description": "Media dan aset publikasi."
        },
        {
          "name": "data",
          "path": "data/",
          "description": "Data bersama sistem."
        }
      ],
      "files": []
    },
    {
      "id": "allunivers-kata",
      "title": "ALLUNIVERS OS · KATA",
      "theme": "KNOWLEDGE / VIRTUAL FILESYSTEM",
      "description": "Integrasi skema Allunivers OS dari planetbintang/aireber. Folder kata virtual dibangkitkan per halaman; setiap node menyediakan enam berkas REBER. Jumlah node aktif dihitung langsung oleh engine.",
      "folders": [
        {
          "name": "allunivers_os",
          "path": "allunivers_os/",
          "description": "Root sistem AlluniverS_OS yang diadaptasi dari aireber/src/lib/virtual-fs.ts."
        },
        {
          "name": "kata",
          "path": "allunivers_os/kata/",
          "description": "Direktori kata virtual dengan pagination dan generator on-demand; bukan direktori fisik massal di Git."
        },
        {
          "name": "reber_ai",
          "path": "allunivers_os/reber_ai/",
          "description": "Folder sistem AI dengan skema file REBER yang sama."
        }
      ],
      "files": [
        {
          "path": "vmdesktopreic/filemanajer/allunivers_os/kata/_template/index.ieje",
          "label": "Template Indeks Kata · .ieje"
        },
        {
          "path": "vmdesktopreic/filemanajer/allunivers_os/kata/_template/style.aeea",
          "label": "Template Style Kata · .aeea"
        },
        {
          "path": "vmdesktopreic/filemanajer/allunivers_os/kata/_template/fungsi.nz",
          "label": "Template Fungsi Kata · .nz"
        },
        {
          "path": "vmdesktopreic/filemanajer/allunivers_os/kata/_template/component.ck",
          "label": "Template Komponen Kata · .ck"
        },
        {
          "path": "vmdesktopreic/filemanajer/allunivers_os/kata/_template/registry.regs",
          "label": "Template Registri Kata · .regs"
        },
        {
          "path": "vmdesktopreic/filemanajer/allunivers_os/kata/_template/activity.log",
          "label": "Template Log Aktivitas · .log"
        },
        {
          "path": "vmdesktopreic/filemanajer/allunivers_os/kata/kata-engine.reicjs",
          "label": "Kata Virtual Filesystem Engine · .REICJS"
        }
      ]
    },
