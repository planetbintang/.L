(()=>{'use strict';
const ROOT='/allunivers_os/kata/',FILES=['index.ieje','style.aeea','fungsi.nz','component.ck','registry.regs','activity.log'];
const EN=['planet','star','system','galaxy','orbit','light','space','energy','matter','field','quantum','cosmos','universe','network','signal','data','logic','memory','model','engine','robot','machine','vision','language','knowledge','science','design','create','build','learn','think','reason','connect','compute','render','stream','search','index','vector','matrix','node','graph','cloud','shell','desktop','window','panel','module','service','secure','stable','dynamic','virtual','digital','semantic','intelligent','adaptive','interface','component','structure','process','function','object','element','context','archive','library','portal','bridge','gateway','kernel','runtime','storage','config','control','manage','monitor','explore','discover','develop','integrate','transform','analyze','generate','compose','resolve','validate','compile','execute','publish','deploy','restore','backup','synchronize','automate','interact','respond','observe','predict','classify','translate','summarize','understand','inspire','innovate','evolve','future','bintang','cahaya','angkasa','semesta'];
const ID=['bintang','cahaya','angkasa','semesta','alam','bumi','matahari','bulan','planet','galaksi','ruang','waktu','energi','materi','medan','kuantum','jaringan','sinyal','data','logika','ingatan','model','mesin','robot','bahasa','pengetahuan','ilmu','rancang','cipta','bangun','belajar','pikir','nalar','hubung','hitung','tampil','alir','cari','indeks','vektor','matriks','simpul','graf','awan','desktop','jendela','panel','modul','layanan','aman','stabil','dinamis','maya','digital','makna','cerdas','adaptif','antarmuka','komponen','struktur','proses','fungsi','objek','elemen','konteks','arsip','pustaka','portal','gerbang','inti','simpan','atur','kendali','pantau','jelajah','temukan','kembang','gabung','ubah','analisis','hasilkan','susun','validasi','jalankan','terbitkan','pulihkan','cadangkan','selaraskan','otomatis','interaksi','respons','amati','prediksi','kelompok','terjemah','ringkas','pahami','inspirasi','inovasi','masa','depan'];
const COMP=['button','input','textarea','select','checkbox','radio','form','label','table','div','span','section','article','header','footer','main','nav','aside','modal','dialog','tooltip','popover','dropdown','accordion','tab','carousel','slider','progress','badge','alert','toast','breadcrumb','pagination','stepper','card','panel','box','container','grid','flex','row','column','avatar','icon','logo','banner','sidebar','drawer','overlay','menu','toolbar','searchbar','chart','graph','diagram','map','timeline','calendar','editor','viewer','preview','terminal','console','logger','monitor','dashboard','login','profile','settings','notifications','inbox','chat'];
const SYMBOLS=['!','@','#','$','%','^','&','*','(',')','-','+','=','[',']','{','}','|','\\',':',';','\\'','"','<','>',',','.','?','/','~','\\u0060','©','®','™','€','£','¥','→','←','↑','↓','↔','⇒','∞','√','∑','∫','π','α','β','γ','Δ','Ω','μ','σ'];
const EP=['','re','un','dis','non','pre','mis','over','under','co','anti','semi'],ES=['','s','ed','ing','er','est','ly','ness','ful','less','able','tion','ism','ist'],IP=['','me','di','ber','ter','pe','se','ke'],IS=['','kan','i','an','nya','kannya','annya','isasi'];
const uniq=a=>[...new Set(a)],er=uniq(EN),ir=uniq(ID),ec=er.length*EP.length*ES.length,ic=ir.length*IP.length*IS.length;
const C=[{id:'numeric',label:'ANGKA',count:1000000,kind:'num'},{id:'en',label:'KATA BAHASA INGGRIS',count:ec,kind:'en'},{id:'id',label:'KATA BAHASA INDONESIA',count:ic,kind:'id'},{id:'alpha-upper',label:'HURUF BESAR A-Z',count:26,kind:'up'},{id:'alpha-lower',label:'HURUF KECIL A-Z',count:26,kind:'lo'},{id:'symbols',label:'SIMBOL',count:SYMBOLS.length,kind:'sym'},{id:'components',label:'KOMPONEN UI',count:COMP.length,kind:'cmp'}],TOTAL=C.reduce((n,x)=>n+x.count,0);
const enc=encodeURIComponent;
function word(c,i){if(c.kind==='num')return String(i).padStart(6,'0');if(c.kind==='up')return String.fromCharCode(65+i);if(c.kind==='lo')return String.fromCharCode(97+i);if(c.kind==='sym')return SYMBOLS[i];if(c.kind==='cmp')return COMP[i];if(c.kind==='en'){let j=i%(EP.length*ES.length),r=er[Math.floor(i/(EP.length*ES.length))%er.length],s=ES[j%ES.length],p=EP[Math.floor(j/ES.length)];let t=r;if(/e$/.test(t)&&/^(ing|ed|er|est|able)/.test(s))t=t.slice(0,-1);return p+t+s;}let j=i%(IP.length*IS.length),r=ir[Math.floor(i/(IP.length*IS.length))%ir.length],p=IP[Math.floor(j/IS.length)],s=IS[j%IS.length];let t=r;if(p==='me'||p==='pe'){let f=t[0];if('aiueo'.includes(f))t='ng'+t;else if(f==='k')t='ng'+t.slice(1);else if('ghq'.includes(f))t='ng'+t;else if(f==='p')t='m'+t.slice(1);else if('bfv'.includes(f))t='m'+t;else if(f==='t')t='n'+t.slice(1);else if('cdjz'.includes(f))t='n'+t.slice(1);else if(f==='s')t='ny'+t.slice(1);}return p+t+s;}
function get(k,cat,i){let b=ROOT+enc(k)+'/',common='kata: '+k+'\ncategory: '+cat+'\nindex: '+i+'\nsystem: allunivers_os\nengine: reber_ai\n';let now=new Date().toISOString();switch(cat){case'index.ieje':return 'REBER_KATA_INDEX v1.0\n'+common+'ref: '+b+'index.ieje\nview: visual\nrender: component\ndisplay: primary\naccess: public\nbuild: reber_engine\ncompiled: true\nversion: 1.0\npath: '+b+'\nextension: .ieje\nstatus: active\n';case'style.aeea':return 'REBER_STYLE v1.0\n'+common+'layout: flex\ntheme: white-blue\nprimary: #0066CC\nsecondary: #FFFFFF\naccent: #4DA3FF\nbackground: #F0F7FF\ntext: #001A33\nborder: 1px solid #CCE5FF\nradius: 0\nfont: system-ui, sans-serif\nfont-size: 14px\nline-height: 1.5\npadding: 16px\nextension: .aeea\nversion: 1.0\n';case'fungsi.nz':return 'REBER_FUNGSI v1.0\n'+common+'logic: kata_processor\nfunction: semantic_parse\ninput: text_string\noutput: component_node\ntransform: kata_to_component\nvalidate: schema_check\nprocess: reber_engine\nexecute: ai_inference\nresponse: structured_json\nformat: json_ld\nsource: allunivers_os\nmode: active\npipeline: kata -> parse -> validate -> render -> output\nextension: .nz\n';case'component.ck':return 'REBER_COMPONENT v1.0\n'+common+'component: kata_component\nprops: [kata, category, lang, index, style]\nstate: [active, hover, selected, loading]\nslots: [header, body, footer]\ncomposition: index.ieje + style.aeea + fungsi.nz\nknowledge: semantic_node\nreusable: true\nextension: .ck\nversion: 1.0\n';case'registry.regs':return 'REBER_REGISTRY v1.0\n'+common+'registry: kata_registry\nscope: '+b+'\npermissions: read, write, execute\nowner: reber_ai\nvisibility: public\nindexed: true\nsearchable: true\nrules:\n  - unique_path: true\n  - min_files: 6\n  - required_ext: [.ieje, .aeea, .nz, .ck, .regs, .log]\nextension: .regs\nversion: 1.0\n';default:return 'REBER_LOG v1.0\n'+common+'['+now+'] node generated on demand\n['+now+'] six REBER files available\n['+now+'] status: active\nextension: .log\nversion: 1.0\n';}}
function browse(id,page=0,size=50){let c=C.find(x=>x.id===id)||C[0],start=Math.max(0,page)*size,items=[];for(let i=start;i<Math.min(c.count,start+size);i++){let name=word(c,i);items.push({name,path:ROOT+enc(name)+'/',category:c.id,index:i,files:FILES});}return{items,total:c.count,page,pageSize:size,pages:Math.ceil(c.count/size),category:c};}
function download(name,body){let u=URL.createObjectURL(new Blob([body],{type:'text/plain;charset=utf-8'})),a=document.createElement('a');a.href=u;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(u),1500);}
window.REICKataEngine={categories:C,total:TOTAL,files:FILES,browse,word,getFile:get,download,summary:()=>({total:TOTAL,physicalFolders:0,mode:'virtual-on-demand'})};
})();