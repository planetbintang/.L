:root{color-scheme:dark;--line:rgba(153,199,239,.2);--cyan:#79dcff;--muted:#a6bad0}*{box-sizing:border-box}button{font:inherit}.vm-shell{width:1920px;height:1080px;min-width:1920px;min-height:1080px;flex:none;position:relative;display:flex;flex-direction:column;background:radial-gradient(ellipse at 76% 12%,rgba(23,91,132,.34),transparent 38%),radial-gradient(ellipse at 18% 88%,rgba(26,65,105,.28),transparent 42%),linear-gradient(135deg,#081321,#0b1b2c 55%,#07101d);color:#eaf4ff;overflow:hidden}.vm-topbar{height:54px;flex:0 0 54px;display:flex;align-items:center;justify-content:space-between;padding:0 24px;border-bottom:1px solid var(--line);background:rgba(4,12,23,.82);backdrop-filter:blur(18px)}.vm-brand,.vm-system-status{display:flex;align-items:center;gap:12px}.vm-brand b{letter-spacing:.12em;font-size:12px}.vm-sub,.vm-top-center,.vm-system-status{font-size:10px;letter-spacing:.12em;color:var(--muted)}.vm-mark{display:grid;place-items:center;width:30px;height:30px;background:linear-gradient(145deg,#1d739b,#153b60);font-weight:900}.live-dot{width:7px;height:7px;background:#66e2b1;border-radius:50%;box-shadow:0 0 12px #66e2b1}.vm-workspace{display:flex;flex:1;min-height:0}.vm-dock{width:88px;flex:0 0 88px;display:flex;flex-direction:column;align-items:center;gap:9px;padding:18px 8px;border-right:1px solid var(--line);background:rgba(5,14,26,.58)}.dock-app{width:66px;min-height:66px;border:1px solid transparent;background:transparent;color:#b9cee2;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;cursor:pointer}.dock-app>span{font-size:23px}.dock-app small{font-size:9px}.dock-app:hover,.dock-app.active{background:rgba(68,155,205,.16);border-color:rgba(121,220,255,.35);color:#fff}.vm-stage{position:relative;flex:1;min-width:0;overflow:auto;padding:clamp(22px,4vw,64px)}.vm-welcome{max-width:1180px;min-height:350px;margin:2vh auto 30px;display:grid;grid-template-columns:1.4fr .8fr;align-items:center;gap:40px;padding:clamp(24px,4vw,60px);border:1px solid var(--line);background:linear-gradient(120deg,rgba(17,43,67,.86),rgba(7,19,33,.7));box-shadow:0 28px 90px rgba(0,0,0,.25)}.eyebrow{font-size:10px;letter-spacing:.2em;color:var(--cyan);font-weight:800}.vm-welcome h1{font-size:clamp(30px,4vw,58px);line-height:1.05;letter-spacing:-.04em;margin:14px 0}.vm-welcome h1 em{font-style:normal;color:#8adfff}.vm-welcome p:not(.eyebrow){max-width:640px;line-height:1.8;color:#b6c9dc}.vm-pills{display:flex;flex-wrap:wrap;gap:8px;margin-top:22px}.vm-pills span{border:1px solid var(--line);padding:8px 10px;color:#b9d9ee;font-size:9px;letter-spacing:.1em}.vm-orbit{height:250px;position:relative;display:grid;place-items:center}.orbit-ring{position:absolute;width:220px;height:220px;border:1px solid rgba(121,220,255,.28);border-radius:50%;box-shadow:0 0 55px rgba(48,155,211,.12) inset}.orbit-ring.two{width:165px;height:165px;border-style:dashed;transform:rotate(35deg)}.orbit-core{width:105px;height:105px;display:grid;place-content:center;text-align:center;background:linear-gradient(145deg,#1b7397,#102b49);box-shadow:0 0 55px rgba(77,194,240,.3);font-size:23px;font-weight:900;letter-spacing:.12em}.orbit-core small{font-size:8px;letter-spacing:.25em;color:#bcecff}.vm-desktop-grid{max-width:1180px;margin:0 auto;display:grid;grid-template-columns:repeat(5,minmax(120px,1fr));gap:12px}.desktop-shortcut{min-height:118px;text-align:left;padding:18px;border:1px solid var(--line);background:rgba(8,23,39,.72);color:#eaf4ff;cursor:pointer;display:flex;flex-direction:column;align-items:flex-start;gap:7px}.desktop-shortcut>span{font-size:24px;color:var(--cyan)}.desktop-shortcut b{font-size:12px}.desktop-shortcut small{font-size:10px;color:var(--muted)}.desktop-shortcut:hover{border-color:var(--cyan);background:rgba(29,83,117,.35)}.vm-window{position:absolute;z-index:4;left:50%;top:50%;transform:translate(-50%,-50%);width:min(760px,calc(100% - 36px));min-height:280px;max-height:75%;border:1px solid rgba(121,220,255,.5);background:#0b1a2b;box-shadow:0 28px 100px #0009;display:flex;flex-direction:column}.vm-window[hidden]{display:none}.vm-window>header{height:46px;display:flex;justify-content:space-between;align-items:center;padding:0 14px;background:#102943;border-bottom:1px solid var(--line)}.vm-window>header button{background:transparent;border:0;color:white;font-size:20px;cursor:pointer;margin-left:12px}.vm-window-content{padding:22px;overflow:auto;line-height:1.7;color:#c6d9eb}.vm-window-content h2{color:#fff;font-size:20px}.vm-window-content code{color:#8de4ff}.vm-taskbar{height:34px;flex:0 0 34px;display:flex;justify-content:space-between;align-items:center;padding:0 18px;border-top:1px solid var(--line);background:#050d18;color:#829bb4;font-size:9px;letter-spacing:.08em}@media(max-width:800px){.vm-top-center,.vm-sub{display:none}.vm-topbar{padding:0 12px}.vm-dock{width:62px;flex-basis:62px}.dock-app{width:48px;min-height:56px}.vm-stage{padding:14px}.vm-welcome{grid-template-columns:1fr;gap:0;margin:0 auto 16px;padding:22px}.vm-orbit{height:150px}.orbit-ring{width:135px;height:135px}.orbit-ring.two{width:105px;height:105px}.orbit-core{width:72px;height:72px;font-size:17px}.vm-desktop-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.vm-taskbar span:nth-child(2){display:none}}@media(max-height:650px){.vm-welcome{min-height:260px;margin-top:0;padding:22px}.vm-orbit{height:160px}}