:root{color-scheme:dark;--blue:#0758e8;--blue2:#063eaa;--line:#d9edff;--cyan:#24baff;--muted:#b9d7ff}*{box-sizing:border-box}button,a{font:inherit}.vm-shell{width:1920px;height:1080px;min-width:1920px;min-height:1080px;flex:none;position:relative;overflow:hidden;background:#0758e8;color:#f4f9ff;padding:18px 22px 18px 54px;font-family:Arial,system-ui,sans-serif}.vm-frame{height:100%;width:100%;position:relative;border:5px solid var(--line);border-radius:32px;padding:12px 14px 10px;display:flex;flex-direction:column;gap:12px;background:rgba(0,35,120,.12);box-shadow:inset 0 0 0 2px rgba(255,255,255,.15)}.vm-layer-1,.vm-layer-2,.vm-layer-3,.vm-layer-4,.vm-inner-frame,.vm-info-card{position:relative;border:3px solid var(--line);border-radius:26px;background:rgba(0,48,160,.24);box-shadow:inset 0 0 0 1px rgba(255,255,255,.12)}.layer-no{position:absolute;z-index:2;top:8px;right:12px;font-size:22px;font-weight:700;color:#fff;text-shadow:0 1px 4px #00317d}.vm-topbar{height:72px;flex:0 0 72px;display:flex;align-items:center;gap:26px;padding:0 22px;border-radius:20px}.vm-brand{display:flex;align-items:center;gap:12px;min-width:330px;font-size:21px;letter-spacing:.04em}.vm-brand i{font-style:normal;color:#8be4ff}.vm-mark{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(145deg,#fff,#72caff);color:#0758e8;font-weight:900}.vm-global-search{height:48px;flex:1;max-width:1050px;border:2px solid #5bc8ff;border-radius:30px;background:#003eaa;display:flex;align-items:center;gap:14px;padding:0 22px;font-size:16px}.vm-global-search>span:first-child{font-size:28px;color:#63d7ff}.vm-global-search small{margin-left:auto}.vm-top-actions{display:flex;align-items:center;gap:12px}.vm-top-actions button{width:44px;height:44px;border:1px solid #75cfff;border-radius:50%;background:#0645b7;color:white;font-size:22px}.vm-time{display:grid;text-align:center;min-width:110px;padding:5px 10px;border:1px solid #8adfff;border-radius:12px}.vm-time small{font-size:11px}.vm-main-nav{height:76px;flex:0 0 76px;display:flex;align-items:center;gap:6px;padding:9px 18px 9px 30px;margin-left:34px}.vm-main-nav a,.vm-main-nav button{height:52px;display:flex;align-items:center;justify-content:center;padding:0 17px;border:0;border-radius:14px;color:white;text-decoration:none;background:rgba(0,38,133,.42);font-size:14px;font-weight:700;white-space:nowrap}.vm-main-nav .nav-current{background:linear-gradient(120deg,#27a9ff,#0872ed)}.vm-main-nav button{border:1px solid #69caff;margin-left:auto}.vm-main-nav .layer-no{left:-22px;right:auto}.vm-sub-nav{height:68px;flex:0 0 68px;display:flex;align-items:center;gap:8px;padding:8px 22px 8px 28px;margin-left:68px}.vm-sub-nav button{height:48px;padding:0 22px;border:1px solid rgba(164,221,255,.3);border-radius:12px;background:rgba(0,43,143,.55);color:white;font-weight:700;white-space:nowrap}.vm-sub-nav button.selected{background:#168ff5;border-color:#a8e8ff}.vm-sub-spacer{flex:1}.vm-sub-nav .layer-no{left:-24px;right:auto}.vm-workspace{display:flex;flex:1;min-height:0;gap:12px;padding:12px 10px 10px 16px;margin-left:90px}.vm-dock{width:112px;flex:0 0 112px;display:flex;flex-direction:column;align-items:center;gap:10px;padding:18px 6px;border-right:2px solid rgba(199,233,255,.6)}.vm-dock .layer-no{left:4px;right:auto}.dock-app{width:90px;min-height:72px;border:1px solid transparent;border-radius:12px;background:transparent;color:#eaf6ff;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;cursor:pointer}.dock-app>span{font-size:26px}.dock-app small{font-size:12px}.dock-app:hover,.dock-app.active{background:#0878ee;border-color:#b9eaff}.vm-stage{position:relative;flex:1;min-width:0;min-height:0;padding:16px}.vm-inner-frame{height:100%;padding:44px 34px 18px;display:flex;flex-direction:column;align-items:center;justify-content:center;background:linear-gradient(145deg,rgba(0,38,132,.7),rgba(0,77,194,.48));border-radius:32px}.vm-inner-frame>.layer-no{left:20px;right:auto;top:12px;font-size:26px}.vm-welcome{width:90%;height:76%;max-width:1180px;border:3px solid #5ecaff;border-radius:24px;background:radial-gradient(ellipse at center,#0649ad,#03286e 80%);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:42px;text-align:center;box-shadow:0 0 50px rgba(0,0,0,.2) inset}.eyebrow{font-size:15px;letter-spacing:.2em;color:#80dcff;font-weight:800}.vm-welcome h1{font-size:54px;line-height:1;margin:14px 0}.vm-welcome h1 em{font-style:normal;color:#39caff}.vm-welcome>p:not(.eyebrow){font-size:18px;color:#c8e5ff}.vm-command{width:65%;height:64px;margin:24px 0 34px;border:3px solid #168ef5;border-radius:40px;background:#052d7e;display:flex;align-items:center;gap:16px;padding:0 24px;text-align:left;color:#d3eaff}.vm-command span:first-child{font-size:30px;color:#38caff}.vm-command b{margin-left:auto;color:#3bcaff;font-size:25px}.vm-desktop-grid{display:grid;grid-template-columns:repeat(6,130px);gap:22px}.desktop-shortcut{min-height:112px;border:2px solid #55baff;border-radius:16px;background:rgba(6,75,170,.65);color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;cursor:pointer}.desktop-shortcut>span{font-size:38px;color:#bcecff}.desktop-shortcut b{font-size:15px}.desktop-shortcut:hover{background:#087fe9}.vm-inner-status{width:100%;display:flex;justify-content:space-between;padding:12px 8px 0;font-size:13px;color:#d3eaff}.vm-right-rail{width:270px;flex:0 0 270px;display:flex;flex-direction:column;gap:10px;padding:0 2px}.vm-info-card{padding:18px 18px 14px;border-radius:20px;background:rgba(0,34,111,.62);min-height:120px}.vm-info-card h3{font-size:15px;margin:0 0 14px;letter-spacing:.04em}.vm-info-card p{font-size:13px;margin:9px 0;color:#d4eaff}.vm-info-card p b{float:right}.vm-info-card> b{font-size:15px}.vm-info-card label{display:flex;justify-content:space-between;font-size:12px;margin:8px 0 4px}.meter{height:9px;background:#092b72;border-radius:9px;overflow:hidden;margin-bottom:8px}.meter i{height:100%;display:block;background:#18baff;border-radius:9px}.vm-window{position:absolute;z-index:10;left:50%;top:50%;transform:translate(-50%,-50%);width:760px;min-height:280px;max-height:78%;border:2px solid #80dfff;border-radius:18px;background:#06245e;box-shadow:0 24px 80px #00194dcc;display:flex;flex-direction:column}.vm-window[hidden]{display:none}.vm-window>header{height:52px;display:flex;justify-content:space-between;align-items:center;padding:0 18px;background:#0754b8;border-bottom:1px solid #70ceff}.vm-window>header button{background:transparent;border:0;color:white;font-size:22px;cursor:pointer;margin-left:12px}.vm-window-content{padding:24px;overflow:auto;line-height:1.7;color:#d6eaff}.vm-window-content h2{color:#fff}.vm-window-content code{color:#8de4ff}.vm-taskbar{height:42px;flex:0 0 42px;display:flex;align-items:center;justify-content:space-between;padding:0 18px 0 28px;margin-left:108px;border-radius:18px;font-size:12px;letter-spacing:.08em}.vm-side-switch{position:absolute;z-index:5;left:4px;top:36%;width:48px;padding:8px 5px;border:3px solid #fff;border-radius:18px;background:#0750d7;display:flex;flex-direction:column;gap:9px}.vm-side-switch b,.vm-side-switch i{height:34px;border:4px solid white;border-radius:7px;background:#b8d9ff}.vm-side-switch b{height:42px;background:#fff}@media(max-width:1920px){.vm-shell{transform-origin:top left}}