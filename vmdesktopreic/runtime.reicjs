(()=>{'use strict';
const $=(s,r=document)=>r.querySelector(s),$$=(s,r=document)=>[...r.querySelectorAll(s)];
const stage=$('.desktop-stage'),apps=$('#apps'),fileWindow=$('#file-window'),items=$('#items'),pathEl=$('#path'),status=$('#status');
const OWNER='planetbintang',API='https://api.github.com';
let currentPath='Beranda',searchTerm='',repoCache=null,repoBusy=false,treeCache=new Map(),windowZ=20;
const roots=['acct','sys','system_ext','cache','config','media','data','repositori','vmdesktopreic','Aireber'];
const modules={
'Beranda':['Ringkasan sistem','Status desktop','Aplikasi terbaru','Pusat aktivitas'],
'File Manager':['Beranda','Repositori GitHub','File System','Indeks REIC','Pencarian file'],
'Terminal Shell':['Terminal REIC','Riwayat perintah','Dokumentasi','Status shell'],
'Pengaturan':['Tampilan desktop','Konfigurasi sistem','Jaringan','Keamanan','Penyimpanan'],
'Perpustakaan':['List Blok','Layout Library','Komponen REIC','Dokumentasi'],
'Aplikasi':['Daftar aplikasi','Aplikasi terpasang','Manajemen aplikasi'],
'REIC Explorer':['Indeks utama','Penjelajah komponen','Manifest','Skema REIC'],
'List Blok':['Blok UI','Blok layout','Blok navigasi','Blok formulir'],
'Layout Library':['Desktop','Dashboard','Panel','Jendela aplikasi'],
'Konfigurasi Infrastruktur':['Runtime','Jaringan','Penyimpanan','Integrasi GitHub'],
'Host Lokal REIC':['Host lokal','Repositori publik dan privat','Penyimpanan lokal','Domain dan TLS'],
'Monitor Sistem':['Status runtime','Koneksi GitHub','Aktivitas aplikasi','Informasi browser'],
'Bantuan Sistem':['Panduan desktop','Navigasi File Manager','Tentang REIC'],
'Browser':['PlanetBintang.L','GitHub','GitHub Pages'],
'Dokumen':['Dokumen sistem','Dokumentasi REIC','README repositori'],
'Galeri':['Media sistem','Wallpaper','Aset visual'],
'Musik':['Perpustakaan media','Pemutar media'],
'Video':['Perpustakaan video','Pemutar video'],
'Sampah':['Item terhapus','Pemulihan item']
};
function safe(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function apiHeaders(){return {'Accept':'application/vnd.github+json','X-GitHub-Api-Version':'2022-11-28'};}
async function getJSON(url){const r=await fetch(url,{headers:apiHeaders()});if(!r.ok)throw new Error(r.status===403?'Batas permintaan GitHub tercapai. Coba lagi beberapa saat.':r.status===404?'Data tidak ditemukan atau repositori tidak publik.':'GitHub API: HTTP '+r.status);return r.json();}
function makeWindow(title,icon,content){
 const w=document.createElement('section');w.className='reic-app-window';w.setAttribute('role','dialog');w.setAttribute('aria-label',title);
 w.style.zIndex=String(++windowZ);
 w.innerHTML='<header class="reic-app-title"><strong><span>'+safe(icon)+'</span> '+safe(title)+'</strong><div><button data-minimize aria-label="Minimalkan">−</button><button data-maximize aria-label="Maksimalkan">□</button><button data-close aria-label="Tutup">×</button></div></header><div class="reic-app-content">'+content+'</div>';
 apps.append(w);placeWindow(w);wireWindow(w);return w;
}
function placeWindow(w){
 const bounds=apps.getBoundingClientRect();
 const width=Math.min(760,Math.max(260,bounds.width-24));
 w.style.width=width+'px';w.style.height='';w.style.maxWidth='calc(100% - 16px)';w.style.maxHeight='calc(100% - 16px)';
 w.style.left=Math.max(8,(bounds.width-width)/2)+'px';
 w.style.top=Math.max(8,Math.min(24,bounds.height*.04))+'px';
}
function wireWindow(w){
 const bar=$('.reic-app-title',w);
 let drag=null,restoreBox=null;
 w.addEventListener('pointerdown',()=>{w.style.zIndex=String(++windowZ);});
 bar.addEventListener('pointerdown',e=>{
  if(e.target.closest('button')||w.classList.contains('is-maximized'))return;
  const r=w.getBoundingClientRect(),b=apps.getBoundingClientRect();
  drag={x:e.clientX-r.left,y:e.clientY-r.top,b};
  bar.setPointerCapture(e.pointerId);
 });
 bar.addEventListener('pointermove',e=>{
  if(!drag)return;
  const x=Math.max(0,Math.min(drag.b.width-w.offsetWidth,e.clientX-drag.b.left-drag.x));
  const y=Math.max(0,Math.min(drag.b.height-w.offsetHeight,e.clientY-drag.b.top-drag.y));
  w.style.left=x+'px';w.style.top=y+'px';
 });
 const stopDrag=()=>{drag=null;};
 bar.addEventListener('pointerup',stopDrag);bar.addEventListener('pointercancel',stopDrag);bar.addEventListener('lostpointercapture',stopDrag);
 $('[data-close]',w).onclick=()=>{const chip=w._restoreChip;if(chip)chip.remove();w.remove();};
 $('[data-minimize]',w).onclick=()=>{
  if(w.hidden)return;w.hidden=true;
  const chip=document.createElement('button');chip.type='button';chip.className='reic-restore-chip';
  chip.textContent=$('.reic-app-title strong',w).textContent.trim();chip.setAttribute('aria-label','Pulihkan '+chip.textContent);
  chip.onclick=()=>{w.hidden=false;chip.remove();w._restoreChip=null;w.style.zIndex=String(++windowZ);};
  w._restoreChip=chip;apps.append(chip);
 };
 $('[data-maximize]',w).onclick=()=>{
  if(!w.classList.contains('is-maximized')){
   const b=apps.getBoundingClientRect(),r=w.getBoundingClientRect();
   restoreBox={left:r.left-b.left,top:r.top-b.top,width:r.width,height:r.height};
   w.classList.add('is-maximized');w.style.left='6px';w.style.top='6px';
   w.style.width='calc(100% - 12px)';w.style.height='calc(100% - 12px)';
   w.setAttribute('aria-label',$('.reic-app-title strong',w).textContent+' — dimaksimalkan');
  }else{
   w.classList.remove('is-maximized');
   if(restoreBox){w.style.left=restoreBox.left+'px';w.style.top=restoreBox.top+'px';w.style.width=Math.min(restoreBox.width,apps.clientWidth-16)+'px';w.style.height=restoreBox.height+'px';}
   else placeWindow(w);
   w.setAttribute('aria-label',$('.reic-app-title strong',w).textContent);
  }
 };
 w.addEventListener('click',e=>{
  const launch=e.target.closest('[data-launch]');
  if(launch){openApp(launch.dataset.launch);return;}
  const control=e.target.closest('button');
  if(control && control.type!=='submit' && !control.onclick && !control.dataset.close && !control.dataset.minimize && !control.dataset.maximize){
   const label=control.textContent.trim();
   if(label){makeWindow(label,'▣','<div class="reic-module-detail"><div class="reic-eyebrow">MODUL REIC</div><h2>'+safe(label)+'</h2><p>Panel '+safe(label)+' tersedia di ruang kerja VMDESKTOPREIC.</p><p>Gunakan navigasi File Manager, REIC Explorer, dan konfigurasi sistem untuk membuka sumber serta pengaturan terkait.</p></div>');}
  }
 });
}
function openApp(name){
 if(name==='File Manager'){fileWindow.hidden=false;return;}
 const body=appContent(name);const w=makeWindow(name,iconFor(name),body);
 if(name==='REIC Explorer'||name==='File Manager')loadRepos(w);
 if(name==='Monitor Sistem')refreshMonitor(w);
 if(name==='Host Lokal REIC')wireHostLocal(w);
 if(name==='Pengaturan')wireSettings(w);
 if(name==='Terminal Shell')wireTerminal(w);
 if(name==='Browser')wireBrowser(w);
 if(name==='Perpustakaan'||name==='List Blok'||name==='Layout Library')wireLibrary(w);
}
function iconFor(n){return ({'Beranda':'⌂','File Manager':'📁','Terminal Shell':'>_','Pengaturan':'⚙','Perpustakaan':'◫','Aplikasi':'▦','REIC Explorer':'★','List Blok':'▦','Layout Library':'▰','Konfigurasi Infrastruktur':'⚙','Host Lokal REIC':'⌂','Monitor Sistem':'∿','Bantuan Sistem':'?','Browser':'◎','Dokumen':'▤','Galeri':'▧','Musik':'♫','Video':'▶','Sampah':'♲'})[n]||'▣';}
function appContent(name){
 if(name==='Beranda')return '<div class="reic-dashboard"><div class="reic-eyebrow">PLANETBINTANG · REIC DESKTOP</div><h2>Selamat datang di VMDESKTOPREIC</h2><p>Ruang kerja terpadu untuk sistem, file, komponen, dan repositori.</p><div class="reic-stat-grid"><article><b>150</b><span>Indeks utama REIC</span></article><article><b>1.000.000</b><span>Ruang sublink virtual terencana</span></article><article><b>GitHub</b><span>Integrasi repositori</span></article></div><div class="reic-action-grid">'+['File Manager','REIC Explorer','Pengaturan','Monitor Sistem'].map(n=>'<button data-launch="'+safe(n)+'">'+iconFor(n)+' '+safe(n)+'</button>').join('')+'</div></div>';
 if(name==='File Manager'||name==='REIC Explorer')return '<div class="reic-github"><div class="reic-eyebrow">GITHUB · LIVE API</div><h2>Repositori PlanetBintang</h2><p>Daftar repositori publik dan konten direktori dimuat langsung dari GitHub.</p><div class="reic-toolbar"><input data-repo-search placeholder="Cari repositori…"><button data-refresh>↻ Muat ulang</button><a href="https://github.com/planetbintang" target="_blank" rel="noopener">Profil GitHub ↗</a></div><div data-repo-status role="status">Menyiapkan koneksi…</div><div data-repo-list class="reic-repo-list"></div></div>';
 if(name==='Host Lokal REIC')return '<div class="reic-host"><div class="reic-eyebrow">REIC LOCAL HOST · STORAGE · DOMAIN</div><h2>Host Lokal REIC</h2><p>Hubungkan desktop ke layanan lokal yang menyimpan kredensial GitHub secara aman dan menyediakan akses penyimpanan.</p><label>Alamat host lokal<input data-host-url value="http://127.0.0.1:8787" placeholder="http://127.0.0.1:8787"></label><div class="reic-host-actions"><button type="button" data-host-connect>Uji koneksi</button><button type="button" data-host-repos>Muat repositori privat + publik</button><button type="button" data-host-storage>Buka penyimpanan lokal</button></div><div data-host-status role="status">Host belum diuji. Jalankan reic-local-host/server.mjs terlebih dahulu.</div><div data-host-counts class="reic-stat-grid"></div><div data-host-storage-list class="reic-repo-list"></div><h3>Profil infrastruktur</h3><ul><li>Nginx / Apache — reverse proxy ke layanan lokal</li><li>Cloudflare — DNS, proxy, dan Worker terautentikasi</li><li>Verisign — lapisan registry melalui registrar dan EPP</li><li>GlobalCert — profil sertifikat; aktif bila ACME/API penyedia tersedia</li></ul><p class="reic-note">Token GitHub tidak dimasukkan ke browser. Gunakan GITHUB_TOKEN di lingkungan server lokal. GitHub Pages tidak menjalankan backend.</p></div>';
 if(name==='Pengaturan'||name==='Konfigurasi Infrastruktur')return '<div class="reic-settings"><div class="reic-eyebrow">KONFIGURASI SISTEM</div><h2>Pengaturan VMDESKTOPREIC</h2><label class="reic-setting"><span>Animasi jendela</span><input type="checkbox" data-setting="motion" checked></label><label class="reic-setting"><span>Efek cahaya biru</span><input type="checkbox" data-setting="glow" checked></label><label class="reic-setting"><span>Skala antarmuka</span><select data-setting="scale"><option value="1">100%</option><option value="1.05">105%</option><option value="1.1">110%</option><option value=".95">95%</option></select></label><p class="reic-note">Pengaturan visual berlaku pada sesi desktop ini. Akses privat GitHub memerlukan layanan backend OAuth yang aman.</p></div>';
 if(name==='Monitor Sistem')return '<div class="reic-monitor"><div class="reic-eyebrow">MONITOR RUNTIME</div><h2>Status Sistem</h2><div data-monitor-status>Memeriksa runtime…</div><div class="reic-stat-grid"><article><b>Online</b><span>Browser runtime</span></article><article><b>GitHub API</b><span data-api-status>Belum diperiksa</span></article><article><b>Local UI</b><span>Aktif</span></article></div></div>';
 if(name==='Terminal Shell')return '<div class="reic-terminal"><div class="reic-eyebrow">REIC SHELL · READ ONLY</div><div class="terminal-output">PlanetBintang REIC Shell<br>Perintah bantuan: help<br>Perintah yang tersedia: help, status, repos, open [aplikasi], clear</div><form data-terminal-form><span>reic@planetbintang:~$</span><input data-terminal-input autocomplete="off" aria-label="Perintah terminal"><button>Kirim</button></form></div>';
 if(name==='Browser')return '<div class="reic-browser"><div class="reic-eyebrow">BROWSER SHORTCUTS</div><h2>Navigasi PlanetBintang</h2><a href="https://planetbintang.github.io/.L/" target="_blank" rel="noopener">PlanetBintang.L ↗</a><a href="https://github.com/planetbintang" target="_blank" rel="noopener">GitHub · planetbintang ↗</a><a href="https://planetbintang.github.io/.L/vmdesktopreic/" target="_blank" rel="noopener">VMDESKTOPREIC Pages ↗</a></div>';
 if(name==='Perpustakaan')return '<div class="reic-library"><div class="reic-eyebrow">OS MEDIA VM · PERPUSTAKAAN</div><h2>Perpustakaan Bahasa</h2><p>Pilih bahasa dari katalog, telusuri ekstensi, lalu masukkan ke konfigurasi proyek.</p><div class="reic-language-input"><label for="reic-language-search">INPUT / CARI BAHASA</label><input id="reic-language-search" data-language-search placeholder="Cari HTML, PHP, TypeScript, REIC…"><label for="reic-language-select">KATALOG BAHASA</label><select id="reic-language-select" data-language-select><option value="">Memuat katalog bahasa…</option></select><div data-language-detail class="reic-language-detail" aria-live="polite">Pilih bahasa untuk melihat detail.</div><button type="button" data-language-add>＋ Tambahkan ke konfigurasi</button><div class="reic-language-selected"><strong>BAHASA TERPILIH</strong><div data-language-selected>Belum ada bahasa dipilih.</div></div><button type="button" data-language-export>Ekspor konfigurasi pilihan</button><pre data-language-config class="reic-language-config" hidden></pre><div data-language-status role="status">Katalog belum dimuat.</div></div><div class="reic-eyebrow">KOMPONEN PUSTAKA</div><div class="reic-action-grid">'+['Panel','Kartu','Navigasi','Formulir','Dialog','Tabel','Explorer','Dashboard','Terminal','Monitor','Editor','Pengaturan'].map(x=>'<button>'+x+'</button>').join('')+'</div></div>';
 if(name==='List Blok'||name==='Layout Library')return '<div class="reic-library"><div class="reic-eyebrow">OS MEDIA VM · LIBRARY</div><h2>'+safe(name)+'</h2><p>Komponen dan tata letak yang tersedia di dalam paket desktop.</p><div class="reic-action-grid">'+['Panel','Kartu','Navigasi','Formulir','Dialog','Tabel','Explorer','Dashboard','Terminal','Monitor','Editor','Pengaturan'].map(x=>'<button>'+x+'</button>').join('')+'</div></div>';
 if(name==='Aplikasi')return '<div class="reic-library"><div class="reic-eyebrow">APLIKASI DESKTOP</div><h2>Semua aplikasi</h2><div class="reic-action-grid">'+Object.keys(modules).map(n=>'<button data-launch="'+safe(n)+'">'+iconFor(n)+' '+safe(n)+'</button>').join('')+'</div></div>';
 return '<div class="reic-library"><div class="reic-eyebrow">SISTEM REIC</div><h2>'+safe(name)+'</h2><p>Modul '+safe(name)+' pada VMDESKTOPREIC.</p><div class="reic-action-grid">'+(modules[name]||['Buka modul','Lihat dokumentasi']).map(x=>'<button>'+safe(x)+'</button>').join('')+'</div></div>';
}
function localHostBase(){return (localStorage.getItem('pb-reic-local-host')||'http://127.0.0.1:8787').replace(/\/$/,'');}
async function loadRepos(w){
 const list=$('[data-repo-list]',w),state=$('[data-repo-status]',w),search=$('[data-repo-search]',w);
 if(!list||!state)return;
 const render=(arr)=>{list.replaceChildren();arr.forEach(repo=>{
  const card=document.createElement('article');card.className='reic-repo-card';
  const a=document.createElement('a');a.href=repo.html_url;a.target='_blank';a.rel='noopener';a.textContent=repo.name+' ↗';
  const meta=document.createElement('small');meta.textContent=(repo.private?'PRIVAT':'PUBLIK')+' · '+(repo.default_branch||'main')+' · '+(repo.language||'Repositori');
  const desc=document.createElement('p');desc.textContent=repo.description||'Tidak ada deskripsi';
  const actions=document.createElement('div');actions.className='reic-repo-actions';
  const browse=document.createElement('button');browse.textContent='Jelajahi file';browse.onclick=()=>loadRepoTree(w,repo);
  const pages=document.createElement('a');pages.href=repo.homepage||repo.html_url;pages.target='_blank';pages.rel='noopener';pages.textContent='Buka ↗';
  actions.append(browse,pages);card.append(a,meta,desc,actions);list.append(card);
 });};
 try{
  state.textContent='Memeriksa host lokal untuk akses repositori terautentikasi…';
  const base=localHostBase();
  let response;
  try{
   response=await fetch(base+'/api/reic/github/repos',{headers:{Accept:'application/json'}});
   if(!response.ok)throw new Error('Host lokal HTTP '+response.status);
   const payload=await response.json();
   if(!Array.isArray(payload.repositories))throw new Error('Format respons host tidak sesuai.');
   repoCache=payload.repositories;
   const filter=()=>{const term=search.value.trim().toLowerCase();const arr=repoCache.filter(r=>(r.name+' '+(r.description||'')).toLowerCase().includes(term));render(arr);state.textContent=payload.total+' repositori terhubung · '+payload.public+' publik · '+payload.private+' privat · sumber: host GitHub terautentikasi.';};
   search.addEventListener('input',filter);$('[data-refresh]',w).onclick=()=>{repoCache=null;loadRepos(w);};filter();return;
  }catch(localError){state.textContent='Host lokal belum tersedia atau belum terautentikasi. Menampilkan repositori publik…';}
  const all=[];
  for(let page=1;page<=5;page++){const part=await getJSON(API+'/users/'+OWNER+'/repos?per_page=100&sort=updated&page='+page);all.push(...part);if(part.length<100)break;}
  repoCache=all.filter(r=>!r.private);
  const filter=()=>{const term=search.value.trim().toLowerCase();const arr=repoCache.filter(r=>(r.name+' '+(r.description||'')).toLowerCase().includes(term));render(arr);state.textContent=repoCache.length+' repositori publik dimuat. Repositori privat disembunyikan sampai host lokal terautentikasi aktif.';};
  search.addEventListener('input',filter);$('[data-refresh]',w).onclick=()=>{repoCache=null;loadRepos(w);};filter();
 }catch(e){state.textContent='Koneksi GitHub gagal: '+e.message;list.innerHTML='<p class="reic-error">Data repositori tidak dapat dimuat. Periksa koneksi dan host lokal.</p>';}
}
async function loadRepoTree(w,repo,path=''){
 const list=$('[data-repo-list]',w),state=$('[data-repo-status]',w);if(!list)return;
 list.innerHTML='<p>Memuat '+safe(path||repo.name)+'…</p>';
 try{
  let entries;
  if(repo.private){
   const response=await fetch(localHostBase()+'/api/reic/github/tree?repo='+encodeURIComponent(repo.name)+'&ref='+encodeURIComponent(repo.default_branch||'main')+'&path='+encodeURIComponent(path));
   if(!response.ok)throw new Error('Host lokal menolak akses privat: HTTP '+response.status);
   entries=await response.json();
  }else{
   entries=await getJSON(API+'/repos/'+OWNER+'/'+encodeURIComponent(repo.name)+'/contents/'+path+'?ref='+encodeURIComponent(repo.default_branch||'main'));
  }
  if(!Array.isArray(entries))throw new Error(entries.message||'Respons direktori tidak valid.');
  list.replaceChildren();
  const head=document.createElement('div');head.className='reic-tree-head';
  const back=document.createElement('button');back.textContent='← Kembali ke repositori';back.onclick=()=>loadRepos(w);
  const label=document.createElement('strong');label.textContent=repo.name+'/'+path;head.append(back,label);list.append(head);
  entries.forEach(entry=>{
   const row=document.createElement('article');row.className='reic-tree-row';
   const b=document.createElement('button');b.textContent=(entry.type==='dir'?'📁 ':'▤ ')+entry.name;
   b.onclick=()=>entry.type==='dir'?loadRepoTree(w,repo,entry.path):openRepoFile(w,repo,entry);
   row.append(b);list.append(row);
  });
  state.textContent=repo.full_name+' · '+entries.length+' item · '+(repo.private?'akses privat terautentikasi':'repositori publik');
 }catch(e){state.textContent='Tidak dapat membaca direktori: '+e.message;list.innerHTML='<p class="reic-error">'+safe(e.message)+'</p><a href="'+safe(repo.html_url)+'" target="_blank" rel="noopener">Buka repositori di GitHub ↗</a>';}
}
async function openRepoFile(w,repo,entry){
 const state=$('[data-repo-status]',w);
 try{
  let data;
  if(repo.private){
   const url=localHostBase()+'/api/reic/github/tree?repo='+encodeURIComponent(repo.name)+'&ref='+encodeURIComponent(repo.default_branch||'main')+'&path='+encodeURIComponent(entry.path);
   const r=await fetch(url);if(!r.ok)throw new Error('Host lokal HTTP '+r.status);data=await r.json();
  }else{
   data=await getJSON(API+'/repos/'+OWNER+'/'+encodeURIComponent(repo.name)+'/contents/'+entry.path+'?ref='+encodeURIComponent(repo.default_branch||'main'));
  }
  let content='';
  if(data.content&&data.encoding==='base64'){const bytes=Uint8Array.from(atob(data.content.replace(/\s/g,'')),c=>c.charCodeAt(0));content=new TextDecoder().decode(bytes);}
  else if(data.download_url){const r=await fetch(data.download_url);content=await r.text();}
  else content=JSON.stringify(data,null,2);
  if(content.length>120000)content=content.slice(0,120000)+'\n\n[Pratinjau dipotong pada 120 KB]';
  const ext=entry.name.split('.').pop().toLowerCase();
  const note=['reic','reicss','reicjs'].includes(ext)?'Sumber REIC dikenali. Komponen hanya diaktifkan melalui manifest yang diizinkan dan validasi runtime; pratinjau ini tidak mengeksekusi kode.':'Berkas ditampilkan sebagai pratinjau aman dan tidak dieksekusi otomatis.';
  makeWindow('Pratinjau · '+entry.name,'▤','<div class="reic-file-preview"><div class="reic-eyebrow">'+safe(repo.full_name+'/'+entry.path)+'</div><p>'+safe(note)+'</p><pre></pre></div>').querySelector('pre').textContent=content;
 }catch(e){if(state)state.textContent='Gagal membuka berkas: '+e.message;}
}
function wireHostLocal(w){
 const input=$('[data-host-url]',w),status=$('[data-host-status]',w),counts=$('[data-host-counts]',w),storage=$('[data-host-storage-list]',w);
 input.value=localHostBase();
 const base=()=>input.value.trim().replace(/\/$/,'');
 const connect=async()=>{
  const value=base();if(!/^https?:\/\//i.test(value)){status.textContent='Alamat host harus berupa URL HTTP atau HTTPS.';return false;}
  localStorage.setItem('pb-reic-local-host',value);
  try{const r=await fetch(value+'/health');if(!r.ok)throw new Error('HTTP '+r.status);const d=await r.json();status.textContent='Host terhubung: '+d.service+' · '+d.status;return true;}
  catch(e){status.textContent='Host belum terhubung: '+e.message+'. Jalankan layanan lokal dan periksa CORS.';return false;}
 };
 $('[data-host-connect]',w).onclick=connect;
 $('[data-host-repos]',w).onclick=async()=>{
  if(!await connect())return;
  try{const r=await fetch(base()+'/api/reic/github/repos');const d=await r.json();if(!r.ok)throw new Error(d.error||'HTTP '+r.status);
   counts.innerHTML='<article><b>'+d.total+'</b><span>Total repositori</span></article><article><b>'+d.public+'</b><span>Publik</span></article><article><b>'+d.private+'</b><span>Privat</span></article>';
   status.textContent='Daftar privat dan publik tersedia melalui host terautentikasi. Buka REIC Explorer untuk menjelajah.';
   window.PB_REIC&&window.PB_REIC.refreshRepositories();
  }catch(e){status.textContent='Repositori belum dapat dimuat: '+e.message;}
 };
 $('[data-host-storage]',w).onclick=async()=>{
  if(!await connect())return;
  try{const r=await fetch(base()+'/api/reic/storage?path=.');const d=await r.json();if(!r.ok)throw new Error(d.error||'HTTP '+r.status);
   storage.replaceChildren();d.entries.forEach(item=>{const row=document.createElement('article');row.className='reic-tree-row';row.textContent=(item.type==='directory'?'📁 ':'▤ ')+item.name+' · '+item.size+' byte';storage.append(row);});
   status.textContent='Penyimpanan lokal: '+d.entries.length+' item pada '+d.root;
  }catch(e){status.textContent='Penyimpanan tidak tersedia: '+e.message;}
 };
}
function refreshMonitor(w){const out=$('[data-monitor-status]',w),api=$('[data-api-status]',w);out.textContent='Browser: '+navigator.userAgent.slice(0,90)+' · Online: '+(navigator.onLine?'Ya':'Tidak');getJSON(API+'/rate_limit').then(()=>api.textContent='Terhubung').catch(()=>api.textContent='Tidak tersedia');}
function wireSettings(w){$$('[data-setting]',w).forEach(el=>el.addEventListener('change',()=>{if(el.dataset.setting==='motion')document.documentElement.classList.toggle('reic-no-motion',!el.checked);if(el.dataset.setting==='glow')document.documentElement.classList.toggle('reic-no-glow',!el.checked);if(el.dataset.setting==='scale')stage.style.setProperty('--reic-ui-scale',el.value);}));}
function wireTerminal(w){const form=$('[data-terminal-form]',w),input=$('[data-terminal-input]',w),out=$('.terminal-output',w);form.onsubmit=e=>{e.preventDefault();const cmd=input.value.trim();let result='Perintah tidak dikenal. Ketik help.';if(cmd==='help')result='help · status · repos · open [aplikasi] · clear';else if(cmd==='status')result='Runtime browser aktif. GitHub API publik dapat digunakan.';else if(cmd==='repos')result=repoCache?repoCache.length+' repositori dimuat pada sesi ini.':'Gunakan REIC Explorer atau Host Lokal REIC untuk memuat repositori.';else if(cmd.startsWith('open ')){const n=cmd.slice(5);if(Object.keys(modules).includes(n)){openApp(n);result='Membuka '+n;}else result='Nama aplikasi tidak ditemukan.';}else if(cmd==='clear'){out.textContent='';input.value='';return;}out.innerHTML+='\n$ '+safe(cmd)+'\n'+safe(result);input.value='';};}
function wireBrowser(w){/* tautan browser menggunakan navigasi aman ke domain yang ditentukan */ }
function wireLibrary(w){
 $('.reic-action-grid button',w).forEach(b=>b.onclick=()=>{const label=b.textContent.trim();const n=Object.keys(modules).find(k=>k===label);if(n)openApp(n);else makeWindow(label,'▣','<div class="reic-library"><h2>'+safe(label)+'</h2><p>Komponen '+safe(label)+' tersedia sebagai modul pustaka REIC.</p></div>');});
 const search=$('[data-language-search]',w),select=$('[data-language-select]',w),detail=$('[data-language-detail]',w),chosen=$('[data-language-selected]',w),status=$('[data-language-status]',w),config=$('[data-language-config]',w);
 if(!search||!select)return;
 let languages=[],selected=[];
 const showDetail=()=>{const item=languages.find(x=>x.id===select.value);detail.textContent=item?item.name+' · '+item.extensions+' · '+item.description+' · '+item.execution:'Pilih bahasa dari katalog.';};
 const renderOptions=()=>{const term=search.value.trim().toLowerCase();const matches=languages.filter(x=>(x.name+' '+x.id+' '+x.extensions+' '+x.description).toLowerCase().includes(term));select.replaceChildren(new Option('Pilih bahasa…',''));matches.forEach(x=>select.add(new Option(x.name+' ('+x.extensions+')',x.id)));showDetail();};
 const renderSelected=()=>{chosen.replaceChildren();if(!selected.length){chosen.textContent='Belum ada bahasa dipilih.';return;}selected.forEach(item=>{const chip=document.createElement('span');chip.className='reic-language-chip';chip.textContent=item.name+' · '+item.extensions;const remove=document.createElement('button');remove.type='button';remove.textContent='×';remove.setAttribute('aria-label','Hapus '+item.name);remove.onclick=()=>{selected=selected.filter(x=>x.id!==item.id);renderSelected();};chip.append(remove);chosen.append(chip);});};
 search.addEventListener('input',renderOptions);select.addEventListener('change',showDetail);
 $('[data-language-add]',w).onclick=()=>{const item=languages.find(x=>x.id===select.value);if(!item){status.textContent='Pilih bahasa sebelum menambahkan.';return;}if(!selected.some(x=>x.id===item.id))selected.push(item);renderSelected();status.textContent=item.name+' ditambahkan ke pilihan proyek.';};
 $('[data-language-export]',w).onclick=()=>{const output={project:'PlanetBintang REIC',selectedLanguages:selected.map(x=>({id:x.id,name:x.name,extensions:x.extensions,execution:x.execution})),generatedAt:new Date().toISOString()};config.hidden=false;config.textContent=JSON.stringify(output,null,2);status.textContent='Konfigurasi pilihan siap disalin atau disimpan.';};
 fetch('./language-catalog.reic').then(r=>{if(!r.ok)throw new Error('HTTP '+r.status);return r.json();}).then(data=>{languages=Array.isArray(data.languages)?data.languages:[];renderOptions();status.textContent=languages.length+' bahasa tersedia di katalog.';}).catch(e=>{status.textContent='Katalog bahasa gagal dimuat: '+e.message;});
}
function drawFiles(path='Beranda'){
 currentPath=path;pathEl.textContent='/ '+path;items.replaceChildren();
 if(path==='repositori'){status.textContent='Repositori publik dan privat tersedia melalui REIC Explorer.';const b=document.createElement('button');b.className='file-entry';b.innerHTML='<b>🌐</b><span>Buka seluruh repositori GitHub</span>';b.onclick=()=>openApp('REIC Explorer');items.append(b);return;}
 let names=path==='Beranda'||path==='File System'?roots:path==='vmdesktopreic'?['index.html','system.reicss','system.reicjs','reference-match.css','README.md','indexes','registry']:path==='media'?['manifest.json','repositori','indeks-reic']:path==='repositori'?[]:['index.reic','manifest.json','system.reicss','system.reicjs','README.md'];
 if(path==='Beranda'||path==='File System')names=[...roots];
 names.filter(n=>n.toLowerCase().includes(searchTerm)).forEach(n=>{const b=document.createElement('button');b.className='file-entry';const isDir=!n.includes('.');b.innerHTML='<b>'+(isDir?'📁':n.endsWith('.reicss')?'🎨':n.endsWith('.reicjs')?'📜':'▤')+'</b><span>'+safe(n)+'</span>';b.onclick=()=>isDir?drawFiles(n):openApp(n);items.append(b);});
 status.textContent=items.children.length+' item · File System REIC · data runtime lokal';
}
function wireFileManager(){
 if(!items||!fileWindow)return;
 drawFiles();
 $$('[data-folder]').forEach(b=>b.onclick=()=>drawFiles(b.dataset.folder));
 $('#search').addEventListener('input',e=>{searchTerm=e.target.value.toLowerCase();drawFiles(currentPath)});
 $('#back').onclick=()=>drawFiles('Beranda');$('#forward').onclick=()=>drawFiles('Beranda');$('#up').onclick=()=>drawFiles('Beranda');
 $('#grid').onclick=()=>items.classList.remove('list-mode');$('#list').onclick=()=>items.classList.add('list-mode');
 const title=$('.window-title',fileWindow),workspace=$('.workspace');
 let drag=null,restore=null,restoreChip=null;
 title.addEventListener('pointerdown',e=>{
  if(e.target.closest('button')||fileWindow.classList.contains('file-window-max'))return;
  const r=fileWindow.getBoundingClientRect(),bounds=workspace.getBoundingClientRect();
  drag={x:e.clientX-r.left,y:e.clientY-r.top,bounds};
  title.setPointerCapture(e.pointerId);
 });
 title.addEventListener('pointermove',e=>{
  if(!drag)return;
  const r=fileWindow.getBoundingClientRect();
  const x=Math.max(0,Math.min(drag.bounds.width-r.width,e.clientX-drag.bounds.left-drag.x));
  const y=Math.max(0,Math.min(drag.bounds.height-r.height,e.clientY-drag.bounds.top-drag.y));
  fileWindow.style.position='absolute';fileWindow.style.transform='none';fileWindow.style.left=x+'px';fileWindow.style.top=y+'px';
 });
 const stop=()=>{drag=null;};title.addEventListener('pointerup',stop);title.addEventListener('pointercancel',stop);title.addEventListener('lostpointercapture',stop);
 $('[data-close]',fileWindow).onclick=()=>{fileWindow.hidden=true;if(restoreChip)restoreChip.remove();restoreChip=null;};
 $('[data-min]',fileWindow).onclick=()=>{
  fileWindow.hidden=true;
  if(!restoreChip){restoreChip=document.createElement('button');restoreChip.type='button';restoreChip.className='reic-restore-chip';restoreChip.textContent='📁 File Manajer';restoreChip.onclick=()=>{fileWindow.hidden=false;restoreChip.remove();restoreChip=null;};apps.append(restoreChip);}
 };
 $('[data-max]',fileWindow).onclick=()=>{
  if(!fileWindow.classList.contains('file-window-max')){
   const r=fileWindow.getBoundingClientRect(),b=workspace.getBoundingClientRect();
   restore={left:r.left-b.left,top:r.top-b.top,width:r.width,height:r.height};
   fileWindow.classList.add('file-window-max');fileWindow.style.transform='none';fileWindow.style.left='';fileWindow.style.top='';
  }else{
   fileWindow.classList.remove('file-window-max');
   if(restore){fileWindow.style.position='absolute';fileWindow.style.left=restore.left+'px';fileWindow.style.top=restore.top+'px';fileWindow.style.width=Math.min(restore.width,workspace.clientWidth-8)+'px';fileWindow.style.height=restore.height+'px';}
   else{fileWindow.style.position='';fileWindow.style.left='';fileWindow.style.top='';fileWindow.style.width='';fileWindow.style.height='';fileWindow.style.transform='';}
  }
 };
}function wireLauncher(){
 $$('[data-open]').forEach(b=>{
  b.type='button';b.setAttribute('aria-label',b.getAttribute('aria-label')||b.dataset.open);
  b.title=b.dataset.open;
  b.addEventListener('click',e=>{e.preventDefault();openApp(b.dataset.open);});
 });
 $$('[data-launch]').forEach(b=>{b.type='button';b.addEventListener('click',()=>openApp(b.dataset.launch));});
 document.addEventListener('keydown',e=>{if(e.key==='Escape'){const visible=$('.reic-app-window',apps).filter(w=>!w.hidden).sort((a,b)=>Number(b.style.zIndex)-Number(a.style.zIndex))[0];if(visible){visible.remove();if(visible._restoreChip)visible._restoreChip.remove();}}});
 window.addEventListener('resize',()=>{$('.reic-app-window',apps).forEach(w=>{if(w.classList.contains('is-maximized')){w.style.left='6px';w.style.top='6px';w.style.width='calc(100% - 12px)';w.style.height='calc(100% - 12px)';}else{const maxX=Math.max(0,apps.clientWidth-w.offsetWidth),maxY=Math.max(0,apps.clientHeight-w.offsetHeight);w.style.left=Math.min(parseFloat(w.style.left)||0,maxX)+'px';w.style.top=Math.min(parseFloat(w.style.top)||0,maxY)+'px';}});});
}
function updateClock(){const el=$('#clock');if(el)el.textContent=new Intl.DateTimeFormat('id-ID',{hour:'2-digit',minute:'2-digit'}).format(new Date());}
wireFileManager();wireLauncher();updateClock();setInterval(updateClock,30000);
window.PB_REIC={version:'2.1',repositoryOwner:OWNER,githubAPI:'authenticated-local-proxy-with-public-fallback',openApp,refreshRepositories:()=>{repoCache=null;},desktopBounds:()=>apps.getBoundingClientRect(),localHost:()=>localHostBase()};
})();