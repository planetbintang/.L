export const moduleInfo = Object.freeze({ id: "34", slug: "git-branch-manager", title: "Pengelola Cabang Git", description: "Menyajikan cabang aktif, riwayat, dan status perubahan.", format: "REIC31" });
export function mount(root) {
  if (!root) throw new TypeError("REIC module requires a root element");
  const status = root.querySelector(".reic-module__status");
  const button = root.querySelector('[data-reic-action="inspect"]');
  const onInspect = () => {
    if (status) status.textContent = "PEMERIKSAAN SELESAI · " + moduleInfo.id;
    root.dispatchEvent(new CustomEvent("reic:module-inspected", { bubbles: true, detail: moduleInfo }));
  };
  button?.addEventListener("click", onInspect);
  return () => button?.removeEventListener("click", onInspect);
}
