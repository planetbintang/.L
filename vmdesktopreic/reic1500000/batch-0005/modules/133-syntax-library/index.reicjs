export const moduleInfo=Object.freeze({id:"133",slug:"syntax-library",title:"Pustaka Sintaks"});export function mount(root){if(!root)throw new TypeError("root required");const out=root.querySelector(".reic-status");const btn=root.querySelector("[data-reic-run]");const run=()=>{if(out)out.textContent="PEMERIKSAAN SELESAI · 133";root.dispatchEvent(new CustomEvent("reic:module-ready",{bubbles:true,detail:moduleInfo}));};btn?.addEventListener("click",run);return()=>btn?.removeEventListener("click",run);}
