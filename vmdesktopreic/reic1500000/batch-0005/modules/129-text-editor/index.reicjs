export const moduleInfo=Object.freeze({id:"129",slug:"text-editor",title:"Editor Teks"});export function mount(root){if(!root)throw new TypeError("root required");const out=root.querySelector(".reic-status");const btn=root.querySelector("[data-reic-run]");const run=()=>{if(out)out.textContent="PEMERIKSAAN SELESAI · 129";root.dispatchEvent(new CustomEvent("reic:module-ready",{bubbles:true,detail:moduleInfo}));};btn?.addEventListener("click",run);return()=>btn?.removeEventListener("click",run);}
