.reic-module{display:grid;gap:1rem;padding:1.25rem;border:1px solid var(--reic-border,rgba(255,255,255,.18));border-radius:1rem;background:var(--reic-panel,rgba(18,24,38,.82));color:var(--reic-text,#f4f7ff)}.reic-module button{justify-self:start;padding:.6rem 1rem;border:1px solid currentColor;border-radius:.6rem;background:transparent;color:inherit;cursor:pointer}
