/* REIC MODULE 28: APPLICATION MANAGER */
[data-module="application-manager"]{display:grid;gap:16px;min-width:0;color:var(--reic-text,#eaf4ff)}
[data-module="application-manager"] .reic-panel{padding:20px;border:1px solid var(--reic-line,rgba(100,190,255,.25));border-radius:16px;background:linear-gradient(145deg,#14263d,#081321)}
