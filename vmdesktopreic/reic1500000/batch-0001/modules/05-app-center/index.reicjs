/* REIC MODULE 05: APP CENTER */
export const moduleInfo=Object.freeze({id:"05",name:"REIC APP CENTER",key:"app-center"});
export function mount(root){if(!root)return false;root.dataset.reicModule=moduleInfo.key;root.dispatchEvent(new CustomEvent("reic:module-ready",{bubbles:true,detail:moduleInfo}));return true;}
