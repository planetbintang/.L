.reic-module{display:grid;gap:1rem;padding:1.25rem;border:1px solid var(--reic-border,rgba(255,255,255,.18));border-radius:1rem;background:var(--reic-panel,rgba(18,24,38,.82));color:var(--reic-text,#f4f7ff);font:inherit}.reic-module__header{display:flex;align-items:center;gap:.8rem;flex-wrap:wrap}.reic-module__id{font:600 .72rem/1.2 ui-monospace,monospace;letter-spacing:.08em;opacity:.7}.reic-module h2{margin:0;font-size:1.15rem}.reic-module p{margin:0;line-height:1.6}.reic-module__status{font:600 .75rem/1.4 ui-monospace,monospace;opacity:.8}.reic-module button{justify-self:start;padding:.65rem 1rem;border:1px solid currentColor;border-radius:.6rem;background:transparent;color:inherit;cursor:pointer}.reic-module button:focus-visible{outline:2px solid currentColor;outline-offset:3px}
