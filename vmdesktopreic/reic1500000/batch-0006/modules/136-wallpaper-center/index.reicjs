export const moduleInfo=Object.freeze({id:"136",slug:"wallpaper-center",title:"Pusat Wallpaper"});export function mount(el){if(!el)throw new TypeError("root required");const form=el.querySelector("[data-reic-form]");const color=form?.elements.color;const preview=el.querySelector("[data-reic-preview]");const out=el.querySelector(".reic-status");color?.addEventListener("input",()=>{if(preview)preview.style.backgroundColor=color.value;});form?.addEventListener("submit",e=>{e.preventDefault();const detail={id:moduleInfo.id,color:color?.value||"#14243a"};if(preview)preview.style.backgroundColor=detail.color;if(out)out.textContent="Pratinjau wallpaper lokal: "+detail.color;el.dispatchEvent(new CustomEvent("reic:wallpaper-preview",{bubbles:true,detail}));});return()=>{};}
