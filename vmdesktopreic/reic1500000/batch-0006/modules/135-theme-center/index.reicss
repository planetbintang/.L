.reic-module{display:grid;gap:1rem;min-width:0;padding:clamp(1rem,2vw,1.5rem);border:1px solid var(--reic-border,rgba(255,255,255,.18));border-radius:1rem;background:var(--reic-panel,rgba(18,24,38,.88));color:var(--reic-text,#f4f7ff)}.reic-module header{display:grid;gap:.35rem}.reic-kicker{font-size:.7rem;letter-spacing:.14em;color:var(--reic-accent,#9db2ff)}.reic-module h2{margin:0;font-size:1.15rem}.reic-module p{margin:0;color:var(--reic-muted,#aab8ce);line-height:1.6}.reic-module form{display:grid;gap:.75rem}.reic-module label{display:flex;align-items:center;gap:.6rem;font-size:.9rem}.reic-module input:not([type=checkbox]),.reic-module select{width:100%;min-height:2.6rem;padding:.55rem .7rem;border:1px solid var(--reic-border,#354660);border-radius:.65rem;background:var(--reic-input,#0b1423);color:inherit}.reic-module button{justify-self:start;padding:.65rem 1rem;border:0;border-radius:.65rem;background:var(--reic-accent,#6d8dff);color:#fff;font-weight:700;cursor:pointer}.reic-status{display:block;min-height:2.5rem;padding:.75rem;border:1px solid var(--reic-border,#293750);border-radius:.65rem;background:#080f1c66;overflow-wrap:anywhere}.reic-preview{min-height:5rem;border-radius:.75rem;border:1px solid var(--reic-border,#293750)}.reic-module :focus-visible{outline:3px solid #a9c2ff;outline-offset:3px}
