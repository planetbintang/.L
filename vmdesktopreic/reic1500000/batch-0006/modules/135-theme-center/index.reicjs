export const moduleInfo=Object.freeze({id:"135",slug:"theme-center",title:"Pusat Tema"});export function mount(el){if(!el)throw new TypeError("root required");const form=el.querySelector("[data-reic-form]");const out=el.querySelector(".reic-status");form?.addEventListener("submit",e=>{e.preventDefault();const theme=form.elements.theme.value;const detail={id:moduleInfo.id,theme};if(out)out.textContent="Tema tersimpan sebagai preferensi sesi: "+theme+". Shell dapat merespons event reic:theme.";el.dispatchEvent(new CustomEvent("reic:theme",{bubbles:true,detail}));});return()=>{};}
