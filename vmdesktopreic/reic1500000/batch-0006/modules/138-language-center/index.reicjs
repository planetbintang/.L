export const moduleInfo=Object.freeze({id:"138",slug:"language-center",title:"Pusat Bahasa"});export function mount(el){if(!el)throw new TypeError("root required");const form=el.querySelector("[data-reic-form]");const out=el.querySelector(".reic-status");form?.addEventListener("submit",e=>{e.preventDefault();const language=form.elements.language.value;const detail={id:moduleInfo.id,language};if(out)out.textContent="Preferensi bahasa sesi: "+(language==="id"?"Bahasa Indonesia":"English")+". Modul lain dapat merespons event reic:language.";el.dispatchEvent(new CustomEvent("reic:language",{bubbles:true,detail}));});return()=>{};}
