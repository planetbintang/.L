const root=globalThis;export const moduleInfo=Object.freeze({id:"134",slug:"display-settings",title:"Pengaturan Tampilan"});export function mount(el){if(!el)throw new TypeError("root required");const form=el.querySelector("[data-reic-form]");const scale=el.querySelector("[name=scale]");const value=el.querySelector("[data-reic-value]");const out=el.querySelector(".reic-status");scale?.addEventListener("input",()=>{if(value)value.textContent=scale.value+"%";});form?.addEventListener("submit",e=>{e.preventDefault();const detail={id:moduleInfo.id,scale:scale?.value||"100",orientation:form.elements.orientation.value};if(out)out.textContent="Preferensi tampilan lokal: skala "+detail.scale+"%, orientasi "+detail.orientation+". Terapkan pada shell desktop melalui event reic:settings.";el.dispatchEvent(new CustomEvent("reic:settings",{bubbles:true,detail}));});return()=>{};}
