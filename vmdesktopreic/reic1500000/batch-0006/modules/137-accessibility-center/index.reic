<section class="reic-module" data-reic-module="137"><header><span class="reic-kicker">AKSESIBILITAS</span><h2>Pusat Aksesibilitas</h2></header><form data-reic-form><label><input type="checkbox" name="contrast"> Kontras tinggi</label><label><input type="checkbox" name="motion"> Kurangi animasi</label><label for="text-size">Ukuran teks</label><select id="text-size" name="textSize"><option value="normal">Normal</option><option value="large">Besar</option><option value="larger">Sangat besar</option></select><button type="submit">SIMPAN PREFERENSI</button></form><output class="reic-status" aria-live="polite">Preferensi aksesibilitas belum disimpan.</output></section>
