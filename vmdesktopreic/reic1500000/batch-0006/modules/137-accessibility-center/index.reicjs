export const moduleInfo=Object.freeze({id:"137",slug:"accessibility-center",title:"Pusat Aksesibilitas"});export function mount(el){if(!el)throw new TypeError("root required");const form=el.querySelector("[data-reic-form]");const out=el.querySelector(".reic-status");form?.addEventListener("submit",e=>{e.preventDefault();const detail={id:moduleInfo.id,highContrast:form.elements.contrast.checked,reducedMotion:form.elements.motion.checked,textSize:form.elements.textSize.value};if(out)out.textContent="Preferensi lokal: kontras "+(detail.highContrast?"tinggi":"normal")+", gerakan "+(detail.reducedMotion?"dikurangi":"normal")+", teks "+detail.textSize+".";el.dispatchEvent(new CustomEvent("reic:accessibility",{bubbles:true,detail}));});return()=>{};}
