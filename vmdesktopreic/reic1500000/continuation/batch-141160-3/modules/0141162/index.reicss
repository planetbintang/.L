/* REIC EVENT BRIDGE | 0141162 */
[data-reic-event-bridge]{display:grid;gap:12px;padding:20px;border:1px solid var(--reic-line,rgba(120,190,255,.28));background:var(--reic-surface,#101d2c);color:var(--reic-text,#edf6ff)}[data-reic-event-bridge] button{justify-self:start;padding:9px 14px;cursor:pointer}[data-reic-event-log]{overflow-wrap:anywhere}
