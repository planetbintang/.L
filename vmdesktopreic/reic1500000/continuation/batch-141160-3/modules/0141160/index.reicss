/* REIC RUNTIME SANDBOX | 0141160 */
[data-reic-sandbox]{display:grid;gap:12px;padding:20px;border:1px solid var(--reic-line,rgba(120,190,255,.28));background:var(--reic-surface,#101d2c);color:var(--reic-text,#edf6ff)}[data-reic-sandbox] button{justify-self:start;border:1px solid currentColor;background:transparent;color:inherit;padding:9px 14px;cursor:pointer}
