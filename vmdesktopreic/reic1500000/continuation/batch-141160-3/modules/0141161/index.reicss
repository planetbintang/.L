/* REIC MANIFEST VALIDATOR | 0141161 */
[data-reic-manifest]{display:grid;gap:12px;padding:20px;border:1px solid var(--reic-line,rgba(120,190,255,.28));background:var(--reic-surface,#101d2c);color:var(--reic-text,#edf6ff)}[data-reic-manifest] input{display:block;max-width:100%;margin-top:6px;padding:8px;background:#081321;color:inherit;border:1px solid #46627d}[data-reic-manifest] button{justify-self:start;padding:9px 14px}
