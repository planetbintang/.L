<reic-module id="0144189" name="VALIDASI KONEKSI" version="1.0">
  <metadata category="KONEKSI" action="VALIDASI" locale="id-ID" />
  <view title="VALIDASI KONEKSI">
    <section class="reic-panel">
      <h2>VALIDASI KONEKSI</h2>
      <p>Modul validasi koneksi pada lingkungan Desktop REIC.</p>
