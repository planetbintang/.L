:host{display:block;color:var(--reic-text,#e8edf5)}.reic-panel{border:1px solid var(--reic-border,#526174);border-radius:0;padding:1rem;background:var(--reic-surface,#172231)}button{border:1px solid var(--reic-accent,#65b8d8);border-radius:0;padding:.55rem .8rem;background:transparent;color:inherit;cursor:pointer}output{display:block;margin:.75rem 0}
