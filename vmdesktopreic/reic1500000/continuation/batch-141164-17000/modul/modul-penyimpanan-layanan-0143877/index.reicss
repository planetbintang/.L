:host{display:block;color:var(--reic-text,#e8edf5);font:inherit}.reic-panel{border:1px solid var(--reic-border,#526174);border-radius:0;padding:1rem;background:var(--reic-surface,#172231)}h2{margin:0 0 .65rem;font-size:1.05rem}p{line-height:1.5}output{display:block;margin:.75rem 0;color:var(--reic-muted,#aab8c8)}button{border:1px solid var(--reic-accent,#65b8d8);border-radius:0;padding:.55rem .8rem;background:transparent;color:inherit;cursor:pointer}button:focus-visible{outline:2px solid var(--reic-accent,#65b8d8);outline-offset:2px}
