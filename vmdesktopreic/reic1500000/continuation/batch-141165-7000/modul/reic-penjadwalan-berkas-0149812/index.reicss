:host{display:block;color:var(--reic-text,#e8edf5)}section{border:1px solid var(--reic-border,#526174);padding:1rem;background:var(--reic-surface,#172231)}h2{font-size:1rem}button{border:1px solid var(--reic-accent,#65b8d8);border-radius:0;padding:.55rem;background:transparent;color:inherit}output{display:block;margin:.7rem 0}
