/* REIC MODULE 0229408 */
[data-reic-module="0229408"]{display:grid;gap:1rem;min-width:0;color:var(--reic-text,#eaf4ff)}
[data-reic-module="0229408"] .reic-panel{padding:1.25rem;border:1px solid var(--reic-line,rgba(100,190,255,.25));border-radius:1rem;background:linear-gradient(145deg,#14263d,#081321)}
