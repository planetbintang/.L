/* REIC MODULE 0228058 */
[data-reic-module="0228058"]{display:grid;gap:1rem;min-width:0;color:var(--reic-text,#eaf4ff)}
[data-reic-module="0228058"] .reic-panel{padding:1.25rem;border:1px solid var(--reic-line,rgba(100,190,255,.25));border-radius:1rem;background:linear-gradient(145deg,#14263d,#081321)}
