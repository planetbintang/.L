export const moduleInfo = Object.freeze({id:"108",slug:"url-inspector",title:"Pemeriksa URL",description:"Memvalidasi format URL.",format:"REIC31"});
export function mount(root){if(!root)throw new TypeError("REIC module requires a root element");const status=root.querySelector(".reic-module__status");const button=root.querySelector('[data-reic-action="run"]');const run=()=>{if(status)status.textContent="PEMERIKSAAN SELESAI · "+moduleInfo.id;root.dispatchEvent(new CustomEvent("reic:module-ready",{bubbles:true,detail:moduleInfo}));};button?.addEventListener("click",run);return()=>button?.removeEventListener("click",run);}
