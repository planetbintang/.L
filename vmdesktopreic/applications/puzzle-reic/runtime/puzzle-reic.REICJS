export const manifest=Object.freeze({"id":"reic-app-075","name":"Puzzle REIC","category":"Multimedia","version":"1.0.0","mode":"media","capabilities":["asset-catalog","metadata","export-json"]});
export function createWorkspace(storage){const key="pb-reic-app-data:reic-app-075";const read=()=>{try{const x=JSON.parse(storage.getItem(key)||"[]");return Array.isArray(x)?x:[];}catch{return [];}};const write=x=>storage.setItem(key,JSON.stringify(x));return Object.freeze({manifest,list:()=>read(),add:r=>{const rows=read(),item={id:Date.now().toString(36),title:String(r.title||"").slice(0,160),detail:String(r.detail||"").slice(0,4000),updatedAt:new Date().toISOString()};if(!item.title)throw new TypeError("title required");rows.unshift(item);write(rows);return item;},remove:id=>{const rows=read().filter(x=>x.id!==id);write(rows);return rows.length;},search:q=>read().filter(x=>(x.title+" "+x.detail).toLowerCase().includes(String(q).toLowerCase())),export:()=>JSON.stringify({manifest,records:read()},null,2)});}
