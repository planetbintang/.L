.reic-app-domain-manager{--app-accent:#168dff;display:grid;gap:12px;color:#102b4c}
.reic-app-domain-manager .workspace-heading{border-left:3px solid var(--app-accent);padding-left:10px}
.reic-app-domain-manager .workspace-card{background:#f2f8ff;border:1px solid #c6def3;padding:10px}
.reic-app-domain-manager button:focus-visible{outline:2px solid var(--app-accent);outline-offset:2px}
