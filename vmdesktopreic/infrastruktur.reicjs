(()=>{'use strict';
const root=document.createElement('div');root.id='reicInfraOverlay';root.innerHTML='<section id="reicInfraPanel" role="dialog" aria-modal="true" aria-labelledby="reicInfraTitle"><header class="reic-infra-head"><div><small>OS MEDIA VM · PUSAT INFRASTRUKTUR</small><h2 id="reicInfraTitle">55 KOMPONEN DESKTOP</h2></div><button class="reic-infra-close" type="button" aria-label="Tutup">×</button></header><div class="reic-infra-tools"><input type="search" id="reicInfraSearch" placeholder="Cari komponen infrastruktur…" aria-label="Cari komponen"><span class="reic-infra-count" id="reicInfraCount">MEMUAT…</span></div><div class="reic-infra-body"><nav class="reic-infra-categories" id="reicInfraCategories" aria-label="Kelompok infrastruktur"></nav><section class="reic-infra-list"><h3 id="reicInfraGroup">SELURUH KELOMPOK</h3><div class="reic-infra-grid" id="reicInfraGrid"></div><section class="reic-infra-detail" id="reicInfraDetail" hidden aria-live="polite"></section></section></div><footer class="reic-infra-foot">FORMAT TERPADU: .REIC · .REICSS · .REICJS · .REICG · DAFTAR KOMPONEN, BUKAN KLAIM BAHWA SEMUA MODUL TELAH DIIMPLEMENTASIKAN PENUH.</footer></section>';
document.body.append(root);
const categories=root.querySelector('#reicInfraCategories'),grid=root.querySelector('#reicInfraGrid'),detail=root.querySelector('#reicInfraDetail'),search=root.querySelector('#reicInfraSearch'),count=root.querySelector('#reicInfraCount'),heading=root.querySelector('#reicInfraGroup');let data=null,active='semua';
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function draw(){if(!data)return;const term=search.value.trim().toLocaleLowerCase('id');const groups=data.komponen;const all=groups.flatMap(g=>g.komponen.map(x=>({...x,kelompok:g.kategori,groupId:g.id})));const rows=all.filter(x=>(active==='semua'||x.groupId===active)&&(!term||(x.nama+' '+x.id+' '+x.kelompok+' '+x.deskripsi).toLocaleLowerCase('id').includes(term)));count.textContent=rows.length+' / 55 KOMPONEN';heading.textContent=active==='semua'?'SELURUH KELOMPOK':groups.find(x=>x.id===active)?.kategori||'HASIL PENCARIAN';grid.innerHTML=rows.map(x=>'<button class="reic-infra-card" type="button" data-id="'+esc(x.id)+'"><small>'+esc(x.id.toUpperCase())+'</small><b>'+esc(x.nama)+'</b><span>'+esc(x.kelompok)+'</span></button>').join('')||'<p>Tidak ada komponen yang sesuai.</p>';grid.querySelectorAll('[data-id]').forEach(b=>b.addEventListener('click',()=>{const x=all.find(y=>y.id===b.dataset.id);detail.hidden=false;detail.innerHTML='<h4>'+esc(x.nama)+'</h4><p>'+esc(x.deskripsi)+'</p><div class="reic-infra-files">'+x.berkas.map(f=>'<span>'+esc(f)+'</span>').join('')+'</div>';grid.querySelectorAll('[data-id]').forEach(y=>y.setAttribute('aria-pressed',String(y===b)));}));}
function open(){root.classList.add('open');root.querySelector('.reic-infra-close').focus();document.body.style.overflow='hidden';}
function close(){root.classList.remove('open');document.body.style.overflow='';}
root.querySelector('.reic-infra-close').addEventListener('click',close);root.addEventListener('click',e=>{if(e.target===root)close();});document.addEventListener('keydown',e=>{if(e.key==='Escape'&&root.classList.contains('open'))close();});
search.addEventListener('input',draw);
fetch('./infrastruktur.reic',{cache:'no-cache'}).then(r=>{if(!r.ok)throw Error('HTTP '+r.status);return r.json();}).then(json=>{data=json;categories.innerHTML='<button type="button" data-group="semua" aria-pressed="true">Semua Komponen · 55</button>'+data.komponen.map(g=>'<button type="button" data-group="'+esc(g.id)+'" aria-pressed="false">'+esc(g.kategori)+' · '+g.komponen.length+'</button>').join('');categories.querySelectorAll('[data-group]').forEach(b=>b.addEventListener('click',()=>{active=b.dataset.group;categories.querySelectorAll('button').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));detail.hidden=true;draw();}));draw();}).catch(err=>{count.textContent='GAGAL MEMUAT';grid.textContent='Manifes infrastruktur tidak dapat dibaca: '+err.message;});
const launcher=document.createElement('button');launcher.type='button';launcher.textContent='INFRASTRUKTUR';launcher.setAttribute('aria-label','Buka 55 komponen infrastruktur desktop');launcher.style.cssText='border:1px solid #65bfe8;background:linear-gradient(135deg,#07517e,#087eae);color:#fff;padding:7px 11px;font:600 10px/1.2 inherit;letter-spacing:.08em;cursor:pointer';launcher.addEventListener('click',open);const links=document.querySelector('.system-links');if(links)links.append(launcher);else{launcher.style.position='fixed';launcher.style.top='12px';launcher.style.right='12px';launcher.style.zIndex='999';document.body.append(launcher);}
window.VMDESKTOPREICInfrastructure={open,close,version:data?.versi||'1.0.0'};
})();