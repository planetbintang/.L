<section class="vm-web-region" aria-label="Area web di atas desktop" data-layout-zone="web-top"></section>
<div class="vm-shell" id="vmDesktop" data-resolution="1920x1080" data-vm-instance="PB-VM-CORE-001" data-runtime-theme="version-runtime" data-vm-count="1" data-vm-bits="10">
<header class="vm-header reic-topbar">
<div class="vm-brand"><span class="vm-logo">ℙ</span><div><b>VMDESKTOP REIC</b><small>PLANETBINTANG</small></div></div>
<input id="desktopSearch" class="reic-hidden-search" aria-hidden="true" tabindex="-1">
<nav class="vm-header-tools reic-top-tools" aria-label="Alat desktop">
<button data-open="files" title="Filemanajer" aria-label="Filemanajer">▱</button>
<button data-open="display" title="Galeri dan wallpaper" aria-label="Galeri dan wallpaper">▧</button>
<button data-open="documents" title="Dokumen" aria-label="Dokumen">▤</button>
<button data-open="settings" title="Pengaturan" aria-label="Pengaturan">⚙</button>
<button data-open="status" title="Layar dan status VM" aria-label="Layar dan status VM">▣</button>
<button data-open="power" title="Daya" aria-label="Daya">⏻</button>
<button data-registry="true" title="REIC System Registry · 1.000.000 unit kode" aria-label="REIC System Registry · 1.000.000 unit kode">▦</button>
<button data-code-container="true" title="REIC Virtual Code Container" aria-label="REIC Virtual Code Container">&lt;/&gt;</button>
</nav></header>
<main class="vm-desktop">
<aside class="vm-core-menu" aria-label="Enam menu utama VMDESKTOPREIC">
<button class="core-item active" data-core="settings" title="Pengaturan" aria-label="Pengaturan"><span>⚙</span><b>PENGATURAN</b></button>
<button class="core-item" data-core="studio" title="Studio & AI Global Agensi" aria-label="Studio & AI Global Agensi"><span>✧</span><b>STUDIO &amp; AI GLOBAL AGENSI</b></button>
<button class="core-item" data-core="documents" title="Pembuat Dokumen" aria-label="Pembuat Dokumen"><span>▤</span><b>PEMBUAT DOKUMEN</b></button>
<button class="core-item" data-core="search" title="Pencarian Utama" aria-label="Pencarian Utama"><span>⌕</span><b>PENCARIAN UTAMA</b></button>
<button class="core-item" data-core="files" title="Filemanajer" aria-label="Filemanajer"><span>▱</span><b>FILEMANAJER</b></button>
<button class="core-item" data-core="apps" title="Aplikasi Sistem" aria-label="Aplikasi Sistem"><span>▦</span><b>APLIKASI SISTEM</b></button>
<button class="core-item" data-registry="true" title="REIC System Registry · 1.000.000 unit kode" aria-label="REIC System Registry · 1.000.000 unit kode"><span>▦</span><b>REIC SYSTEM<br>REGISTRY<br>1.000.000</b></button>
<button class="core-item" data-code-container="true" title="REIC Virtual Code Container" aria-label="REIC Virtual Code Container"><span>&lt;/&gt;</span><b>CODE<br>CONTAINER</b></button>
</aside>
<section class="vm-slide-panel" id="slidePanel" aria-label="Submenu pilihan"><header><span id="slideIcon">⚙</span><b id="slideTitle">PENGATURAN</b><button id="slideClose" aria-label="Tutup submenu">×</button></header><div id="slideItems" class="slide-items"></div></section>
<section class="vm-workspace" aria-label="Pusat kontainer VM tunggal">
<section class="vm-app-launcher" aria-label="Aplikasi desktop">
