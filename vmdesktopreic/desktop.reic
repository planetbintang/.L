<div class="vm-modal-backdrop" id="modalBackdrop" hidden><section class="vm-modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle"><header><span id="modalIcon">⚙</span><b id="modalTitle">Pengaturan Sistem</b><div><button id="modalMin" aria-label="Minimalkan">—</button><button id="modalMax" aria-label="Maksimalkan">□</button><button id="modalClose" aria-label="Tutup">×</button></div></header><nav class="modal-tabs" id="modalTabs"></nav><div class="modal-body" id="modalBody"></div><footer><span id="modalStatus">OS MEDIA VM · MODUL REIC</span><button id="modalSave">✓ SIMPAN</button></footer></section></div>
</main><footer class="vm-statusbar"><span><i></i> Sistem Berjalan Normal</span><div class="status-progress"><b></b></div><span>◉　Wi-Fi　 |　 RAM 8 GB　 |　 SSD 256 GB　 |　 ▣</span></footer>
</div>
