<div class="vm-shell" id="vmDesktop" data-resolution="1920x1080">
<header class="vm-header"><div class="vm-brand"><span class="vm-logo">★</span><b>PlanetBintang <i>.L/</i></b></div><div class="vm-search"><span>⌕</span><input id="desktopSearch" placeholder="Cari di PlanetBintang..."><small>⌕</small></div><div class="vm-header-tools"><button data-open="apps" title="Aplikasi">▦</button><button type="button" data-wallpaper-toggle aria-label="Jeda animasi wallpaper" aria-pressed="false" title="Jeda animasi wallpaper">✧</button><button data-open="keyboard" title="Keyboard REIC">⌨</button><button data-open="notifications">♧</button><button data-open="account">◉</button><div class="vm-clock"><b id="vmClock">--:--</b><small id="vmDate">--</small></div><button data-open="settings">⚙</button></div></header>
<main class="vm-desktop">
