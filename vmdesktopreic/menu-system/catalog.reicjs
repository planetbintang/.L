/* VMDESKTOPREIC 150 MENU / 150 SUBMENU / 150 FEATURE CATALOG */
(()=>{'use strict';const root=document.querySelector('#vmDesktop');const core=document.querySelector('.vm-core-menu');if(!root||!core||document.querySelector('#pbCatalogBackdrop'))return;const groups=[{"id":"sistem","name":"SISTEM & RUNTIME","count":19},{"id":"file-data","name":"FILE & DATA","count":19},{"id":"aplikasi","name":"APLIKASI","count":19},{"id":"desain-ui","name":"DESAIN UI & UX","count":19},{"id":"gambar-galeri","name":"GAMBAR & GALERI","count":19},{"id":"video-film","name":"VIDEO & FILM","count":19},{"id":"studio-media","name":"STUDIO MEDIA","count":18},{"id":"pengaturan","name":"PENGATURAN","count":18}];let items=[];let activeGroup='all';let current=null;const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const launch=document.createElement('button');launch.type='button';launch.className='core-item pb-catalog-launch';launch.innerHTML='<span>▦</span><b>150 MENU</b>';launch.title='Katalog 150 menu utama';core.append(launch);const back=document.createElement('div');back.id='pbCatalogBackdrop';back.className='pb-catalog-backdrop';back.innerHTML='<section class="pb-catalog-window" role="dialog" aria-modal="true" aria-label="Katalog VMDESKTOPREIC"><header class="pb-catalog-head"><span>▦</span><div><h2 id="pbCatalogTitle">VMDESKTOPREIC · 150 MENU UTAMA</h2><p id="pbCatalogDesc">150 MENU · 150 SUBMENU · 150 FITUR APLIKASI</p></div><button type="button" data-catalog-close>TUTUP ✕</button></header><div class="pb-catalog-tools"><input id="pbCatalogSearch" placeholder="Cari menu, fungsi, atau fitur…"><span id="pbCatalogCount">150 / 150</span></div><nav class="pb-catalog-groups" id="pbCatalogGroups"></nav><div class="pb-catalog-list" id="pbCatalogList"></div><button class="pb-feature-back" type="button">← KEMBALI KE 150 MENU</button><div class="pb-feature-stage" id="pbFeatureStage" hidden></div><footer class="pb-catalog-foot" id="pbCatalogStatus">KATALOG MODULAR · REIC</footer></section>';document.body.append(back);const win=back.querySelector('.pb-catalog-window'),list=back.querySelector('#pbCatalogList'),groupsNav=back.querySelector('#pbCatalogGroups'),search=back.querySelector('#pbCatalogSearch'),stage=back.querySelector('#pbFeatureStage'),status=back.querySelector('#pbCatalogStatus');function renderGroups(){groupsNav.innerHTML='<button data-group="all" class="'+(activeGroup==='all'?'active':'')+'">SEMUA · 150</button>'+groups.map(g=>'<button data-group="'+g.id+'" class="'+(activeGroup===g.id?'active':'')+'">'+esc(g.name)+' · '+g.count+'</button>').join('');}function renderList(){const q=search.value.trim().toLowerCase();const filtered=items.filter(x=>(activeGroup==='all'||x.group===activeGroup)&&(!q||(x.title+' '+x.submenu+' '+x.groupName).toLowerCase().includes(q)));list.innerHTML=filtered.map(x=>'<button class="pb-catalog-card" data-feature-id="'+x.id+'"><small>'+String(x.number).padStart(3,'0')+' · '+esc(x.groupName)+'</small><b>'+esc(x.title)+'</b><span>'+esc(x.submenu)+'</span></button>').join('');back.querySelector('#pbCatalogCount').textContent=filtered.length+' / '+items.length;}async function openFeature(item){current=item;win.classList.add('is-feature');back.querySelector('#pbCatalogTitle').textContent=item.title;back.querySelector('#pbCatalogDesc').textContent=item.groupName+' · SUBMENU: '+item.submenu;stage.hidden=false;stage.innerHTML='<p>Memuat modul REIC…</p>';const base='./menu-system/features/'+item.id+'/';try{const [html,css]=await Promise.all([fetch(base+'index.reic').then(r=>{if(!r.ok)throw Error('index.reic '+r.status);return r.text();}),fetch(base+'feature.reicss').then(r=>{if(!r.ok)throw Error('feature.reicss '+r.status);return r.text();})]);const old=document.querySelector('#pbFeatureStyle');if(old)old.remove();const style=document.createElement('style');style.id='pbFeatureStyle';style.textContent=css;document.head.append(style);stage.innerHTML=html;const script=document.createElement('script');script.src=base+'feature.reicjs';script.onload=()=>{const cfg=window.VMDESKTOPREIC_FEATURE_CONFIG||item;initFeature(stage,cfg);};script.onerror=()=>{status.textContent='Gagal memuat logika modul';};document.body.append(script);status.textContent='MODUL '+String(item.number).padStart(3,'0')+' · '+item.kind.toUpperCase()+' · MODE LOKAL';}catch(err){stage.innerHTML='<p role="alert">Modul gagal dimuat: '+esc(err.message)+'</p>';status.textContent='PEMUATAN MODUL GAGAL';}}function initFeature(container,cfg){const $=s=>container.querySelector(s);const setStatus=t=>{const el=$('[data-status]');if(el)el.textContent=t;status.textContent=t;};const records=$('[data-records]');const savedKey='vmdesktopreic:'+cfg.id;const addRow=(name)=>{if(!records)return;const li=document.createElement('li');li.dataset.record='';li.textContent=name;records.append(li);};container.addEventListener('click',e=>{const b=e.target.closest('[data-action]');if(!b)return;const a=b.dataset.action;const editor=$('[data-editor]');if(a==='refresh'||a==='run'){if(cfg.kind==='terminal'){const inp=$('[data-command]');const cmd=(inp?.value||'help').trim();const out=$('[data-preview]');if(out)out.textContent=cmd==='clear'?'':cmd==='status'?'STATUS: AKTIF · RUNTIME: REIC · MODE: LOKAL':'Perintah tersedia: help, status, clear\\nMode ini berjalan lokal di browser.';if(inp)inp.value='';}else if(records){records.innerHTML='';['Pemeriksaan antarmuka: OK','Struktur modul: OK','Penyimpanan sesi: tersedia'].forEach(addRow);}setStatus('PEMERIKSAAN SELESAI · '+new Date().toLocaleTimeString());}else if(a==='add'){const inp=$('[data-setting]');const value=inp?.value.trim()||('Item '+(records?.children.length+1||1));if(cfg.kind==='kanban'){const col=records?.querySelector('section');const card=document.createElement('article');card.textContent=value;col?.append(card);}else if(cfg.kind==='timeline'){const track=document.createElement('div');track.className='reic-track';track.textContent='TRACK · '+value;records?.append(track);}else if(cfg.kind==='prototype'){const card=document.createElement('article');card.innerHTML='LAYAR '+(records.children.length+1)+'<br><small>'+esc(value)+'</small>';records.append(card);}else if(cfg.kind==='components'){const item=document.createElement('span');item.textContent=value;records?.append(item);}else if(cfg.kind==='checklist'){const li=document.createElement('li');li.innerHTML='<label><input type="checkbox"> '+esc(value)+'</label>';records?.append(li);}else addRow(value);if(inp)inp.value='';setStatus('ITEM DITAMBAHKAN · '+value);}else if(a==='remove'){records?.lastElementChild?.remove();setStatus('ITEM TERAKHIR DIHAPUS');}else if(a==='clear'||a==='reset'){if(records)records.innerHTML='';const p=$('[data-preview]');if(p&&p.tagName==='VIDEO')p.removeAttribute('src');else if(p)p.textContent='Tampilan direset.';setStatus('MODUL DIRESET');}else if(a==='save'){const payload=editor?.value||records?.innerText||JSON.stringify({module:cfg.id,updatedAt:new Date().toISOString()});try{localStorage.setItem(savedKey,payload);setStatus('TERSIMPAN DI PENYIMPANAN LOKAL BROWSER');}catch(_){setStatus('PENYIMPANAN LOKAL TIDAK TERSEDIA');}}else if(a==='export'){const payload=JSON.stringify({module:cfg.id,title:cfg.title,content:editor?.value||records?.innerText||'',createdAt:new Date().toISOString()},null,2);download(payload,cfg.id+'.json','application/json');setStatus('BERKAS EKSPOR DIBUAT');}else if(a==='preview'){const p=$('[data-preview]');if(p)p.textContent=editor?.value||'Pratinjau '+cfg.title+' berhasil disiapkan.';setStatus('PRATINJAU DIPERBARUI');}else if(a==='apply'){const p=$('[data-preview]');if(cfg.kind==='colors'&&p){p.style.color=$('[data-color]')?.value||'#fff';p.style.background=$('[data-bg]')?.value||'#10243a';}if(cfg.kind==='layout'&&p){p.style.gridTemplateColumns='repeat('+($('[data-columns]')?.value||3)+',1fr)';p.style.gap=($('[data-gap]')?.value||12)+'px';}setStatus('PENGATURAN DITERAPKAN');}else if(a==='reset'){localStorage.removeItem(savedKey);setStatus('PREFERENSI DEFAULT DIPULIHKAN');}});container.addEventListener('input',e=>{if(e.target.matches('[data-search]')){const q=e.target.value.toLowerCase();records?.querySelectorAll('li,tr').forEach(el=>el.hidden=!el.textContent.toLowerCase().includes(q));}if(e.target.matches('[data-scale]')){const img=$('[data-preview] img');if(img)img.style.transform='scale('+(e.target.value/100)+')';}if(e.target.matches('[data-fontsize]')){const p=$('[data-preview]');if(p)p.style.fontSize=e.target.value+'px';}});container.addEventListener('change',e=>{if(e.target.matches('[data-file]')){const files=[...(e.target.files||[])];if(cfg.kind==='video'||cfg.kind==='audio'){const media=$('[data-preview]');if(media&&files[0])media.src=URL.createObjectURL(files[0]);}else if(cfg.kind==='image'){const p=$('[data-preview]');if(p&&files[0]){p.innerHTML='';const img=document.createElement('img');img.src=URL.createObjectURL(files[0]);p.append(img);}}else if(records){if(cfg.kind==='gallery'){records.innerHTML='';files.forEach(f=>{const img=document.createElement('img');img.src=URL.createObjectURL(f);img.alt=f.name;records.append(img);});}else{records.innerHTML='';files.forEach(f=>addRow(f.name+' · '+f.size+' byte'));}}setStatus(files.length+' BERKAS DIPILIH · TETAP DI PERANGKAT');}if(e.target.matches('[data-font]')){const p=$('[data-preview]');if(p)p.style.fontFamily=e.target.value;}if(e.target.matches('[data-size]')){const p=$('[data-preview]');if(p)p.style.maxWidth=({desktop:'100%',tablet:'760px',mobile:'360px'})[e.target.dataset.size];}});const drop=$('[data-dropzone]');if(drop){drop.addEventListener('dragover',e=>{e.preventDefault();drop.classList.add('active');});drop.addEventListener('dragleave',()=>drop.classList.remove('active'));drop.addEventListener('drop',e=>{e.preventDefault();drop.classList.remove('active');const fs=[...(e.dataTransfer?.files||[])];if(records){records.innerHTML='';fs.forEach(f=>addRow(f.name+' · '+f.size+' byte'));}setStatus(fs.length+' BERKAS DITERIMA UNTUK SESI INI');});}if(editor){try{editor.value=localStorage.getItem(savedKey)||'';}catch(_){}}}function download(content,name,type){const a=document.createElement('a');const url=URL.createObjectURL(new Blob([content],{type}));a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);}async function init(){const r=await fetch('./menu-system/catalog.reic');if(!r.ok)throw Error('catalog.reic '+r.status);const data=await r.json();items=data.items;renderGroups();renderList();launch.addEventListener('click',()=>{back.classList.add('open');win.classList.remove('is-feature');stage.hidden=true;back.querySelector('#pbCatalogTitle').textContent='VMDESKTOPREIC · 150 MENU UTAMA';back.querySelector('#pbCatalogDesc').textContent='150 MENU · 150 SUBMENU · 150 FITUR APLIKASI';search.value='';activeGroup='all';renderGroups();renderList();});groupsNav.addEventListener('click',e=>{const b=e.target.closest('[data-group]');if(!b)return;activeGroup=b.dataset.group;renderGroups();renderList();});search.addEventListener('input',renderList);list.addEventListener('click',e=>{const b=e.target.closest('[data-feature-id]');if(!b)return;const item=items.find(x=>x.id===b.dataset.featureId);if(item)openFeature(item);});back.querySelector('.pb-feature-back').addEventListener('click',()=>{win.classList.remove('is-feature');stage.hidden=true;back.querySelector('#pbCatalogTitle').textContent='VMDESKTOPREIC · 150 MENU UTAMA';back.querySelector('#pbCatalogDesc').textContent='150 MENU · 150 SUBMENU · 150 FITUR APLIKASI';});const close=()=>back.classList.remove('open');back.querySelector('[data-catalog-close]').addEventListener('click',close);back.addEventListener('click',e=>{if(e.target===back)close();});document.addEventListener('keydown',e=>{if(e.key==='Escape')close();});window.VMDESKTOPREIC_CATALOG={version:'1.0.0',mainMenus:150,submenus:150,features:150,groups:8,open:id=>{const item=items.find(x=>x.id===id);if(item){back.classList.add('open');openFeature(item);}}};root.dataset.catalogReady='true';}init().catch(e=>{status.textContent='KATALOG GAGAL DIMUAT · '+e.message;});})();