/* VMDESKTOPREIC MAIN MENU MODAL STYLES */
.vm-core-menu .pb-main-menu{min-height:58px}.vm-core-menu .pb-main-menu b{font-size:9px;line-height:1.2}.vm-modal-backdrop.is-open{display:flex}.pb-modal-kicker{margin-right:auto;color:#9db9d5;font-size:11px;padding:8px}.pb-menu-page{padding:18px;min-height:100%;box-sizing:border-box}.pb-menu-intro{padding:8px 4px 20px;border-bottom:1px solid #29445f;margin-bottom:18px}.pb-menu-intro>span,.pb-detail-heading>small{color:#7dc4ff;font-size:11px;letter-spacing:.12em}.pb-menu-intro h2,.pb-detail-heading h2{margin:8px 0;font-size:24px}.pb-menu-intro p,.pb-detail-heading p{color:#a9bfd4}.pb-submenu-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.pb-submenu-card{position:relative;display:flex;flex-direction:column;gap:8px;min-height:112px;border:1px solid #294b6c;background:linear-gradient(145deg,#142b48,#081424);color:#eaf4ff;border-radius:3px;padding:16px;text-align:left;cursor:pointer}.pb-submenu-card>span{font:11px monospace;color:#77bfff}.pb-submenu-card>b{font-size:14px}.pb-submenu-card>small{color:#9eb5cc}.pb-submenu-card>i{position:absolute;right:14px;top:14px;color:#75c4ff}.pb-submenu-card:hover,.pb-submenu-card:focus-visible{border-color:#66b7ff;outline:2px solid transparent}.pb-module-detail{padding:18px}.pb-detail-heading{border-bottom:1px solid #29445f;padding-bottom:16px;margin-bottom:16px}.pb-back{display:block;background:none;border:0;color:#83caff;padding:0 0 16px;cursor:pointer;font-weight:700}.pb-detail-workspace{display:grid;grid-template-columns:220px minmax(0,1fr);gap:14px;min-height:390px}.pb-detail-tools,.pb-detail-canvas{border:1px solid #29445f;background:#07182b;min-width:0}.pb-detail-tools{padding:12px;display:flex;flex-direction:column;gap:6px}.pb-detail-tools>b{font-size:10px;color:#7dc4ff;padding:6px}.pb-detail-tools button{background:transparent;border:1px solid transparent;color:#b8cce0;text-align:left;padding:10px;cursor:pointer}.pb-detail-tools button.active,.pb-detail-tools button:hover{background:#173b60;border-color:#477ba5;color:white}.pb-canvas-toolbar{display:flex;justify-content:space-between;padding:12px;border-bottom:1px solid #29445f;font-size:10px;color:#8fb6d8}.pb-canvas-content{padding:24px;min-height:320px;display:grid;place-items:center}.pb-module-placeholder{text-align:center;max-width:520px}.pb-module-placeholder>span{font-size:42px;color:#82caff}.pb-module-placeholder h3{font-size:21px}.pb-module-placeholder p,.pb-module-placeholder small{color:#a9bfd4}.pb-module-actions{display:flex;justify-content:center;flex-wrap:wrap;gap:8px;margin:22px 0}.pb-module-actions button{border:1px solid #4379a7;background:#123455;color:#eaf4ff;padding:10px 14px;cursor:pointer}.pb-overview-stat{font-size:28px;color:#83caff}.pb-layout-gallery .pb-canvas-content,.pb-layout-media-player .pb-canvas-content{background:linear-gradient(135deg,#0a1c31,#132b45)}.pb-layout-timeline .pb-canvas-content{background:repeating-linear-gradient(90deg,#25415a22 0 1px,transparent 1px 48px),#09182a}.pb-layout-file-manager .pb-canvas-content{background:linear-gradient(90deg,#204a6e33 0 28%,transparent 28%),#09182a}@media(max-width:900px){.pb-submenu-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.pb-detail-workspace{grid-template-columns:1fr}.pb-detail-tools{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:560px){.pb-submenu-grid{grid-template-columns:1fr}.pb-menu-intro h2,.pb-detail-heading h2{font-size:19px}.pb-menu-page,.pb-module-detail{padding:12px}.pb-modal-kicker{display:none}}@media(prefers-reduced-motion:reduce){.pb-submenu-card{scroll-behavior:auto;transition:none}}

/* 150+ MENU WORKSPACE SYSTEM · V2 */
.pb-menu-search{display:flex;align-items:center;gap:12px;max-width:680px;margin-top:16px;color:#7dc4ff;font-size:10px;letter-spacing:.1em}
.pb-menu-search input,.pb-module-form input,.pb-module-form textarea{width:100%;min-width:0;box-sizing:border-box;border:1px solid #315575;background:#081a2d;color:#eaf4ff;border-radius:4px;padding:12px;font:inherit}
.pb-menu-search input{max-width:460px}
.pb-group-foot{margin-top:18px;padding:12px;border-top:1px solid #29445f;color:#8baac7;font:10px monospace;letter-spacing:.08em}
.pb-module-app{width:min(900px,100%);text-align:left}
.pb-module-symbol{font-size:38px;color:#82caff}
.pb-module-app>h3{margin:8px 0;font-size:24px}
.pb-module-app>p,.pb-module-app>small{color:#a9bfd4;line-height:1.6}
.pb-module-form{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:22px 0}
.pb-module-form label{display:grid;gap:7px;color:#8fcaff;font-size:10px;letter-spacing:.08em}
.pb-module-form textarea{resize:vertical}
.pb-module-actions{justify-content:flex-start}
.pb-module-records{margin:20px 0;border:1px solid #29445f;background:#071525}
.pb-module-records>div{display:flex;justify-content:space-between;padding:12px;border-bottom:1px solid #29445f;color:#9fc8e8;font-size:11px}
.pb-module-records ul{list-style:none;padding:0;margin:0}
.pb-module-records li{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px 12px;padding:12px;border-bottom:1px solid #203b55;color:#eaf4ff}
.pb-module-records li b,.pb-module-records li small{grid-column:1}
.pb-module-records li small{color:#9db5cb;overflow-wrap:anywhere}
.pb-module-records li button{grid-column:2;grid-row:1/3;background:#40232b;border:1px solid #75414b;color:#fff;padding:4px 10px;cursor:pointer}
.pb-module-records .pb-empty-record{display:block;color:#8faac4;text-align:center}
.pb-overview-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:8px}
.pb-overview-grid button{padding:12px;text-align:left;background:#102943;border:1px solid #294b6c;color:#eaf4ff;cursor:pointer}
.pb-main-menu.active{outline:1px solid #75caff;background:#153b5d}
@media(max-width:700px){.pb-module-form{grid-template-columns:1fr}.pb-menu-search{align-items:stretch;flex-direction:column}.pb-menu-search input{max-width:none}}
