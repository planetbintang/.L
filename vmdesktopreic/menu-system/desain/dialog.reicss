/* DESAIN · DIALOG */
.pb-design-page{color:#eaf4ff}.pb-design-page .pb-submenu-card{background:linear-gradient(145deg,#20344e,#101a2a);border-color:#48617d}.pb-design-menu{display:grid;gap:7px}.pb-design-menu button,.pb-design-manager button{padding:10px 13px;text-align:left;background:#152b43;color:#eaf4ff;border:1px solid #46617d;cursor:pointer}.pb-design-modal,.pb-design-dialog,.pb-design-content,.pb-design-manager{padding:16px;color:#eaf4ff;background:#0b1b2d}.pb-design-modal header{border-bottom:1px solid #39516a;padding-bottom:12px}.pb-design-modal header h2{display:inline-block;margin-left:8px}.pb-design-canvas{min-height:260px;display:grid;place-items:center;margin-top:14px;border:1px dashed #78bce8;background:linear-gradient(135deg,#142d46,#0a1625)}.pb-design-canvas span{letter-spacing:.18em;color:#8bcfff}.pb-design-manager-actions{display:flex;flex-wrap:wrap;gap:8px}.pb-design-dialog label{display:grid;gap:7px}.pb-design-dialog input{padding:10px;background:#10253b;color:#fff;border:1px solid #47627e}.pb-design-manifest{white-space:pre-wrap;color:#a9c8e4}
/* Dialog properti dan konfirmasi desain. */