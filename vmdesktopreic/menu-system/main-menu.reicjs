/* VMDESKTOPREIC · 150+ DEDICATED MENU MODALS · REIC */
(()=>{'use strict';
const groups=[
{id:'sistem',title:'SISTEM & RUNTIME',icon:'▣',desc:'Kontrol inti, runtime REIC, proses, layanan dan diagnostik.',subs:['Pusat Sistem','Runtime REIC','Layanan Sistem','Registri Komponen','Monitor Sistem','Log & Diagnostik','API Sistem','Proses Aktif','Manajemen Memori','Kinerja Sistem','Pembaruan Runtime','Jadwal Tugas','Variabel Lingkungan','Pemulihan Sistem','Status Integritas']},
{id:'file-data',title:'FILE & DATA',icon:'▱',desc:'Manajemen file, folder, metadata, penyimpanan dan pemulihan.',subs:['File Manager','Folder Sistem','Data Bersama','Penyimpanan','Unggah & Unduh','Metadata File','Pencarian File','Backup & Pemulihan','Riwayat File','Berbagi Data','Arsip & Kompresi','Validasi Berkas','Indeks File','Izin Akses','Sinkronisasi Data']},
{id:'aplikasi',title:'APLIKASI',icon:'▦',desc:'Katalog aplikasi, launcher, workspace dan siklus modul.',subs:['Katalog Aplikasi','Aplikasi Terpasang','Launcher','Workspace','Jendela Aplikasi','Pintasan','Instalasi Modul','Pembaruan Aplikasi','Manajer Ekstensi','Profil Aplikasi','Notifikasi Aplikasi','Izin Aplikasi','Riwayat Aplikasi','Integrasi Aplikasi','Pusat Bantuan']},
{id:'desain-ui',title:'DESAIN UI & UX',icon:'◇',desc:'Komponen antarmuka, layout, tema, aksesibilitas dan prototipe.',subs:['Blok Komponen','Layout Web','Design System','Tema & Warna','Tipografi & Ikon','Prototipe','Aksesibilitas','Pratinjau Responsif','Grid & Spacing','Navigasi UI','Form Builder','Komponen Data','Animasi Antarmuka','Audit UX','Ekspor UI']},
{id:'desain',title:'DESAIN & KREATIF',icon:'✎',desc:'Kanvas desain, aset visual, produksi dan kolaborasi kreatif.',subs:['Kanvas Desain','Editor Layout','Desain Grafis','Komponen Visual','Tipografi','Palet Warna','Prototipe Desain','Ekspor Desain','Papan Inspirasi','Template Kreatif','Mockup Produk','Ilustrasi Vektor','Manajemen Aset','Review Desain','Versi Desain']},
{id:'gambar-galeri',title:'GAMBAR & GALERI',icon:'▧',desc:'Galeri gambar, editor foto, pengelompokan dan metadata visual.',subs:['Galeri Gambar','Penampil Gambar','Editor Gambar','Crop & Resize','Filter & Warna','Kolase','Metadata Gambar','Ekspor Gambar','Album & Koleksi','Pencarian Visual','Konversi Format','Optimasi Gambar','Slideshow','Label & Tag','Impor Media']},
{id:'video-film',title:'VIDEO & FILM',icon:'▶',desc:'Pemutar, timeline, penyuntingan video dan produksi film.',subs:['Pemutar Video','Editor Video','Timeline','Subtitle','Audio & Mixing','Storyboard','Manajemen Adegan','Ekspor Video','Daftar Putar','Potong & Gabung','Transisi Video','Koreksi Warna','Kompresi Video','Katalog Film','Render Queue']},
{id:'studio-media',title:'STUDIO MEDIA',icon:'✧',desc:'Produksi konten, workflow kreatif, publikasi dan arsip.',subs:['Proyek Kreatif','Asset Library','Template Produksi','Review & Komentar','Kolaborasi','Publikasi','Arsip Media','Riwayat Versi','Kalender Konten','Manajer Naskah','Studio Audio','Studio Streaming','Paket Produksi','Distribusi Media','Analitik Konten']},
{id:'pengaturan',title:'PENGATURAN',icon:'⚙',desc:'Preferensi desktop, keamanan, jaringan, akun dan perangkat.',subs:['Tampilan Desktop','Personalisasi','Jaringan','Keamanan','Akun & Akses','Perangkat','Notifikasi','Daya & Sistem','Privasi Data','Bahasa & Wilayah','Penyimpanan Lokal','Aksesibilitas Sistem','Tema Desktop','Kontrol Sesi','Reset Preferensi']},
{id:'jaringan-cloud',title:'JARINGAN & CLOUD',icon:'⌁',desc:'Koneksi, layanan cloud, domain, deployment dan observabilitas.',subs:['Pusat Jaringan','Koneksi & DNS','Domain Manager','Hosting','Server Console','Cloud Storage','Deployment','Build & Release','API Gateway','Webhooks','Integrasi Eksternal','Status Layanan','Log Server','Backup Cloud','Pemantauan Uptime']}
];
const $=s=>document.querySelector(s),core=$('.vm-core-menu'),back=$('#modalBackdrop'),title=$('#modalTitle'),icon=$('#modalIcon'),tabs=$('#modalTabs'),body=$('#modalBody'),status=$('#modalStatus'),root=$('#vmDesktop');
if(!core||!back||!body)return;
let active=null,activeSub=null,searchTerm='';
const safe=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const key=(g,s)=>'vmdesktopreic:module:'+g.id+':'+s.toLocaleLowerCase('id').replace(/[^a-z0-9]+/g,'-');
const moduleCopy=(g,s)=>({purpose:s+' menjadi ruang kerja khusus dalam '+g.title+'.',workspace:'Kelola data, susun pekerjaan, periksa status, dan simpan hasil dari satu modal REIC.',actions:['BUAT BARU','IMPOR DATA','SIMPAN','EKSPOR']});
function showGroup(g){
active=g;activeSub=null;title.textContent=g.title;icon.textContent=g.icon;
tabs.innerHTML='<span class="pb-modal-kicker">'+safe(g.desc)+'</span><button class="active" data-view="menu">SEMUA MENU · 15</button><button data-view="overview">RINGKASAN</button>';
body.dataset.layout='menu-grid';
body.innerHTML='<section class="pb-menu-page"><div class="pb-menu-intro"><span>VMDESKTOPREIC · MODULAR SYSTEM</span><h2>'+safe(g.title)+'</h2><p>'+safe(g.desc)+'</p><label class="pb-menu-search">CARI MODUL <input type="search" id="pbModuleSearch" placeholder="Cari nama menu atau fungsi…"></label></div><div class="pb-submenu-grid" id="pbSubmenuGrid">'+g.subs.map((s,i)=>'<button class="pb-submenu-card" data-module="'+i+'"><span>MODUL '+String(i+1).padStart(2,'0')+'</span><b>'+safe(s)+'</b><small>'+safe(moduleCopy(g,s).purpose)+'</small><i>↗</i></button>').join('')+'</div><footer class="pb-group-foot">'+g.subs.length+' MODUL TERSEDIA · SETIAP MODUL MEMILIKI RUANG KERJA TERSENDIRI</footer></section>';
body.querySelector('#pbModuleSearch').addEventListener('input',e=>{const q=e.target.value.toLocaleLowerCase('id');body.querySelectorAll('[data-module]').forEach(b=>b.hidden=!b.textContent.toLocaleLowerCase('id').includes(q));});
body.dataset.layout='menu-grid';back.hidden=false;back.classList.add('is-open');status.textContent=g.title+' · '+g.subs.length+' MODUL';core.querySelectorAll('[data-pb-menu]').forEach(b=>b.classList.toggle('active',b.dataset.pbMenu===g.id));root.dataset.activeMenu=g.id;
}
function showModule(index){
const s=active.subs[index];if(!s)return;activeSub=s;const copy=moduleCopy(active,s),storageKey=key(active,s);
body.dataset.layout='workspace';
body.innerHTML='<section class="pb-module-detail"><div class="pb-detail-heading"><button class="pb-back">← KEMBALI KE '+safe(active.title)+'</button><small>'+safe(active.title)+' / MODUL '+String(index+1).padStart(2,'0')+'</small><h2>'+safe(s)+'</h2><p>'+safe(copy.purpose)+'</p></div><div class="pb-detail-workspace"><aside class="pb-detail-tools"><b>NAVIGASI MODUL</b>'+active.subs.map((name,j)=>'<button data-submenu="'+j+'" class="'+(j===index?'active':'')+'">'+safe(name)+'</button>').join('')+'</aside><div class="pb-detail-canvas"><div class="pb-canvas-toolbar"><span>WORKSPACE / '+safe(s.toUpperCase())+'</span><span>REIC MODULE · LOCAL READY</span></div><div class="pb-canvas-content"><div class="pb-module-app"><div class="pb-module-symbol">'+active.icon+'</div><h3>'+safe(s)+'</h3><p>'+safe(copy.workspace)+'</p><div class="pb-module-form"><label>NAMA / JUDUL<input id="pbModuleName" placeholder="Masukkan nama pekerjaan atau data…"></label><label>CATATAN / KONFIGURASI<textarea id="pbModuleNote" rows="3" placeholder="Tuliskan rincian, catatan, atau konfigurasi modul…"></textarea></label></div><div class="pb-module-actions"><button data-action="new">＋ BUAT BARU</button><button data-action="import">↑ IMPOR</button><button data-action="save">✓ SIMPAN</button><button data-action="export">↓ EKSPOR</button></div><div class="pb-module-records"><div><b>DATA TERSIMPAN</b><span id="pbModuleCount">0 item</span></div><ul id="pbModuleRecords"></ul></div><small>Data modul disimpan lokal pada browser perangkat ini. Operasi server memerlukan integrasi backend tersendiri.</small></div></div></div></div></section>';
const records=body.querySelector('#pbModuleRecords');let saved=[];try{saved=JSON.parse(localStorage.getItem(storageKey)||'[]');if(!Array.isArray(saved))saved=[];}catch(_){saved=[];}
function draw(){records.innerHTML=saved.map((r,i)=>'<li><b>'+safe(r.name)+'</b><small>'+safe(r.note||'Tanpa catatan')+'</small><button data-remove="'+i+'" aria-label="Hapus item">×</button></li>').join('')||'<li class="pb-empty-record">Belum ada data tersimpan.</li>';body.querySelector('#pbModuleCount').textContent=saved.length+' item';}
draw();status.textContent='MODUL AKTIF · '+s.toUpperCase()+' · '+active.title;
}
body.addEventListener('click',e=>{
if(e.target.closest('.pb-back')){showGroup(active);return;}
const sub=e.target.closest('[data-submenu]');if(sub){showModule(Number(sub.dataset.submenu));return;}
const card=e.target.closest('[data-module]');if(card){showModule(Number(card.dataset.module));return;}
const remove=e.target.closest('[data-remove]');if(remove&&active&&activeSub){const i=Number(remove.dataset.remove),k=key(active,activeSub);try{const a=JSON.parse(localStorage.getItem(k)||'[]');a.splice(i,1);localStorage.setItem(k,JSON.stringify(a));showModule(active.subs.indexOf(activeSub));}catch(_){status.textContent='Gagal menghapus data lokal';}return;}
const action=e.target.closest('[data-action]');if(!action||!active||!activeSub)return;
const k=key(active,activeSub),name=body.querySelector('#pbModuleName').value.trim(),note=body.querySelector('#pbModuleNote').value.trim();
let saved=[];try{saved=JSON.parse(localStorage.getItem(k)||'[]');if(!Array.isArray(saved))saved=[];}catch(_){}
if(action.dataset.action==='new'){body.querySelector('#pbModuleName').value='';body.querySelector('#pbModuleNote').value='';body.querySelector('#pbModuleName').focus();status.textContent='FORM BARU · '+activeSub;}
if(action.dataset.action==='import'){const input=document.createElement('input');input.type='file';input.accept='.json,.txt,.csv';input.onchange=async()=>{const f=input.files?.[0];if(!f)return;try{const text=await f.text();let rows;try{const data=JSON.parse(text);rows=Array.isArray(data)?data:[data];}catch(_){rows=text.split(/\r?\n/).filter(Boolean).map(line=>({name:line,note:''}));}saved.push(...rows.map(x=>({name:String(x.name||x.title||x),note:String(x.note||''),createdAt:new Date().toISOString()})));localStorage.setItem(k,JSON.stringify(saved));showModule(active.subs.indexOf(activeSub));status.textContent='IMPOR BERHASIL · '+f.name;}catch(err){status.textContent='IMPOR GAGAL · '+err.message;}};input.click();}
if(action.dataset.action==='save'){if(!name){status.textContent='ISI NAMA/JUDUL SEBELUM MENYIMPAN';return;}saved.unshift({name,note,createdAt:new Date().toISOString()});try{localStorage.setItem(k,JSON.stringify(saved));showModule(active.subs.indexOf(activeSub));status.textContent='TERSIMPAN · '+activeSub;}catch(_){status.textContent='PENYIMPANAN LOKAL PENUH / TIDAK TERSEDIA';}}
if(action.dataset.action==='export'){const blob=new Blob([JSON.stringify({group:active.title,module:activeSub,items:saved},null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=activeSub.toLowerCase().replace(/[^a-z0-9]+/g,'-')+'.json';a.click();URL.revokeObjectURL(url);status.textContent='EKSPOR DIBUAT · '+saved.length+' ITEM';}
});
tabs.addEventListener('click',e=>{const b=e.target.closest('[data-view]');if(!b||!active)return;if(b.dataset.view==='menu')showGroup(active);else{body.dataset.layout='dashboard';body.innerHTML='<section class="pb-menu-overview"><h2>'+safe(active.title)+'</h2><p>'+safe(active.desc)+'</p><div class="pb-overview-stat">'+active.subs.length+'</div><h3>MODUL TERSEDIA</h3><div class="pb-overview-grid">'+active.subs.map((s,i)=>'<button data-module="'+i+'">'+String(i+1).padStart(2,'0')+' · '+safe(s)+'</button>').join('')+'</div></section>';}}); 
groups.forEach(g=>{const b=document.createElement('button');b.type='button';b.className='core-item pb-main-menu';b.dataset.pbMenu=g.id;b.title=g.title;b.innerHTML='<span>'+g.icon+'</span><b>'+safe(g.title)+'</b>';b.addEventListener('click',()=>showGroup(g));core.append(b);});
const close=()=>{back.hidden=true;back.classList.remove('is-open');core.querySelectorAll('[data-pb-menu]').forEach(b=>b.classList.remove('active'));};
$('#modalClose')?.addEventListener('click',close);back.addEventListener('click',e=>{if(e.target===back)close();});document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!back.hidden)close();});
window.VMDESKTOPREIC_MENUS=Object.freeze({version:'2.0.0',count:groups.reduce((n,g)=>n+g.subs.length,0),groupCount:groups.length,folders:groups.map(g=>g.id),open:id=>{const g=groups.find(x=>x.id===id);if(g)showGroup(g);},close});
root.dataset.mainMenusReady='true';root.dataset.mainMenuModules=String(groups.reduce((n,g)=>n+g.subs.length,0));
})();