/* VMDESKTOPREIC MAIN MENU + MODAL MANAGER */
(()=>{'use strict';const menus=[{"id":"sistem","title":"SISTEM & RUNTIME","icon":"▣","desc":"Kontrol inti, runtime, layanan dan status sistem","subs":["Pusat Sistem","Runtime REIC","Layanan Sistem","Registri Komponen","Monitor Sistem","Log & Diagnostik","API Sistem","Proses Aktif"]},{"id":"file-data","title":"FILE & DATA","icon":"▱","desc":"Manajemen file, folder, data dan penyimpanan","subs":["File Manager","Folder Sistem","Data Bersama","Penyimpanan","Unggah & Unduh","Metadata File","Pencarian File","Backup & Pemulihan"]},{"id":"aplikasi","title":"APLIKASI","icon":"▦","desc":"Katalog aplikasi, workspace dan pengelolaan aplikasi","subs":["Katalog Aplikasi","Aplikasi Terpasang","Launcher","Workspace","Jendela Aplikasi","Pintasan","Instalasi Modul","Pembaruan Aplikasi"]},{"id":"desain-ui","title":"DESAIN UI & UX","icon":"◇","desc":"Komponen, layout, tema dan prototipe antarmuka","subs":["Blok Komponen","Layout Web","Design System","Tema & Warna","Tipografi & Ikon","Prototipe","Aksesibilitas","Pratinjau Responsif"]},{"id":"desain","title":"DESAIN","icon":"✎","desc":"Kanvas desain, tata letak, komponen visual dan produksi aset","subs":["Kanvas Desain","Editor Layout","Desain Grafis","Komponen Visual","Tipografi","Palet Warna","Prototipe Desain","Ekspor Desain"]},{"id":"gambar-galeri","title":"GAMBAR & GALERI","icon":"▧","desc":"Galeri, editor gambar dan pustaka aset visual","subs":["Galeri Gambar","Penampil Gambar","Editor Gambar","Crop & Resize","Filter & Warna","Kolase","Metadata Gambar","Ekspor Gambar"]},{"id":"video-film","title":"VIDEO & FILM","icon":"▶","desc":"Pemutar, penyuntingan video dan produksi film","subs":["Pemutar Video","Editor Video","Timeline","Subtitle","Audio & Mixing","Storyboard","Manajemen Adegan","Ekspor Video"]},{"id":"studio-media","title":"STUDIO MEDIA","icon":"✧","desc":"Produksi konten, proyek kreatif dan workflow media","subs":["Proyek Kreatif","Asset Library","Template Produksi","Review & Komentar","Kolaborasi","Publikasi","Arsip Media","Riwayat Versi"]},{"id":"pengaturan","title":"PENGATURAN","icon":"⚙","desc":"Preferensi desktop, keamanan, jaringan dan perangkat","subs":["Tampilan Desktop","Personalisasi","Jaringan","Keamanan","Akun & Akses","Perangkat","Notifikasi","Daya & Sistem"]}];const $=s=>document.querySelector(s),core=$('.vm-core-menu'),back=$('#modalBackdrop'),title=$('#modalTitle'),icon=$('#modalIcon'),tabs=$('#modalTabs'),body=$('#modalBody'),status=$('#modalStatus'),root=$('#vmDesktop');if(!core||!back||!body)return;let active=null;const cache=new Map(),safe=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));async function open(m){active=m;let html=cache.get(m.id);if(!html){const r=await fetch('./menu-system/'+m.id+'/index.reic');if(!r.ok)throw Error('HTTP '+r.status);html=await r.text();cache.set(m.id,html);}title.textContent=m.title;icon.textContent=m.icon;tabs.innerHTML='<span class="pb-modal-kicker">'+safe(m.desc)+'</span><button class="active" data-view="menu">MENU</button><button data-view="overview">RINGKASAN</button>';body.innerHTML=html;body.dataset.layout='menu-grid';back.hidden=false;back.classList.add('is-open');status.textContent=m.title+' · '+m.subs.length+' SUBMENU';core.querySelectorAll('[data-pb-menu]').forEach(b=>b.classList.toggle('active',b.dataset.pbMenu===m.id));root.dataset.activeMenu=m.id;}menus.forEach(m=>{const b=document.createElement('button');b.type='button';b.className='core-item pb-main-menu';b.dataset.pbMenu=m.id;b.title=m.title;b.innerHTML='<span>'+m.icon+'</span><b>'+safe(m.title)+'</b>';b.addEventListener('click',()=>open(m).catch(e=>status.textContent='Gagal memuat: '+e.message));core.append(b);});function detail(i){const n=active.subs[i];if(!n)return;const layout=({'Galeri Gambar':'gallery','Editor Video':'timeline','Timeline':'timeline','File Manager':'file-manager','Pemutar Video':'media-player','Penyimpanan':'storage','Blok Komponen':'component-grid','Design System':'component-grid','Kanvas Desain':'design-canvas','Editor Layout':'design-canvas','Desain Grafis':'design-canvas','Komponen Visual':'component-grid','Tipografi':'design-canvas','Palet Warna':'design-canvas','Prototipe Desain':'design-canvas','Ekspor Desain':'design-canvas','Jaringan':'settings','Keamanan':'settings'})[n]||'workspace';body.dataset.layout=layout;body.innerHTML='<section class="pb-module-detail"><div class="pb-detail-heading"><button class="pb-back">← KEMBALI KE '+safe(active.title)+'</button><small>'+safe(active.title)+' / MODUL '+(i+1)+'</small><h2>'+safe(n)+'</h2><p>Ruang kerja khusus '+safe(n.toLowerCase())+'.</p></div><div class="pb-detail-workspace"><aside class="pb-detail-tools"><b>MENU MODUL</b>'+active.subs.map((s,j)=>'<button data-submenu="'+j+'" class="'+(j===i?'active':'')+'">'+safe(s)+'</button>').join('')+'</aside><div class="pb-detail-canvas"><div class="pb-canvas-toolbar"><span>WORKSPACE / '+safe(n.toUpperCase())+'</span><span>REIC MODULE · READY</span></div><div class="pb-canvas-content"><div class="pb-module-placeholder"><span>'+active.icon+'</span><h3>'+safe(n)+'</h3><p>'+safe(active.desc)+'</p><div class="pb-module-actions"><button data-action="new">＋ BUAT BARU</button><button data-action="import">↑ IMPOR</button><button data-action="save">✓ SIMPAN</button></div><small>Modul dikelola oleh folder menu-system/'+active.id+'/.</small></div></div></div></div></section>';status.textContent='MODUL AKTIF · '+n.toUpperCase()+' · '+layout.toUpperCase();}body.addEventListener('click',e=>{if(e.target.closest('.pb-back')){open(active);return;}const s=e.target.closest('[data-submenu]');if(s){detail(+s.dataset.submenu);return;}const a=e.target.closest('[data-action]');if(a){status.textContent='AKSI '+a.dataset.action.toUpperCase()+' · '+active.title;if(a.dataset.action==='save')a.textContent='✓ TERSIMPAN';}});tabs.addEventListener('click',e=>{const b=e.target.closest('[data-view]');if(!b||!active)return;if(b.dataset.view==='menu')open(active);else{body.dataset.layout='dashboard';body.innerHTML='<section class="pb-menu-overview"><h2>'+safe(active.title)+'</h2><p>'+safe(active.desc)+'</p><h3>'+active.subs.length+' SUBMENU</h3><ul>'+active.subs.map(s=>'<li>'+safe(s)+'</li>').join('')+'</ul></section>';}});const close=()=>{back.hidden=true;back.classList.remove('is-open');core.querySelectorAll('[data-pb-menu]').forEach(b=>b.classList.remove('active'));};$('#modalClose')?.addEventListener('click',close);back.addEventListener('click',e=>{if(e.target===back)close();});document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!back.hidden)close();});window.VMDESKTOPREIC_MENUS=Object.freeze({version:'1.0.0',count:menus.length,folders:menus.map(m=>m.id),open:id=>{const m=menus.find(x=>x.id===id);if(m)open(m);},close});root.dataset.mainMenusReady='true';})();