/* PENGATURAN · index */
.pb-menu-page[data-menu="pengaturan"] .pb-submenu-card{border:1px solid rgba(164,205,255,.24);background:linear-gradient(145deg,rgba(20,43,72,.92),rgba(8,20,36,.96));color:#eaf4ff;border-radius:3px;padding:18px;cursor:pointer}.pb-menu-page[data-menu="pengaturan"] .pb-submenu-card:hover{border-color:#66b7ff;background:#17436f}.pb-menu-page[data-menu="pengaturan"] .pb-submenu-card:focus-visible{outline:2px solid #8bd0ff}
