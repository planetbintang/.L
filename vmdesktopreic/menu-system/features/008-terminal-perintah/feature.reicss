.reic-feature[data-feature="008-terminal-perintah"]{--feature-accent:#68bfff;border-top:2px solid var(--feature-accent)}.reic-feature[data-feature="008-terminal-perintah"] h3{color:var(--feature-accent)}.reic-feature[data-feature="008-terminal-perintah"] .reic-terminal-output{font-family:ui-monospace,monospace}