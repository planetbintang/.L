.pb-catalog-launch{min-width:64px!important}.pb-catalog-launch b{font-size:9px!important}.pb-catalog-backdrop{position:fixed;inset:0;z-index:100000;background:#020812eF;display:none;align-items:center;justify-content:center;padding:clamp(8px,2vw,24px);box-sizing:border-box}.pb-catalog-backdrop.open{display:flex}.pb-catalog-window{width:min(1180px,100%);height:min(88vh,900px);display:flex;flex-direction:column;background:#081727;border:1px solid #477ba5;box-shadow:0 24px 90px #000b;color:#eaf4ff}.pb-catalog-head{display:flex;align-items:center;gap:12px;padding:14px 18px;border-bottom:1px solid #29445f}.pb-catalog-head h2{font-size:16px;margin:0}.pb-catalog-head p{font-size:11px;color:#9db9d5;margin:4px 0 0}.pb-catalog-head button{margin-left:auto;background:transparent;color:#eaf4ff;border:1px solid #456987;padding:8px 12px}.pb-catalog-tools{display:flex;gap:8px;flex-wrap:wrap;padding:12px 16px;border-bottom:1px solid #29445f}.pb-catalog-tools input{flex:1;min-width:180px;background:#06111d;border:1px solid #36546f;color:#fff;padding:10px}.pb-catalog-groups{display:flex;gap:6px;overflow:auto;padding:0 16px 12px}.pb-catalog-groups button,.pb-catalog-card{background:#10243a;color:#dceeff;border:1px solid #29445f;padding:9px 12px;cursor:pointer;white-space:nowrap}.pb-catalog-groups button.active,.pb-catalog-card:hover{border-color:#70bfff;background:#163756}.pb-catalog-list{overflow:auto;padding:14px 16px 22px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}.pb-catalog-card{text-align:left;white-space:normal;min-height:78px;display:flex;flex-direction:column;gap:6px}.pb-catalog-card small{color:#83bde8;font-size:10px}.pb-catalog-card b{font-size:12px}.pb-catalog-card span{color:#9bb5cd;font-size:10px;line-height:1.4}.pb-feature-back{margin:14px 16px 0;align-self:flex-start;background:#123455;color:#eaf4ff;border:1px solid #477ba5;padding:8px 12px}.pb-feature-stage{overflow:auto;padding:16px;flex:1}.pb-catalog-foot{padding:9px 16px;border-top:1px solid #29445f;color:#86a8c7;font-size:10px}.pb-catalog-window.is-feature .pb-catalog-tools,.pb-catalog-window.is-feature .pb-catalog-groups,.pb-catalog-window.is-feature .pb-catalog-list{display:none}.pb-catalog-window.is-feature .pb-feature-back{display:block}.pb-feature-back{display:none}@media(max-width:760px){.pb-catalog-list{grid-template-columns:repeat(2,minmax(0,1fr))}.pb-catalog-window{height:94vh}}@media(max-width:480px){.pb-catalog-list{grid-template-columns:1fr}.pb-catalog-head{padding:10px}.pb-catalog-card{min-height:60px}}
/* SHARED REIC FEATURE WORKSPACE */
.reic-feature{color:#eaf4ff;background:#0b1a2c;border:1px solid #29445f;padding:18px;min-height:360px;font:13px system-ui,sans-serif}.reic-feature h3{margin:0 0 8px;font-size:20px}.reic-feature p{color:#a9bfd4}.reic-feature small,.reic-help{color:#8caac5}.reic-feature button,.reic-feature select,.reic-feature input,.reic-feature textarea{font:inherit}.reic-feature button{border:1px solid #477ba5;background:#123455;color:#eaf4ff;padding:9px 12px;cursor:pointer}.reic-feature input:not([type=checkbox]):not([type=color]):not([type=range]):not([type=file]),.reic-feature textarea,.reic-feature select{background:#071321;color:#eaf4ff;border:1px solid #36546f;padding:9px;max-width:100%}.reic-toolbar{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin:14px 0}.reic-field{display:flex;flex-direction:column;gap:7px;margin:12px 0;color:#9ec4e5}.reic-field input,.reic-field textarea{width:min(100%,560px);box-sizing:border-box}.reic-record-list{padding:0;list-style:none;display:grid;gap:8px}.reic-record-list li,.reic-table-wrap,.reic-settings,.reic-form-preview,.reic-component-list span,.reic-kanban section{border:1px solid #29445f;background:#10243a;padding:12px}.reic-table-wrap{overflow:auto}.reic-feature table{width:100%;border-collapse:collapse}.reic-feature td,.reic-feature th{padding:9px;border-bottom:1px solid #29445f;text-align:left}.reic-dropzone{padding:30px;text-align:center;border:1px dashed #5b91bc;background:#0d2034;color:#9ec4e5}.reic-gallery{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:10px}.reic-gallery img{width:100%;height:110px;object-fit:cover;border:1px solid #36546f}.reic-preview,.reic-terminal-output{white-space:pre-wrap;overflow:auto;background:#06111d;color:#b9d9f5;padding:14px;border:1px solid #29445f;min-height:60px}.reic-video{width:100%;max-height:360px;background:#000}.reic-image-stage,.reic-color-preview,.reic-type-preview,.reic-responsive-frame{display:grid;place-items:center;min-height:180px;background:#10243a;border:1px solid #36546f;padding:16px}.reic-image-stage img{max-width:100%;max-height:320px}.reic-timeline{display:grid;gap:10px}.reic-track{height:54px;background:#10243a;border:1px solid #36546f;padding:8px}.reic-track span{display:inline-block;margin-left:20px;padding:10px 20px;background:#1c5278}.reic-metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:14px 0}.reic-metrics article{background:#10243a;border:1px solid #29445f;padding:16px}.reic-metrics strong{display:block;font-size:22px;color:#8dd0ff;margin-top:6px}.reic-settings{display:grid;gap:16px}.reic-color-tools,.reic-layout-tools{display:flex;flex-wrap:wrap;gap:16px;align-items:center}.reic-component-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.reic-component-list{grid-column:1/-1;display:flex;gap:10px;flex-wrap:wrap}.reic-layout-preview{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:14px}.reic-layout-preview span,.reic-prototype article{background:#14324d;border:1px solid #477ba5;padding:26px;text-align:center}.reic-kanban{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.reic-kanban section{min-height:140px}.reic-kanban article{background:#183b59;padding:10px;margin-top:10px}.reic-prototype{display:flex;gap:10px}.reic-responsive-frame{max-width:100%;margin:10px auto;transition:max-width .2s}@media(max-width:620px){.reic-metrics,.reic-kanban{grid-template-columns:1fr}.reic-feature{padding:12px}.reic-component-grid{grid-template-columns:1fr}}.pb-catalog-window.is-feature .pb-feature-back{display:block}
