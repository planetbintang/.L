.pb-catalog-launch{min-width:64px!important}.pb-catalog-launch b{font-size:9px!important}.pb-catalog-backdrop{position:fixed;inset:0;z-index:100000;background:#020812eF;display:none;align-items:center;justify-content:center;padding:clamp(8px,2vw,24px);box-sizing:border-box}.pb-catalog-backdrop.open{display:flex}.pb-catalog-window{width:min(1180px,100%);height:min(88vh,900px);display:flex;flex-direction:column;background:#081727;border:1px solid #477ba5;box-shadow:0 24px 90px #000b;color:#eaf4ff}.pb-catalog-head{display:flex;align-items:center;gap:12px;padding:14px 18px;border-bottom:1px solid #29445f}.pb-catalog-head h2{font-size:16px;margin:0}.pb-catalog-head p{font-size:11px;color:#9db9d5;margin:4px 0 0}.pb-catalog-head button{margin-left:auto;background:transparent;color:#eaf4ff;border:1px solid #456987;padding:8px 12px}.pb-catalog-tools{display:flex;gap:8px;flex-wrap:wrap;padding:12px 16px;border-bottom:1px solid #29445f}.pb-catalog-tools input{flex:1;min-width:180px;background:#06111d;border:1px solid #36546f;color:#fff;padding:10px}.pb-catalog-groups{display:flex;gap:6px;overflow:auto;padding:0 16px 12px}.pb-catalog-groups button,.pb-catalog-card{background:#10243a;color:#dceeff;border:1px solid #29445f;padding:9px 12px;cursor:pointer;white-space:nowrap}.pb-catalog-groups button.active,.pb-catalog-card:hover{border-color:#70bfff;background:#163756}.pb-catalog-list{overflow:auto;padding:14px 16px 22px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}.pb-catalog-card{text-align:left;white-space:normal;min-height:78px;display:flex;flex-direction:column;gap:6px}.pb-catalog-card small{color:#83bde8;font-size:10px}.pb-catalog-card b{font-size:12px}.pb-catalog-card span{color:#9bb5cd;font-size:10px;line-height:1.4}.pb-feature-back{margin:14px 16px 0;align-self:flex-start;background:#123455;color:#eaf4ff;border:1px solid #477ba5;padding:8px 12px}.pb-feature-stage{overflow:auto;padding:16px;flex:1}.pb-catalog-foot{padding:9px 16px;border-top:1px solid #29445f;color:#86a8c7;font-size:10px}.pb-catalog-window.is-feature .pb-catalog-tools,.pb-catalog-window.is-feature .pb-catalog-groups,.pb-catalog-window.is-feature .pb-catalog-list{display:none}.pb-catalog-window.is-feature .pb-feature-back{display:block}.pb-feature-back{display:none}@media(max-width:760px){.pb-catalog-list{grid-template-columns:repeat(2,minmax(0,1fr))}.pb-catalog-window{height:94vh}}@media(max-width:480px){.pb-catalog-list{grid-template-columns:1fr}.pb-catalog-head{padding:10px}.pb-catalog-card{min-height:60px}}