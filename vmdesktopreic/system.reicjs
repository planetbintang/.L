(()=>{const $=s=>document.querySelector(s),roots=['acct','sys','system_ext','cache','config','media','data','repositori','vmdesktopreic','Aireber'],cats=["Kernel","Desktop","FileManager","Explorer","BlockLibrary","LayoutLibrary","Infrastructure","Configuration","Security","Network","Storage","Applications","Terminal","Monitoring","Notifications","Search","Backup","Integration","Git","Publishing"],total=1000000,size=120;let path='Beranda',q='',page=0,h=['Beranda'],pos=0;function data(){if(path==='Beranda'||path==='File System')return roots.map(n=>({n,dir:1}));if(path==='repositori')return[{n:'planetbintang/.L',dir:1},{n:'system-indexes',dir:1}];if(roots.includes(path))return['index.reic','system.reicss','system.reicjs','manifest.json',...cats.slice(0,10).map(x=>x.toLowerCase())].map(n=>({n,dir:!n.includes('.')}));return Array.from({length:size},(_,i)=>({n:path+'-'+String(page*size+i+1).padStart(7,'0')+(i%3===0?'.reic':i%3===1?'.reicss':'.reicjs'),dir:0,id:page*size+i+1}));}function draw(){let d=data().filter(x=>x.n.toLowerCase().includes(q));$('#items').innerHTML='';d.forEach(x=>{let b=document.createElement('button');b.innerHTML='<b>'+(x.dir?'📁':x.n.endsWith('.reicss')?'🎨':x.n.endsWith('.reicjs')?'📜':'▤')+'</b><span></span>';b.lastChild.textContent=x.n;b.onclick=()=>x.dir?go(x.n):app(x.n,'Indeks REIC '+(x.id||'utama')+'<br>Registry virtual • format REIC');$('#items').append(b)});$('#path').textContent='/ '+path;$('#status').textContent=d.length+' item · '+(path==='Beranda'?'10 folder sistem':'indeks '+(page*size+1)+'–'+Math.min(total,(page+1)*size)+' / 1.000.000 · klik untuk halaman berikutnya')}function go(p){path=p;q='';$('#search').value='';page=0;h=h.slice(0,pos+1);h.push(p);pos++;draw()}function app(n,body){let e=document.createElement('section');e.className='app';e.innerHTML='<button>×</button><h3></h3><p></p>';e.querySelector('h3').textContent=n;e.querySelector('p').innerHTML=body||'Modul sistem REIC terhubung dengan 150 indeks utama.';e.querySelector('button').onclick=()=>e.remove();$('#apps').replaceChildren(e)}document.querySelectorAll('[data-open]').forEach(b=>b.onclick=()=>{let n=b.dataset.open;if(n==='File Manager'){$('#file-window').hidden=false;return}app(n,'Modul '+n+'<br>150 indeks utama · 1.000.000 sublink virtual · .REIC / .REICSS / .REICJS')});document.querySelectorAll('[data-folder]').forEach(b=>b.onclick=()=>go(b.dataset.folder));$('#search').oninput=e=>{q=e.target.value.toLowerCase();draw()};$('#back').onclick=()=>{if(pos){path=h[--pos];draw()}};$('#forward').onclick=()=>{if(pos<h.length-1){path=h[++pos];draw()}};$('#up').onclick=()=>go('Beranda');$('#grid').onclick=()=>$('#items').style.gridTemplateColumns='repeat(auto-fill,minmax(76px,1fr))';$('#list').onclick=()=>$('#items').style.gridTemplateColumns='1fr';document.querySelector('[data-close]').onclick=()=>$('#file-window').hidden=true;document.querySelector('[data-min]').onclick=()=>$('#file-window').hidden=true;document.querySelector('[data-max]').onclick=()=>{const w=$('#file-window');w.classList.toggle('maximized');w.style.width=w.classList.contains('maximized')?'100%':'min(100%,900px)';w.style.height=w.classList.contains('maximized')?'100%':'min(86%,450px)'};$('#status').onclick=e=>{if(path!=='Beranda'&&path!=='File System'&&!roots.includes(path)){page=e.shiftKey?Math.max(0,page-1):(page+1)*size<total?page+1:0;draw()}};const win=$('#file-window'),bar=win.querySelector('.window-title');let drag=null;bar.addEventListener('pointerdown',e=>{if(e.target.closest('button'))return;drag={x:e.clientX-win.offsetLeft,y:e.clientY-win.offsetTop};bar.setPointerCapture(e.pointerId)});bar.addEventListener('pointermove',e=>{if(drag){win.style.position='fixed';win.style.left=(e.clientX-drag.x)+'px';win.style.top=(e.clientY-drag.y)+'px';win.style.margin=0}});bar.addEventListener('pointerup',()=>drag=null);$('#clock').textContent=new Intl.DateTimeFormat('id-ID',{hour:'2-digit',minute:'2-digit'}).format(new Date());draw();window.PB_REIC_FS={physicalIndexes:150,virtualSublinks:total,pageSize:size,extensions:['.reic','.reicss','.reicjs']};})();