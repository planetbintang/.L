<section id="planetKeyboard" class="planet-keyboard">
 <header class="pk-overview"><div class="pk-brand"><span>⌨</span><div><small>VMDESKTOPREIC · OS MEDIA VM</small><h2>KEYBOARD</h2><p>Keyboard Independent · Tombol · Layout · Output</p></div></div><div class="pk-controls"><label>LAYOUT<select id="pkLayout"><option value="standard">Standar</option><option value="independent">Keyboard Independen</option><option value="nurnaisli">Nurnaisli</option></select></label><label>RESOLUSI<select id="pkScale"><option value="100">100%</option><option value="90">90%</option><option value="80">80%</option><option value="110">110%</option></select></label></div></header>
 <div class="pk-main"><section class="pk-panel pk-layout"><h3>LAYOUT TOMBOL</h3><div class="pk-keys" id="pkKeys"></div><div class="pk-extra"><button data-key="⌜">⌜</button><button data-key="⌟">⌟</button><button data-key="↹">↹</button><button data-key="⌞">⌞</button><button data-key="⌝">⌝</button><button data-key="↵">↵</button><button data-key="⇧">⇧</button></div></section>
 <section class="pk-panel pk-functions"><h3>TOMBOL FUNGSIONAL</h3><button data-action="save"><b>▣</b><span><strong>SIMPAN</strong><small>Menyimpan data / file</small></span><i>›</i></button><button data-action="process"><b>⚙</b><span><strong>PROSES</strong><small>Menjalankan proses keyboard</small></span><i>›</i></button><button data-action="record"><b>◉</b><span><strong>RECORDIN</strong><small>Rekaman ganda / double recordin</small></span><i>›</i></button><button data-action="alpha"><b>A</b><span><strong>ALFABETA AB / TAB</strong><small>Mode huruf / tab</small></span><i>›</i></button><button data-action="remove"><b>▤</b><span><strong>REMOVE</strong><small>Menghapus karakter terakhir</small></span><i>›</i></button><button data-action="international"><b>◎</b><span><strong>INTERNASIONAL</strong><small>Inter / Enter</small></span><i>›</i></button></section>
 <section class="pk-panel pk-output"><div class="pk-panel-title"><h3>OUTPUT TOMBOL</h3><button id="pkClear">BERSIHKAN</button></div><div id="pkLog" class="pk-log" aria-live="polite"></div><label class="pk-text-label">HASIL INPUT<textarea id="pkOutput" placeholder="Tekan tombol layout untuk menghasilkan output…"></textarea></label></section>
 <section class="pk-panel pk-nurnaisli"><h3>KEYBOARD NLC &amp; NLD</h3><div class="pk-symbols"><button data-key="⌜">⌜</button><button data-key="⌟">⌟</button><span>NURNAISLI NL</span><button data-key="⌞">⌞</button><button data-key="⌝">⌝</button><span>NURNAISLI NLD</span><button data-key="⌜">⌜</button><button data-key="⌟">⌟</button><span>NURNAISLI J</span><button data-key="⌞">⌞</button><button data-key="⌝">⌝</button><span>NURNAISLI Z</span></div></section></div>
 <div class="pk-status"><span id="pkState">● SISTEM KEYBOARD AKTIF</span><span id="pkCount">0 TOMBOL</span><span>REIC · INPUT / OUTPUT LOKAL</span></div>
</section>