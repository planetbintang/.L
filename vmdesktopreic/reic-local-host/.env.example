REIC_PORT=8787
GITHUB_OWNER=planetbintang
# Buat token fine-grained dengan izin Metadata: Read-only dan Contents: Read-only
# Batasi token hanya pada repositori yang diperlukan. Jangan pernah memasukkan token ke berkas frontend.
GITHUB_TOKEN=ISI_TOKEN_GITHUB_DI_LINGKUNGAN_LOKAL
REIC_STORAGE_ROOT=./data
REIC_ALLOWED_ORIGINS=http://127.0.0.1:8787,http://localhost:8787,https://planetbintang.github.io
\n# Opsional: kunci Bing Web Search API untuk hasil web dari mesin pencari REIC\nBING_SEARCH_KEY=\n# Direktori yang diindeks, dipisahkan koma. Default: root repositori dan data lokal\nREIC_SEARCH_ROOTS=../../,./data\n