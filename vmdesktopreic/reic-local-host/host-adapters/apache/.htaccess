# REIC Local Host — Apache .htaccess
# Memerlukan AllowOverride All dan modul mod_proxy, mod_proxy_http, mod_headers.
RewriteEngine On
RewriteRule ^api/reic/(.*)$ http://127.0.0.1:8787/api/reic/$1 [P,L]
RewriteRule ^health$ http://127.0.0.1:8787/health [P,L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Tolak akses web ke penyimpanan lokal dan rahasia.
<FilesMatch "^\.env$">
  Require all denied
</FilesMatch>
