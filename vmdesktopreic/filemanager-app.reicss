/* FILEMANAJER application frame · OS MEDIA VM graphite/cyan */
.pb-filemanajer-window{position:absolute;z-index:80;left:390px;top:80px;width:min(1380px,calc(100% - 430px));height:min(820px,calc(100% - 150px));min-width:680px;min-height:420px;display:flex;flex-direction:column;background:#081522;border:1px solid #83e1ff;box-shadow:0 22px 70px #000b;color:#eaf4ff;overflow:hidden}
.pb-filemanajer-window[hidden]{display:none}.pfm-head{height:62px;flex:0 0 62px;display:flex;align-items:center;gap:9px;padding:0 12px;background:linear-gradient(100deg,#10263b,#091522);border-bottom:1px solid #29445d;cursor:move}.pfm-mark{font-size:25px;color:#83e1ff}.pfm-brand{min-width:150px;display:grid;gap:3px}.pfm-brand b{font-size:13px;letter-spacing:.1em}.pfm-brand small{font-size:8px;color:#91a8c3}.pfm-modes{display:flex;gap:3px;flex:1;justify-content:center;overflow:auto}.pfm-head button{border:1px solid #31536b;background:#10243a;color:#dff7ff;padding:9px 10px;cursor:pointer;white-space:nowrap}.pfm-modes button{font-size:9px}.pfm-modes button.active,.pfm-head .pfm-run,.pfm-head .pfm-build{border-color:#83e1ff;background:#17405a;color:#fff}.pfm-head .pfm-close{font-size:18px}.pfm-body{display:grid;grid-template-columns:minmax(0,1fr) 245px;min-height:0;flex:1}.pfm-app-host{min-width:0;min-height:0;overflow:auto;padding:10px;background:#091625}.pfm-sidepanel{min-width:0;padding:14px;border-left:1px solid #29445d;background:linear-gradient(160deg,#10243a,#081522);overflow:auto}.pfm-sidepanel>b{font-size:10px;letter-spacing:.12em;color:#83e1ff}.pfm-sidepanel p,.pfm-sidepanel li{font-size:11px;line-height:1.6;color:#b8cbe0}.pfm-sidepanel label{display:grid;gap:7px;font-size:10px;color:#83e1ff}.pfm-sidepanel input{width:100%;padding:9px;background:#06111e;border:1px solid #31536b;color:#fff}.pfm-sidepanel button{margin:7px 4px 0 0;padding:8px 10px;border:1px solid #47718e;background:#14334a;color:#eaf4ff;cursor:pointer;font-size:9px}.pfm-note{padding:9px;border-left:2px solid #e2b66f;background:#2b261c;color:#d9c59f!important}.pfm-check{padding:7px;border-bottom:1px solid #29445d}.pfm-check.ok{color:#9be7c0}.pfm-check.warn{color:#f2c67c}.pfm-log{margin-top:14px;padding:10px;border:1px solid #31536b;background:#06111e;color:#9edcff;font:9px/1.5 monospace;overflow-wrap:anywhere}.pfm-foot{height:28px;flex:0 0 28px;display:flex;justify-content:space-between;align-items:center;gap:10px;padding:0 12px;background:#07111d;border-top:1px solid #29445d;color:#8fa9c1;font:8px monospace}.pfm-loading,.pfm-error{padding:24px;color:#9edcff}.pb-filemanajer-shortcut{position:absolute;z-index:5;left:405px;top:115px;display:grid;gap:8px;justify-items:center;width:100px;padding:12px 5px;border:1px solid #31536b;background:#0b1c2c;color:#eaf4ff;cursor:pointer}.pb-filemanajer-shortcut span{font-size:34px;color:#83e1ff}.pb-filemanajer-shortcut b{font-size:9px;letter-spacing:.08em}
@media(max-width:900px){.pb-filemanajer-window{left:8px!important;top:8px!important;width:calc(100% - 16px);height:calc(100% - 16px);min-width:0;min-height:0}.pfm-body{grid-template-columns:minmax(0,1fr)}.pfm-sidepanel{display:none}.pfm-brand{min-width:0}.pfm-modes{justify-content:flex-start}.pfm-head{gap:4px;padding:0 5px}.pfm-head button{padding:7px 6px;font-size:8px}}
