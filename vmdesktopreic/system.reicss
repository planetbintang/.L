*{box-sizing:border-box}body{margin:0;background:#020820;color:#f5faff;font-family:Inter,Arial,sans-serif}.universe{min-height:100vh;overflow:hidden;background:radial-gradient(ellipse at 68% 12%,#174cae,transparent 42%),radial-gradient(ellipse at 20% 78%,#0758bd,transparent 38%),linear-gradient(145deg,#01051a,#031849 55%,#01051b);position:relative}.universe:before{content:"";position:absolute;inset:0;pointer-events:none;background-image:radial-gradient(1px 1px at 12% 13%,white 99%,transparent),radial-gradient(2px 2px at 40% 22%,#7bbdff 99%,transparent),radial-gradient(1px 1px at 76% 8%,white 99%,transparent),radial-gradient(1px 1px at 88% 42%,white 99%,transparent);background-size:190px 160px,270px 220px,230px 180px,170px 210px}.brand{height:32vh;min-height:210px;display:flex;align-items:center;justify-content:center;gap:clamp(15px,4vw,48px);text-align:center;border-bottom:2px solid #159fff;box-shadow:0 0 15px #078cff}.planet{font-size:clamp(60px,10vw,120px);color:#7bcaff;text-shadow:0 0 22px #078bff;position:relative}.planet b{position:absolute;right:-8px;top:-5px;color:white;font-size:.45em}.brand-name{font-size:clamp(30px,7vw,72px);font-weight:900;font-style:italic;letter-spacing:-.06em;text-shadow:0 4px 12px #001}.brand-name span{color:#18aaff}.brand-reic{font-size:clamp(20px,3vw,34px);font-weight:800;letter-spacing:.6em;padding-left:.6em}.tagline{font-size:clamp(9px,1.3vw,15px);letter-spacing:.32em;margin-top:9px}.system-bar{height:48px;background:#010b27eF;border-bottom:1px solid #188dff;display:flex;align-items:center;justify-content:space-between;padding:0 2%;gap:10px;font-size:clamp(9px,1.1vw,13px)}.system-bar span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.desktop-stage{height:48vh;min-height:380px;display:grid;grid-template-columns:minmax(55px,8%) minmax(0,1fr) minmax(55px,8%);gap:clamp(7px,2vw,22px);padding:16px 2.5%;position:relative;background:linear-gradient(#00133b55,#041e66aa 80%,#00102d)}.desktop-stage:after{content:"";position:absolute;bottom:0;left:0;right:0;height:3px;background:#20c9ff;box-shadow:0 0 18px #19aaff}.launcher{display:flex;flex-direction:column;justify-content:space-around;align-items:center;z-index:1}.launcher button{border:0;background:none;color:white;display:flex;flex-direction:column;align-items:center;gap:4px;font-size:clamp(22px,3vw,34px);cursor:pointer;text-shadow:0 0 10px #09f}.launcher small{font-size:clamp(8px,1vw,12px);font-weight:700;max-width:70px}.workspace{min-width:0;display:flex;justify-content:center;align-items:center;position:relative}.window{width:min(100%,900px);height:min(86%,450px);min-height:275px;border:1px solid #138aff;border-radius:12px;background:#061b45f2;box-shadow:0 18px 50px #0009,0 0 22px #087cff70;overflow:hidden}.window-title{height:42px;display:flex;align-items:center;justify-content:space-between;padding:0 12px;background:linear-gradient(90deg,#05112e,#092d69);border-bottom:1px solid #2a91ff}.window-title button{width:25px;height:24px;border:1px solid #1a82e9;border-radius:4px;color:white;background:#073b85;cursor:pointer}.file-layout{height:calc(100% - 42px);display:grid;grid-template-columns:140px minmax(0,1fr)}.file-nav{background:linear-gradient(#123b84,#071c4c);padding:8px 6px;overflow:auto}.file-nav button{width:100%;padding:8px 5px;text-align:left;color:#eaf5ff;border:0;background:transparent;border-radius:5px;font-size:11px;cursor:pointer}.file-nav button:hover{background:#1684ee}.file-nav hr{border:0;border-top:1px solid #ffffff28}.file-main{background:linear-gradient(145deg,#eaf4ff,#c9ddfb);color:#071b3d;display:flex;flex-direction:column;min-width:0}.file-toolbar{height:42px;display:flex;align-items:center;gap:5px;padding:5px 8px}.file-toolbar button{border:0;background:#d9e9ff;color:#16477e;border-radius:4px;height:28px;min-width:26px;cursor:pointer}.file-toolbar input{min-width:0;flex:1;border:1px solid #a9c8ef;border-radius:5px;padding:7px;color:#132a4e}#path{padding:4px 12px;font-size:10px;color:#54749b}#items{padding:10px;display:grid;grid-template-columns:repeat(auto-fill,minmax(76px,1fr));gap:8px;align-content:start;overflow:auto;flex:1}#items button{border:1px solid transparent;background:transparent;color:#092449;border-radius:7px;min-height:74px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;font-size:10px;font-weight:700;overflow-wrap:anywhere;cursor:pointer}#items button:hover{background:#a9d1ff80;border-color:#80baff}#items b{font-size:34px;color:#168bfa}#status{height:27px;padding:6px 10px;border-top:1px solid #aac9ef;font-size:10px;color:#23446c}.caption{position:absolute;bottom:-2px;left:0;font-size:clamp(14px,2vw,22px);font-weight:900;text-shadow:0 2px 8px #000}.footer{min-height:20vh;padding:22px 5%;display:flex;align-items:end;justify-content:space-between;background:radial-gradient(ellipse at 50% -15%,#148bff80,transparent 55%),linear-gradient(#061f5b,#01091f);position:relative}.footer:before{content:"";position:absolute;left:-10%;right:-10%;top:-35px;height:90px;border-top:5px solid #7edcff;border-radius:50% 50% 0 0;box-shadow:0 -8px 24px #087cff}.footer strong{display:block;font-size:clamp(17px,2.5vw,28px)}.footer em{font-style:normal;color:#20c9ff}.footer span{font-size:clamp(14px,2vw,22px)}.footer p{text-align:right;font-style:italic}#apps{position:fixed;inset:0;z-index:5;pointer-events:none}.app{pointer-events:auto;position:absolute;top:18%;left:50%;transform:translateX(-50%);width:min(650px,90vw);padding:18px;background:#061b45f5;border:1px solid #168dff;border-radius:9px;box-shadow:0 18px 55px #000c}.app button{float:right;background:#a8204a;color:white;border:0;padding:5px 10px}@media(max-width:650px){.brand{height:25vh;min-height:170px}.planet{display:none}.desktop-stage{height:54vh;min-height:420px;grid-template-columns:45px minmax(0,1fr) 45px;padding:10px 4px;gap:3px}.launcher small{font-size:8px}.window{height:80%;min-height:300px}.file-layout{grid-template-columns:86px minmax(0,1fr)}.file-nav button{font-size:9px;padding:8px 3px}#items{grid-template-columns:repeat(3,minmax(0,1fr));gap:3px;padding:5px}#items b{font-size:28px}.caption{display:none}.footer{min-height:18vh;padding:14px 4%}.footer p{max-width:42%;font-size:12px}}