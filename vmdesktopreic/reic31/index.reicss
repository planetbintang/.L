:root{--reic-bg:#071523;--reic-panel:#102a40;--reic-line:#27536e;--reic-cyan:#65d9ff;--reic-text:#eaf7ff}#reic31-app{position:fixed;z-index:99990;inset:0;display:none;flex-direction:column;background:#030b14;color:var(--reic-text);font:14px/1.5 system-ui,sans-serif}#reic31-app.open{display:flex}#reic31-app *{box-sizing:border-box}#reic31-top{display:flex;gap:12px;align-items:center;padding:12px 16px;background:#071827;border-bottom:1px solid var(--reic-line)}#reic31-top strong{color:var(--reic-cyan);letter-spacing:.12em}#reic31-top input{flex:1;min-width:0;padding:11px;border:1px solid var(--reic-line);border-radius:9px;background:#0b2031;color:white}#reic31-close,#reic31-nav button,.reic31-action{border:1px solid #277ba0;border-radius:9px;background:#0b2b43;color:white;padding:10px 13px;cursor:pointer}#reic31-nav{display:flex;gap:7px;overflow:auto;padding:10px;background:#091b2a}#reic31-nav button{white-space:nowrap;font-size:10px}#reic31-nav button[aria-current=true]{border-color:var(--reic-cyan);background:#104365}#reic31-content{overflow:auto;flex:1;padding:clamp(16px,3vw,38px);background:radial-gradient(ellipse at 80% 0%,#124b8055,transparent 42%),linear-gradient(145deg,#071523,#0b1d30 58%,#07111e)}.reic31-heading{display:flex;justify-content:space-between;gap:20px;align-items:center;padding-bottom:22px;border-bottom:1px solid #3d769855}.reic31-heading small{color:var(--reic-cyan);letter-spacing:.18em}.reic31-heading h1{font-size:clamp(24px,3vw,42px);margin:8px 0}.reic31-heading p,.reic31-card p{color:#94b4cb}.reic31-mark{padding:18px;border:1px solid var(--reic-cyan);border-radius:16px;background:#102d46;font-weight:900}.reic31-metrics,.reic31-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:18px}.reic31-metrics{grid-template-columns:repeat(3,minmax(0,1fr))}.reic31-metric,.reic31-card{padding:18px;border:1px solid var(--reic-line);border-radius:14px;background:linear-gradient(145deg,#112b40,#0a1b2a)}.reic31-metric small{display:block;color:#7ea2b9;font-size:10px}.reic31-metric b{font-size:22px}.reic31-card h3{margin:8px 0}.reic31-card p{font-size:12px}.reic31-card[hidden]{display:none}@media(max-width:640px){.reic31-metrics,.reic31-grid{grid-template-columns:1fr}#reic31-top strong{font-size:10px}}