:root{--reic-bg:#07111f;--reic-panel:#0d1a2b;--reic-panel-2:#10243a;--reic-line:#29445d;--reic-cyan:#83e1ff;--reic-text:#eaf4ff;--reic-muted:#91a8c3}
#reic31-app{position:absolute;z-index:40;inset:0;display:none;flex-direction:column;min-width:0;min-height:0;overflow:hidden;background-color:var(--reic-bg);background-image:radial-gradient(ellipse at 72% -12%,rgba(31,76,112,.48),transparent 48%),linear-gradient(rgba(131,225,255,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(131,225,255,.045) 1px,transparent 1px),linear-gradient(145deg,#07111f,#0a1727 60%,#050c16);background-size:auto,28px 28px,28px 28px,auto;color:var(--reic-text);font:14px/1.5 system-ui,sans-serif}
#reic31-app.open{display:flex}
#reic31-app *{box-sizing:border-box;border-radius:0!important}
#reic31-top{display:flex;gap:12px;align-items:center;flex:0 0 auto;padding:12px 16px;background:linear-gradient(100deg,#0d1a2b,#10243a 58%,#0a1727);border-bottom:1px solid var(--reic-line)}
#reic31-top strong{color:var(--reic-cyan);letter-spacing:.12em}
#reic31-top input{flex:1;min-width:0;padding:11px;border:1px solid var(--reic-line);background:#071321;color:white}
#reic31-close,#reic31-nav button,.reic31-action{border:1px solid var(--reic-line);background:#10243a;color:white;padding:10px 13px;cursor:pointer}
#reic31-close:hover,#reic31-nav button:hover,.reic31-action:hover{border-color:var(--reic-cyan);background:#173b56}
#reic31-nav{display:flex;gap:7px;overflow:auto;flex:0 0 auto;padding:10px;background:#091625;border-bottom:1px solid var(--reic-line)}
#reic31-nav button{white-space:nowrap;font-size:10px}
#reic31-nav button[aria-current=true]{border-color:var(--reic-cyan);background:#173b56;color:#fff}
#reic31-content{overflow:auto;flex:1;min-height:0;padding:clamp(16px,3vw,38px);background:transparent}
.reic31-heading{display:flex;justify-content:space-between;gap:20px;align-items:center;padding-bottom:22px;border-bottom:1px solid #3d769855}
.reic31-heading small{color:var(--reic-cyan);letter-spacing:.18em}
.reic31-heading h1{font-size:clamp(24px,3vw,42px);margin:8px 0}
.reic31-heading p,.reic31-card p{color:var(--reic-muted)}
.reic31-mark{padding:18px;border:1px solid var(--reic-cyan);background:#10243a;font-weight:900}
.reic31-metrics,.reic31-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:18px}
.reic31-metrics{grid-template-columns:repeat(3,minmax(0,1fr))}
.reic31-metric,.reic31-card{padding:18px;border:1px solid var(--reic-line);background:linear-gradient(145deg,#0d1b2d,#081321)}
.reic31-metric small{display:block;color:var(--reic-muted);font-size:10px}
.reic31-metric b{font-size:22px}
.reic31-card h3{margin:8px 0}
.reic31-card p{font-size:12px}
.reic31-card[hidden]{display:none}
@media(max-width:640px){.reic31-metrics,.reic31-grid{grid-template-columns:1fr}#reic31-top{flex-wrap:wrap}#reic31-top strong{font-size:10px}#reic31-top input{order:3;flex-basis:100%}.reic31-heading{align-items:flex-start}.reic31-mark{padding:10px}}
