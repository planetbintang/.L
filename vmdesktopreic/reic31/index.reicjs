(()=>{'use strict';const defs=[["REIC DESKTOP","Pusat kerja dan ringkasan sistem","Ringkasan Sistem|Aktivitas|Ruang Kerja|Status Runtime"],["REIC FILE MANAGER","Berkas, folder, repositori, penyimpanan","Struktur Folder|Berkas Terbaru|Penyimpanan|Repositori"],["REIC WORKSPACE","Ruang kerja multi-panel","Panel Aktif|Sesi Kerja|Ruang Tersimpan|Kolaborasi"],["REIC CONTROL CENTER","Kontrol konfigurasi dan preferensi","Kontrol Utama|Perangkat|Preferensi|Profil Sistem"],["REIC APP CENTER","Katalog aplikasi dan modul","Aplikasi Terpasang|Katalog Modul|Kategori|Pembaruan"],["REIC WINDOW MANAGER","Pengaturan lapisan dan panel","Lapisan Aktif|Posisi Panel|Aturan Tampilan|Preset"],["REIC MODAL CENTER","Dialog dan panel kontekstual","Dialog Aktif|Formulir|Riwayat|Komponen Dialog"],["REIC NOTIFICATION","Pemberitahuan sistem","Semua Notifikasi|Belum Dibaca|Prioritas|Riwayat"],["REIC SEARCH","Pencarian terpadu","Pencarian Global|Repositori|Dokumen|Riwayat"],["REIC TERMINAL","Konsol perintah runtime","Konsol|Riwayat Perintah|Tugas|Informasi Runtime"],["REIC CODE EDITOR","Editor kode dan inspeksi sumber","Editor|Berkas Proyek|Pemeriksaan|Perubahan"],["REIC NODE EDITOR","Alur node dan koneksi","Kanvas Node|Node Tersedia|Koneksi|Validasi Alur"],["REIC VISUAL BUILDER","Pembangun halaman visual","Kanvas Halaman|Komponen|Properti|Pratinjau"],["REIC LAYOUT EDITOR","Grid dan tata letak","Kanvas Layout|Grid|Breakpoint|Inspektor"],["REIC COMPONENT LIBRARY","Katalog komponen","Komponen|Kategori|Versi|Dokumentasi"],["REIC BLOCK LIBRARY","Koleksi blok dan pola","Blok|Pola|Koleksi|Detail Blok"],["REIC IMAGE MANAGER","Aset gambar dan galeri","Galeri Aset|Unggahan|Metadata|Koleksi"],["REIC COLOR STUDIO","Palet dan gradasi","Palet|Gradasi|Token Warna|Kontras"],["REIC FONT STUDIO","Font dan tipografi","Keluarga Font|Spesimen|Skala Teks|Glyph"],["REIC DISPLAY CENTER","Resolusi dan viewport","Resolusi|Viewport|Orientasi|Skala UI"],["REIC SYSTEM MONITOR","Pemantauan runtime","CPU & Memori|Penyimpanan|Proses|Log Sistem"],["REIC NETWORK CENTER","Koneksi dan topologi","Koneksi|Topologi|Transfer|Diagnostik"],["REIC SECURITY CENTER","Keamanan dan audit","Status Keamanan|Izin|Audit|Kebijakan"],["REIC CLOUD CENTER","Penyimpanan cloud","Ruang Cloud|Sinkronisasi|Transfer|Riwayat"],["REIC AI CENTER","Asisten dan orkestrasi AI","Percakapan|Agen|Model|Riwayat Tugas"],["REIC DOCUMENT STUDIO","Pembuatan dokumen","Dokumen|Templat|Editor|Ekspor"],["REIC MEDIA STUDIO","Pengelolaan media","Perpustakaan Media|Timeline|Pemutar|Ekspor Media"],["REIC APPLICATION MANAGER","Siklus hidup aplikasi","Aplikasi|Instalasi|Konfigurasi|Log Aplikasi"],["REIC DATA CENTER","Dataset dan struktur data","Dataset|Tabel|Skema|Impor Data"],["REIC DEPLOYMENT CENTER","Build dan deployment","Build|Rilis|Lingkungan|Log Deployment"],["REIC POWER CENTER","Daya dan efisiensi","Status Daya|Mode Operasi|Konsumsi|Riwayat"]];const app=document.querySelector('#reic31-app');if(!app||app.dataset.ready)return;app.dataset.ready='1';const nav=app.querySelector('#reic31-nav'),content=app.querySelector('#reic31-content');let active=0;defs.forEach((d,i)=>{const b=document.createElement('button');b.textContent=String(i+1).padStart(2,'0')+' · '+d[0];b.onclick=()=>render(i);nav.append(b)});function render(i){active=i;const d=defs[i],mods=d[2].split('|');nav.querySelectorAll('button').forEach((b,n)=>b.setAttribute('aria-current',String(n===i)));content.innerHTML='<header class="reic31-heading"><div><small>PLANETBINTANG / OS MEDIA VM / REIC-'+String(i+1).padStart(2,'0')+'</small><h1>'+d[0]+'</h1><p>'+d[1]+'</p></div><div class="reic31-mark">REIC '+String(i+1).padStart(2,'0')+'</div></header><div class="reic31-metrics"><div class="reic31-metric"><small>MODUL TERSEDIA</small><b>04</b></div><div class="reic31-metric"><small>STATUS RUNTIME</small><b>ONLINE</b></div><div class="reic31-metric"><small>INDEKS TAMPILAN</small><b>'+(i+1)+'/31</b></div></div><h2>Kontrol dan komponen</h2><div class="reic31-grid">'+mods.map((m,j)=>'<article class="reic31-card"><small>MODUL '+String(j+1).padStart(2,'0')+'</small><h3>'+m+'</h3><p>Panel '+m.toLowerCase()+' pada '+d[0]+'.</p><button class="reic31-action" data-module="'+j+'">BUKA MODUL ↗</button></article>').join('')+'</div>';content.querySelectorAll('[data-module]').forEach(b=>b.onclick=()=>{b.textContent='✓ MODUL DIPILIH';content.dispatchEvent(new CustomEvent('reic:module',{bubbles:true,detail:{screen:d[0],module:mods[Number(b.dataset.module)]}}))})}app.querySelector('#reic31-close').onclick=()=>app.classList.remove('open');app.querySelector('#reic31-search').oninput=e=>nav.querySelectorAll('button').forEach(b=>b.hidden=!b.textContent.toLowerCase().includes(e.target.value.toLowerCase()));document.addEventListener('keydown',e=>{if(e.key==='Escape')app.classList.remove('open')});const launcher=document.createElement('button');launcher.id='reic31-launch';launcher.textContent='▦ 31 REIC';launcher.onclick=()=>{app.classList.add('open');render(active)};document.querySelector('.vm-header-tools')?.prepend(launcher);render(0);window.VMDESKTOPREIC31=Object.freeze({open:()=>launcher.click(),screens:31,registryCapacity:1500000})})();