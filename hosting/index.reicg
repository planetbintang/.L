export const moduleCount=()=>hostingModules.length;
export const subfeatureCount=()=>hostingModules.reduce((n,m)=>n+m.submenus.length,0);
export function validateServiceConfig(config){return Boolean(config&&typeof config==="object"&&config.provider&&config.endpoint)}
export function createActionRequest(module,action,payload={}){return {module,action,payload,createdAt:new Date().toISOString(),mode:"preview"}}
