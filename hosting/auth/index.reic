<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="hosting-api" content="/api/hosting/v1"><meta name="theme-color" content="#07111f"><title>Register & Login — Hosting PlanetBintang</title><style>
:root{color-scheme:dark;--bg:#07111f;--panel:#0e1c2e;--line:#2a405a;--text:#edf5ff;--muted:#9cb0c9;--accent:#0981d1;--mint:#69e0c4}*{box-sizing:border-box}body{margin:0;background:radial-gradient(850px 420px at 80% -10%,#183a62,transparent 65%),var(--bg);color:var(--text);font:14px/1.55 Inter,system-ui,sans-serif}a{color:var(--accent);text-decoration:none}.top{padding:18px 5%;border-bottom:1px solid var(--line);display:flex;justify-content:space-between}.wrap{max-width:760px;margin:5vh auto;padding:20px}.panel{background:var(--panel);border:1px solid var(--line);padding:clamp(18px,4vw,32px)}h1{font-size:clamp(28px,5vw,42px);margin:8px 0}.muted{color:var(--muted)}.tabs{display:flex;gap:8px;margin:22px 0}.tabs button,button{min-height:46px;padding:10px 16px;background:#102a43;border:1px solid #426184;color:var(--text);cursor:pointer}.tabs button[aria-selected=true]{background:var(--accent);border-color:var(--accent)}label{display:block;margin:14px 0 6px}input{width:100%;min-height:46px;padding:10px;background:#071727;border:1px solid var(--line);color:var(--text)}form button{width:100%;margin-top:18px;background:var(--accent)}.status{min-height:48px;margin-top:16px;color:var(--mint);white-space:pre-wrap}.hidden{display:none}.foot{margin-top:20px;color:var(--muted);font-size:12px}
</style></head><body><header class="top"><b>PLANETBINTANG / HOSTING</b><a href="../index.reic">KEMBALI KE HOSTING</a></header><main class="wrap"><section class="panel"><p class="muted">IDENTITAS PENGGUNA · REIC AUTH</p><h1>Akses Hosting</h1><p class="muted">Buat akun atau masuk untuk mengelola layanan, domain, website, server, dan berkas Hosting.</p><div class="tabs"><button id="tab-login" aria-selected="true" type="button">LOGIN</button><button id="tab-register" aria-selected="false" type="button">REGISTER</button></div><form id="login"><label for="login-email">Email akun</label><input id="login-email" type="email" autocomplete="username" required><label for="login-password">Kata sandi</label><input id="login-password" type="password" autocomplete="current-password" required minlength="10"><button type="submit">MASUK KE HOSTING</button></form><form id="register" class="hidden"><label for="name">Nama lengkap / organisasi</label><input id="name" autocomplete="name" required maxlength="120"><label for="email">Email</label><input id="email" type="email" autocomplete="email" required><label for="password">Kata sandi (minimal 10 karakter)</label><input id="password" type="password" autocomplete="new-password" required minlength="10"><label for="confirm">Ulangi kata sandi</label><input id="confirm" type="password" autocomplete="new-password" required minlength="10"><button type="submit">BUAT AKUN HOSTING</button></form><p id="status" class="status" role="status" aria-live="polite">Backend belum diverifikasi. Form akan mengirim data ke API Hosting; tidak ada akun palsu yang dibuat di browser.</p><p class="foot">Kata sandi hanya dikirim melalui HTTPS ke backend. Backend wajib melakukan hashing Argon2id/bcrypt, verifikasi email, pembatasan percobaan, dan penerbitan sesi aman.</p></section></main><script src="../assets/hosting-core.js"></script><script>
(()=>{const $=id=>document.getElementById(id),status=$("status"),login=$("login"),register=$("register");function tab(which){const isLogin=which==="login";login.classList.toggle("hidden",!isLogin);register.classList.toggle("hidden",isLogin);$("tab-login").setAttribute("aria-selected",String(isLogin));$("tab-register").setAttribute("aria-selected",String(!isLogin));status.textContent=isLogin?"Masuk menggunakan akun Hosting.":"Pendaftaran akun baru Hosting."}
$("tab-login").onclick=()=>tab("login");$("tab-register").onclick=()=>tab("register");
login.onsubmit=async e=>{e.preventDefault();status.textContent="Menghubungkan ke backend…";try{const data=await HostingREIC.request("/auth/login",{method:"POST",auth:false,body:{email:$("login-email").value.trim(),password:$("login-password").value}});HostingREIC.saveSession(data.session||data);await HostingREIC.log("auth.login","account");location.href="../profile/index.reic"}catch(err){status.textContent=err.message}};
register.onsubmit=async e=>{e.preventDefault();if($("password").value!==$("confirm").value){status.textContent="Konfirmasi kata sandi tidak cocok.";return}status.textContent="Mengirim pendaftaran ke backend…";try{const data=await HostingREIC.request("/auth/register",{method:"POST",auth:false,body:{name:$("name").value.trim(),email:$("email").value.trim(),password:$("password").value}});status.textContent=data.message||"Pendaftaran diterima. Periksa email untuk verifikasi.";register.reset()}catch(err){status.textContent=err.message}};
})();</script></body></html>