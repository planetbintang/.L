{
  "functions": {
    "api/**/*.js": { "maxDuration": 15 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {"key":"X-Content-Type-Options","value":"nosniff"},
        {"key":"Referrer-Policy","value":"same-origin"},
        {"key":"Cache-Control","value":"no-store"}
      ]
    }
  ]
}