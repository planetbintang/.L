<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#07111f">
<meta name="description" content="Konsol operasional GitHub Planetbintang dengan data langsung dari GitHub REST API.">
<title>GitHub Operations · Planetbintang</title>
<style>
:root{color-scheme:dark;--bg:#07111f;--panel:#0d1b2b;--line:#29445e;--text:#edf5ff;--muted:#a6bbcf;--cyan:#86e4ff;--green:#8ce7be;--amber:#f5d28c;--red:#ffaaa9;font-family:Inter,system-ui,sans-serif}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 80% -20%,#193c5c,transparent 48%),var(--bg);color:var(--text);min-height:100vh}a{color:var(--cyan)}button,input,select,textarea{font:inherit}.top{display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap;padding:16px clamp(14px,4vw,42px);border-bottom:1px solid var(--line);position:sticky;top:0;background:#07111fee;z-index:3}.brand{font-weight:850;letter-spacing:.12em;font-size:12px}.brand small{display:block;color:var(--muted);font-weight:400;letter-spacing:0;margin-top:5px}.top nav{display:flex;gap:14px;flex-wrap:wrap;font-size:12px}main{max-width:1450px;margin:auto;padding:clamp(14px,3vw,36px)}.hero{display:flex;justify-content:space-between;align-items:end;gap:20px;flex-wrap:wrap;padding:clamp(20px,4vw,38px);border:1px solid var(--line);background:linear-gradient(120deg,#122d46,#0b1929)}.eyebrow{color:var(--cyan);font-size:10px;letter-spacing:.2em;font-weight:800}.hero h1{font-size:clamp(28px,4vw,44px);letter-spacing:-.04em;margin:10px 0}.hero p{color:#c1d2e3;font-size:13px;line-height:1.7;max-width:780px}.status{padding:10px 12px;border:1px solid var(--line);font-size:11px;color:var(--amber);max-width:100%;overflow-wrap:anywhere}.grid{display:grid;grid-template-columns:minmax(270px,.75fr) minmax(0,1.5fr);gap:14px;margin-top:14px;align-items:start}.panel{border:1px solid var(--line);background:#0b1928;padding:18px;min-width:0}.panel h2{font-size:16px;margin:0 0 12px}.field{display:grid;gap:6px;margin:12px 0;color:#c7d9e9;font-size:11px}.field input,.field select,.field textarea{width:100%;min-width:0;padding:11px;border:1px solid #34516c;background:#071321;color:var(--text);font-size:12px;outline-color:var(--cyan)}.field textarea{min-height:90px;resize:vertical}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.btn{padding:10px 12px;border:1px solid #3b5c78;background:#142b40;color:var(--text);font-size:11px;cursor:pointer}.btn.primary{background:#b8efff;color:#071321;border-color:#b8efff;font-weight:800}.btn:disabled{opacity:.45;cursor:not-allowed}.muted{color:var(--muted);font-size:11px;line-height:1.7}.notice{border-left:2px solid var(--amber);padding:10px 12px;background:#201e18;color:#e9d8b1;font-size:11px;line-height:1.7;margin-top:12px}.metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px;margin:14px 0}.metric{border:1px solid var(--line);background:#0b1928;padding:14px}.metric small{display:block;color:var(--muted);font-size:9px;letter-spacing:.1em}.metric strong{display:block;font-size:25px;margin-top:8px}.tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px}.tab{border:1px solid var(--line);background:#0c1a29;color:var(--muted);padding:9px 11px;font-size:11px;cursor:pointer}.tab[aria-selected=true]{border-color:var(--cyan);color:var(--cyan);background:#112c40}.toolbar{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}.toolbar input{flex:1;min-width:170px;padding:10px;border:1px solid var(--line);background:#071321;color:var(--text)}.list{display:grid;gap:8px}.item{padding:12px;border:1px solid #263f56;background:#091624;overflow-wrap:anywhere}.itemtop{display:flex;justify-content:space-between;gap:10px;align-items:start}.item b{font-size:12px}.item p{font-size:11px;line-height:1.6;color:var(--muted);margin:7px 0}.pill{display:inline-block;border:1px solid #34556f;padding:4px 7px;color:var(--green);font-size:9px;white-space:nowrap}.empty{padding:24px;text-align:center;border:1px dashed var(--line);color:var(--muted);font-size:12px}.footer{border-top:1px solid var(--line);margin-top:18px;padding:16px 0;color:var(--muted);font-size:10px;line-height:1.7}#toast{display:none;position:fixed;bottom:16px;left:50%;transform:translateX(-50%);max-width:90vw;padding:12px 16px;background:#d5f5ff;color:#071321;z-index:9;font-size:12px}.hide{display:none!important}@media(max-width:850px){.grid{grid-template-columns:1fr}.metrics{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:460px){.metric strong{font-size:20px}.panel{padding:13px}.itemtop{flex-direction:column}}
</style>
</head>
<body>
<header class="top"><div class="brand">PLANETBINTANG / GITHUB OPS<small>Konsol data langsung · REST API</small></div><nav><a href="./index.html">Sistem utama</a><a href="./git-feature-catalog.html">Katalog fitur</a><a href="./feature-workbench.html">Ruang kerja implementasi</a></nav></header>
<main>
<section class="hero"><div><div class="eyebrow">OPERATIONAL WORKSPACE</div><h1>GitHub Operations</h1><p>Panel operasional untuk membaca repositori, branch, commit, issue, pull request, dan workflow dari GitHub secara langsung. Aksi yang mengubah data hanya dikirim ke API GitHub setelah Anda memberikan token dengan izin yang sesuai.</p></div><div id="connectionStatus" class="status" role="status">Belum terhubung · isi owner dan repository, lalu muat data</div></section>
<section class="metrics" aria-label="Statistik repositori"><div class="metric"><small>STARS</small><strong id="stars">—</strong></div><div class="metric"><small>FORKS</small><strong id="forks">—</strong></div><div class="metric"><small>OPEN ISSUES</small><strong id="issuesCount">—</strong></div><div class="metric"><small>DEFAULT BRANCH</small><strong id="defaultBranch" style="font-size:15px;overflow-wrap:anywhere">—</strong></div></section>
<div class="grid">
<aside class="panel"><h2>Koneksi GitHub</h2><p class="muted">Data repositori publik dapat dibaca tanpa token. Untuk repositori privat atau aksi tulis, gunakan fine-grained personal access token dengan akses repositori minimum yang diperlukan. Token hanya disimpan di memori tab ini, tidak masuk localStorage atau URL.</p>
<label class="field">Pemilik / organisasi<input id="owner" value="planetbintang" autocomplete="off" spellcheck="false"></label>
<label class="field">Nama repositori<input id="repo" value=".L" autocomplete="off" spellcheck="false"></label>
<label class="field">Token (opsional; hanya sesi tab)<input id="token" type="password" autocomplete="off" placeholder="github_pat_…"></label>
<div class="actions"><button class="btn primary" id="connect">Muat data langsung</button><button class="btn" id="disconnect">Hapus token sesi</button></div>
<div class="notice"><b>Batas keamanan:</b> GitHub Pages adalah frontend statis. Token browser tetap dapat diakses oleh JavaScript pada halaman ini dan ekstensi browser; jangan gunakan token luas/klasik pada perangkat bersama. Untuk layanan produksi multi-pengguna, gunakan backend/proxy dengan session server-side, audit, rate limit, dan secret manager.</div>
<h2 style="margin-top:22px">Buat issue GitHub</h2><p class="muted">Operasi nyata. Memerlukan token dengan izin Issues: Read and write. Issue akan dibuat pada repositori yang sedang dipilih.</p>
<label class="field">Judul issue<input id="issueTitle" maxlength="200" placeholder="Ringkasan masalah atau pekerjaan"></label><label class="field">Deskripsi<textarea id="issueBody" maxlength="60000" placeholder="Langkah reproduksi, kriteria penerimaan, atau konteks"></textarea></label>
<div class="actions"><button class="btn primary" id="createIssue" disabled>Buat issue</button></div><p class="muted" id="writeHint">Hubungkan repositori dan token yang berizin untuk mengaktifkan aksi tulis.</p>
</aside>
<section class="panel"><div class="tabs" role="tablist" aria-label="Data GitHub"><button class="tab" data-tab="overview" aria-selected="true">Ringkasan</button><button class="tab" data-tab="branches" aria-selected="false">Branches</button><button class="tab" data-tab="commits" aria-selected="false">Commits</button><button class="tab" data-tab="issues" aria-selected="false">Issues</button><button class="tab" data-tab="pulls" aria-selected="false">Pull requests</button><button class="tab" data-tab="actions" aria-selected="false">Actions</button></div>
<div class="toolbar"><input id="filter" type="search" placeholder="Filter data yang sedang tampil…"><button class="btn" id="refresh">Refresh</button></div><div id="dataView" class="list" aria-live="polite"><div class="empty">Hubungkan ke GitHub untuk memuat data asli.</div></div></section>
</div>
<footer class="footer">Integrasi ini menggunakan api.github.com langsung dan menampilkan respons aktual, bukan data contoh. Batas API, izin token, visibilitas repo, dan status workflow ditentukan oleh GitHub. Tanggal ditampilkan menurut waktu lokal perangkat. <span id="apiMeta"></span></footer>
</main><div id="toast" role="status" aria-live="polite"></div>
<script>
(()=>{'use strict';
const $=id=>document.getElementById(id);
const state={owner:'planetbintang',repo:'.L',token:'',repoData:null,tab:'overview',data:{overview:[],branches:[],commits:[],issues:[],pulls:[],actions:[]},busy:false};
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fmtDate=s=>s?new Date(s).toLocaleString():'Tanggal tidak tersedia';
const safeUrl=s=>{try{const u=new URL(s);return u.protocol==='https:'&&u.hostname==='github.com'?u.href:'#'}catch{return '#'}};
function toast(s){$('toast').textContent=s;$('toast').style.display='block';clearTimeout(toast.t);toast.t=setTimeout(()=>$('toast').style.display='none',3500)}
function status(s){$('connectionStatus').textContent=s}
function api(path,options={}){const headers={'Accept':'application/vnd.github+json','X-GitHub-Api-Version':'2022-11-28'};if(state.token)headers.Authorization='Bearer '+state.token;if(options.body)headers['Content-Type']='application/json';return fetch('https://api.github.com'+path,{...options,headers:{...headers,...options.headers}}).then(async r=>{const text=await r.text();let data;try{data=text?JSON.parse(text):{}}catch{data={message:text}}if(!r.ok){const e=new Error(data.message||('GitHub API HTTP '+r.status));e.status=r.status;e.data=data;throw e}return {data,remaining:r.headers.get('x-ratelimit-remaining'),limit:r.headers.get('x-ratelimit-limit')}})}
function escError(e){if(e.status===401)return'Token tidak valid atau kedaluwarsa (401).';if(e.status===403)return'Izin tidak cukup atau batas API tercapai (403). Periksa izin token dan rate limit.';if(e.status===404)return'Repositori atau endpoint tidak ditemukan/ tidak dapat diakses (404).';if(e.status===422)return'GitHub menolak validasi data (422). Periksa judul issue, izin, dan aturan repositori.';return e.message||'Permintaan gagal.'}
function render(){const q=$('filter').value.trim().toLocaleLowerCase();const rows=state.data[state.tab]||[];if(state.tab==='overview'){const d=state.repoData;if(!d){$('dataView').innerHTML='<div class="empty">Muat data repositori untuk melihat ringkasan.</div>';return}$('dataView').innerHTML='<article class="item"><div class="itemtop"><b>'+esc(d.full_name)+'</b><span class="pill">'+esc(d.private?'Private':'Public')+'</span></div><p>'+esc(d.description||'Tidak ada deskripsi')+'</p><p>Bahasa utama: '+esc(d.language||'Belum ditentukan')+' · Dibuat '+esc(fmtDate(d.created_at))+' · Diperbarui '+esc(fmtDate(d.updated_at))+'</p><p>Default branch: '+esc(d.default_branch)+' · License: '+esc(d.license?.spdx_id||'Tidak dicantumkan')+'</p><p><a href="'+safeUrl(d.html_url)+'" target="_blank" rel="noopener noreferrer">Buka repositori di GitHub ↗</a></p></article><article class="item"><b>Kapabilitas panel</b><p>Branches, commits, issues, pull requests dan Actions berasal dari API. Buat issue akan mengirim POST ke GitHub setelah tombol ditekan. Tidak ada status implementasi katalog yang diubah otomatis.</p></article>' ;return}
const filtered=rows.filter(x=>JSON.stringify([x.name,x.title,x.login,x.commit?.message,x.head?.ref,x.base?.ref,x.state,x.html_url,x.conclusion,x.status]).join(' ').toLocaleLowerCase().includes(q));
if(!filtered.length){$('dataView').innerHTML='<div class="empty">'+(rows.length?'Tidak ada data yang cocok dengan filter.':'Belum ada data. Tekan Refresh atau periksa izin API.')+'</div>';return}
$('dataView').innerHTML=filtered.map(x=>{let title=x.name||x.title||x.commit?.message?.split('\n')[0]||x.head?.ref||('Run #'+x.run_number)||'Item GitHub';let sub=x.commit?.author?.date||x.created_at||x.updated_at||x.pushed_at;let desc=x.commit?.message||x.description||x.body||x.head?.label||x.path||'';let status=x.conclusion||x.state||x.status||x.protected&&'protected'||'';let user=x.user?.login||x.author?.login||x.actor?.login||'';let url=safeUrl(x.html_url);return '<article class="item"><div class="itemtop"><b>'+esc(title)+'</b><span class="pill">'+esc(String(status||'aktif'))+'</span></div><p>'+esc(desc.slice(0,700))+'</p><p>'+esc(user)+' '+(sub?'· '+esc(fmtDate(sub)):'')+'</p><div class="actions">'+(url!=='#'?'<a class="btn" href="'+url+'" target="_blank" rel="noopener noreferrer">Buka di GitHub ↗</a>':'')+(x.sha?'<button class="btn copy-sha" data-sha="'+esc(x.sha)+'">Salin SHA</button>':'')+'</div></article>'}).join('');
document.querySelectorAll('.copy-sha').forEach(b=>b.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(b.dataset.sha);toast('SHA disalin')}catch{toast(b.dataset.sha)}}))}
async function load(){state.owner=$('owner').value.trim();state.repo=$('repo').value.trim();state.token=$('token').value.trim();if(!/^[a-zA-Z0-9-]+$/.test(state.owner)||!/^[a-zA-Z0-9_.-]+$/.test(state.repo)){toast('Format owner atau nama repositori tidak valid.');return}state.busy=true;$('connect').disabled=true;status('Menghubungkan ke api.github.com…');$('dataView').innerHTML='<div class="empty">Memuat data aktual dari GitHub…</div>';try{const root=await api('/repos/'+encodeURIComponent(state.owner)+'/'+encodeURIComponent(state.repo));state.repoData=root.data;$('stars').textContent=root.data.stargazers_count??'—';$('forks').textContent=root.data.forks_count??'—';$('issuesCount').textContent=root.data.open_issues_count??'—';$('defaultBranch').textContent=root.data.default_branch||'—';const base='/repos/'+encodeURIComponent(state.owner)+'/'+encodeURIComponent(state.repo);const results=await Promise.allSettled([api(base+'/branches?per_page=100'),api(base+'/commits?per_page=30'),api(base+'/issues?state=open&per_page=30'),api(base+'/pulls?state=open&per_page=30'),api(base+'/actions/runs?per_page=20')]);const keys=['branches','commits','issues','pulls','actions'];const errs=[];results.forEach((r,i)=>{if(r.status==='fulfilled'){let d=r.value.data;state.data[keys[i]]=keys[i]==='actions'?(d.workflow_runs||[]):Array.isArray(d)?d:[]}else{state.data[keys[i]]=[];errs.push(keys[i]+': '+escError(r.reason))}});state.data.issues=state.data.issues.filter(x=>!x.pull_request);const rate=results.find(r=>r.status==='fulfilled')?.value;status=(root.data.private?'Private':'Public')+' · '+root.data.full_name+' · API '+(rate?.remaining??'?')+'/'+(rate?.limit??'?')+' request tersisa';$('apiMeta').textContent='Terakhir dimuat: '+new Date().toLocaleString()+(errs.length?' · Endpoint terbatas: '+errs.join(' | '):'');$('createIssue').disabled=!state.token; $('writeHint').textContent=state.token?'Token dimuat di memori tab. Buat issue akan mengubah repositori nyata.':'Token tidak diisi: mode baca saja.';render();if(errs.length)toast('Sebagian endpoint gagal. Lihat catatan di bawah panel.');else toast('Data repositori berhasil dimuat dari GitHub.')}catch(e){state.repoData=null;status('Gagal terhubung · '+escError(e));$('dataView').innerHTML='<div class="empty">'+esc(escError(e))+'<br>Periksa nama repositori, koneksi internet, token, dan izin akses.</div>';toast(escError(e))}finally{state.busy=false;$('connect').disabled=false}}
async function createIssue(){if(!state.token){toast('Token dengan izin Issues: Read and write diperlukan.');return}const title=$('issueTitle').value.trim(),body=$('issueBody').value.trim();if(title.length<3){toast('Judul issue minimal 3 karakter.');return}if(!state.repoData){toast('Muat repositori terlebih dahulu.');return}if(!confirm('Buat issue nyata pada '+state.owner+'/'+state.repo+'?'))return;$('createIssue').disabled=true;try{const r=await api('/repos/'+encodeURIComponent(state.owner)+'/'+encodeURIComponent(state.repo)+'/issues',{method:'POST',body:JSON.stringify({title,body})});$('issueTitle').value='';$('issueBody').value='';toast('Issue #'+r.data.number+' berhasil dibuat.');state.tab='issues';document.querySelectorAll('[data-tab]').forEach(b=>b.setAttribute('aria-selected',String(b.dataset.tab===state.tab)));await load()}catch(e){toast('Issue tidak dibuat: '+escError(e))}finally{$('createIssue').disabled=!state.token}}
document.querySelectorAll('[data-tab]').forEach(b=>b.addEventListener('click',()=>{state.tab=b.dataset.tab;document.querySelectorAll('[data-tab]').forEach(x=>x.setAttribute('aria-selected',String(x===b)));render()}));
$('connect').addEventListener('click',load);$('refresh').addEventListener('click',load);$('filter').addEventListener('input',render);$('createIssue').addEventListener('click',createIssue);$('disconnect').addEventListener('click',()=>{$('token').value='';state.token='';$('createIssue').disabled=true;$('writeHint').textContent='Token dihapus dari memori aplikasi. Muat ulang data untuk kembali ke mode baca saja.';status('Token sesi dihapus. Data publik yang terakhir dimuat tetap terlihat.');toast('Token dihapus dari state aplikasi.')});
if(location.protocol==='file:'){status('Buka melalui GitHub Pages/HTTPS agar koneksi API berfungsi.')}else{load()}
})();
</script>
</body></html>